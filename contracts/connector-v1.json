{
  "contractVersion": 1,
  "snapshotSchemaVersion": 4,
  "capabilityRegistry": {
    "connector.contract.v1": {
      "owner": "shared",
      "fields": ["contractVersion"],
      "fallback": "reject snapshots with an unknown newer contract version"
    },
    "connector.daemon.status.v1": {
      "owner": "shared",
      "fields": ["daemon.platform", "daemon.status", "daemon.persistent", "daemon.registration"],
      "fallback": "show connector health as unknown without invalidating provider usage"
    },
    "activity.windowsProcessScan": {
      "owner": "windows",
      "fields": ["activity.scanSource"],
      "fallback": "use the Windows app process fallback and mark the snapshot partial"
    },
    "providerInstances.v1": {
      "owner": "shared",
      "fields": ["providerInstances"],
      "fallback": "render the aggregate providers map as one connection per provider",
      "optionalFields": ["providerInstances[].usage.today", "providerInstances[].usage.week", "providerInstances[].usage.month"]
    },
    "connections.openrouter.v1": {
      "owner": "shared",
      "fields": ["connections"],
      "fallback": "omit explicit API connections while preserving observed provider integrations"
    },
    "connections.codex.appServer.v1": {
      "owner": "shared",
      "fields": ["connections"],
      "fallback": "omit managed Codex connections while preserving observed provider integrations"
    },
    "usage.antigravity.sqlite": {
      "owner": "shared",
      "fields": ["providers.antigravity.tokens", "providers.antigravity.sourceAttribution"],
      "fallback": "show Antigravity quota and activity without borrowing Gemini CLI token usage"
    },
    "usage.tokenAccounting.v1": {
      "owner": "shared",
      "fields": [
        "providers.codex.tokens.undatedFloor",
        "providers.copilot.tokens.estimated",
        "providers.copilot.tokens.estimatedShare"
      ],
      "fallback": "render provider token totals without provenance details"
    },
    "homes.discovery": {
      "owner": "shared",
      "fields": [
        "homes.<provider>.tracked",
        "homes.<provider>.discovered[].id",
        "homes.<provider>.discovered[].path",
        "homes.<provider>.discovered[].sources",
        "homes.<provider>.discovered[].launchers",
        "homes.<provider>.discovered[].state",
        "homes.<provider>.discovered[].evidence",
        "homes.<provider>.discovered[].usage"
      ],
      "fallback": "ignore optional home diagnostics; render aggregate provider usage",
      "itemShape": {
        "id": "sha256(realpath)[:12]",
        "path": "tilde-relative; external homes use ~/<external-ID>",
        "sources": "array of default, adopted, env, known_runtime, auto, launcher",
        "launchers": "array of launcher names",
        "state": [
          "tracked",
          "excluded",
          "mirror",
          "foreign",
          "ambiguous"
        ],
        "evidence": "array of codes only",
        "usage": {
          "today": "tokens",
          "week": "tokens",
          "month": "tokens",
          "all": "tokens"
        }
      }
    }
  },
  "sharedRequired": [
    "snapshot.metadata",
    "activity.memory",
    "usage.coverage",
    "limits.errorBackoff",
    "limits.quotaFallbackOn429",
    "limits.codex.oauthUsage",
    "limits.claude.oauthUsage",
    "limits.claude.statuslineQuotas",
    "limits.grok.oauthUsage",
    "limits.kimi.oauthUsage",
    "providerInstances.v1"
  ],
  "apps": {
    "macos": {
      "minimumAppVersion": "26.34.6",
      "required": [
        "snapshot.metadata",
        "activity.memory",
        "limits.errorBackoff",
        "limits.quotaFallbackOn429",
        "limits.claude.statuslineQuotas",
        "limits.grok.oauthUsage",
        "limits.kimi.oauthUsage",
        "providerInstances.v1"
      ],
      "platformRequired": []
    },
    "windows": {
      "minimumAppVersion": "26.28.4",
      "required": [
        "snapshot.metadata",
        "connector.daemon.status.v1",
        "activity.memory",
        "usage.coverage",
        "limits.errorBackoff",
        "limits.quotaFallbackOn429",
        "limits.codex.oauthUsage",
        "limits.claude.oauthUsage",
        "limits.claude.statuslineQuotas",
        "limits.grok.oauthUsage",
        "limits.kimi.oauthUsage",
        "providerInstances.v1"
      ],
      "platformRequired": [
        "activity.windowsProcessScan",
        "usage.antigravity.sqlite"
      ]
    }
  },
  "compatibilityAliases": {
    "connector.daemon": "connector.daemon.status.v1"
  }
}
