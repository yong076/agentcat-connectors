def _lookup_pricing(
    model: str,
    table: Optional[Dict[str, Dict[str, Any]]] = None,
) -> Optional[Dict[str, Any]]:
    """Resolve a model name to its pricing entry, tolerant of dated suffixes.

    Consults the merged table (LiteLLM feed overlaid on the bundled
    MODEL_PRICING) unless an explicit table is supplied.
    """
    if table is None:
        table = merged_pricing_table()[0]
    if model in table:
        return table[model]
    normalized = model.lower()
    if normalized in table:
        return table[normalized]
    trimmed = normalized.replace("-preview", "").replace("-latest", "")
    if trimmed in table:
        return table[trimmed]
    # Strip trailing dated build id (e.g. -20251022)
    m = re.match(r"^(.+?)-\d{6,}$", trimmed)
    if m and m.group(1) in table:
        return table[m.group(1)]
    # Longest-prefix match for variants like "claude-opus-4-7-1m"; longest so
    # "gpt-5.5-codex" prefers a "gpt-5.5" entry over "gpt-5".
    best_key: Optional[str] = None
    for key in table:
        if not trimmed.startswith(key):
            continue
        # Require a separator boundary after the prefix so "gpt-4" does not match an
        # unrelated "gpt-45…": the char right after the key must be "-"/"." or the
        # end of the string (audit #13).
        rest = trimmed[len(key):]
        if rest and rest[0] not in "-.":
            continue
        if best_key is None or len(key) > len(best_key):
            best_key = key
    if best_key is not None:
        return table[best_key]
    return None


def _tier_rates(pricing: Dict[str, Any], context_tokens: Optional[int]) -> Dict[str, float]:
    """Flatten a price entry into the 4 bucket rates, applying tier overrides.

    Missing cache rates degrade safely: cache_read -> 0 (models without cache
    pricing report no cache tokens anyway), cache_write -> input rate (a cache
    write costs at least a fresh prompt). When context_tokens is provided and
    the entry carries "tiers" (e.g. above-200k long-context rates), the
    highest tier whose threshold <= context_tokens overrides the base rates.
    """
    base_input = float(pricing.get("input") or 0.0)
    rates = {
        "input": base_input,
        "output": float(pricing.get("output") or 0.0),
        "cache_read": float(pricing.get("cache_read") or 0.0),
        "cache_write": float(pricing["cache_write"]) if pricing.get("cache_write") is not None else base_input,
    }
    tiers = pricing.get("tiers")
    if context_tokens is None or not isinstance(tiers, list):
        return rates
    selected: Optional[Dict[str, Any]] = None
    selected_threshold = -1.0
    for tier in tiers:
        if not isinstance(tier, dict):
            continue
        threshold = tier.get("threshold")
        if isinstance(threshold, bool) or not isinstance(threshold, (int, float)):
            continue
        if context_tokens >= threshold and threshold > selected_threshold:
            selected = tier
            selected_threshold = float(threshold)
    if selected:
        for bucket in ("input", "output", "cache_read", "cache_write"):
            value = selected.get(bucket)
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                rates[bucket] = float(value)
    return rates


def estimate_cost(
    model: str,
    input_tokens: int,
    output_tokens: int,
    cache_read_tokens: int,
    cache_write_tokens: int,
    context_tokens: Optional[int] = None,
) -> Optional[Dict[str, float]]:
    """Estimate USD cost for a model usage event, split by token bucket.

    Consults the merged price table (LiteLLM feed when cached, overlaid on
    the bundled MODEL_PRICING). Returns {input, output, cache_read,
    cache_write, total} or None if the model is unknown. Cost in each bucket
    = tokens / 1e6 * rate. Negative or None token counts are coerced to 0.

    Tiered pricing: when the entry carries above-Nk long-context tiers and
    the caller passes context_tokens, the whole row is priced at the matching
    tier — mirroring provider behavior where crossing the threshold reprices
    the request. Aggregated usage rows do not carry context-window size, so
    without context_tokens the base rate applies (documented simplification).
    """
    pricing = _lookup_pricing(model)
    if pricing is None:
        return None
    rates = _tier_rates(pricing, context_tokens)
    inp = max(0, int(input_tokens or 0))
    out = max(0, int(output_tokens or 0))
    cr = max(0, int(cache_read_tokens or 0))
    cw = max(0, int(cache_write_tokens or 0))
    cost_in = inp / 1_000_000.0 * rates["input"]
    cost_out = out / 1_000_000.0 * rates["output"]
    cost_cr = cr / 1_000_000.0 * rates["cache_read"]
    cost_cw = cw / 1_000_000.0 * rates["cache_write"]
    return {
        "input": cost_in,
        "output": cost_out,
        "cache_read": cost_cr,
        "cache_write": cost_cw,
        "total": cost_in + cost_out + cost_cr + cost_cw,
    }


# --- LiteLLM pricing feed (capability "pricing.feed") ---
# Refreshes the per-model price table from LiteLLM's public JSON at most once
# per PRICING_FETCH_MAX_AGE_SECONDS (24h). ANY failure keeps the previous
# cache; with no cache at all the bundled MODEL_PRICING serves estimates. The
# fetch runs on a background daemon thread (pricing_refresh_loop) so snapshot
# serving never blocks on the network.
_LITELLM_RATE_KEYS = {
    "input_cost_per_token": "input",
    "output_cost_per_token": "output",
    "cache_read_input_token_cost": "cache_read",
    "cache_creation_input_token_cost": "cache_write",
}
# Tiered long-context rates, e.g. "input_cost_per_token_above_200k_tokens".
# Anchored so time-based cache TTL keys ("..._above_1hr") never match.
_LITELLM_TIER_KEY_RE = re.compile(
    r"^(input_cost_per_token|output_cost_per_token|cache_read_input_token_cost|"
    r"cache_creation_input_token_cost)_above_(\d+)k_tokens$"
)
_PRICING_TABLE_LOCK = threading.Lock()
_PRICING_TABLE_MEMO: Optional[Tuple[Tuple[str, Optional[int], Optional[int]], Dict[str, Dict[str, Any]], Dict[str, Any]]] = None


def pricing_cache_file() -> Path:
    """LiteLLM price cache: {"fetchedAt": iso, "models": {model: per-1M rates}}."""
    return AGENTCAT_HOME / "pricing-cache.json"


def _per_million(raw: Any) -> Optional[float]:
    """LiteLLM stores USD per token; the connector prices in USD per 1M tokens."""
    if isinstance(raw, bool) or not isinstance(raw, (int, float)):
        return None
    value = float(raw) * 1_000_000.0
    if value < 0:
        return None
    return value


def litellm_price_table(raw: Any) -> Dict[str, Dict[str, Any]]:
    """Convert LiteLLM model_prices JSON into the bundled MODEL_PRICING shape.

    Output per model: {"input", "output", "cache_read"?, "cache_write"?,
    "tiers"?: [{"threshold": tokens, <bucket rate overrides>}]} with all rates
    in USD per 1M tokens. Skips the "sample_spec" metadata entry and models
    without positive input AND output token rates (embeddings, image models).
    Provider-prefixed keys ("anthropic/claude-x") also register their basename
    as an alias when no unprefixed entry exists.
    """
    if not isinstance(raw, dict):
        return {}
    table: Dict[str, Dict[str, Any]] = {}
    aliases: Dict[str, Dict[str, Any]] = {}
    for key, spec in raw.items():
        if not isinstance(key, str) or key == "sample_spec" or not isinstance(spec, dict):
            continue
        entry: Dict[str, Any] = {}
        for raw_key, bucket in _LITELLM_RATE_KEYS.items():
            rate = _per_million(spec.get(raw_key))
            if rate is not None:
                entry[bucket] = rate
        if not entry.get("input") or not entry.get("output"):
            continue
        tiers: Dict[int, Dict[str, float]] = {}
        for raw_key, value in spec.items():
            tier_match = _LITELLM_TIER_KEY_RE.match(raw_key)
            if not tier_match:
                continue
            rate = _per_million(value)
            if rate is None:
                continue
            threshold = int(tier_match.group(2)) * 1000
            tiers.setdefault(threshold, {})[_LITELLM_RATE_KEYS[tier_match.group(1)]] = rate
        if tiers:
            entry["tiers"] = [
                {"threshold": threshold, **rates}
                for threshold, rates in sorted(tiers.items())
            ]
        model_key = key.strip().lower()
        table[model_key] = entry
        if "/" in model_key:
            basename = model_key.rsplit("/", 1)[-1]
            if basename:
                aliases.setdefault(basename, entry)
    for basename, entry in aliases.items():
        table.setdefault(basename, entry)
    return table


def read_pricing_cache() -> Optional[Dict[str, Any]]:
    raw = read_json(pricing_cache_file())
    if not isinstance(raw, dict) or not isinstance(raw.get("models"), dict):
        return None
    return raw


def pricing_cache_age_seconds(cache: Optional[Dict[str, Any]]) -> Optional[float]:
    if not cache:
        return None
    fetched = parse_iso_timestamp(cache.get("fetchedAt"))
    if fetched is None:
        return None
    if fetched.tzinfo is None:
        fetched = fetched.replace(tzinfo=dt.timezone.utc)
    return max(0.0, (dt.datetime.now(dt.timezone.utc) - fetched).total_seconds())


def _fetch_litellm_raw() -> Any:
    request = urllib.request.Request(
        LITELLM_PRICING_URL,
        headers={"User-Agent": f"AgentCat/{CONNECTOR_VERSION}"},
    )
    with urllib.request.urlopen(request, timeout=PRICING_FETCH_HTTP_TIMEOUT_SECONDS) as response:
        return json.loads(response.read().decode("utf-8", "replace"))


def refresh_litellm_pricing(force: bool = False) -> Dict[str, Any]:
    """Fetch LiteLLM pricing at most once per PRICING_FETCH_MAX_AGE_SECONDS.

    ANY failure (network, JSON decode, empty table) keeps the existing cache
    so the last good fetch — or the bundled table — keeps serving estimates.
    """
    cache = read_pricing_cache()
    age = pricing_cache_age_seconds(cache)
    if not force and cache is not None and age is not None and age < PRICING_FETCH_MAX_AGE_SECONDS:
        return {"status": "fresh", "fetchedAt": cache.get("fetchedAt")}
    try:
        table = litellm_price_table(_fetch_litellm_raw())
        if not table:
            raise ValueError("LiteLLM price table was empty")
        payload = {"fetchedAt": now_iso(), "models": table}
        write_json_atomic(pricing_cache_file(), payload)
        return {"status": "fetched", "fetchedAt": payload["fetchedAt"], "models": len(table)}
    except Exception as exc:
        return {
            "status": "error",
            "error": str(exc),
            "fetchedAt": cache.get("fetchedAt") if cache else None,
        }


def merged_pricing_table() -> Tuple[Dict[str, Dict[str, Any]], Dict[str, Any]]:
    """Bundled pricing overlaid with the feed and current official overrides.

    LiteLLM rates normally win for models present in both. A small provider-
    verified override set is applied last so a lagging community feed cannot
    undo a newly announced price cut. Memoized on the cache file's (path,
    mtime, size) so per-snapshot cost estimation does not re-parse the cache.
    """
    global _PRICING_TABLE_MEMO
    path = pricing_cache_file()
    try:
        stat = path.stat()
        key = (str(path), stat.st_mtime_ns, stat.st_size)
    except OSError:
        key = (str(path), None, None)
    with _PRICING_TABLE_LOCK:
        memo = _PRICING_TABLE_MEMO
    if memo is not None and memo[0] == key:
        return memo[1], memo[2]
    cache = read_pricing_cache()
    table: Dict[str, Dict[str, Any]] = dict(MODEL_PRICING)
    if cache:
        table.update(cache["models"])
        meta = {"source": "litellm", "fetchedAt": cache.get("fetchedAt")}
    else:
        meta = {"source": "bundled", "fetchedAt": None}
    table.update(OFFICIAL_PRICING_OVERRIDES)
    with _PRICING_TABLE_LOCK:
        _PRICING_TABLE_MEMO = (key, table, meta)
    return table, meta


def pricing_status_snapshot() -> Dict[str, Any]:
    _table, meta = merged_pricing_table()
    return dict(meta)


def pricing_refresh_loop(interval_seconds: float, initial_delay_seconds: float) -> None:
    time.sleep(max(0.0, initial_delay_seconds))
    while True:
        try:
            state = refresh_litellm_pricing()
            if state.get("status") == "error":
                print(f"agentcatd pricing refresh failed: {state.get('error')}", file=sys.stderr, flush=True)
        except Exception as exc:
            print(f"agentcatd pricing loop failed: {exc}", file=sys.stderr, flush=True)
        time.sleep(max(60.0, interval_seconds))


_FINDING_SEVERITY_ORDER = {"high": 0, "medium": 1, "info": 2}


def _insight_int(raw: Any) -> int:
    if isinstance(raw, bool):
        return 0
    if isinstance(raw, (int, float)):
        return max(0, int(raw))
    if isinstance(raw, str):
        try:
            return max(0, int(float(raw.replace(",", "").strip())))
        except ValueError:
            return 0
    return 0


def _scaled_token_class(amount: int, period_total: int, all_total: int) -> int:
    if amount <= 0 or period_total <= 0:
        return 0
    if all_total <= 0 or period_total >= all_total:
        return amount
    return max(0, int(round(amount * (period_total / all_total))))


def insight_model_period_bucket(
    model_data: Dict[str, Any],
    period: str,
    *,
    allow_lifetime_fallback: bool = True,
) -> Optional[Tuple[Dict[str, int], int]]:
    """Return per-class model tokens plus total for an insights period.

    Older model stats store `week`/`today` as nested token-class dicts. Gemini,
    Codex, OpenCode, and Copilot snapshots store the same period as an integer
    total next to top-level token classes. Treat both as first-class inputs so
    providers are not dropped from the pre-derived insights object.
    """
    raw_bucket = model_data.get(period)
    token_keys = (
        "inputTokens",
        "outputTokens",
        "cacheReadInputTokens",
        "cacheCreationInputTokens",
    )
    extra_token_keys = ("thoughtTokens", "toolTokens", "reasoningTokens")

    if isinstance(raw_bucket, dict):
        bucket = {key: _insight_int(raw_bucket.get(key)) for key in token_keys}
        extra_total = sum(_insight_int(raw_bucket.get(key)) for key in extra_token_keys)
        explicit_total = _insight_int(raw_bucket.get("totalTokens"))
        total = explicit_total or sum(bucket.values()) + extra_total
        return bucket, total

    if raw_bucket is not None:
        period_total = _insight_int(raw_bucket)
        if period_total <= 0:
            return None
        all_total = _insight_int(model_data.get("all")) or sum(
            _insight_int(model_data.get(key)) for key in (*token_keys, *extra_token_keys)
        )
        bucket = {
            key: _scaled_token_class(_insight_int(model_data.get(key)), period_total, all_total)
            for key in token_keys
        }
        return bucket, period_total

    if not allow_lifetime_fallback:
        return None

    bucket = {key: _insight_int(model_data.get(key)) for key in token_keys}
    extra_total = sum(_insight_int(model_data.get(key)) for key in extra_token_keys)
    explicit_total = _insight_int(model_data.get("totalTokens"))
    total = explicit_total or sum(bucket.values()) + extra_total
    if total <= 0:
        return None
    return bucket, total


def derive_insights(snapshot: Dict[str, Any], period: str = "week") -> Dict[str, Any]:
    """Pure port of Swift AgentInsights.derive() with split-bucket pricing.

    Iterates snapshot.providers, sums per-bucket tokens per model, prices each
    bucket separately via estimate_cost(), emits findings (pricing_missing,
    provider_no_limits, high_weekly_usage), and returns the same shape the
    Mac/Windows clients will decode.

    period: "today" | "week" | "month" | "all"  — selects which bucket inside
    each model entry to read (if absent, falls back to the top-level model dict).
    """
    providers = snapshot.get("providers") or {}

    model_entries: list = []
    provider_tokens: Dict[str, int] = {}
    provider_cost: Dict[str, float] = {}
    provider_class_costs: Dict[str, Dict[str, float]] = {}
    provider_representatives: Dict[str, Tuple[int, str]] = {}
    pricing_known = False
    findings: list = []

    total_input = 0
    total_output = 0
    total_cache_read = 0
    total_cache_write = 0
    any_input = any_output = any_cache_read = any_cache_write = False

    for kind, provider in providers.items():
        if not isinstance(provider, dict):
            continue
        if provider.get("status") == "not_found":
            continue

        ptokens = provider.get("tokens") or {}
        models = provider.get("models") or {}
        for model_name, model_data in models.items():
            if not isinstance(model_data, dict):
                continue
            period_bucket = insight_model_period_bucket(
                model_data,
                period,
                allow_lifetime_fallback=(period == "all"),
            )
            if period_bucket is None:
                continue
            bucket, model_total = period_bucket
            i = int(bucket.get("inputTokens") or 0)
            o = int(bucket.get("outputTokens") or 0)
            cr = int(bucket.get("cacheReadInputTokens") or 0)
            cw = int(bucket.get("cacheCreationInputTokens") or 0)
            if model_total == 0:
                continue

            total_input += i
            total_output += o
            total_cache_read += cr
            total_cache_write += cw
            any_input = any_input or "inputTokens" in bucket
            any_output = any_output or "outputTokens" in bucket
            any_cache_read = any_cache_read or "cacheReadInputTokens" in bucket
            any_cache_write = any_cache_write or "cacheCreationInputTokens" in bucket

            cost = estimate_cost(model_name, i, o, cr, cw)
            if cost is None:
                findings.append({
                    "id": f"pricing_missing:{kind}:{model_name}",
                    "severity": "info",
                    "provider": kind,
                    "title": "Pricing missing",
                    "detail": f"No bundled price for {model_name}; cost shown as estimate-only",
                })
                cost_total = None
            else:
                cost_total = cost["total"]
                provider_cost[kind] = provider_cost.get(kind, 0.0) + cost_total
                class_cost = provider_class_costs.setdefault(
                    kind,
                    {"input": 0.0, "output": 0.0, "cache_read": 0.0, "cache_write": 0.0},
                )
                for key in class_cost:
                    class_cost[key] += cost.get(key, 0.0)
                pricing_known = True

            provider_tokens[kind] = provider_tokens.get(kind, 0) + model_total
            representative = provider_representatives.get(kind)
            candidate = (model_total, str(model_name))
            if representative is None or candidate[0] > representative[0] or (
                candidate[0] == representative[0] and candidate[1] < representative[1]
            ):
                provider_representatives[kind] = candidate
            model_entries.append({
                "name": model_name,
                "provider": kind,
                "tokens": model_total,
                "estimated_cost_usd": cost_total,
                "share_percent": 0.0,  # filled after totals known
            })

        if period == "all" and "all" in ptokens:
            provider_tokens[kind] = min(
                provider_tokens.get(kind, 0),
                _insight_int(ptokens.get("all")),
            )

        # provider_no_limits finding
        limits = provider.get("limits") or {}
        has_quota = bool(limits.get("quotas")) or limits.get("weeklyTokens") is not None \
                    or limits.get("monthlyTokens") is not None
        if not has_quota and provider_tokens.get(kind, 0) > 0:
            findings.append({
                "id": f"provider_no_limits:{kind}",
                "severity": "info",
                "provider": kind,
                "title": "Provider has no quota metadata",
                "detail": f"{kind} reports usage but no quota limits; remaining capacity unknown",
            })

        # high_weekly_usage finding
        used_pct = limits.get("weeklyUsedPercent")
        if used_pct is not None:
            try:
                used_pct_f = float(used_pct)
            except (TypeError, ValueError):
                used_pct_f = None
            if used_pct_f is not None and used_pct_f >= 80:
                findings.append({
                    "id": f"high_weekly_usage:{kind}",
                    "severity": "high" if used_pct_f >= 95 else "medium",
                    "provider": kind,
                    "title": "High weekly usage",
                    "detail": f"{kind} at {int(round(used_pct_f))}% of weekly limit",
                })

        # Override cost with JournalScanner per-period per-class data when available.
        # tokens["week_input"], tokens["week_cacheRead"], etc. are more accurate than
        # the lifetime stats-cache model buckets used above.
        pc_inp = int(ptokens.get(f"{period}_input") or 0)
        pc_out = int(ptokens.get(f"{period}_output") or 0)
        pc_cr  = int(ptokens.get(f"{period}_cacheRead") or 0)
        pc_cw1h = int(ptokens.get(f"{period}_cacheWrite_1h") or 0)
        pc_cw5m = int(ptokens.get(f"{period}_cacheWrite_5m") or 0)
        if pc_inp or pc_out or pc_cr or pc_cw1h or pc_cw5m:
            # Pick pricing from the dominant model for this provider
            representative = provider_representatives.get(kind)
            rep_model = representative[1] if representative is not None else kind
            pc_cost = estimate_cost(rep_model, pc_inp, pc_out, pc_cr, pc_cw1h + pc_cw5m)
            if pc_cost:
                pricing_known = True
                provider_class_costs[kind] = pc_cost

    # Normalize share %
    total_tokens = sum(provider_tokens.values())
    for entry in model_entries:
        entry["share_percent"] = (entry["tokens"] / total_tokens * 100.0) if total_tokens > 0 else 0.0
    model_entries.sort(key=lambda e: -e["tokens"])

    # Provider summaries
    provider_summaries = []
    for kind in sorted(provider_tokens, key=lambda k: -provider_tokens[k]):
        tokens_val = provider_tokens[kind]
        if tokens_val == 0:
            continue
        provider_summaries.append({
            "kind": kind,
            "tokens": tokens_val,
            "estimated_cost_usd": provider_cost.get(kind, 0.0),
            "share_percent": (tokens_val / total_tokens * 100.0) if total_tokens > 0 else 0.0,
        })

    top_provider = provider_summaries[0]["kind"] if provider_summaries else None
    top_model = model_entries[0]["name"] if model_entries else None

    # Aggregate per-class model costs, including provider period-class overrides.
    sum_input_cost = sum_output_cost = sum_cr_cost = sum_cw_cost = 0.0
    any_pc_cost = False
    for pc in provider_class_costs.values():
        sum_input_cost += pc.get("input", 0.0)
        sum_output_cost += pc.get("output", 0.0)
        sum_cr_cost += pc.get("cache_read", 0.0)
        sum_cw_cost += pc.get("cache_write", 0.0)
        any_pc_cost = True
    total_cost = sum_input_cost + sum_output_cost + sum_cr_cost + sum_cw_cost

    cache_hit = None
    if any_cache_read or any_input:
        denom = total_cache_read + total_input
        if denom > 0:
            cache_hit = total_cache_read / denom * 100.0

    findings.sort(key=lambda f: (_FINDING_SEVERITY_ORDER.get(f["severity"], 9), f["id"]))

    return {
        "summary": {
            "total_tokens": total_tokens,
            "estimated_cost_usd": total_cost,
            "top_provider": top_provider,
            "top_model": top_model,
            "input_tokens": total_input if any_input else None,
            "output_tokens": total_output if any_output else None,
            "cache_read_tokens": total_cache_read if any_cache_read else None,
            "cache_write_tokens": total_cache_write if any_cache_write else None,
            "cache_hit_percent": cache_hit,
            # Per-class cost breakdown (populated when JournalScanner data available)
            "input_cost_usd": sum_input_cost if any_pc_cost else None,
            "output_cost_usd": sum_output_cost if any_pc_cost else None,
            "cache_read_cost_usd": sum_cr_cost if any_pc_cost else None,
            "cache_write_cost_usd": sum_cw_cost if any_pc_cost else None,
        },
        "providers": provider_summaries,
        "models": model_entries,
        "findings": findings,
        "pricing_status": "ok" if pricing_known else "unknown",
    }


BURN_RATE_WINDOW_MINUTES = 60
AUTO_QUOTA_MIN_SAMPLE_DAYS = 14
DAY_KEY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def provider_effective_usd_per_token(
    provider: Dict[str, Any], period: str = "today"
) -> Optional[float]:
    models = provider.get("models")
    if not isinstance(models, dict):
        return None
    priced_cost = 0.0
    priced_tokens = 0
    for model_name, model_data in models.items():
        if not isinstance(model_data, dict):
            continue
        period_bucket = insight_model_period_bucket(
            model_data, period, allow_lifetime_fallback=(period == "all")
        )
        if period_bucket is None:
            continue
        classes, total = period_bucket
        if total <= 0 or sum(int(value or 0) for value in classes.values()) <= 0:
            continue
        cost = estimate_cost(
            model_name,
            int(classes.get("inputTokens") or 0),
            int(classes.get("outputTokens") or 0),
            int(classes.get("cacheReadInputTokens") or 0),
            int(classes.get("cacheCreationInputTokens") or 0),
        )
        if cost is None:
            continue
        priced_cost += cost["total"]
        priced_tokens += total
    return priced_cost / priced_tokens if priced_tokens > 0 else None


def provider_burn_rate(
    provider: Dict[str, Any], now: Optional[dt.datetime] = None
) -> Optional[Dict[str, Any]]:
    hourly = provider.get("hourlyTokens")
    if not isinstance(hourly, dict) or not hourly:
        return None
    now = now or dt.datetime.now(dt.timezone.utc)
    if now.tzinfo is None:
        now = now.replace(tzinfo=dt.timezone.utc)
    current = nonnegative_int(hourly.get(hour_key_for_timestamp(now))) or 0
    previous = nonnegative_int(hourly.get(hour_key_for_timestamp(now - dt.timedelta(hours=1)))) or 0
    tokens = current + previous
    if tokens <= 0:
        return None
    local = now.astimezone()
    basis_minutes = float(BURN_RATE_WINDOW_MINUTES) + local.minute + local.second / 60.0
    tokens_per_min = tokens / basis_minutes
    out: Dict[str, Any] = {
        "tokensPerMin": round(tokens_per_min, 3),
        "basisMinutes": round(basis_minutes, 1),
    }
    usd_per_token = provider_effective_usd_per_token(provider, period="today")
    if usd_per_token is not None:
        out["usdPerHour"] = round(tokens_per_min * 60.0 * usd_per_token, 4)
    return out


def provider_auto_quota(
    provider: Dict[str, Any], now: Optional[dt.datetime] = None
) -> Optional[Dict[str, Any]]:
    daily = provider.get("dailyTokens")
    if not isinstance(daily, dict):
        return None
    now = now or dt.datetime.now(dt.timezone.utc)
    today_key = day_key_for_timestamp(now)
    values: List[int] = []
    for day, raw in daily.items():
        if not DAY_KEY_RE.match(str(day)) or str(day) == today_key:
            continue
        amount = nonnegative_int(raw)
        if amount:
            values.append(amount)
    if len(values) < AUTO_QUOTA_MIN_SAMPLE_DAYS:
        return None
    values.sort()
    rank = (9 * len(values) + 9) // 10
    return {"p90DailyTokens": values[rank - 1], "sampleDays": len(values), "basis": "p90"}


def provider_quota_headroom(limits: Any) -> Optional[Tuple[float, Optional[int]]]:
    if not isinstance(limits, dict):
        return None
    candidates: List[Tuple[float, Optional[int]]] = []
    quotas = limits.get("quotas")
    for quota in quotas if isinstance(quotas, list) else []:
        if not isinstance(quota, dict):
            continue
        remaining = float_percent(quota.get("remainingPercent"))
        if remaining is None:
            used = float_percent(quota.get("usedPercent"))
            remaining = remaining_percent_from_used(used) if used is not None else None
        if remaining is not None:
            candidates.append((remaining, int_limit(quota.get("resetAt"))))
    if not candidates:
        weekly_used = float_percent(limits.get("weeklyUsedPercent"))
        if weekly_used is not None:
            candidates.append((100.0 - weekly_used, reset_epoch(limits.get("weeklyResetAt"))))
    return min(candidates, key=lambda entry: entry[0]) if candidates else None


def snapshot_recommendation(providers: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    entries: List[Tuple[str, float, Optional[int]]] = []
    for provider_id in sorted(providers or {}):
        data = providers[provider_id]
        if not isinstance(data, dict) or data.get("status") != "ok":
            continue
        headroom = provider_quota_headroom(data.get("limits"))
        if headroom is not None:
            entries.append((str(provider_id), headroom[0], headroom[1]))
    if len(entries) < 2:
        return None

    def sort_key(entry: Tuple[str, float, Optional[int]]) -> Tuple[float, float, str]:
        provider_id, headroom, reset_at = entry
        return (-headroom, float(reset_at) if reset_at is not None else float("inf"), provider_id)

    entries.sort(key=sort_key)
    top, runner_up = entries[0], entries[1]
    reason = "most_headroom" if top[1] > runner_up[1] else "resets_soonest"
    return {"providerId": top[0], "reason": reason, "confidence": "heuristic"}


