SENSITIVE_KEY_PARTS = (
    "prompt",
    "completion",
    "content",
    "cwd",
    "directory",
    "file_path",
    "filepath",
    "message",
    "messages",
    "path",
    "repo",
    "transcript",
    "conversation",
    "input_text",
    "output_text",
    "workspace",
    "description",
    "command",
    "title",
    "args",
)

# Exact-match denylist for short keys that would over-match as substrings
# (e.g. "text" would otherwise redact "context_window", a legitimate metric).
SENSITIVE_KEY_EXACT = frozenset(
    {
        "text",
        "arg",
        "argv",
    }
)

# Numeric-metadata keys survive redaction even when they contain a sensitive
# token: a COUNT or SIZE of messages/commands/paths is not the content itself.
BENIGN_METRIC_SUFFIXES = frozenset(
    {
        "count", "counts", "size", "sizes", "total", "totals", "segments",
        "len", "length", "bytes", "ms", "seconds", "percent", "pct",
        "ratio", "index", "num", "version",
    }
)

# Value-based redaction: even when a key is not in the denylist, redact string
# values that look like filesystem paths or secrets so prompt-shaped content
# never lands in storage. Token/limit metadata stays numeric, so this only
# trips on string values.
SENSITIVE_VALUE_PATTERNS: Tuple[re.Pattern[str], ...] = (
    # Dir-root-anchored absolute paths only, so 3-segment model identifiers like
    # "openrouter/anthropic/claude-3-opus" are not mistaken for filesystem paths.
    re.compile(r"^(?:file://)?/(?:Users|home|var|tmp|private|opt|etc|root)/", re.IGNORECASE),
    re.compile(r"^~[/\\]"),  # home-relative paths
    re.compile(r"^[A-Za-z]:[\\/]"),  # windows drive paths
    re.compile(r"\\Users\\", re.IGNORECASE),  # windows user paths anywhere
    re.compile(r"\bsk-[A-Za-z0-9_-]{8,}\b"),  # OpenAI-style secret keys
    re.compile(r"\b(?:sk-ant|ghp|gho|ghu|ghs|github_pat|xox[abpr]|AKIA)[A-Za-z0-9_-]{6,}\b"),  # vendor tokens
    re.compile(r"\bBearer\s+[A-Za-z0-9._-]{10,}\b", re.IGNORECASE),  # bearer tokens
    re.compile(r"\beyJ[A-Za-z0-9._-]{20,}\b"),  # JWT-shaped tokens
)


def value_is_sensitive(value: str) -> bool:
    candidate = value.strip()
    if not candidate or len(candidate) > 4000:
        # Empty values are harmless; oversized free text is already truncated by
        # sanitize_payload and is treated conservatively as non-matching here.
        candidate = candidate[:4000]
    return any(pattern.search(candidate) for pattern in SENSITIVE_VALUE_PATTERNS)

RUNTIME_MODE_TTL_SECONDS = int(os.environ.get("AGENTCAT_RUNTIME_MODE_TTL_SECONDS", "1800"))
RUNTIME_MODE_KEYWORD_PATTERNS: Tuple[Tuple[re.Pattern[str], str], ...] = (
    (re.compile(r"\bultra[\s_-]*think\b|\bultrathink\b", re.IGNORECASE), "ultrathink"),
    (re.compile(r"\bultra[\s_-]*code\b|\bultracode\b", re.IGNORECASE), "ultracode"),
)
RUNTIME_MODE_PROMPT_KEYS = {
