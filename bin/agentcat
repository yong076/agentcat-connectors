def droid_session_files(factory_dir: Path) -> List[Path]:
    sessions_dir = factory_dir / "sessions"
    files: List[Path] = []
    try:
        project_dirs = [path for path in sessions_dir.iterdir() if path.is_dir()]
    except OSError:
        return files
    for project_dir in project_dirs:
