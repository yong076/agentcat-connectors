def qwen_project_dirs() -> List[Path]:
    base = Path(os.environ.get("QWEN_DATA_DIR") or str(HOME / ".qwen" / "projects")).expanduser()
    try:
        return [path for path in base.iterdir() if path.is_dir()]
    except OSError:
        return []


def qwen_snapshot() -> Dict[str, Any]:
    source = Path(os.environ.get("QWEN_DATA_DIR") or str(HOME / ".qwen" / "projects")).expanduser()
    result = empty_provider_usage(source=str(source), provider="qwen")
    files: List[Path] = []
    for project_dir in qwen_project_dirs():
        chats = project_dir / "chats"
        try:
            files.extend(path for path in chats.iterdir() if path.is_file() and path.suffix == ".jsonl")
        except OSError:
            continue
    files = recent_candidate_files(files)
    events = 0
    for path in files:
        file_when = safe_file_mtime(path)
        for entry in iter_jsonl_file(path):
            if entry.get("type") != "assistant":
                continue
            usage = entry.get("usageMetadata")
            if not isinstance(usage, dict):
                continue
            metrics = {
                "inputTokens": nonnegative_int(usage.get("promptTokenCount")) or 0,
                "outputTokens": nonnegative_int(usage.get("candidatesTokenCount")) or 0,
                "reasoningTokens": nonnegative_int(usage.get("thoughtsTokenCount")) or 0,
                "cacheReadInputTokens": nonnegative_int(usage.get("cachedContentTokenCount")) or 0,
            }
            if add_usage_metrics(
                result,
                entry.get("model") or "qwen-auto",
                metrics,
                parse_timestamp(entry.get("timestamp")) or file_when,
                project=path.parent.parent.name,
                session_id=str(entry.get("sessionId") or path.stem),
            ):
                events += 1
    return finish_local_usage_snapshot(result, events, sources_seen=bool(files))


def pi_like_snapshot(provider: str, base: Path, default_model: str = "gpt-5") -> Dict[str, Any]:
    sessions_dir = base / "agent" / "sessions"
    result = empty_provider_usage(source=str(sessions_dir), provider=provider)
    files: List[Path] = []
    try:
        project_dirs = [path for path in sessions_dir.iterdir() if path.is_dir()]
    except OSError:
        project_dirs = []
    for project_dir in project_dirs:
        try:
            files.extend(path for path in project_dir.iterdir() if path.is_file() and path.suffix == ".jsonl")
        except OSError:
            continue
    files = recent_candidate_files(files)
    events = 0
    for path in files:
        file_when = safe_file_mtime(path)
        for entry in iter_jsonl_file(path):
            if entry.get("type") != "message":
                continue
            message = entry.get("message")
            if not isinstance(message, dict) or message.get("role") != "assistant":
                continue
            usage = message.get("usage")
            if not isinstance(usage, dict):
                continue
            metrics = {
                "inputTokens": nonnegative_int(usage.get("input")) or 0,
                "outputTokens": nonnegative_int(usage.get("output")) or 0,
                "cacheReadInputTokens": nonnegative_int(usage.get("cacheRead")) or 0,
                "cacheCreationInputTokens": nonnegative_int(usage.get("cacheWrite")) or 0,
            }
            if add_usage_metrics(
                result,
                message.get("model") or default_model,
                metrics,
                parse_timestamp(entry.get("timestamp")) or file_when,
                project=path.parent.name,
                session_id=path.stem,
            ):
                events += 1
    return finish_local_usage_snapshot(result, events, sources_seen=bool(files))


