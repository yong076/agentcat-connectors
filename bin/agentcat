DESKTOP_APP_METADATA_SUFFIXES = {
    ".db",
    ".sqlite",
    ".sqlite3",
    ".json",
    ".jsonl",
    ".log",
}
DESKTOP_APP_SCAN_MAX_FILES = int(os.environ.get("AGENTCAT_DESKTOP_APP_SCAN_MAX_FILES", "4000"))


def iso_from_timestamp(timestamp: float) -> str:
    return dt.datetime.fromtimestamp(timestamp, dt.timezone.utc).isoformat().replace("+00:00", "Z")


def expand_agentcat_user_path(raw: str) -> Path:
    text = str(raw)
    if text == "~":
        return HOME
    if text.startswith("~/"):
        return HOME / text[2:]
    return Path(text).expanduser()


def configured_provider_entries(settings: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
    raw = settings.get("providers") if isinstance(settings.get("providers"), dict) else {}
    entries: Dict[str, Dict[str, Any]] = {}
    for provider in CONFIG_PROVIDER_IDS:
        entry = raw.get(provider) if isinstance(raw, dict) else None
        if isinstance(entry, dict):
            normalized: Dict[str, Any] = {"enabled": entry.get("enabled") is not False}
            if isinstance(entry.get("limits"), dict):
                normalized["limits"] = entry["limits"]
        else:
            normalized = {"enabled": True}
        entries[provider] = normalized
    if isinstance(raw, dict):
        for provider, entry in raw.items():
            if provider in entries:
                continue
            if isinstance(entry, dict):
                entries[str(provider)] = dict(entry)
    return entries


def normalize_desktop_app_path(raw: Any) -> Optional[str]:
    if raw is None:
        return None
    if not isinstance(raw, str):
        raise ValueError("desktop app path must be a string")
    trimmed = raw.strip()
    if not trimmed:
        return None
    path = expand_agentcat_user_path(trimmed)
    if not path.is_absolute():
        raise ValueError("desktop app path must be absolute")
    return str(path)


def normalize_desktop_app_config(provider: str, raw: Any) -> Dict[str, Any]:
    if provider not in DESKTOP_APP_PROVIDER_IDS:
        raise ValueError(f"unsupported desktop app provider: {provider}")
    if raw is None:
        return {}
    if not isinstance(raw, dict):
        raise ValueError("desktop app config entry must be an object")
    path = normalize_desktop_app_path(raw.get("path"))
    return {"path": path} if path else {}


def first_existing_default_app_path(provider: str) -> Optional[str]:
    spec = DESKTOP_APP_SPECS.get(provider) or {}
    for raw in spec.get("defaultPaths", ()):
        path = expand_agentcat_user_path(str(raw))
        try:
            if path.exists():
                return str(path)
        except OSError:
            continue
    return None


def desktop_app_bundle_id(path: Path) -> Optional[str]:
    info = path / "Contents" / "Info.plist"
    try:
        result = subprocess.run(
            ["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleIdentifier", str(info)],
            capture_output=True,
            text=True,
            timeout=1.5,
        )
        bundle_id = result.stdout.strip()
        if result.returncode == 0 and bundle_id:
            return bundle_id
    except Exception:
        pass
    try:
        text = info.read_text(encoding="utf-8", errors="ignore")
        match = re.search(r"<key>CFBundleIdentifier</key>\s*<string>([^<]+)</string>", text)
        return match.group(1).strip() if match else None
    except Exception:
        return None


def desktop_app_host_label(provider: str, path: Path, bundle_id: Optional[str]) -> Optional[str]:
    """Return the host application without changing the provider identity.

    ChatGPT and the standalone Codex app both expose the same account-level
    Codex usage. The host label is therefore metadata only; it must never
    create a second provider or a second quota.
    """
    if provider != "codex":
        return None
    if bundle_id == "com.openai.chat" or path.name.lower() == "chatgpt.app":
        return "ChatGPT"
    if bundle_id in {"com.openai.codex", "com.openai.chatgpt.codex"} or path.name.lower() == "codex.app":
        return "Codex"
    return None


def desktop_app_data_roots(provider: str) -> List[Path]:
    spec = DESKTOP_APP_SPECS.get(provider) or {}
    roots: List[Path] = []
    for raw in spec.get("dataRoots", ()):
        try:
            roots.append(expand_agentcat_user_path(str(raw)))
        except Exception:
            continue
    return roots


def scan_desktop_app_data_root(root: Path) -> Dict[str, Any]:
    result: Dict[str, Any] = {
        "path": str(root),
        "exists": False,
        "readableFiles": 0,
        "latestModifiedAt": None,
        "truncated": False,
    }
    try:
        if not root.exists():
            return result
        result["exists"] = True
        latest_mtime: Optional[float] = None
        scanned = 0
        for path in root.rglob("*"):
            scanned += 1
            if scanned > DESKTOP_APP_SCAN_MAX_FILES:
                result["truncated"] = True
                break
            try:
                if not path.is_file():
                    continue
                if path.suffix.lower() not in DESKTOP_APP_METADATA_SUFFIXES:
                    continue
                stat = path.stat()
            except OSError:
                continue
            result["readableFiles"] = int(result["readableFiles"]) + 1
            if latest_mtime is None or stat.st_mtime > latest_mtime:
                latest_mtime = stat.st_mtime
        if latest_mtime is not None:
            result["latestModifiedAt"] = iso_from_timestamp(latest_mtime)
        return result
    except Exception as exc:
        result["error"] = str(exc)
        return result


def desktop_app_source_snapshot(provider: str, settings: Dict[str, Any]) -> Dict[str, Any]:
    spec = DESKTOP_APP_SPECS.get(provider) or {}
    raw_apps = settings.get("desktopApps") if isinstance(settings.get("desktopApps"), dict) else {}
    raw_entry = raw_apps.get(provider) if isinstance(raw_apps, dict) else None
    configured_path = None
    try:
        if isinstance(raw_entry, dict):
            configured_path = normalize_desktop_app_path(raw_entry.get("path"))
    except ValueError:
        configured_path = None
    default_path = first_existing_default_app_path(provider)
    selected_path = configured_path or default_path
    configured = bool(configured_path)

    usage_import = "allowlisted_usage" if provider == "claude" else "metadata_only"
    tokens_included = usage_import == "allowlisted_usage"
    base: Dict[str, Any] = {
        "provider": provider,
        "displayName": spec.get("displayName") or provider,
        "hostApp": None,
        "path": selected_path,
        "configured": configured,
        "detectedDefault": (not configured and default_path is not None),
        "privacy": "metadata_only",
        "usageImport": usage_import,
        "tokensIncluded": tokens_included,
        "readsContent": False,
        "status": "not_configured",
        "dataRoots": [],
        "readableFiles": 0,
        "latestModifiedAt": None,
    }
    if not selected_path:
        return base

    path = expand_agentcat_user_path(selected_path)
    try:
        exists = path.exists()
        is_dir = path.is_dir()
    except OSError as exc:
        base["status"] = "error"
        base["error"] = str(exc)
        return base
    if not exists:
        base["status"] = "not_found"
        return base
    if not is_dir or path.suffix.lower() != ".app":
        base["status"] = "unsupported"
        return base

    bundle_id = desktop_app_bundle_id(path)
    if bundle_id:
        base["bundleId"] = bundle_id
    host_app = desktop_app_host_label(provider, path, bundle_id)
    if host_app:
        base["hostApp"] = host_app
    expected = set(str(item) for item in (spec.get("expectedBundleIds") or ()))
    if bundle_id and expected and bundle_id not in expected:
        base["bundleMismatch"] = True

    roots = [scan_desktop_app_data_root(root) for root in desktop_app_data_roots(provider)]
    base["dataRoots"] = roots
    readable = sum(int(root.get("readableFiles") or 0) for root in roots)
    base["readableFiles"] = readable
    latest_values = [
        root.get("latestModifiedAt")
        for root in roots
        if isinstance(root.get("latestModifiedAt"), str)
    ]
    if latest_values:
        base["latestModifiedAt"] = max(latest_values)
    if readable > 0:
        if tokens_included:
            base["status"] = "ok"
        else:
            base["status"] = "installed_no_data"
            base["statusDetail"] = "metadata_only_not_counted"
    else:
        base["status"] = "installed_no_data"
    return base


def desktop_app_sources_snapshot(settings: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    resolved = settings if isinstance(settings, dict) else agentcat_settings()
    return {
        provider: desktop_app_source_snapshot(provider, resolved)
        for provider in DESKTOP_APP_PROVIDER_IDS
    }


def attach_desktop_app_sources(
    providers: Dict[str, Dict[str, Any]],
    desktop_apps: Dict[str, Any],
) -> None:
    for provider, source in desktop_apps.items():
        if provider in providers and isinstance(providers[provider], dict):
            providers[provider]["desktopApp"] = source


def connector_config_payload(settings: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    resolved = settings if isinstance(settings, dict) else agentcat_settings()
    return {
        "contractVersion": CONTRACT_VERSION,
        "providers": configured_provider_entries(resolved),
        "desktopApps": desktop_app_sources_snapshot(resolved),
        "capabilities": list(CONNECTOR_CAPABILITIES),
    }


def connector_version_payload() -> Dict[str, Any]:
    """Return bounded runtime metadata without building a usage snapshot."""
    return {
        "connectorVersion": CONNECTOR_VERSION,
        "schemaVersion": SCHEMA_VERSION,
        "contractVersion": CONTRACT_VERSION,
        "capabilities": list(CONNECTOR_CAPABILITIES),
    }


def connector_contract_payload() -> Dict[str, Any]:
    """Return the connector-owned compatibility manifest.

    The file ships with the connector package and is deliberately separate
    from either app repository. Both presentation shells can pin this exact
    document in CI instead of growing independent capability interpretations.
    """
    path = Path(__file__).resolve().parent.parent / "contracts" / "connector-v1.json"
    raw = read_json(path)
    if not isinstance(raw, dict):
        raise ValueError("connector contract is missing or invalid")
    if int(raw.get("contractVersion") or 0) != CONTRACT_VERSION:
        raise ValueError("connector contract version does not match the runtime")
    if int(raw.get("snapshotSchemaVersion") or 0) != SCHEMA_VERSION:
        raise ValueError("connector contract schema version does not match the runtime")
    return raw


def _status_command(args: List[str]) -> Optional[subprocess.CompletedProcess]:
    try:
        return subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=3,
            creationflags=CREATE_NO_WINDOW,
        )
    except Exception:
        return None


def _daemon_status_snapshot_uncached() -> Dict[str, Any]:
    """Return path-free daemon persistence metadata for both app shells.

    This intentionally exposes booleans and registration kinds, never a task
    command, executable path, username, PID, or raw OS error. Snapshot and
    support bundles are therefore useful without becoming a path disclosure.
    """
    if IS_WINDOWS:
        task = _status_command(
            ["schtasks.exe", "/Query", "/TN", WINDOWS_TASK_NAME, "/FO", "LIST"]
        )
        run_entry = _status_command(
            ["reg.exe", "query", WINDOWS_RUN_KEY, "/v", WINDOWS_RUN_VALUE]
        )
        task_registered = bool(task is not None and task.returncode == 0)
        run_registered = bool(run_entry is not None and run_entry.returncode == 0)
        legacy_present = False
        if WINDOWS_LEGACY_STARTUP_SCRIPT.is_file():
            try:
                legacy_present = "daemon" in WINDOWS_LEGACY_STARTUP_SCRIPT.read_text(
                    encoding="utf-8", errors="ignore"
                ).lower()
            except OSError:
                legacy_present = False

        if task_registered:
            registration = "scheduled_task"
            status = "registered"
        elif run_registered:
            registration = "run_key"
            status = "fallback"
        elif legacy_present:
            registration = "legacy_startup"
            status = "fallback"
        else:
            registration = "none"
            status = "error" if task is None and run_entry is None else "missing"
        return {
            "platform": "windows",
            "status": status,
            "persistent": task_registered or run_registered or legacy_present,
            "registration": registration,
            "taskRegistered": task_registered,
            "runEntryRegistered": run_registered,
            "legacyStartupPresent": legacy_present,
        }

    if sys.platform == "darwin":
        registered = LAUNCHD_AGENT_PLIST.is_file()
        return {
            "platform": "macos",
            "status": "registered" if registered else "missing",
            "persistent": registered,
            "registration": "launch_agent" if registered else "none",
        }

    if sys.platform.startswith("linux"):
        return {
            "platform": "linux",
            "status": "manual",
            "persistent": False,
            "registration": "manual",
        }
    return {
        "platform": "other",
        "status": "manual",
        "persistent": False,
        "registration": "manual",
    }


def daemon_status_snapshot(force: bool = False) -> Dict[str, Any]:
    global _DAEMON_STATUS_AT, _DAEMON_STATUS_VALUE
    now = time.monotonic()
    with _DAEMON_STATUS_LOCK:
        if (
            not force
            and _DAEMON_STATUS_VALUE is not None
            and now - _DAEMON_STATUS_AT < DAEMON_STATUS_TTL_SECONDS
        ):
            return copy.deepcopy(_DAEMON_STATUS_VALUE)
        value = _daemon_status_snapshot_uncached()
        _DAEMON_STATUS_VALUE = copy.deepcopy(value)
        _DAEMON_STATUS_AT = now
        return value


def merge_connector_config_payload(payload: Dict[str, Any]) -> Dict[str, Any]:
    settings = agentcat_settings()
    if not isinstance(settings, dict):
        settings = {}

    providers_payload = payload.get("providers")
    if providers_payload is not None:
        if not isinstance(providers_payload, dict):
            raise ValueError("providers must be an object")
        current = settings.get("providers") if isinstance(settings.get("providers"), dict) else {}
        merged_providers: Dict[str, Any] = dict(current)
        for provider, raw_entry in providers_payload.items():
            if not isinstance(raw_entry, dict):
                raise ValueError("provider config entry must be an object")
            existing = merged_providers.get(str(provider)) if isinstance(merged_providers.get(str(provider)), dict) else {}
            entry = dict(existing)
            if "enabled" in raw_entry:
                entry["enabled"] = bool(raw_entry.get("enabled"))
            if isinstance(raw_entry.get("limits"), dict):
                entry["limits"] = raw_entry["limits"]
            merged_providers[str(provider)] = entry
        settings["providers"] = merged_providers

    desktop_payload = payload.get("desktopApps")
    if desktop_payload is not None:
        if not isinstance(desktop_payload, dict):
            raise ValueError("desktopApps must be an object")
        current_apps = settings.get("desktopApps") if isinstance(settings.get("desktopApps"), dict) else {}
        merged_apps: Dict[str, Any] = dict(current_apps)
        for provider, raw_entry in desktop_payload.items():
            provider_s = str(provider)
            normalized = normalize_desktop_app_config(provider_s, raw_entry)
            if normalized:
                merged_apps[provider_s] = normalized
            else:
                merged_apps.pop(provider_s, None)
        settings["desktopApps"] = merged_apps

    write_agentcat_settings(settings)
    return connector_config_payload(settings)


def disabled_provider_snapshot(provider: str) -> Dict[str, Any]:
    return {
        "status": "disabled",
        "source": "settings",
        "tokens": {},
        "models": {},
        "projects": {},
        "estimated": False,
        "message": f"{provider} scanning is disabled in Agent Cat settings",
    }


def env_flag(name: str, default: bool) -> bool:
    raw = os.environ.get(name)
    if raw is None:
        return default
    return raw.strip().lower() not in {"0", "false", "no", "off", "disabled"}


def positive_float(raw: Any) -> Optional[float]:
    if isinstance(raw, bool) or raw is None:
        return None
    try:
        value = float(raw)
    except (TypeError, ValueError):
        return None
    if not value > 0:
        return None
    return value


def windows_process_scan_timeout_seconds() -> float:
    env_value = positive_float(os.environ.get("AGENTCAT_WINDOWS_PROCESS_SCAN_TIMEOUT_SECONDS"))
    if env_value is not None:
        return min(max(env_value, 1.0), 30.0)

    settings = agentcat_settings()
    configured = positive_float(
        settings_value(
            settings,
            ("windowsProcessScanTimeoutSeconds",),
            ("processScanTimeoutSeconds",),
            ("windows", "processScanTimeoutSeconds"),
        )
    )
    if configured is not None:
        return min(max(configured, 1.0), 30.0)
    return 3.0


def read_stdin_payload() -> Any:
    try:
        data = sys.stdin.read()
    except OSError:
        # Hooks/statusline commands must stay non-blocking even when the host
        # process provides no readable stdin (pytest capture, some editor
        # launchers, detached notification hooks). Treat that as an empty event
        # payload rather than failing the runtime hook.
        return {}
    if not data.strip():
        return {}
    try:
        return json.loads(data)
    except json.JSONDecodeError:
        return {"raw": data[:4000]}


def normalized_key(key: Any) -> str:
    return str(key).replace("-", "_").replace(" ", "_").lower()


def key_is_sensitive(key_norm: str) -> bool:
    """Whole-underscore-token denylist check.

    A key is sensitive when a denylisted single-word part appears as a whole
    ``_`` token — so ``user_message``/``system_prompt``/``repo_path`` redact, not
    just the bare key — or a multi-token part (``file_path``/``input_text``)
    appears as a contiguous token run. Numeric-metadata keys whose LAST token is
    a benign suffix (``message_count``, ``path_segments``, ``content_length``)
    survive: a count/size is not the content. Token totals (``TOKEN_KEYS``) are
    filtered by the caller.
    """
    if key_norm in SENSITIVE_KEY_EXACT:
        return True
    tokens = key_norm.split("_")
    if tokens[-1] in BENIGN_METRIC_SUFFIXES:
        return False
    token_set = set(tokens)
    for part in SENSITIVE_KEY_PARTS:
        part_tokens = part.split("_")
        span = len(part_tokens)
        if span == 1:
            if part in token_set:
                return True
            continue
        if any(tokens[i : i + span] == part_tokens for i in range(len(tokens) - span + 1)):
            return True
    return False


def sanitize_payload(value: Any, depth: int = 0) -> Any:
    if depth > 8:
        return "[truncated]"
    if isinstance(value, dict):
        out: Dict[str, Any] = {}
        for key, child in value.items():
            key_s = str(key)
            key_norm = normalized_key(key_s)
            if key_norm not in TOKEN_KEYS and key_is_sensitive(key_norm):
                out[key_s] = "[redacted]"
            else:
                out[key_s] = sanitize_payload(child, depth + 1)
        return out
    if isinstance(value, list):
        return [sanitize_payload(item, depth + 1) for item in value[:50]]
    if isinstance(value, str):
        if value_is_sensitive(value):
            return "[redacted]"
        if len(value) > 1000:
            return value[:1000] + "...[truncated]"
    return value


def extract_tokens(value: Any) -> Dict[str, int]:
    totals: Dict[str, int] = {}

    def add(name: str, raw: Any) -> None:
        if isinstance(raw, bool):
            return
        if isinstance(raw, (int, float)):
            amount = int(raw)
        elif isinstance(raw, str) and raw.isdigit():
            amount = int(raw)
        else:
            return
        totals[name] = totals.get(name, 0) + max(0, amount)

    def walk(node: Any) -> None:
        if isinstance(node, dict):
            for key, child in node.items():
                canonical = TOKEN_KEYS.get(normalized_key(key))
                if canonical:
                    add(canonical, child)
                walk(child)
        elif isinstance(node, list):
            for child in node:
                walk(child)

    walk(value)
    if "totalTokens" not in totals:
        partial_total = sum(
            amount
            for key, amount in totals.items()
            if key in {"inputTokens", "outputTokens", "cacheReadInputTokens", "cacheCreationInputTokens", "thoughtTokens", "toolTokens"}
        )
        if partial_total:
            totals["totalTokens"] = partial_total
    return totals


def parse_iso_timestamp(value: Any) -> Optional[dt.datetime]:
    if not isinstance(value, str) or not value:
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def runtime_mode_expires_at(ts: int, ttl_seconds: int = RUNTIME_MODE_TTL_SECONDS) -> str:
    return dt.datetime.fromtimestamp(ts + max(1, ttl_seconds), dt.timezone.utc).isoformat().replace("+00:00", "Z")


def prompt_strings_for_runtime_mode(value: Any, sensitive_parent: bool = False, depth: int = 0) -> Iterable[str]:
    if depth > 8:
        return []
    if isinstance(value, dict):
        out: List[str] = []
        for key, child in value.items():
            key_norm = normalized_key(key)
            is_prompt_field = sensitive_parent or key_norm in RUNTIME_MODE_PROMPT_KEYS or "prompt" in key_norm
            out.extend(prompt_strings_for_runtime_mode(child, is_prompt_field, depth + 1))
        return out
    if isinstance(value, list):
        out: List[str] = []
        for child in value[:50]:
            out.extend(prompt_strings_for_runtime_mode(child, sensitive_parent, depth + 1))
        return out
    if sensitive_parent and isinstance(value, str):
        return [value]
    return []


def runtime_keyword_mode(value: Any) -> Optional[str]:
    for text in prompt_strings_for_runtime_mode(value):
        for pattern, mode in RUNTIME_MODE_KEYWORD_PATTERNS:
            if pattern.search(text) is not None:
                return mode
    return None


def normalize_runtime_effort(value: Any) -> Optional[str]:
    if isinstance(value, str):
        normalized = value.strip().lower().replace("-", "_")
        return normalized or None
    if isinstance(value, dict):
        for key, child in value.items():
            if normalized_key(key) in RUNTIME_MODE_EFFORT_VALUE_KEYS:
                normalized = normalize_runtime_effort(child)
                if normalized:
                    return normalized
    return None


def find_runtime_effort(value: Any) -> Optional[str]:
    if isinstance(value, dict):
        for key, child in value.items():
            key_norm = normalized_key(key)
            if key_norm in RUNTIME_MODE_EFFORT_KEYS:
                normalized = normalize_runtime_effort(child)
                if normalized:
                    return normalized
        for child in value.values():
            found = find_runtime_effort(child)
            if found:
                return found
    elif isinstance(value, list):
        for child in value[:50]:
            found = find_runtime_effort(child)
            if found:
                return found
    return None


def runtime_mode_from_effort(effort: Optional[str]) -> Optional[str]:
    if effort in {"xhigh", "ultra", "ultra_high", "highest"}:
        return "effort_xhigh"
    if effort == "high":
        return "effort_high"
    return None


def runtime_mode_event(
    *,
    provider: str,
    mode: str,
    confidence: str,
    source: str,
    detected_from: str,
    privacy: str,
    ts: Optional[int] = None,
    ttl_seconds: int = RUNTIME_MODE_TTL_SECONDS,
) -> Dict[str, Any]:
    detected_at = int(ts or time.time())
    return {
        "mode": mode,
        "provider": provider,
        "confidence": confidence,
        "source": source,
        "detectedFrom": detected_from,
        "privacy": privacy,
        "detectedAt": dt.datetime.fromtimestamp(detected_at, dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        "expiresAt": runtime_mode_expires_at(detected_at, ttl_seconds),
    }


def claude_runtime_mode_event(event_type: Optional[str], payload: Any, ts: Optional[int] = None) -> Optional[Dict[str, Any]]:
    event_norm = normalized_key(event_type or "")
    detected_at = int(ts or time.time())
    if event_norm in {"stop", "subagentstop"}:
        return {
            "mode": "clear",
            "provider": "claude",
            "confidence": "exact",
            "source": "claude-hook",
            "detectedFrom": "stop_hook",
            "detectedAt": dt.datetime.fromtimestamp(detected_at, dt.timezone.utc).isoformat().replace("+00:00", "Z"),
            "expiresAt": dt.datetime.fromtimestamp(detected_at, dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        }

    if event_norm not in {"userpromptsubmit", "sessionstart"}:
        return None

    effort = find_runtime_effort(payload)
    mode: Optional[str] = None
    confidence: Optional[str] = None
    detected_from: Optional[str] = None

    keyword_mode = runtime_keyword_mode(payload)
    if keyword_mode:
        mode = keyword_mode
        confidence = "exact"
        detected_from = "prompt_keyword"
    else:
        mode = runtime_mode_from_effort(effort)
        confidence = "exact"
        detected_from = "effort_setting"

    if not mode or not confidence or not detected_from:
        return None

    return runtime_mode_event(
        provider="claude",
        mode=mode,
        confidence=confidence,
        source="claude-hook",
        detected_from=detected_from,
        privacy="prompt_text_discarded" if detected_from == "prompt_keyword" else "metadata_only",
        ts=detected_at,
    )


def codex_runtime_mode_event(payload: Any, ts: Optional[int] = None) -> Optional[Dict[str, Any]]:
    mode = runtime_mode_from_effort(find_runtime_effort(payload))
    if not mode:
        return None
    return runtime_mode_event(
        provider="codex",
        mode=mode,
        confidence="exact",
        source="codex-notify",
        detected_from="effort_setting",
        privacy="metadata_only",
        ts=ts,
    )


def codex_notify_storage_payload(payload: Any, runtime_mode: Optional[Dict[str, Any]]) -> Dict[str, Any]:
    stored = copy.deepcopy(payload) if isinstance(payload, dict) else {}
    if "raw" in stored:
        stored["raw"] = "[redacted]"
    if runtime_mode:
        stored["agentcatRuntimeMode"] = runtime_mode
    return stored


def claude_hook_storage_payload(payload: Any, runtime_mode: Optional[Dict[str, Any]]) -> Dict[str, Any]:
    stored = copy.deepcopy(payload) if isinstance(payload, dict) else {}
    # Invalid JSON falls back to {"raw": "..."} in read_stdin_payload. For
    # Claude hooks that can be prompt text, so never persist it.
    if "raw" in stored:
        stored["raw"] = "[redacted]"
    if runtime_mode:
        stored["agentcatRuntimeMode"] = runtime_mode
    return stored


def codex_config_reasoning_effort() -> Optional[str]:
    path = codex_home() / "config.toml"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            # Only read the global default. Project/profile sections can have
            # different semantics and should not color every Codex session.
            return None
        match = re.match(r"model_reasoning_effort\s*=\s*['\"]?([A-Za-z0-9_-]+)['\"]?", line)
        if match:
            return normalize_runtime_effort(match.group(1))
    return None


def codex_config_runtime_mode(active_providers: Iterable[str], ts: Optional[int] = None) -> Optional[Dict[str, Any]]:
    if "codex" not in {str(provider) for provider in active_providers}:
        return None
    mode = runtime_mode_from_effort(codex_config_reasoning_effort())
    if not mode:
        return None
    return runtime_mode_event(
        provider="codex",
        mode=mode,
        confidence="config_default",
        source="codex-config",
        detected_from="model_reasoning_effort",
        privacy="metadata_only",
        ts=ts,
        ttl_seconds=180,
    )


def runtime_modes_snapshot(
    now: Optional[dt.datetime] = None,
    active_providers: Optional[Iterable[str]] = None,
) -> List[Dict[str, Any]]:
    init_db()
    current = now or dt.datetime.now(dt.timezone.utc)
    rows: List[Tuple[Any, ...]]
    with closing(sqlite3.connect(EVENTS_DB)) as conn:
        rows = conn.execute(
            "select ts, provider, source, event_type, payload_json from events order by ts desc, id desc limit 300"
        ).fetchall()

    modes: List[Dict[str, Any]] = []
    seen_providers: set[str] = set()
    for ts, provider, source, event_type, payload_json in rows:
        provider_s = str(provider)
        if provider_s in seen_providers:
            continue
        try:
            payload = json.loads(payload_json)
        except json.JSONDecodeError:
            continue
        if not isinstance(payload, dict):
            continue
        raw_mode = payload.get("agentcatRuntimeMode")
        if not isinstance(raw_mode, dict):
            continue
        seen_providers.add(provider_s)

        mode = str(raw_mode.get("mode") or "")
        if not mode or mode == "clear":
            continue
        expires_at = parse_iso_timestamp(raw_mode.get("expiresAt"))
        if expires_at is None or expires_at <= current:
            continue

        modes.append(
            {
                "provider": provider_s,
                "mode": mode,
                "confidence": str(raw_mode.get("confidence") or "inferred"),
                "source": str(raw_mode.get("source") or source or "event"),
                "detectedFrom": str(raw_mode.get("detectedFrom") or "event"),
                "detectedAt": str(raw_mode.get("detectedAt") or dt.datetime.fromtimestamp(int(ts), dt.timezone.utc).isoformat().replace("+00:00", "Z")),
                "expiresAt": raw_mode["expiresAt"],
                "privacy": str(raw_mode.get("privacy") or "metadata_only"),
            }
        )
    existing_providers = {str(mode.get("provider") or "") for mode in modes}
    if active_providers is not None and "codex" not in existing_providers:
        fallback = codex_config_runtime_mode(active_providers, ts=int(current.timestamp()))
        if fallback:
            modes.append(fallback)

    modes.sort(key=lambda item: (item["confidence"] != "exact", item["provider"], item["mode"]))
    return modes


def safe_runtime_modes_snapshot(active_providers: Optional[Iterable[str]] = None) -> List[Dict[str, Any]]:
    try:
        return runtime_modes_snapshot(active_providers=active_providers)
    except Exception:
        return []


def find_first_key(value: Any, keys: Iterable[str]) -> Optional[Any]:
    wanted = {normalized_key(key) for key in keys}
    if isinstance(value, dict):
        for key, child in value.items():
            if normalized_key(key) in wanted:
                return child
        for child in value.values():
            found = find_first_key(child, wanted)
            if found is not None:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_first_key(child, wanted)
            if found is not None:
                return found
    return None


def display_model(value: Any) -> Optional[str]:
    if value is None:
        return None
    if isinstance(value, dict):
        return str(value.get("display_name") or value.get("id") or value) if value else None
    return str(value)


def init_db() -> None:
    ensure_dirs()
    with closing(sqlite3.connect(EVENTS_DB, timeout=5.0)) as conn:
        # WAL is a persistent DB property (set once, applies to every later connection):
        # readers (the 60s refresh loop) no longer block the CLI-hook writers, so a
        # store_event racing a snapshot build isn't dropped with "database is locked".
        conn.execute("pragma journal_mode=WAL")
        conn.execute("pragma busy_timeout=5000")
        conn.execute(
            """
            create table if not exists events (
              id integer primary key autoincrement,
              ts integer not null,
              provider text not null,
              source text not null,
              event_type text,
              payload_json text not null
            )
            """
        )
        conn.execute("create index if not exists idx_events_provider_ts on events(provider, ts desc)")
        conn.execute(
            """
            create table if not exists claude_statusline_throttle (
              session_key text primary key,
              last_posted_at integer not null,
              payload_hash text not null
            )
            """
        )
        conn.commit()
    # The sqlite file is created on connect; lock it down owner-only afterward.
    _chmod_quiet(EVENTS_DB, 0o600)


def store_event(provider: str, source: str, event_type: Optional[str], payload: Any) -> Dict[str, Any]:
    init_db()
    sanitized = sanitize_payload(payload)
    with closing(sqlite3.connect(EVENTS_DB, timeout=5.0)) as conn:
        cur = conn.execute(
            "insert into events(ts, provider, source, event_type, payload_json) values (?, ?, ?, ?, ?)",
            (int(time.time()), provider, source, event_type, json.dumps(sanitized, ensure_ascii=False, sort_keys=True)),
        )
        event_id = int(cur.lastrowid)
        conn.commit()
    return {
        "id": event_id,
        "provider": provider,
        "source": source,
        "eventType": event_type,
        "tokens": extract_tokens(sanitized),
    }


def should_store_claude_statusline(payload: Any) -> bool:
    """Atomically reserve a rate-limited statusline event for this session."""
    session_id = find_first_key(payload, ("session_id", "sessionId"))
    if session_id is None:
        session_id = f"process:{os.getppid()}"
    session_key = hashlib.sha256(str(session_id).encode("utf-8")).hexdigest()
    sanitized = sanitize_payload(payload)
    payload_hash = hashlib.sha256(
        json.dumps(sanitized, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    now = int(time.time())
    try:
        init_db()
        with closing(sqlite3.connect(EVENTS_DB, timeout=5.0)) as conn:
            conn.execute("pragma busy_timeout=5000")
            conn.execute("begin immediate")
            row = conn.execute(
                "select last_posted_at, payload_hash from claude_statusline_throttle where session_key = ?",
                (session_key,),
            ).fetchone()
            if row:
                elapsed = now - int(row[0])
                if elapsed < CLAUDE_STATUSLINE_MIN_INTERVAL_SECONDS:
                    conn.rollback()
                    return False
                if str(row[1]) == payload_hash and elapsed < CLAUDE_STATUSLINE_DUPLICATE_INTERVAL_SECONDS:
                    conn.rollback()
                    return False
            conn.execute(
                """
                insert into claude_statusline_throttle(session_key, last_posted_at, payload_hash)
                values (?, ?, ?)
                on conflict(session_key) do update set
                  last_posted_at = excluded.last_posted_at,
                  payload_hash = excluded.payload_hash
                """,
                (session_key, now, payload_hash),
            )
            conn.execute(
                "delete from claude_statusline_throttle where last_posted_at < ?",
                (now - 7 * 86400,),
            )
            conn.commit()
        return True
    except Exception:
        return True


def prune_events(max_age_days: Optional[int] = None) -> int:
    """Delete events older than the retention window, then VACUUM if any were removed.

    events.sqlite is otherwise append-only forever (only the latest ~300 rows are ever
    read for activity/runtime-modes), so it grows unbounded (audit #5). Historical rows
    feed no token totals — those come from the provider files — so pruning is safe.
    Best-effort: any failure is logged and swallowed so it never blocks the daemon.
    Returns the number of rows deleted.
    """
    if max_age_days is None:
        max_age_days = int(os.environ.get("AGENTCAT_EVENTS_RETENTION_DAYS", "45"))
    try:
        init_db()
        cutoff = int(time.time()) - max(1, int(max_age_days)) * 86400
        with closing(sqlite3.connect(EVENTS_DB, timeout=5.0)) as conn:
            deleted = conn.execute("delete from events where ts < ?", (cutoff,)).rowcount
            conn.commit()
            if deleted and deleted > 0:
                conn.execute("vacuum")
                conn.commit()
        return int(deleted or 0)
    except Exception as exc:
        logging.debug("prune_events failed: %s", exc)
        return 0


def parse_event_row(row: Tuple[Any, ...]) -> Dict[str, Any]:
    event_id, ts, provider, source, event_type, payload_json = row
    try:
        payload = json.loads(payload_json)
    except json.JSONDecodeError:
        payload = {}
    return {
        "id": event_id,
        "timestamp": dt.datetime.fromtimestamp(int(ts), dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        "provider": provider,
        "source": source,
        "eventType": event_type,
        "tokens": extract_tokens(payload),
        "model": display_model(find_first_key(payload, ["model", "modelName", "model_name"])),
    }


def latest_events_by_provider() -> Dict[str, Any]:
    init_db()
    latest: Dict[str, Any] = {}
    with closing(sqlite3.connect(EVENTS_DB)) as conn:
        rows = conn.execute(
            "select id, ts, provider, source, event_type, payload_json from events order by ts desc, id desc limit 200"
        ).fetchall()
    for row in rows:
        event = parse_event_row(row)
        latest.setdefault(event["provider"], event)
    return latest


def read_json(path: Path) -> Optional[Any]:
    try:
        with path.open("r", encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None
    except Exception as exc:
        return {"_agentcat_error": str(exc)}


def _is_under_agentcat_home(path: Path) -> bool:
    try:
        path.resolve().relative_to(AGENTCAT_HOME.resolve())
        return True
    except (ValueError, OSError):
        return False


def write_json_atomic(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = unique_atomic_tmp_path(path)
    with tmp_path.open("w", encoding="utf-8") as fh:
        json.dump(payload, fh, ensure_ascii=False, indent=2, sort_keys=True)
        fh.write("\n")
    # Lock down private state files (snapshot, caches, update channel/state) to
    # owner-only before publishing. External configs (e.g. ~/.gemini) keep their
    # own permissions so other tools are unaffected.
    if _is_under_agentcat_home(path):
        _chmod_quiet(tmp_path, 0o600)
    for attempt in range(8):
        try:
            tmp_path.replace(path)
            break
        except PermissionError:
            if attempt == 7:
                raise
            time.sleep(0.01 * (attempt + 1))


def unique_atomic_tmp_path(path: Path) -> Path:
    """Return a process/thread-unique sibling temp path for atomic replace.

    The CLI, daemon refresh loop, and HTTP fallback can all build snapshots at
    the same time. A fixed ``latest-snapshot.json.tmp`` lets concurrent writers
    delete each other's temp file before replace; include process/thread/time
    entropy so atomic replace remains race-free.
    """
    return path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.{time.time_ns()}.tmp")


def int_limit(raw: Any) -> Optional[int]:
    if isinstance(raw, bool):
        return None
    if isinstance(raw, (int, float)):
        value = int(raw)
    elif isinstance(raw, str):
        text = raw.strip().replace(",", "").replace("_", "")
        if not text.isdigit():
            return None
        value = int(text)
    else:
        return None
    return value if value > 0 else None


def nonnegative_int(raw: Any) -> Optional[int]:
    if isinstance(raw, bool):
        return None
    if isinstance(raw, (int, float)):
        value = int(raw)
    elif isinstance(raw, str):
        text = raw.strip().replace(",", "").replace("_", "")
        if not text.isdigit():
            return None
        value = int(text)
    else:
        return None
    return value if value >= 0 else None


def float_percent(raw: Any) -> Optional[float]:
    if isinstance(raw, bool):
        return None
    if isinstance(raw, (int, float)):
        value = float(raw)
    elif isinstance(raw, str):
        text = raw.strip().removesuffix("%").strip()
        try:
            value = float(text)
        except ValueError:
            return None
    else:
        return None
    return min(max(value, 0.0), 100.0)


def float_value(raw: Any) -> Optional[float]:
    if isinstance(raw, bool):
        return None
    if isinstance(raw, (int, float)):
        return float(raw)
    if isinstance(raw, str):
        text = raw.strip().replace(",", "").replace("_", "")
        try:
            return float(text)
        except ValueError:
            return None
    return None


def first_present(*values: Any) -> Any:
    for value in values:
        if value is not None:
            return value
    return None


def remaining_percent_from_used(raw: Any) -> Optional[float]:
    used = float_percent(raw)
    if used is None:
        return None
    return min(max(100.0 - used, 0.0), 100.0)


def reset_epoch(raw: Any) -> Optional[int]:
    parsed = parse_timestamp(raw)
    return int(parsed.timestamp()) if parsed else None


def quota_entry(
    quota_id: str,
    label: str,
    *,
    used_percent: Any = None,
    remaining_percent: Any = None,
    reset_at: Any = None,
    unit: Optional[str] = "percent",
    used: Any = None,
    remaining: Any = None,
    limit: Any = None,
    window: Optional[str] = None,
    model: Optional[str] = None,
    source: Optional[str] = None,
) -> Dict[str, Any]:
    used_pct = float_percent(used_percent)
    remaining_pct = float_percent(remaining_percent)
    if remaining_pct is None and used_pct is not None:
        remaining_pct = remaining_percent_from_used(used_pct)
    if used_pct is None and remaining_pct is not None:
        used_pct = remaining_percent_from_used(remaining_pct)

    return {
        "id": quota_id,
        "label": label,
        "window": window,
        "unit": unit,
        "used": float_value(used),
        "remaining": float_value(remaining),
        "limit": float_value(limit),
        "usedPercent": used_pct,
        "remainingPercent": remaining_pct,
        "resetAt": reset_epoch(reset_at),
        "model": model,
        "source": source,
    }


def live_limit_error(
    exc: Exception,
    source: str,
    project_id: Optional[str] = None,
) -> Dict[str, Any]:
    limits = empty_limits(status="error", error=str(exc))
    limits["source"] = source
    reason = "unknown_error"
    if isinstance(exc, urllib.error.HTTPError):
        status = int(exc.code)
        if status == 429:
            reason = "rate_limited"
            retry_after = exc.headers.get("Retry-After") if exc.headers is not None else None
            retry_seconds = 300
            if retry_after is not None:
                try:
                    retry_seconds = max(int(float(str(retry_after).strip())), 0)
                except (TypeError, ValueError):
                    try:
                        retry_date = email.utils.parsedate_to_datetime(str(retry_after))
                        if retry_date.tzinfo is None:
                            retry_date = retry_date.replace(tzinfo=dt.timezone.utc)
                        retry_seconds = max(int(retry_date.timestamp() - time.time()), 0)
                    except (TypeError, ValueError, OverflowError):
                        retry_seconds = 300
            limits["retryAt"] = int(time.time()) + retry_seconds
        elif status == 401:
            reason = "token_expired"
        elif status == 403:
            try:
                body = exc.read(64 * 1024).decode("utf-8", errors="replace")
            except Exception:
                body = ""
            if "user:profile" in body:
                reason = "missing_scope"
            elif project_id is not None and not str(project_id).strip():
                # Valid OAuth, but Code Assist has no project after the 2026-06-18
                # consumer cutover. Do not call this token_expired.
                reason = "project_required"
            else:
                reason = "token_expired"
        elif status >= 500:
            reason = "server_error"
        else:
            reason = "http_error"
        try:
            exc.close()
        except Exception:
            pass
    elif isinstance(exc, json.JSONDecodeError):
        reason = "parse_error"
    elif isinstance(exc, (urllib.error.URLError, OSError, TimeoutError)):
        reason = "network_error"
    limits["reason"] = reason
    return limits


def live_limits_error_backoff_seconds(failure_streak: int) -> int:
    exponent = min(max(int(failure_streak) - 1, 0), 5)
    return min(
        LIVE_LIMITS_ERROR_BACKOFF_BASE_SECONDS * (2 ** exponent),
        LIVE_LIMITS_ERROR_BACKOFF_MAX_SECONDS,
    )


def cached_live_limits(provider: str, max_age_seconds: int, allow_stale: bool = False) -> Optional[Dict[str, Any]]:
    raw = read_json(LIVE_LIMITS_CACHE)
    if not isinstance(raw, dict) or raw.get("_agentcat_error"):
        return None
    entry = raw.get(provider)
    if not isinstance(entry, dict):
        return None
    cached_at = int_limit(entry.get("cachedAt"))
    limits = entry.get("limits")
    if cached_at is None or not isinstance(limits, dict):
        return None
    now = int(time.time())
    age = now - cached_at
    failure_streak = int_count(entry.get("failureStreak")) or 0
    retry_at = int_limit(limits.get("retryAt"))
    if retry_at is not None:
        if retry_at > now:
            effective_max_age = max(retry_at - cached_at, 0)
        elif not allow_stale:
            return None
        else:
            effective_max_age = -1
    elif failure_streak > 0:
        effective_max_age = live_limits_error_backoff_seconds(failure_streak)
    elif limits.get("status") == "not_configured" and limits.get("reason") == "not_applicable":
        effective_max_age = LIVE_LIMITS_NOT_APPLICABLE_TTL
    else:
        effective_max_age = max_age_seconds
    if age > effective_max_age and not allow_stale:
        return None
    out = dict(limits)
    out["cachedAt"] = cached_at
    out["cacheAgeSeconds"] = max(age, 0)
    if age > effective_max_age:
        out["stale"] = True
    return out


def write_live_limits_cache(provider: str, limits: Dict[str, Any]) -> None:
    status = limits.get("status")
    if status == "error":
        pass
    elif status == "not_configured" and limits.get("reason") == "not_applicable":
        # A definitive "this account has no quota API data" answer from the live
        # API — cache it (throttled to the normal max-age) so the daemon stops
        # re-probing api.anthropic.com every tick.
        pass
    elif status not in {"auto", "ok"} or not limits.get("quotas"):
        return
    try:
        ensure_dirs()
        raw = read_json(LIVE_LIMITS_CACHE)
        cache = raw if isinstance(raw, dict) and not raw.get("_agentcat_error") else {}
        previous = cache.get(provider) if isinstance(cache.get(provider), dict) else {}
        previous_limits = previous.get("limits") if isinstance(previous.get("limits"), dict) else {}
        if (
            status == "error"
            and previous_limits.get("status") in {"auto", "ok"}
            and previous_limits.get("quotas")
        ):
            # Keep last-good quotas. An error-only payload would blank the tile
            # even though the token is still valid (e.g. project_required 403).
            merged = dict(previous_limits)
            merged["liveError"] = limits.get("error")
            merged["liveErrorReason"] = limits.get("reason")
            if limits.get("retryAt") is not None:
                merged["retryAt"] = limits.get("retryAt")
            limits = merged
        previous_streak = int_count(previous.get("failureStreak")) or 0
        failed = status == "error" or bool(limits.get("liveError"))
        cache[provider] = {
            "cachedAt": int(time.time()),
            "failureStreak": previous_streak + 1 if failed else 0,
            "limits": limits,
        }
        tmp_path = unique_atomic_tmp_path(LIVE_LIMITS_CACHE)
        with tmp_path.open("w", encoding="utf-8") as fh:
            json.dump(cache, fh, ensure_ascii=False, indent=2, sort_keys=True)
            fh.write("\n")
        tmp_path.replace(LIVE_LIMITS_CACHE)
    except Exception:
        pass


def serve_stale_live_limits(
    provider: str,
    stale: Dict[str, Any],
    exc: Exception,
    project_id: Optional[str] = None,
) -> Dict[str, Any]:
    """Return the last-good live limits during a probe failure, re-stamping the
    cache so the daemon does not re-probe (and re-refresh the OAuth token) on every
    60s tick while the provider keeps failing. Without the re-stamp, `cachedAt`
    never advances once the good entry goes stale, so one revoked/expired token
    turns into a full refresh POST — and for Antigravity a ~140MB binary re-scan —
    every tick. Re-stamping throttles re-probing to one attempt per max-age window.
    """
    stale = dict(stale)
    stale["liveError"] = str(exc)
    error_limits = live_limit_error(exc, str(stale.get("source") or provider), project_id=project_id)
    stale["liveErrorReason"] = error_limits.get("reason")
    stale.pop("retryAt", None)
    if error_limits.get("retryAt") is not None:
        stale["retryAt"] = error_limits["retryAt"]
    served = {k: v for k, v in stale.items() if k not in ("cacheAgeSeconds", "stale", "cachedAt")}
    write_live_limits_cache(provider, served)
    return stale


def empty_limits(
    status: str = "not_configured",
    error: Optional[str] = None,
    reason: Optional[str] = None,
) -> Dict[str, Any]:
    limits: Dict[str, Any] = {
        "status": status,
        "source": _tilde(LIMITS_FILE),
        "weeklyTokens": None,
        "monthlyTokens": None,
        "sessionTokens": None,
        "weeklyUsedPercent": None,
        "weeklyResetAt": None,
        "shortUsedPercent": None,
        "shortWindowMinutes": None,
        "shortResetAt": None,
        "planType": None,
        "quotas": [],
    }
    if error:
        limits["error"] = error
    if reason:
        # Machine-readable cause the app can turn into an actionable message
        # (e.g. token_missing, keychain_denied, token_expired). Distinct from
        # `error`, which carries a raw exception string from a live API call.
        limits["reason"] = reason
    return limits


def normalize_limits(raw: Any) -> Dict[str, Any]:
    if not isinstance(raw, dict):
        return empty_limits()

    aliases = {
        "weeklyTokens": ("weeklyTokens", "weekTokens", "week", "weekly", "weeklyLimit", "weekly_token_limit"),
        "monthlyTokens": ("monthlyTokens", "monthTokens", "month", "monthly", "monthlyLimit", "monthly_token_limit"),
        "sessionTokens": ("sessionTokens", "session", "context", "contextWindow", "sessionLimit", "session_token_limit"),
    }
    limits = empty_limits(status="ok")
    configured = False
    normalized = {normalized_key(key): value for key, value in raw.items()}
    for canonical, keys in aliases.items():
        for key in keys:
            value = int_limit(normalized.get(normalized_key(key)))
            if value is not None:
                limits[canonical] = value
                configured = True
                break
    if not configured:
        limits["status"] = "not_configured"
    return limits


def merge_limits(configured: Dict[str, Any], detected: Dict[str, Any]) -> Dict[str, Any]:
    merged = dict(detected)
    for key in ("weeklyTokens", "monthlyTokens", "sessionTokens"):
        if configured.get(key) is not None:
            merged[key] = configured[key]
    if configured.get("status") == "ok":
        merged["status"] = "ok"
        merged["source"] = configured.get("source") or merged.get("source")
        merged.pop("reason", None)  # a configured-ok override supersedes any detection reason
    elif merged.get("status") in {None, "not_configured"}:
        # Fall back to the configured limits, but keep the live detection's
        # diagnostic reason so the app can still explain WHY it's not configured
        # (token_missing / keychain_denied / token_expired / not_applicable).
        reason = detected.get("reason")
        merged = dict(configured)
        if reason and not merged.get("reason"):
            merged["reason"] = reason
    return merged


def configured_limits() -> Dict[str, Dict[str, Any]]:
    base = {provider: empty_limits() for provider in ("codex", "claude", "gemini", "antigravity", "grok", "kimi")}
    raw = read_json(LIMITS_FILE)
    if raw is None:
        return base
    if isinstance(raw, dict) and raw.get("_agentcat_error"):
        return {provider: empty_limits("error", str(raw["_agentcat_error"])) for provider in base}
    if not isinstance(raw, dict):
        return {provider: empty_limits("error", "limits.json must be a JSON object") for provider in base}

    providers = raw.get("providers") if isinstance(raw.get("providers"), dict) else raw
    for provider in base:
        base[provider] = normalize_limits(providers.get(provider))
    return base


def latest_event_payload(provider: str, source: Optional[str] = None) -> Optional[Dict[str, Any]]:
    init_db()
    query = "select payload_json from events where provider = ?"
    params: List[Any] = [provider]
    if source:
        query += " and source = ?"
        params.append(source)
    query += " order by ts desc, id desc limit 1"
    try:
        with closing(sqlite3.connect(EVENTS_DB)) as conn:
            row = conn.execute(query, params).fetchone()
    except Exception:
        return None
    if not row:
        return None
    try:
        payload = json.loads(str(row[0]))
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def codex_runtime_limits() -> Dict[str, Any]:
    limits = empty_limits()

    def _safe_mtime(path: Path) -> float:
        try:
            return path.stat().st_mtime
        except OSError:
            return 0.0

    try:
        candidates = list((codex_home() / "sessions").glob("**/rollout-*.jsonl"))
    except OSError:
        candidates = []
    # Safe mtime key: a session file deleted between glob and stat must not raise
    # (it would propagate up through runtime_limits and freeze the whole snapshot).
    session_files = sorted(candidates, key=_safe_mtime, reverse=True)[:30]
    for path in session_files:
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except Exception:
            continue
        for line in reversed(lines):
            if "rate_limits" not in line and "model_context_window" not in line:
                continue
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            payload = item.get("payload")
            if not isinstance(payload, dict) or payload.get("type") != "token_count":
                continue
            rate_limits = payload.get("rate_limits")
            info = payload.get("info")
            if not isinstance(rate_limits, dict):
                continue

            limits = empty_limits(status="auto")
            limits["source"] = _tilde(path)
            limits["planType"] = rate_limits.get("plan_type")

            # Classify by window length, not by slot name. Codex used to send
            # the 5-hour window as `primary` and the weekly one as `secondary`,
            # but it now sends a single `primary` with window_minutes=10080 and
            # leaves `secondary` null. Keying off the slot dropped the weekly
            # percent entirely and filed it as a short window — the fallback
            # served a blank weekly number whenever the live usage API failed.
            for slot in ("primary", "secondary"):
                window = rate_limits.get(slot)
                if not isinstance(window, dict):
                    continue
                minutes = int_limit(window.get("window_minutes"))
                used = float_percent(window.get("used_percent"))
                resets = int_limit(window.get("resets_at"))
                # Prefer known durations with a one-minute tolerance; older or
                # novel payloads fall back to primary/secondary position.
                if minutes is not None and abs(minutes - 300) <= 1:
                    kind = "short"
                elif minutes is not None and abs(minutes - CODEX_WEEKLY_WINDOW_MINUTES) <= 1:
                    kind = "weekly"
                else:
                    kind = "short" if slot == "primary" else "weekly"
                if kind == "weekly":
                    if limits.get("weeklyUsedPercent") is None:
                        limits["weeklyUsedPercent"] = used
                        limits["weeklyResetAt"] = resets
                elif limits.get("shortUsedPercent") is None:
                    limits["shortUsedPercent"] = used
                    limits["shortWindowMinutes"] = minutes
                    limits["shortResetAt"] = resets

            if isinstance(info, dict):
                limits["sessionTokens"] = int_limit(info.get("model_context_window"))

            if any(limits.get(key) is not None for key in ("weeklyUsedPercent", "shortUsedPercent", "sessionTokens")):
                return limits
    return limits


def claude_runtime_limits() -> Dict[str, Any]:
    payload = latest_event_payload("claude", "claude-statusline")
    if not payload:
        return empty_limits()

    limits = empty_limits(status="auto")
    limits["source"] = "claude-statusline"
    quotas: List[Dict[str, Any]] = []

    context_window = payload.get("context_window")
    if isinstance(context_window, dict):
        limits["sessionTokens"] = int_limit(context_window.get("context_window_size"))
        if limits["sessionTokens"] is not None:
            quotas.append(
                quota_entry(
                    "claude:session",
                    "세션 한도",
                    limit=limits["sessionTokens"],
                    unit="tokens",
                    window="session",
                    source="claude-statusline",
                )
            )

    rate_limits = payload.get("rate_limits")
    if isinstance(rate_limits, dict):
        seven_day = rate_limits.get("seven_day")
        if isinstance(seven_day, dict):
            limits["weeklyUsedPercent"] = float_percent(seven_day.get("used_percentage"))
            limits["weeklyResetAt"] = int_limit(seven_day.get("resets_at"))
            if limits["weeklyUsedPercent"] is not None:
                quotas.append(
                    quota_entry(
                        "claude:seven_day",
                        "7일",
                        used_percent=limits["weeklyUsedPercent"],
                        reset_at=limits["weeklyResetAt"],
                        window="7d",
                        source="claude-statusline",
                    )
                )

        five_hour = rate_limits.get("five_hour")
        if isinstance(five_hour, dict):
            limits["shortUsedPercent"] = float_percent(five_hour.get("used_percentage"))
            limits["shortWindowMinutes"] = 300
            limits["shortResetAt"] = int_limit(five_hour.get("resets_at"))
            if limits["shortUsedPercent"] is not None:
                quotas.append(
                    quota_entry(
                        "claude:five_hour",
                        "5시간",
                        used_percent=limits["shortUsedPercent"],
                        reset_at=limits["shortResetAt"],
                        window="5h",
                        source="claude-statusline",
                    )
                )

    if any(limits.get(key) is not None for key in ("weeklyUsedPercent", "shortUsedPercent", "sessionTokens")):
        quotas.sort(key=claude_quota_sort_key)
        limits["quotas"] = quotas
        return limits
    return empty_limits()


def oauth_tokens(raw: Any) -> Dict[str, Any]:
    if not isinstance(raw, dict):
        return {}
    tokens = raw.get("tokens")
    if isinstance(tokens, dict):
        return tokens
    return raw


def read_codex_auth(home: Optional[Path] = None) -> Optional[Dict[str, Any]]:
    raw = read_json((home or codex_home()) / "auth.json")
    return raw if isinstance(raw, dict) and not raw.get("_agentcat_error") else None


def _jwt_claims_unverified(token: Any) -> Dict[str, Any]:
    """Decode local JWT display claims without treating them as authorization.

    The credential file itself is the identity source. These unverified claims
    only supply a plan badge; access decisions and account grouping never depend
    on them.
    """
    if not isinstance(token, str):
        return {}
    parts = token.split(".")
    if len(parts) < 2:
        return {}
    try:
        encoded = parts[1] + ("=" * (-len(parts[1]) % 4))
        payload = json.loads(base64.urlsafe_b64decode(encoded).decode("utf-8"))
    except Exception:
        return {}
    return payload if isinstance(payload, dict) else {}


def codex_auth_identity(auth: Dict[str, Any]) -> Dict[str, Optional[str]]:
    """Return stable grouping identity and non-sensitive plan metadata."""
    tokens = oauth_tokens(auth)
    claims = _jwt_claims_unverified(tokens.get("id_token") or auth.get("id_token"))
    openai_claims = claims.get("https://api.openai.com/auth")
    if not isinstance(openai_claims, dict):
        openai_claims = {}
    account_id = (
        tokens.get("account_id")
        or auth.get("account_id")
        or openai_claims.get("chatgpt_account_id")
    )
    if not isinstance(account_id, str) or not account_id.strip():
        account_id = None
    plan = (
        openai_claims.get("chatgpt_plan_type")
        or claims.get("chatgpt_plan_type")
        or auth.get("plan_type")
        or auth.get("plan")
    )
    if not isinstance(plan, str) or not plan.strip():
        plan = None
    return {"accountID": account_id, "planType": plan}


def _provider_instance_secret() -> bytes:
    """Load/create the device-local key used to pseudonymize provider IDs."""
    global _PROVIDER_INSTANCE_SECRET_CACHE
    cache_key = str(PROVIDER_INSTANCE_SECRET)
    with _PROVIDER_INSTANCE_SECRET_LOCK:
        if _PROVIDER_INSTANCE_SECRET_CACHE is not None and _PROVIDER_INSTANCE_SECRET_CACHE[0] == cache_key:
            return _PROVIDER_INSTANCE_SECRET_CACHE[1]
        try:
            value = PROVIDER_INSTANCE_SECRET.read_bytes()
            if len(value) >= 32:
                _PROVIDER_INSTANCE_SECRET_CACHE = (cache_key, value)
                return value
        except OSError:
            pass
        ensure_dirs()
        value = os.urandom(32)
        try:
            fd = os.open(PROVIDER_INSTANCE_SECRET, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            try:
                os.write(fd, value)
            finally:
                os.close(fd)
        except FileExistsError:
            # Another process won the first-run race; use exactly its key.
            try:
                existing = PROVIDER_INSTANCE_SECRET.read_bytes()
                if len(existing) >= 32:
                    value = existing
            except OSError:
                pass
        except OSError:
            # A read-only install may still render stable IDs for this daemon run.
            pass
        _PROVIDER_INSTANCE_SECRET_CACHE = (cache_key, value)
        return value


def provider_instance_id(provider: str, identity: str) -> str:
    digest = hmac.new(
        _provider_instance_secret(),
        f"{provider}:{identity}".encode("utf-8"),
        hashlib.sha256,
    ).hexdigest()[:12]
    return f"{provider}:{digest}"


def refresh_codex_access_token(auth: Dict[str, Any]) -> Optional[str]:
    tokens = oauth_tokens(auth)
    refresh_token = tokens.get("refresh_token")
    if not isinstance(refresh_token, str) or not refresh_token:
        return None

    body = urllib.parse.urlencode(
        {
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
            "client_id": CODEX_OAUTH_CLIENT_ID,
        }
    ).encode("utf-8")
    req = urllib.request.Request(
        CODEX_OAUTH_TOKEN_URL,
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    token = payload.get("access_token")
    return token if isinstance(token, str) and token else None


def codex_usage_request(access_token: str, account_id: str, url: str) -> Dict[str, Any]:
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Accept": "application/json",
        "User-Agent": "codex-cli",
        "OpenAI-Beta": "codex-1",
    }
    if account_id:
        headers["chatgpt-account-id"] = account_id
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=12) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    return payload if isinstance(payload, dict) else {}


def codex_reset_credits_request(access_token: str, account_id: str) -> Dict[str, Any]:
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Accept": "application/json",
        "User-Agent": "codex-cli",
        "OpenAI-Beta": "codex-1",
    }
    if account_id:
        headers["chatgpt-account-id"] = account_id
    req = urllib.request.Request(CODEX_RESET_CREDITS_URL, headers=headers)
    with urllib.request.urlopen(req, timeout=12) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    return payload if isinstance(payload, dict) else {}


def codex_window_quota(
    quota_id: str,
    label: str,
    window: Any,
    *,
    source: str,
    model: Optional[str] = None,
) -> Optional[Dict[str, Any]]:
    if not isinstance(window, dict):
        return None
    used = float_percent(first_present(window.get("used_percent"), window.get("utilization")))
    if used is None:
        return None
    seconds = int_limit(window.get("limit_window_seconds") or window.get("window_secs"))
    if seconds and seconds % 86400 == 0:
        window_label = f"{seconds // 86400}d"
    elif seconds and seconds % 3600 == 0:
        window_label = f"{seconds // 3600}h"
    elif seconds and seconds % 60 == 0:
        window_label = f"{seconds // 60}m"
    else:
        window_label = None
    return quota_entry(
        quota_id,
        label,
        used_percent=used,
        reset_at=first_present(window.get("reset_at"), window.get("resets_at")),
        window=window_label,
        model=model,
        source=source,
    )


def codex_window_descriptor(window: Any, default_kind: Optional[str] = None) -> Optional[Dict[str, Any]]:
    """Classify a Codex rate-limit window with tolerance for rounded durations.

    Duration wins when it is within one minute of five hours or seven days.
    Other durations use the API field position supplied through ``default_kind``.
    """
    seconds = None
    if isinstance(window, dict):
        seconds = int_limit(window.get("limit_window_seconds") or window.get("window_secs"))
    if seconds is None and default_kind:
        seconds = {"short": 5 * 3600, "weekly": 7 * 86400}.get(default_kind)
    if not seconds or seconds <= 0:
        return None

    minutes = seconds / 60.0
    if abs(minutes - 300) <= 1:
        amount, suffix, label, kind = 5, "h", "5시간", "short"
    elif abs(minutes - 10080) <= 1:
        amount, suffix, label, kind = 7, "d", "7일", "weekly"
    elif default_kind == "short":
        amount, suffix, label, kind = 5, "h", "5시간", "short"
    elif default_kind == "weekly":
        amount, suffix, label, kind = 7, "d", "7일", "weekly"
    elif seconds % 86400 == 0:
        amount, suffix, label = seconds // 86400, "d", f"{seconds // 86400}일"
        kind = None
    elif seconds % 3600 == 0:
        amount, suffix, label = seconds // 3600, "h", f"{seconds // 3600}시간"
        kind = None
    elif seconds % 60 == 0:
        amount, suffix, label = seconds // 60, "m", f"{seconds // 60}분"
        kind = None
    else:
        amount, suffix, label = seconds, "s", f"{seconds}초"
        kind = None

    return {"suffix": f"{amount}{suffix}", "label": label, "kind": kind, "seconds": seconds}


def codex_window_kind(window: Any, default: str) -> Optional[str]:
    """Classify by tolerant duration, then fall back to the field position."""
    if not isinstance(window, dict):
        return None
    descriptor = codex_window_descriptor(window, default)
    return descriptor.get("kind") if descriptor else None


def codex_cached_window_kind(quota: Dict[str, Any]) -> Optional[str]:
    """Recover a known bucket from the serialized cache window label."""
    raw = quota.get("window")
    if not isinstance(raw, str):
        return None
    match = re.fullmatch(r"(\d+)([hd])", raw.strip().lower())
    if not match:
        return None
    value = int(match.group(1))
    seconds = value * (86400 if match.group(2) == "d" else 3600)
    return codex_window_descriptor({"limit_window_seconds": seconds}).get("kind")


def codex_cached_window_descriptor(quota: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    raw = quota.get("window")
    if not isinstance(raw, str):
        return None
    match = re.fullmatch(r"(\d+)([hdms])", raw.strip().lower())
    if not match:
        return None
    value = int(match.group(1))
    multiplier = {"d": 86400, "h": 3600, "m": 60, "s": 1}[match.group(2)]
    return codex_window_descriptor({"limit_window_seconds": value * multiplier})


def sanitize_codex_cached_limits(limits: Dict[str, Any]) -> Dict[str, Any]:
    """Correct pre-hotfix cached Codex buckets when their duration is known."""
    quotas = limits.get("quotas")
    if not isinstance(quotas, list):
        return limits

    out = dict(limits)
    sanitized: List[Dict[str, Any]] = []
    for quota in quotas:
        if not isinstance(quota, dict):
            continue
        item = dict(quota)
        quota_id = str(item.get("id") or "")
        cached_descriptor = codex_cached_window_descriptor(item)
        # A cached response from before the duration-aware parser may carry a
        # stale id/label. Re-key only the aggregate Codex bucket; never infer
        # a semantic window from array position.
        if cached_descriptor and quota_id in {"codex:5h", "codex:7d"}:
            expected_id = f"codex:{cached_descriptor['suffix']}"
            item["id"] = expected_id
            item["label"] = cached_descriptor["label"]
            quota_id = expected_id
        cached_kind = codex_cached_window_kind(item)
        if quota_id == "codex:5h" and cached_kind == "weekly":
            item["id"] = "codex:7d"
            item["label"] = "7일"
        elif quota_id == "codex:7d" and cached_kind == "short":
            item["id"] = "codex:5h"
            item["label"] = "5시간"
        sanitized.append(item)

    out["quotas"] = sanitized
    out["shortUsedPercent"] = None
    out["shortResetAt"] = None
    out["shortWindowMinutes"] = None
    out["weeklyUsedPercent"] = None
    out["weeklyResetAt"] = None
    for quota in sanitized:
        quota_id = str(quota.get("id") or "")
        if quota_id == "codex:5h":
            out["shortUsedPercent"] = quota.get("usedPercent")
            out["shortResetAt"] = quota.get("resetAt")
            cached_kind = codex_cached_window_kind(quota)
            if cached_kind == "short":
                raw = quota.get("window")
                if isinstance(raw, str):
                    match = re.fullmatch(r"(\d+)h", raw.strip().lower())
                    if match:
                        out["shortWindowMinutes"] = int(match.group(1)) * 60
        elif quota_id == "codex:7d":
            out["weeklyUsedPercent"] = quota.get("usedPercent")
            out["weeklyResetAt"] = quota.get("resetAt")
    return out


def sum_intish_list(raw: Any) -> Optional[int]:
    if isinstance(raw, list):
        values = [int_limit(item) for item in raw]
        values = [item for item in values if item is not None]
        return sum(values) if values else None
    return int_limit(raw)


def int_count(raw: Any) -> Optional[int]:
    if isinstance(raw, bool):
        return None
    if isinstance(raw, (int, float)):
        value = int(raw)
    elif isinstance(raw, str):
        text = raw.strip().replace(",", "").replace("_", "")
        if not text.isdigit():
            return None
        value = int(text)
    else:
        return None
    return value if value >= 0 else None


def sum_count_list(raw: Any) -> Optional[int]:
    if isinstance(raw, list):
        values = [int_count(item) for item in raw]
        values = [item for item in values if item is not None]
        return sum(values) if values else None
    return int_count(raw)


def codex_credit_usage_summary(raw: Any) -> Optional[Dict[str, Any]]:
    if not isinstance(raw, dict):
        return None
    summary: Dict[str, Any] = {}
    for source, target in (
        ("balance", "balance"),
        ("has_credits", "hasCredits"),
        ("unlimited", "unlimited"),
        ("overage_limit_reached", "overageLimitReached"),
    ):
        value = raw.get(source)
        if isinstance(value, bool):
            summary[target] = value
        elif source == "balance" and value is not None:
            summary[target] = str(value)

    cloud = sum_count_list(raw.get("approx_cloud_messages"))
    local = sum_count_list(raw.get("approx_local_messages"))
    if cloud is not None:
        summary["approxCloudMessages"] = cloud
    if local is not None:
        summary["approxLocalMessages"] = local
    return summary or None


def codex_rate_limit_reached_type(raw: Any) -> Optional[str]:
    if isinstance(raw, str):
        return raw
    if isinstance(raw, dict):
        value = raw.get("type") or raw.get("reason") or raw.get("name")
        return str(value) if value is not None else None
    return None


def codex_reset_credit_summaries(raw: Any) -> List[Dict[str, Any]]:
    if not isinstance(raw, list):
        return []
    summaries: List[Dict[str, Any]] = []
    for item in raw[:10]:
        if not isinstance(item, dict):
            continue
        summary: Dict[str, Any] = {}
        for source, target in (
            ("status", "status"),
            ("title", "title"),
            ("description", "description"),
            ("reset_type", "resetType"),
        ):
            value = item.get(source)
            if isinstance(value, str) and value.strip():
                summary[target] = value.strip()
        for source, target in (
            ("granted_at", "grantedAt"),
            ("expires_at", "expiresAt"),
            ("redeemed_at", "redeemedAt"),
        ):
            value = item.get(source)
            if value is not None:
                summary[target] = str(value)
        if summary:
            summaries.append(summary)
    return summaries


def merge_codex_reset_credit_details(limits: Dict[str, Any], payload: Dict[str, Any]) -> None:
    # int_count keeps 0 (a real "no reset credits left" signal) instead of
    # dropping it the way int_limit does for non-positive values.
    available = int_count(payload.get("available_count"))
    if available is not None:
        limits["resetCreditsAvailable"] = available
    summaries = codex_reset_credit_summaries(payload.get("credits"))
    if summaries:
        limits["resetCredits"] = summaries


def codex_limits_from_usage_response(payload: Dict[str, Any], source: str = "codex-usage-api") -> Dict[str, Any]:
    limits = empty_limits(status="auto")
    limits["source"] = source
    limits["planType"] = payload.get("plan_type") or payload.get("plan")

    rate_limit = payload.get("rate_limit")
    if not isinstance(rate_limit, dict):
        rate_limit = payload.get("rate_limits") if isinstance(payload.get("rate_limits"), dict) else {}

    for source_key, target_key in (
        ("allowed", "rateLimitAllowed"),
        ("limit_reached", "rateLimitReached"),
    ):
        value = rate_limit.get(source_key)
        if isinstance(value, bool):
            limits[target_key] = value

    reached_type = codex_rate_limit_reached_type(payload.get("rate_limit_reached_type"))
    if reached_type:
        limits["rateLimitReachedType"] = reached_type

    reset_credits = payload.get("rate_limit_reset_credits")
    if isinstance(reset_credits, dict):
        # int_count surfaces available_count == 0 (int_limit would drop it).
        available = int_count(reset_credits.get("available_count"))
        if available is not None:
            limits["resetCreditsAvailable"] = available

    credit_summary = codex_credit_usage_summary(payload.get("credits"))
    if credit_summary is not None:
        limits["codexCredits"] = credit_summary

    spend_control = payload.get("spend_control")
    if isinstance(spend_control, dict) and isinstance(spend_control.get("reached"), bool):
        limits["spendControlReached"] = spend_control.get("reached")

    primary = rate_limit.get("primary_window") or rate_limit.get("primary")
    secondary = rate_limit.get("secondary_window") or rate_limit.get("secondary")

    quotas: List[Dict[str, Any]] = []

    def append_window(window: Any, default_kind: Optional[str]) -> None:
        descriptor = codex_window_descriptor(window, default_kind)
        if not descriptor:
            return
        quota = codex_window_quota(
            f"codex:{descriptor['suffix']}", descriptor["label"], window, source=source
        )
        if not quota:
            return
        quotas.append(quota)
        if descriptor["kind"] == "short":
            limits["shortUsedPercent"] = quota.get("usedPercent")
            limits["shortResetAt"] = quota.get("resetAt")
            limits["shortWindowMinutes"] = descriptor["seconds"] // 60
        elif descriptor["kind"] == "weekly":
            limits["weeklyUsedPercent"] = quota.get("usedPercent")
            limits["weeklyResetAt"] = quota.get("resetAt")

    append_window(primary, "short")
    append_window(secondary, "weekly")

    additional = payload.get("additional_rate_limits")
    if isinstance(additional, list):
        for item in additional:
            if not isinstance(item, dict):
                continue
            name = str(item.get("limit_name") or item.get("name") or "model")
            sub_rate = item.get("rate_limit") if isinstance(item.get("rate_limit"), dict) else {}
            primary_window = sub_rate.get("primary_window") or sub_rate.get("primary")
            primary_descriptor = codex_window_descriptor(primary_window, "short")
            p = codex_window_quota(
                f"codex:{name}:{primary_descriptor['suffix']}",
                f"{name} {primary_descriptor['label']}",
                primary_window, source=source, model=name,
            ) if primary_descriptor else None
            if p:
                quotas.append(p)
            secondary_window = sub_rate.get("secondary_window") or sub_rate.get("secondary")
            secondary_descriptor = codex_window_descriptor(secondary_window, "weekly")
            s = codex_window_quota(
                f"codex:{name}:{secondary_descriptor['suffix']}",
                f"{name} {secondary_descriptor['label']}",
                secondary_window, source=source, model=name,
            ) if secondary_descriptor else None
            if s:
                quotas.append(s)

    code_review = payload.get("code_review_rate_limit")
    if isinstance(code_review, dict):
        review_quota = codex_window_quota(
            "codex:code_review",
            "리뷰",
            code_review.get("primary_window") or code_review.get("primary"),
            source=source,
        )
        if review_quota:
            quotas.append(review_quota)

    limits["quotas"] = quotas
    if not quotas and not limits.get("planType"):
        limits["status"] = "not_configured"
    return limits


def codex_live_limits_for_auth(
    auth: Dict[str, Any],
    cache_key: str,
    force: bool = False,
) -> Dict[str, Any]:
    """Fetch one Codex identity's quota without sharing another identity's cache."""
    cached = None if force else cached_live_limits(cache_key, LIVE_LIMITS_MAX_AGE_SECONDS)
    if cached:
        return sanitize_codex_cached_limits(cached)
    tokens = oauth_tokens(auth)
    access_token = tokens.get("access_token")
    account_id = tokens.get("account_id") or auth.get("account_id") or ""
    if not isinstance(access_token, str) or not access_token:
        return empty_limits()

    last_error: Optional[Exception] = None
    for attempt in range(2):
        for url in CODEX_USAGE_URLS:
            try:
                payload = codex_usage_request(access_token, str(account_id), url)
                limits = codex_limits_from_usage_response(payload, source=url)
                try:
                    reset_payload = codex_reset_credits_request(access_token, str(account_id))
                    merge_codex_reset_credit_details(limits, reset_payload)
                except Exception:
                    pass
                write_live_limits_cache(cache_key, limits)
                return limits
            except urllib.error.HTTPError as exc:
                last_error = exc
                # Codex currently exposes several adjacent usage endpoints.
                # Some valid sessions receive 403 on /codex/usage while
                # /wham/usage succeeds with the same access token, so exhaust
                # the URL list before attempting token refresh.
                continue
            except Exception as exc:
                last_error = exc
        if attempt == 0:
            try:
                refreshed = refresh_codex_access_token(auth)
            except Exception as exc:
                last_error = exc
                refreshed = None
            if not refreshed:
                break
            access_token = refreshed
    stale = cached_live_limits(cache_key, LIVE_LIMITS_MAX_AGE_SECONDS, allow_stale=True)
    if stale:
        return serve_stale_live_limits(cache_key, stale, last_error or RuntimeError("Codex usage API failed"))
    limits = live_limit_error(last_error or RuntimeError("Codex usage API failed"), "codex-usage-api")
    write_live_limits_cache(cache_key, limits)
    return limits


def codex_live_limits(force: bool = False) -> Dict[str, Any]:
    auth = read_codex_auth()
    if not auth:
        return empty_limits()
    # Keep the legacy provider-level key for installed clients and migrations.
    return codex_live_limits_for_auth(auth, "codex", force=force)


def _resolved_path_key(path: Path) -> str:
    try:
        return str(path.resolve())
    except OSError:
        return str(path)


def codex_provider_instances(current_limits: Optional[Dict[str, Any]] = None) -> List[Dict[str, Any]]:
    """Discover N Codex identities and collapse profiles sharing one account ID.

    Profiles are candidates, not identities. Two homes carrying the same native
    account ID (for example ~/.codex and an Orca runtime mirror) become one
    instance. Without a native ID we deliberately keep the profile separate;
    plan/email/quota similarity is never sufficient evidence for a merge.
    """
    active_path = _resolved_path_key(default_provider_home("codex"))
    grouped: Dict[str, Dict[str, Any]] = {}

    for candidate in provider_home_candidates("codex"):
        home = candidate.get("path")
        if not isinstance(home, Path) or not candidate.get("exists"):
            continue
        auth = read_codex_auth(home)
        if not auth:
            continue
        identity = codex_auth_identity(auth)
        native_id = identity.get("accountID")
        home_key = _resolved_path_key(home)
        if native_id:
            identity_seed = f"native:{native_id}"
            confidence = "native_account_id"
        else:
            identity_seed = f"profile:{home_key}"
            confidence = "profile_only"
        instance_id = provider_instance_id("codex", identity_seed)
        entry = grouped.get(instance_id)
        if entry is None:
            suffix = instance_id.rsplit(":", 1)[-1][-4:].upper()
            entry = {
                "id": instance_id,
                "providerID": "codex",
                "label": f"Codex · {suffix}",
                "identityConfidence": confidence,
                "planType": identity.get("planType"),
                "profileCount": 0,
                "tracked": False,
                "active": False,
                "lastSeenAt": None,
                "_auth": auth,
            }
            grouped[instance_id] = entry

        entry["profileCount"] += 1
        entry["tracked"] = bool(entry["tracked"] or candidate.get("tracked"))
        entry["active"] = bool(entry["active"] or home_key == active_path)
        if not entry.get("planType") and identity.get("planType"):
            entry["planType"] = identity.get("planType")
        newest = (candidate.get("stats") or {}).get("newestMtime")
        if isinstance(newest, (int, float)):
            previous = entry.get("_lastSeenTimestamp")
            if not isinstance(previous, (int, float)) or newest > previous:
                entry["_lastSeenTimestamp"] = float(newest)

    instances: List[Dict[str, Any]] = []
    for entry in grouped.values():
        auth = entry.pop("_auth")
        last_seen = entry.pop("_lastSeenTimestamp", None)
        if isinstance(last_seen, (int, float)):
            entry["lastSeenAt"] = iso_from_timestamp(float(last_seen))
        else:
            entry.pop("lastSeenAt", None)

        if entry["active"] and isinstance(current_limits, dict):
            limits = copy.deepcopy(current_limits)
        else:
            cache_key = f"codex-instance:{entry['id'].rsplit(':', 1)[-1]}"
            try:
                limits = codex_live_limits_for_auth(auth, cache_key)
            except Exception as exc:
                limits = empty_limits(status="error", error=str(exc))
        entry["limits"] = limits
        if not entry.get("planType") and isinstance(limits.get("planType"), str):
            entry["planType"] = limits.get("planType")
        entry["status"] = "connected" if entry["tracked"] else "discovered"
        instances.append(entry)

    return sorted(
        instances,
        key=lambda item: (
            not bool(item.get("active")),
            not bool(item.get("tracked")),
            str(item.get("label") or ""),
        ),
    )


# Only normalized, privacy-safe rows are cached, never Orca's raw account list.
ORCA_ACCOUNTS_ENABLED = True
ORCA_ACCOUNTS_TTL_SECONDS = 60
ORCA_ACCOUNTS_TIMEOUT_SECONDS = 2
_ORCA_ACCOUNTS_LOCK = threading.Lock()
_ORCA_ACCOUNTS_CACHE: List[Dict[str, Any]] = []
_ORCA_ACCOUNTS_CHECKED_AT: Optional[float] = None


def orca_account_cli() -> Optional[str]:
    """Resolve a local CLI without launching Orca or a shell.

    Linux's bare `orca` is commonly the GNOME screen reader, not the IDE.
    A launchd daemon may not inherit the interactive shell's ~/.local/bin PATH.
    Explicit overrides select one runtime and must never fall through on failure.
    """
    override = os.environ.get("AGENTCAT_ORCA_CLI") or os.environ.get("ORCA_CLI_COMMAND")
    if override:
        return override
    name = "orca-dev" if os.environ.get("ORCA_DEV_REPO_ROOT") else (
        "orca-ide" if sys.platform.startswith("linux") else "orca"
    )
    found = shutil.which(name)
    if found:
        return found
    local = HOME / ".local" / "bin" / name
    return str(local) if local.is_file() and os.access(local, os.X_OK) else None


def orca_quota_timestamp(raw: Any) -> Optional[int]:
    # Orca emits epoch milliseconds; reject non-finite and malformed values.
    value = finite_float_value(raw)
    return reset_epoch(value) if value is not None else None


def orca_claude_limits(raw: Any, now: float) -> Dict[str, Any]:
    """Allowlist Orca quota buckets; never propagate errors or usageMetadata."""
    source = "orca-account-list"
    limits = empty_limits(status="not_configured", reason="orca_quota_unavailable")
    limits["source"] = source
    if not isinstance(raw, dict) or raw.get("provider") != "claude":
        return limits
    updated = orca_quota_timestamp(raw.get("updatedAt"))
    # Unknown/old source timestamps must not be refreshed merely by polling Orca.
    if updated is None or updated <= 0 or updated > now + 60 or now - updated > 900:
        limits["reason"] = "orca_quota_stale"
        return limits
    usage: Dict[str, Any] = {}
    for name, key in (("session", "five_hour"), ("weekly", "seven_day"),
                      ("fableWeekly", "seven_day_fable")):
        bucket = raw.get(name)
        if not isinstance(bucket, dict):
            continue
        percent = finite_float_value(bucket.get("usedPercent"))
        if percent is None or not 0 <= percent <= 100:
            continue
        # The CLI names these windows explicitly. Reject changed window semantics.
        expected_minutes = 300 if name == "session" else 10080
        if bucket.get("windowMinutes") != expected_minutes:
            continue
        reset_at = orca_quota_timestamp(bucket.get("resetsAt"))
        if name == "fableWeekly":
            usage["limits"] = [{"percent": percent, "resets_at": reset_at, "group": "weekly",
                                "scope": {"model": {"id": "fable", "display_name": "Fable"}}}]
        else:
            usage[key] = {"utilization": percent, "resets_at": reset_at}
    if not usage:
        return limits
    limits = claude_limits_from_usage_response(usage, source=source)
    limits["updatedAt"] = iso_from_timestamp(updated)
    limits["stale"] = bool(now - updated > 300 or raw.get("error") or raw.get("status") != "ok")
    if limits["stale"]:
        limits["reason"] = "orca_quota_stale"
    return limits


def orca_claude_instances_from_accounts(payload: Any, now: Optional[float] = None) -> List[Dict[str, Any]]:
    """Map explicit host profile IDs, not emails, quota similarity, or sessions.

    Orca IDs identify managed profiles, not verified native Claude identities.
    The system-default row identifies a mutable slot, not a durable account.
    WSL scopes are deliberately excluded until their identity contract is supported.
    """
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        raise ValueError("orca_account_list_invalid")
    result = payload.get("result")
    claude = result.get("claude") if isinstance(result, dict) else None
    rates = result.get("rateLimits") if isinstance(result, dict) else None
    if not isinstance(claude, dict) or not isinstance(claude.get("accounts"), list) or not isinstance(rates, dict):
        raise ValueError("orca_account_list_invalid")
    now = time.time() if now is None else now
    accounts = {
        row["id"]: row for row in claude["accounts"]
        if isinstance(row, dict) and isinstance(row.get("id"), str)
        and 0 < len(row["id"]) <= 256 and row.get("managedAuthRuntime") == "host"
    }
    target = rates.get("claudeTarget")
    target_is_host = isinstance(target, dict) and target.get("runtime") == "host"
    by_runtime = claude.get("activeAccountIdsByRuntime")
    if isinstance(by_runtime, dict) and "host" in by_runtime:
        active_id = by_runtime["host"]
        selection_known = active_id is None or isinstance(active_id, str)
    else:
        active_id = claude.get("activeAccountId")
        selection_known = target_is_host and "activeAccountId" in claude and (
            active_id is None or isinstance(active_id, str)
        )
    inactive: Dict[str, Dict[str, Any]] = {}
    inactive_rows = rates.get("inactiveClaudeAccounts")
    for row in inactive_rows if isinstance(inactive_rows, list) else []:
        if not isinstance(row, dict) or not isinstance(row.get("accountId"), str):
            continue
        account_id, quota = row["accountId"], row.get("rateLimits")
        if account_id not in accounts or not isinstance(quota, dict):
            continue
        previous = inactive.get(account_id)
        if previous is None or (orca_quota_timestamp(quota.get("updatedAt")) or 0) > (orca_quota_timestamp(previous.get("updatedAt")) or 0):
            inactive[account_id] = quota

    def verified_quota(raw: Any, expected: str) -> Any:
        metadata = raw.get("usageMetadata") if isinstance(raw, dict) else None
        # Selection and quota refresh are asynchronous. The quota's own auth
        # provenance must agree; otherwise a switch could label A's limits as B's.
        return raw if isinstance(metadata, dict) and metadata.get("authProvenance") == expected else None

    profiles = [(account_id, False) for account_id in accounts]
    if selection_known and active_id is None and target_is_host:
        # A missing/expired default quota carries no identity evidence. Let the
        # legacy provider continue to describe that case instead of inventing a row.
        if orca_claude_limits(verified_quota(rates.get("claude"), "system"), now).get("quotas"):
            profiles.append(("system-default", True))
    instances = []
    for account_id, system_default in profiles:
        selected = selection_known and (active_id is None if system_default else active_id == account_id)
        raw = rates.get("claude") if selected and target_is_host else (
            None if selected else inactive.get(account_id)
        )
        raw = verified_quota(raw, "system" if system_default else f"managed:{account_id}")
        limits = orca_claude_limits(raw, now)
        seed = "orca:host:system-default" if system_default else f"orca:host:managed:{account_id}"
        instance_id = provider_instance_id("claude", seed)
        suffix = instance_id.rsplit(":", 1)[-1][-4:].upper()
        instances.append({
            "id": instance_id,
            "providerID": "claude",
            "label": f"Claude · Orca {'default · ' if system_default else ''}{suffix}",
            "identityConfidence": "profile_only",
            "source": "orca-account-list",
            "profileCount": 1,
            # Tracked here means quota polling, never transcript adoption.
            "tracked": bool(limits.get("quotas")),
            "active": bool(selected),
            "status": "connected" if limits.get("quotas") else "discovered",
            "limits": limits,
        })
    return sorted(instances, key=lambda row: (not row["active"], row["id"]))


def orca_claude_provider_instances() -> List[Dict[str, Any]]:
    """Optional, failure-isolated read bridge. Never starts Orca or refreshes auth."""
    global _ORCA_ACCOUNTS_CHECKED_AT, _ORCA_ACCOUNTS_CACHE
    if not ORCA_ACCOUNTS_ENABLED or os.environ.get("AGENTCAT_ORCA_ACCOUNTS", "1").lower() in ("0", "false", "off"):
        return []
    with _ORCA_ACCOUNTS_LOCK:
        now = time.monotonic()
        if _ORCA_ACCOUNTS_CHECKED_AT is not None and 0 <= now - _ORCA_ACCOUNTS_CHECKED_AT < ORCA_ACCOUNTS_TTL_SECONDS:
            return copy.deepcopy(_ORCA_ACCOUNTS_CACHE)
        rows: List[Dict[str, Any]] = []
        try:
            executable = orca_account_cli()
            if executable:
                completed = subprocess.run(
                    [executable, "account", "list", "--json"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    timeout=ORCA_ACCOUNTS_TIMEOUT_SECONDS, check=True,
                    creationflags=CREATE_NO_WINDOW,
                )
                if len(completed.stdout) > 2 * 1024 * 1024:
                    raise ValueError("orca_account_list_too_large")
                rows = orca_claude_instances_from_accounts(json.loads(completed.stdout))
        except (OSError, ValueError, subprocess.SubprocessError):
            # Raw exceptions can contain CLI stdout, paths, emails, or auth errors.
            # Clear rows rather than presenting a previous account selection as live.
            logging.debug("Orca account bridge unavailable; using legacy provider collection")
        _ORCA_ACCOUNTS_CACHE = rows
        _ORCA_ACCOUNTS_CHECKED_AT = time.monotonic()
        return copy.deepcopy(rows)


def provider_instances_snapshot(
    limits_by_provider: Optional[Dict[str, Dict[str, Any]]] = None,
) -> List[Dict[str, Any]]:
    """Provider-neutral additive surface; optional Orca Claude quota profiles."""
    resolved_limits = limits_by_provider if isinstance(limits_by_provider, dict) else {}
    return codex_provider_instances(resolved_limits.get("codex")) + orca_claude_provider_instances()


def codex_usage_breakdown_request(access_token: str, account_id: str, url: str) -> Dict[str, Any]:
    headers = {"Authorization": f"Bearer {access_token}", "Accept": "application/json", "User-Agent": "AgentCat/1.0"}
    if account_id:
        headers["chatgpt-account-id"] = account_id
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=12) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    return payload if isinstance(payload, dict) else {}


def finite_float_value(raw: Any) -> Optional[float]:
    """Coerce one numeric value without permitting JSON-invalid NaN/Infinity."""
    try:
        value = float_value(raw)
    except (TypeError, ValueError, OverflowError):
        return None
    return value if value is not None and math.isfinite(value) else None


def codex_usage_breakdown_from_response(payload: Any, source: str = "codex-daily-usage-api") -> Dict[str, Any]:
    result: Dict[str, Any] = {
        "status": "not_available", "units": "credits", "bySurface": {},
        "byModel": [], "daily": [], "source": source,
    }
    if not isinstance(payload, dict):
        return result
    units = payload.get("units")
    if isinstance(units, str) and units.strip():
        result["units"] = units.strip()
    data = payload.get("data")
    if not isinstance(data, list):
        return result
    by_surface: Dict[str, float] = {}
    by_model: Dict[Tuple[str, Optional[str]], float] = {}
    daily: List[Dict[str, Any]] = []
    for entry in data:
        if not isinstance(entry, dict):
            continue
        surfaces: Dict[str, float] = {}
        raw_surfaces = entry.get("product_surface_usage_values")
        if isinstance(raw_surfaces, dict):
            for surface, raw_value in raw_surfaces.items():
                value = finite_float_value(raw_value)
                if value is None:
                    continue
                key = str(surface)
                surfaces[key] = surfaces.get(key, 0.0) + value
                by_surface[key] = by_surface.get(key, 0.0) + value
        daily.append({"date": str(entry["date"]) if entry.get("date") is not None else None, "surfaces": surfaces})
        raw_models = entry.get("models")
        if isinstance(raw_models, list):
            for model_entry in raw_models:
                if not isinstance(model_entry, dict):
                    continue
                credits = finite_float_value(model_entry.get("credits"))
                if credits is None:
                    continue
                model = str(model_entry.get("model") if model_entry.get("model") is not None else "unknown")
                speed_raw = model_entry.get("speed")
                speed = str(speed_raw) if isinstance(speed_raw, str) and speed_raw.strip() else None
                by_model[(model, speed)] = by_model.get((model, speed), 0.0) + credits
    result["status"] = "ok"
    result["bySurface"] = {key: round(value, 6) for key, value in by_surface.items()}
    result["daily"] = daily
    result["byModel"] = sorted(
        ({"model": model, "speed": speed, "credits": round(credits, 6)} for (model, speed), credits in by_model.items()),
        key=lambda item: item["credits"], reverse=True,
    )
    return result


def empty_codex_usage_breakdown() -> Dict[str, Any]:
    return {
        "status": "not_available", "units": "credits", "bySurface": {},
        "byModel": [], "daily": [], "source": "codex-daily-usage-api",
    }


def validated_codex_usage_breakdown(raw: Any) -> Optional[Dict[str, Any]]:
    """Return a detached, finite cached breakdown or reject the whole blob."""
    if not isinstance(raw, dict):
        return None
    if not isinstance(raw.get("status"), str):
        return None
    if not isinstance(raw.get("units"), str) or not isinstance(raw.get("source"), str):
        return None
    by_surface = raw.get("bySurface")
    by_model = raw.get("byModel")
    daily = raw.get("daily")
    if not isinstance(by_surface, dict) or not isinstance(by_model, list) or not isinstance(daily, list):
        return None
    for key, value in by_surface.items():
        if not isinstance(key, str) or isinstance(value, bool) or not isinstance(value, (int, float)) or finite_float_value(value) is None:
            return None
    for entry in by_model:
        if not isinstance(entry, dict) or not isinstance(entry.get("model"), str):
            return None
        speed = entry.get("speed")
        credits = entry.get("credits")
        if speed is not None and not isinstance(speed, str):
            return None
        if isinstance(credits, bool) or not isinstance(credits, (int, float)) or finite_float_value(credits) is None:
            return None
    for entry in daily:
        if not isinstance(entry, dict) or not isinstance(entry.get("surfaces"), dict):
            return None
        date = entry.get("date")
        if date is not None and not isinstance(date, str):
            return None
        for key, value in entry["surfaces"].items():
            if not isinstance(key, str) or isinstance(value, bool) or not isinstance(value, (int, float)) or finite_float_value(value) is None:
                return None
    try:
        # Enforce the same strict JSON numeric contract Swift's decoder expects.
        json.dumps(raw, allow_nan=False)
    except (TypeError, ValueError):
        return None
    return copy.deepcopy(raw)


def _codex_usage_breakdown_impl() -> Dict[str, Any]:
    not_available = empty_codex_usage_breakdown()
    cached = read_json(CODEX_USAGE_BREAKDOWN_CACHE)
    cached_data = validated_codex_usage_breakdown(cached.get("data")) if isinstance(cached, dict) else None
    fetched_at: Optional[int] = None
    if isinstance(cached, dict):
        raw_fetched_at = cached.get("fetched_at")
        if not isinstance(raw_fetched_at, bool):
            try:
                candidate = int(raw_fetched_at)
            except (TypeError, ValueError, OverflowError):
                candidate = -1
            if candidate >= 0:
                fetched_at = candidate
    if cached_data is not None and fetched_at is not None:
        age = int(time.time()) - fetched_at
        if 0 <= age < CODEX_USAGE_BREAKDOWN_TTL_SECONDS:
            return cached_data

    def cache_and_return(data: Dict[str, Any]) -> Dict[str, Any]:
        validated = validated_codex_usage_breakdown(data)
        if validated is None:
            return not_available
        try:
            write_json_atomic(CODEX_USAGE_BREAKDOWN_CACHE, {"fetched_at": int(time.time()), "data": validated})
        except Exception:
            pass
        return validated

    def stale_or_unavailable() -> Dict[str, Any]:
        if cached_data is not None:
            stale = dict(cached_data)
            stale["stale"] = True
            return stale
        return not_available

    try:
        auth = read_codex_auth()
    except Exception:
        return stale_or_unavailable()
    if not auth:
        return stale_or_unavailable()
    try:
        tokens = oauth_tokens(auth)
    except Exception:
        return stale_or_unavailable()
    access_token = tokens.get("access_token")
    account_id = tokens.get("account_id") or auth.get("account_id") or ""
    if not isinstance(access_token, str) or not access_token:
        return stale_or_unavailable()
    for attempt in range(2):
        try:
            payload = codex_usage_breakdown_request(access_token, str(account_id), CODEX_USAGE_BREAKDOWN_URL)
            parsed = codex_usage_breakdown_from_response(payload)
            if parsed.get("status") != "ok":
                # A 200 with an unknown schema is still a failed refresh. Keep
                # the last known-good cache rather than replacing it with an
                # empty section. A legitimate data: [] response parses as ok.
                return stale_or_unavailable()
            return cache_and_return(parsed)
        except urllib.error.HTTPError as exc:
            if exc.code == 401 and attempt == 0:
                try:
                    refreshed = refresh_codex_access_token(auth)
                except Exception:
                    refreshed = None
                if refreshed:
                    access_token = refreshed
                    continue
            return stale_or_unavailable()
        except Exception:
            return stale_or_unavailable()
    return stale_or_unavailable()


def codex_usage_breakdown() -> Dict[str, Any]:
    """Return account usage without ever risking the parent Codex snapshot."""
    try:
        return _codex_usage_breakdown_impl()
    except Exception as exc:
        logging.debug("codex usage breakdown failed: %s", exc)
        return empty_codex_usage_breakdown()


def attach_codex_usage_breakdown(snapshot: Dict[str, Any]) -> Dict[str, Any]:
    """Attach the optional section fail-soft while preserving existing fields."""
    if "codexUsageBreakdown" in snapshot:
        return snapshot
    try:
        breakdown = codex_usage_breakdown()
    except Exception as exc:
        logging.debug("codex usage breakdown attachment failed: %s", exc)
        breakdown = empty_codex_usage_breakdown()
    snapshot["codexUsageBreakdown"] = breakdown
    return snapshot


def claude_config_dir() -> Path:
    """Resolve Claude Code's config directory at call time.

    Honors ``$CLAUDE_CONFIG_DIR`` (Claude Code's own override) and otherwise
    falls back to ``~/.claude``. Resolved per-call rather than at import so the
    daemon picks up an env var injected into its launch environment.
    """
    override = os.environ.get("CLAUDE_CONFIG_DIR")
    if override:
        return Path(override).expanduser()
    return HOME / ".claude"


_CLAUDE_KEYCHAIN_WARNED = False


def _warn_keychain_once(message: str, *args: Any) -> None:
    """Log a Claude Keychain read failure at most once. This path runs every 60s snapshot
    tick on a denied/locked keychain and would otherwise flood the unrotated daemon log."""
    global _CLAUDE_KEYCHAIN_WARNED
    if not _CLAUDE_KEYCHAIN_WARNED:
        logging.warning(message, *args)
        _CLAUDE_KEYCHAIN_WARNED = True


def claude_api_billing_mode() -> Optional[str]:
    """Detect a Claude Code install billed through the API, not a subscription.

    These users have no subscription quota to report — correctly so — but the
    connector used to fold them into ``token_missing``, which reads as "we
    failed to detect Claude" and is a known share of the "detection works for
    some users, not others" reports.

    The daemon's own environment is not enough: it inherits whatever the launch
    job froze, so an ``ANTHROPIC_API_KEY`` exported in the user's shell is
    invisible to it. Claude Code's own ``settings.json`` env block is checked
    too, which is where a persistent setup actually lives.
    """
    def _from_env(source: Dict[str, Any]) -> Optional[str]:
        if str(source.get("CLAUDE_CODE_USE_BEDROCK") or "").strip() not in ("", "0", "false"):
            return "bedrock"
        if str(source.get("CLAUDE_CODE_USE_VERTEX") or "").strip() not in ("", "0", "false"):
            return "vertex"
        if source.get("ANTHROPIC_API_KEY") or source.get("ANTHROPIC_AUTH_TOKEN"):
            return "api_key"
        return None

    mode = _from_env(dict(os.environ))
    if mode:
        return mode
    settings = read_json(claude_config_dir() / "settings.json")
    env_block = settings.get("env") if isinstance(settings, dict) else None
    if isinstance(env_block, dict):
        return _from_env(env_block)
    return None


def read_claude_oauth_credentials() -> Dict[str, Any]:
    """Resolve Claude Code OAuth credentials with a machine-readable failure reason.

    Successful reads include ``credentialSource`` (``scoped-keychain``,
    ``legacy-keychain``, or ``credentials-file``). When no usable credentials
    are found, ``reason`` is one of:
      - ``keychain_denied``: the macOS Keychain refused the read (ACL deny,
        locked/headless session) — a distinct, diagnosable state, not "logged out".
      - ``api_billing``: this install bills through the API (API key, Bedrock or
        Vertex) rather than a subscription, so there is no subscription quota to
        read. Not a failure — reporting it as one is what made these users look
        like "Claude detection is broken".
      - ``token_missing``: no credentials on disk and no OAuth block present.
    """
    def usable_oauth(item: Any) -> Optional[Dict[str, Any]]:
        if not isinstance(item, dict):
            return None
        oauth = item.get("claudeAiOauth")
        if not isinstance(oauth, dict):
            oauth = item.get("claude_ai_oauth")
        if isinstance(oauth, dict) and (oauth.get("accessToken") or oauth.get("access_token")):
            return oauth
        if item.get("accessToken") or item.get("access_token"):
            return item
        return None

    config_dir = claude_config_dir()
    keychain_denied = False
    if sys.platform == "darwin":
        services: List[Tuple[str, str]] = []
        if os.environ.get("CLAUDE_CONFIG_DIR"):
            normalized_dir = str(config_dir.expanduser().resolve())
            scope_hash = hashlib.sha256(normalized_dir.encode("utf-8")).hexdigest()[:8]
            services.append((f"Claude Code-credentials-{scope_hash}", "scoped-keychain"))
        services.append(("Claude Code-credentials", "legacy-keychain"))
        for service, credential_source in services:
            try:
                raw = subprocess.check_output(
                    ["security", "find-generic-password", "-s", service, "-w"],
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=5,
                )
                oauth = usable_oauth(json.loads(raw))
                if oauth is not None:
                    return {"oauth": oauth, "reason": None, "credentialSource": credential_source}
            except subprocess.CalledProcessError as exc:
                # 44 = item genuinely not found (no Claude Code login in this Keychain).
                # Any other non-zero exit means the read was refused/blocked, which the
                # old bare `except: pass` hid as an indistinguishable "not configured".
                if exc.returncode != 44:
                    keychain_denied = True
                    _warn_keychain_once("agentcat: Claude Keychain read refused (security exit %s)", exc.returncode)
            except Exception as exc:  # security binary missing, timeout, malformed JSON
                _warn_keychain_once("agentcat: Claude Keychain read failed: %s", type(exc).__name__)

    for path in (config_dir / ".credentials.json", config_dir / "credentials.json"):
        raw = read_json(path)
        if isinstance(raw, dict) and not raw.get("_agentcat_error"):
            oauth = usable_oauth(raw)
            if oauth is not None:
                return {"oauth": oauth, "reason": None, "credentialSource": "credentials-file"}

    if keychain_denied:
        return {"oauth": None, "reason": "keychain_denied"}
    billing = claude_api_billing_mode()
    if billing:
        return {"oauth": None, "reason": "api_billing", "billingMode": billing}
    return {"oauth": None, "reason": "token_missing"}


def refresh_claude_access_token(refresh_token: str) -> Optional[str]:
    """Refresh Claude OAuth in memory without modifying Claude Code's auth state."""
    body = urllib.parse.urlencode(
        {
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
            "client_id": CLAUDE_OAUTH_CLIENT_ID,
        }
    ).encode("utf-8")
    req = urllib.request.Request(
        CLAUDE_OAUTH_TOKEN_URL,
        data=body,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Accept": "application/json",
        },
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    token = payload.get("access_token") if isinstance(payload, dict) else None
    return token.strip() if isinstance(token, str) and token.strip() else None


def claude_usage_request(access_token: str) -> Dict[str, Any]:
    req = urllib.request.Request(
        CLAUDE_USAGE_URL,
        headers={
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "Content-Type": "application/json",
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": "claude-code/2.1.69",
        },
    )
    with urllib.request.urlopen(req, timeout=12) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    return payload if isinstance(payload, dict) else {}


def claude_quota_label(key: str) -> str:
    labels = {
        "five_hour": "5시간",
        "seven_day": "7일",
        "seven_day_sonnet": "Sonnet 7일",
        "seven_day_opus": "Opus 7일",
        "extra_usage": "월별 크레딧",
        "monthly_limit": "월별 한도",
    }
    if key in labels:
        return labels[key]
    if key.startswith("seven_day_"):
        return "Claude 모델 7일"
    return "Claude 한도"


def short_stable_hash(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()[:8]


def claude_quota_id(key: str) -> str:
    known = {
        "five_hour",
        "seven_day",
        "seven_day_sonnet",
        "seven_day_opus",
        "extra_usage",
        "monthly_limit",
    }
    if key in known:
        return f"claude:{key}"
    if key.startswith("seven_day_"):
        return f"claude:seven_day_model:{short_stable_hash(key)}"
    return f"claude:quota:{short_stable_hash(key)}"


def claude_quota_model(key: str) -> Optional[str]:
    if key == "seven_day_sonnet":
        return "sonnet"
    if key == "seven_day_opus":
        return "opus"
    return None


def sanitize_claude_cached_limits(limits: Dict[str, Any]) -> Dict[str, Any]:
    quotas = limits.get("quotas")
    if not isinstance(quotas, list):
        return limits

    out = dict(limits)
    sanitized: List[Dict[str, Any]] = []
    for quota in quotas:
        if not isinstance(quota, dict):
            continue
        item = dict(quota)
        quota_id = str(item.get("id") or "")
        if quota_id.startswith("claude:seven_day_") and not quota_id.startswith("claude:seven_day_model:"):
            key = quota_id.removeprefix("claude:")
            if key not in {"seven_day_sonnet", "seven_day_opus"}:
                item["id"] = claude_quota_id(key)
                item["label"] = claude_quota_label(key)
                item["model"] = claude_quota_model(key)
        if isinstance(item.get("model"), str) and item["model"].strip().lower() in {"unknown", "null", "none", ""}:
            item["model"] = None
        sanitized.append(item)

    sanitized.sort(key=claude_quota_sort_key)
    out["quotas"] = sanitized
    return out


def claude_quota_sort_key(quota: Dict[str, Any]) -> Tuple[int, str]:
    order = {
        "claude:five_hour": 0,
        "claude:seven_day": 1,
        "claude:session": 2,
        "claude:extra_usage": 3,
        "claude:seven_day_sonnet": 4,
        "claude:seven_day_opus": 5,
    }
    quota_id = str(quota.get("id"))
    if quota_id.startswith("claude:seven_day_model:"):
        return (6, quota_id)
    return (order.get(quota_id, 100), quota_id)


def claude_scoped_quota_metadata(item: Dict[str, Any]) -> Optional[Tuple[str, str, str, Optional[str]]]:
    """Return dynamic metadata for a scoped Claude limit row.

    Claude's OAuth usage endpoint keeps newly introduced model capacities in
    ``limits[]`` instead of adding a top-level field.  Do not enumerate model
    names here: the API owns the set of scopes, so a model can appear or
    disappear without an app release.
    """
    scope = item.get("scope")
    if not isinstance(scope, dict):
        return None
    model_scope = scope.get("model")
    surface = scope.get("surface")
    if not isinstance(model_scope, dict) and not surface:
        return None

    display_name = ""
    model_id = ""
    if isinstance(model_scope, dict):
        display_name = str(model_scope.get("display_name") or model_scope.get("displayName") or "").strip()
        model_id = str(model_scope.get("id") or "").strip()
    surface_name = str(surface or "").strip()
    scope_name = display_name or model_id or surface_name
    if not scope_name:
        return None

    group = str(item.get("group") or item.get("kind") or "").strip().lower()
    if group in {"session", "five_hour", "5h"}:
        window, window_label = "5h", "5시간"
    elif group in {"daily", "day"}:
        window, window_label = "1d", "1일"
    elif group in {"monthly", "month"}:
        window, window_label = "monthly", "월별"
    else:
        window, window_label = "7d", "7일"

    normalized_model = model_id or display_name or surface_name
    return normalized_model, f"{scope_name} {window_label}", window, group or None


def claude_limits_from_usage_response(payload: Dict[str, Any], source: str = "claude-oauth-usage-api") -> Dict[str, Any]:
    limits = empty_limits(status="auto")
    limits["source"] = source
    quotas: List[Dict[str, Any]] = []

    for key, entry in payload.items():
        if not isinstance(entry, dict):
            continue
        if entry.get("is_enabled") is False:
            continue

        if key == "extra_usage" or entry.get("monthly_limit") is not None:
            limit = float_value(entry.get("monthly_limit"))
            used = float_value(entry.get("used_credits")) or 0.0
            currency = str(entry.get("currency") or "credits")
            if limit and limit > 0:
                remaining = max(limit - used, 0.0)
                used_percent = min(max((used / limit) * 100.0, 0.0), 100.0)
                quotas.append(
                    quota_entry(
                        claude_quota_id(key),
                        claude_quota_label(key),
                        used_percent=used_percent,
                        used=used,
                        remaining=remaining,
                        limit=limit,
                        unit=currency,
                        window="monthly",
                        model=claude_quota_model(key),
                        source=source,
                    )
                )
            continue

        used = float_percent(first_present(entry.get("utilization"), entry.get("used_percentage")))
        if used is None:
            continue
        window = "5h" if key == "five_hour" else "7d" if key.startswith("seven_day") else None
        # The usage endpoint also carries codenamed placeholders for features
        # that are not live for this account — nimbus_quill, amber_ladder,
        # iguana_necktie and friends, all `utilization: 0.0` with a null
        # `resets_at`. Those were rendered as a generic "Claude 한도" row
        # reading 100% remaining, directly contradicting the real seven-day
        # number sitting next to it at 2%.
        #
        # Gate on shape rather than on a name allowlist: a row the client
        # cannot place in a window *and* that has no reset time is not a quota
        # a user can act on. This keeps genuinely new limits (Anthropic keeps
        # adding `seven_day_*` scopes) flowing through without a client update,
        # while placeholders stay hidden.
        if window is None and not entry.get("resets_at"):
            continue
        quota = quota_entry(
            claude_quota_id(key),
            claude_quota_label(key),
            used_percent=used,
            reset_at=entry.get("resets_at"),
            window=window,
            model=claude_quota_model(key),
            source=source,
        )
        quotas.append(quota)

        if key == "five_hour":
            limits["shortUsedPercent"] = quota.get("usedPercent")
            limits["shortWindowMinutes"] = 300
            limits["shortResetAt"] = quota.get("resetAt")
        elif key == "seven_day":
            limits["weeklyUsedPercent"] = quota.get("usedPercent")
            limits["weeklyResetAt"] = quota.get("resetAt")

    # New model/surface capacities are represented by Claude as scoped rows in
    # ``limits[]``.  Keep these rows data-driven: if the service stops sending
    # Fable (or introduces another scope), the next refresh naturally removes
    # (or adds) the corresponding quota without a client-side feature flag.
    scoped_limits = payload.get("limits")
    if isinstance(scoped_limits, list):
        for index, item in enumerate(scoped_limits):
            if not isinstance(item, dict):
                continue
            used_percent = float_percent(item.get("percent"))
            metadata = claude_scoped_quota_metadata(item)
            if used_percent is None or metadata is None:
                continue
            model_key, label, window, group = metadata
            scope_key = ":".join(
                part for part in (group or "scoped", model_key, str(item.get("kind") or "")) if part
            )
            quota = quota_entry(
                f"claude:scoped:{short_stable_hash(scope_key or str(index))}",
                label,
                used_percent=used_percent,
                reset_at=item.get("resets_at"),
                window=window,
                model=model_key,
                source=source,
            )
            quotas.append(quota)

    quotas.sort(key=claude_quota_sort_key)
    limits["quotas"] = quotas
    if not quotas:
        # The token authenticated but the usage API returned no quota buckets
        # (console / API-key-adjacent accounts have no subscription quota to report).
        # Tag it so the app can say so, and so this definitive negative is cacheable
        # instead of re-hitting the API on every 60s tick.
        limits["status"] = "not_configured"
        limits["reason"] = "not_applicable"
    return limits


def claude_live_limits(force: bool = False) -> Dict[str, Any]:
    cached = None if force else cached_live_limits("claude", LIVE_LIMITS_MAX_AGE_SECONDS)
    if cached:
        return sanitize_claude_cached_limits(cached)
    creds = read_claude_oauth_credentials()
    oauth = creds["oauth"]
    if not isinstance(oauth, dict):
        return empty_limits(reason=creds["reason"])
    credential_source = creds.get("credentialSource")

    def credentialed(limits: Dict[str, Any]) -> Dict[str, Any]:
        if isinstance(credential_source, str) and credential_source:
            limits["credentialSource"] = credential_source
        return limits

    token = oauth.get("accessToken") or oauth.get("access_token")
    if not (isinstance(token, str) and token):
        return credentialed(empty_limits(reason="token_missing"))
    expires_at = int_limit(oauth.get("expiresAt"))
    now_ms = int(time.time() * 1000)
    refresh_token = oauth.get("refreshToken") or oauth.get("refresh_token")
    should_refresh = bool(expires_at and now_ms + CLAUDE_OAUTH_EXPIRY_BUFFER_MS >= expires_at)
    refresh_attempted = False
    if should_refresh and isinstance(refresh_token, str) and refresh_token:
        refresh_attempted = True
        try:
            refreshed = refresh_claude_access_token(refresh_token)
        except Exception:
            refreshed = None
        if not refreshed:
            return credentialed(empty_limits(reason="token_expired"))
        token = refreshed
    elif expires_at and now_ms >= expires_at:
        return credentialed(empty_limits(reason="token_expired"))
    last_error: Optional[Exception] = None
    while True:
        try:
            payload = claude_usage_request(token)
            limits = claude_limits_from_usage_response(payload, source=CLAUDE_USAGE_URL)
            credentialed(limits)
            write_live_limits_cache("claude", limits)
            return limits
        except urllib.error.HTTPError as exc:
            last_error = exc
            if (
                exc.code == 401
                and not refresh_attempted
                and isinstance(refresh_token, str)
                and refresh_token
            ):
                refresh_attempted = True
                try:
                    refreshed = refresh_claude_access_token(refresh_token)
                except Exception:
                    refreshed = None
                if refreshed:
                    exc.close()
                    token = refreshed
                    continue
            break
        except Exception as exc:
            last_error = exc
            break

    stale = cached_live_limits("claude", LIVE_LIMITS_MAX_AGE_SECONDS, allow_stale=True)
    if stale:
        return serve_stale_live_limits(
            "claude",
            credentialed(stale),
            last_error or RuntimeError("Claude usage API failed"),
        )
    limits = credentialed(live_limit_error(
        last_error or RuntimeError("Claude usage API failed"), CLAUDE_USAGE_URL
    ))
    write_live_limits_cache("claude", limits)
    return limits


def gemini_display_name(model: Any) -> str:
    names = {
        "gemini-2.5-pro": "Gemini Pro",
        "gemini-2.5-flash": "Gemini Flash",
        "gemini-2.5-flash-lite": "Gemini Flash Lite",
        "gemini-3-pro-preview": "Gemini 3 Pro",
        "gemini-3-flash-preview": "Gemini 3 Flash",
        "gemini-3.1-flash-lite": "Gemini 3.1 Flash Lite",
        "gemini-3.1-flash-lite-preview": "Gemini 3.1 Flash Lite",
        "gemini-3.1-pro-preview": "Gemini 3.1 Pro",
    }
    key = str(model or "")
    return names.get(key, key or "Gemini")


def read_gemini_auth_type() -> Optional[str]:
    paths = [
        HOME / ".gemini" / "settings.json",
        HOME / ".gemini" / "antigravity-cli" / "settings.json",
        HOME / ".antigravity" / "settings.json",
    ]
    try:
        # A project-local .gemini/settings.json wins, but cwd may have been deleted
        # under the daemon — do not let that raise and freeze the snapshot.
        paths.insert(0, Path.cwd() / ".gemini" / "settings.json")
    except OSError:
        pass
    for path in paths:
        raw = read_json(path)
        if not isinstance(raw, dict) or raw.get("_agentcat_error"):
            continue
        security = raw.get("security")
        auth = security.get("auth") if isinstance(security, dict) else None
        selected = auth.get("selectedType") if isinstance(auth, dict) else None
        # Older gemini-cli / Antigravity builds wrote a flat selectedAuthType.
        if not (isinstance(selected, str) and selected):
            legacy = raw.get("selectedAuthType")
            if isinstance(legacy, str):
                selected = legacy
        if isinstance(selected, str) and selected:
            return selected
    if os.environ.get("GOOGLE_GENAI_USE_GCA") == "true":
        return "oauth-personal"
    if os.environ.get("GEMINI_API_KEY"):
        return "gemini-api-key"
    if os.environ.get("GOOGLE_GENAI_USE_VERTEXAI") == "true":
        return "vertex-ai"
    # Fallback: if usable OAuth creds exist but settings.json never recorded the
    # auth type (common for Antigravity, esp. on Windows), treat it as personal
    # OAuth so the Code Assist quota path runs instead of returning empty.
    if read_gemini_oauth_credentials():
        return "oauth-personal"
    return None


def unwrap_antigravity_oauth_token(raw: Dict[str, Any]) -> Dict[str, Any]:
    # Antigravity's antigravity-oauth-token nests the OAuth payload under a
    # "token" key: {"token": {"access_token": ..., "token_type": ...,
    # "refresh_token": ..., "expiry": ...}, "auth_method": ...}. Flatten it to
    # the oauth_creds.json shape the rest of the gemini quota path expects,
    # letting the inner token keys win over any outer duplicates.
    inner = raw.get("token")
    if not isinstance(inner, dict):
        return raw
    flat = {key: value for key, value in raw.items() if key != "token"}
    flat.update(inner)
    return flat


def read_gemini_oauth_credentials() -> Optional[Dict[str, Any]]:
    # Gemini CLI's own OAuth creds only. Antigravity is probed independently since
    # 26.28.0 (read_antigravity_oauth_credentials / antigravity_live_limits). Reading
    # Antigravity's token here would (a) double-count Antigravity's quota on the gemini
    # tile and (b) POST Antigravity's refresh_token with the *gemini* client id/secret
    # — a guaranteed failure repeated every probe cycle (audit M3, was agent-cat-releases#31).
    raw = read_json(HOME / ".gemini" / "oauth_creds.json")
    if isinstance(raw, dict) and not raw.get("_agentcat_error"):
        return raw
    return None


def gemini_oauth2_source_candidates() -> List[Path]:
    candidates: List[Path] = []
    gemini_bin = shutil.which("gemini")
    if gemini_bin:
        resolved = Path(gemini_bin).resolve()
        candidates.extend([resolved.parent, resolved.parent.parent, resolved.parent.parent / "libexec"])
    # Windows global-npm prefix (the daemon often runs under pythonw with a minimal
    # PATH, so shutil.which("gemini") can return None even when the CLI is installed).
    appdata = os.environ.get("APPDATA")
    if appdata:
        candidates.append(Path(appdata) / "npm")
    candidates.extend(
        [
            HOME / "AppData" / "Roaming" / "npm",
            HOME / ".local" / "lib",
            HOME / "node_modules",
            Path("/opt/homebrew/lib"),
            Path("/opt/homebrew/Cellar/gemini-cli"),
            Path("/usr/local/lib"),
            HOME / ".nvm" / "versions",
        ]
    )
    # De-dupe while preserving order; keep only existing dirs.
    seen: set = set()
    unique: List[Path] = []
    for path in candidates:
        key = str(path)
        if key in seen:
            continue
        seen.add(key)
        if path.exists():
            unique.append(path)
    return unique


def _scan_js_for_oauth_creds(path: Path) -> Optional[Tuple[str, str]]:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None
    client_id = GEMINI_OAUTH_CLIENT_ID_RE.search(text)
    client_secret = GEMINI_OAUTH_CLIENT_SECRET_RE.search(text)
    if client_id and client_secret:
        return client_id.group(1), client_secret.group(1)
    return None


def gemini_cli_oauth_client_credentials() -> Optional[Tuple[str, str]]:
    # Old layout (gemini-cli < ~0.40): the OAuth constants live in an unbundled
    # source file shipped inside @google/gemini-cli-core.
    rels = (
        Path("node_modules") / "@google" / "gemini-cli-core" / "dist" / "src" / "code_assist" / "oauth2.js",
        Path("node_modules")
        / "@google"
        / "gemini-cli"
        / "node_modules"
        / "@google"
        / "gemini-cli-core"
        / "dist"
        / "src"
        / "code_assist"
        / "oauth2.js",
        Path("lib") / "node_modules" / "@google" / "gemini-cli" / "node_modules" / "@google" / "gemini-cli-core" / "dist" / "src" / "code_assist" / "oauth2.js",
        Path("libexec") / "lib" / "node_modules" / "@google" / "gemini-cli" / "node_modules" / "@google" / "gemini-cli-core" / "dist" / "src" / "code_assist" / "oauth2.js",
    )
    # New layout (gemini-cli >= ~0.40, e.g. 0.42.0): everything is bundled into
    # hashed esbuild chunks under .../@google/gemini-cli/bundle/*.js. The constants
    # are emitted as `var OAUTH_CLIENT_ID = "..."` inside one of the chunk-*.js files,
    # so glob the bundle dir rather than relying on a fixed filename.
    bundle_rels = (
        Path("node_modules") / "@google" / "gemini-cli" / "bundle",
        Path("lib") / "node_modules" / "@google" / "gemini-cli" / "bundle",
        Path("node_modules") / "@google" / "gemini-cli" / "node_modules" / "@google" / "gemini-cli" / "bundle",
        Path("@google") / "gemini-cli" / "bundle",
        Path("bundle"),
    )
    for root in gemini_oauth2_source_candidates():
        for rel in rels:
            path = root / rel
            if path.exists():
                found = _scan_js_for_oauth_creds(path)
                if found:
                    return found
        for rel in bundle_rels:
            bundle_dir = root / rel
            if not bundle_dir.is_dir():
                continue
            for js in sorted(bundle_dir.glob("*.js")):
                found = _scan_js_for_oauth_creds(js)
                if found:
                    return found
    return None


def gemini_oauth_client_credentials(creds: Dict[str, Any]) -> Tuple[str, str]:
    env_id = os.environ.get("GEMINI_OAUTH_CLIENT_ID")
    env_secret = os.environ.get("GEMINI_OAUTH_CLIENT_SECRET")
    if env_id and env_secret:
        return env_id, env_secret
    client_id = creds.get("client_id")
    client_secret = creds.get("client_secret")
    if isinstance(client_id, str) and isinstance(client_secret, str) and client_id and client_secret:
        return client_id, client_secret
    live = gemini_cli_oauth_client_credentials()
    if live:
        return live
    raise RuntimeError("Gemini OAuth metadata not found; run `gemini` once or set GEMINI_OAUTH_CLIENT_ID/GEMINI_OAUTH_CLIENT_SECRET")


def refresh_gemini_access_token(creds: Dict[str, Any]) -> Dict[str, Any]:
    refresh_token = creds.get("refresh_token")
    if not isinstance(refresh_token, str) or not refresh_token:
        raise RuntimeError("No refresh token in ~/.gemini/oauth_creds.json")
    client_id, client_secret = gemini_oauth_client_credentials(creds)
    body = urllib.parse.urlencode(
        {
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
            "client_id": client_id,
            "client_secret": client_secret,
        }
    ).encode("utf-8")
    req = urllib.request.Request(
        GEMINI_OAUTH_TOKEN_URL,
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    updated = dict(creds)
    updated["access_token"] = payload.get("access_token") or updated.get("access_token")
    updated["token_type"] = payload.get("token_type") or updated.get("token_type") or "Bearer"
    updated["expiry_date"] = int(time.time() * 1000) + int(payload.get("expires_in") or 3600) * 1000
    if payload.get("id_token"):
        updated["id_token"] = payload.get("id_token")
    return updated


def gemini_access_token() -> Optional[str]:
    creds = read_gemini_oauth_credentials()
    if not creds:
        return None
    expires_at = int_limit(creds.get("expiry_date")) or 0
    if expires_at and time.time() * 1000 >= expires_at - 60_000:
        creds = refresh_gemini_access_token(creds)
    token = creds.get("access_token")
    return token if isinstance(token, str) and token else None


def agy_binary_path() -> Optional[Path]:
    for candidate in (shutil.which("agy"), shutil.which("antigravity")):
        if candidate:
            try:
                return Path(candidate).resolve()
            except Exception:
                return Path(candidate)
    for candidate in (
        HOME / ".local" / "bin" / "agy",
        ANTIGRAVITY_CLI_DIR / "bin" / "agy",
    ):
        if candidate.exists():
            return candidate
    return None


def _read_cached_antigravity_client() -> Optional[Tuple[str, str]]:
    raw = read_json(ANTIGRAVITY_CLIENT_CACHE)
    if isinstance(raw, dict) and not raw.get("_agentcat_error"):
        cid = raw.get("client_id")
        secret = raw.get("client_secret")
        if isinstance(cid, str) and isinstance(secret, str) and cid and secret:
            return cid, secret
    return None


def antigravity_oauth_client_candidates() -> List[Tuple[str, str]]:
    # Env override wins (mirrors gemini's GEMINI_OAUTH_CLIENT_ID/SECRET).
    env_id = os.environ.get("ANTIGRAVITY_OAUTH_CLIENT_ID")
    env_secret = os.environ.get("ANTIGRAVITY_OAUTH_CLIENT_SECRET")
    if env_id and env_secret:
        return [(env_id, env_secret)]
    cached = _read_cached_antigravity_client()
    if cached:
        return [cached]
    binary = agy_binary_path()
    if not binary:
        return []
    try:
        data = binary.read_bytes()
    except Exception:
        return []
    ids = list(dict.fromkeys(m.decode() for m in ANTIGRAVITY_OAUTH_CLIENT_ID_RE.findall(data)))
    secrets = list(dict.fromkeys(m.decode() for m in ANTIGRAVITY_OAUTH_CLIENT_SECRET_RE.findall(data)))
    # Bounded product of the handful of embedded credentials; the working pair is
    # cached after first success so this scan runs at most once per install.
    pairs: List[Tuple[str, str]] = []
    for cid in ids:
        for secret in secrets:
            pairs.append((cid, secret))
    return pairs[:8]


def refresh_antigravity_access_token(creds: Dict[str, Any]) -> Dict[str, Any]:
    refresh_token = creds.get("refresh_token")
    if not isinstance(refresh_token, str) or not refresh_token:
        raise RuntimeError("No refresh token in antigravity-oauth-token")
    last_error: Optional[Exception] = None
    env_client = bool(os.environ.get("ANTIGRAVITY_OAUTH_CLIENT_ID") and os.environ.get("ANTIGRAVITY_OAUTH_CLIENT_SECRET"))
    # Two passes: first the env/cached client, then — if that fails — drop the cache
    # and rescan the agy binary once. agy can rotate its OAuth client or the user can
    # re-log-in under a different one, which would otherwise pin a dead cached client
    # forever (audit M2).
    for attempt in range(2):
        candidates = antigravity_oauth_client_candidates()
        if not candidates:
            raise RuntimeError("Antigravity OAuth client credentials not found (agy binary missing?)")
        had_cached_client = _read_cached_antigravity_client() is not None
        for client_id, client_secret in candidates:
            body = urllib.parse.urlencode(
                {
                    "grant_type": "refresh_token",
                    "refresh_token": refresh_token,
                    "client_id": client_id,
                    "client_secret": client_secret,
                }
            ).encode("utf-8")
            req = urllib.request.Request(
                GEMINI_OAUTH_TOKEN_URL,
                data=body,
                headers={"Content-Type": "application/x-www-form-urlencoded"},
            )
            try:
                with urllib.request.urlopen(req, timeout=10) as resp:
                    payload = json.loads(resp.read().decode("utf-8"))
            except urllib.error.HTTPError as exc:
                last_error = exc
                continue
            access_token = payload.get("access_token")
            if not access_token:
                continue
            # Persist the working client so subsequent refreshes skip the binary scan.
            try:
                write_json_atomic(ANTIGRAVITY_CLIENT_CACHE, {"client_id": client_id, "client_secret": client_secret})
            except Exception:
                pass
            updated = dict(creds)
            updated["access_token"] = access_token
            updated["token_type"] = payload.get("token_type") or updated.get("token_type") or "Bearer"
            updated["expiry_date"] = int(time.time() * 1000) + int(payload.get("expires_in") or 3600) * 1000
            if payload.get("id_token"):
                updated["id_token"] = payload.get("id_token")
            return updated
        if attempt == 0 and had_cached_client and not env_client:
            try:
                ANTIGRAVITY_CLIENT_CACHE.unlink()
            except Exception:
                pass
            continue
        break
    raise RuntimeError(f"Antigravity token refresh failed for all client candidates: {last_error}")


def read_antigravity_oauth_credentials() -> Optional[Dict[str, Any]]:
    raw = read_json(ANTIGRAVITY_OAUTH_TOKEN)
    if not isinstance(raw, dict) or raw.get("_agentcat_error"):
        return None
    return unwrap_antigravity_oauth_token(raw)


def antigravity_expiry_ms(creds: Dict[str, Any]) -> int:
    # Antigravity stores expiry as an ISO8601 string; gemini uses epoch millis.
    numeric = int_limit(creds.get("expiry_date"))
    if numeric:
        return numeric
    expiry = creds.get("expiry") or creds.get("expiry_date")
    if isinstance(expiry, str) and expiry:
        parsed = parse_timestamp(expiry)
        if parsed is not None:
            return int(parsed.timestamp() * 1000)
    return 0


def antigravity_access_token() -> Optional[str]:
    creds = read_antigravity_oauth_credentials()
    if not creds:
        return None
    expires_at = antigravity_expiry_ms(creds)
    if not expires_at or time.time() * 1000 >= expires_at - 60_000:
        creds = refresh_antigravity_access_token(creds)
    token = creds.get("access_token")
    return token if isinstance(token, str) and token else None


def gemini_code_assist_post(method: str, payload: Dict[str, Any], access_token: str) -> Dict[str, Any]:
    req = urllib.request.Request(
        f"{GEMINI_CODE_ASSIST_URL}:{method}",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "Content-Type": "application/json",
            "User-Agent": "AgentCat/1.0",
        },
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read().decode("utf-8"))
    return data if isinstance(data, dict) else {}


def gemini_limits_from_quota_response(
    quota_payload: Dict[str, Any],
    tier_payload: Optional[Dict[str, Any]] = None,
    source: str = "gemini-code-assist-quota-api",
) -> Dict[str, Any]:
    limits = empty_limits(status="auto")
    limits["source"] = source
    tier_payload = tier_payload or {}
    current_tier = tier_payload.get("currentTier") if isinstance(tier_payload.get("currentTier"), dict) else {}
    paid_tier = tier_payload.get("paidTier") if isinstance(tier_payload.get("paidTier"), dict) else {}
    plan = paid_tier.get("name") or current_tier.get("name") or paid_tier.get("id") or current_tier.get("id")
    limits["planType"] = str(plan) if plan else None

    quotas: List[Dict[str, Any]] = []
    buckets = quota_payload.get("buckets")
    if isinstance(buckets, list):
        for bucket in buckets:
            if not isinstance(bucket, dict):
                continue
            model = str(bucket.get("modelId") or "")
            remaining_fraction = float_value(bucket.get("remainingFraction"))
            remaining_percent = None
            used_percent = None
            if remaining_fraction is not None:
                remaining_percent = min(max(remaining_fraction * 100.0, 0.0), 100.0)
                used_percent = min(max(100.0 - remaining_percent, 0.0), 100.0)
            remaining = int_limit(bucket.get("remainingAmount"))
            limit = None
            if remaining is not None and remaining_fraction and remaining_fraction > 0:
                limit = round(remaining / remaining_fraction)
            token_type = str(bucket.get("tokenType") or "REQUESTS").lower()
            quotas.append(
                quota_entry(
                    f"gemini:{model or len(quotas)}",
                    gemini_display_name(model),
                    used_percent=used_percent,
                    remaining_percent=remaining_percent,
                    reset_at=bucket.get("resetTime"),
                    unit="requests" if token_type == "requests" else token_type,
                    used=None if remaining is None or limit is None else max(limit - remaining, 0),
                    remaining=remaining,
                    limit=limit,
                    window="daily",
                    model=model or None,
                    source=source,
                )
            )

    limits["quotas"] = sorted_gemini_quotas(quotas)
    if not quotas:
        limits["status"] = "not_configured"
    return limits


def sorted_gemini_quotas(quotas: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    if len(quotas) > 3:
        return sorted(quotas, key=gemini_quota_compact_sort_key)
    return sorted(quotas, key=lambda q: (0 if "pro" in str(q.get("model")).lower() else 1, str(q.get("label"))))


def normalize_gemini_limits(limits: Dict[str, Any]) -> Dict[str, Any]:
    quotas = limits.get("quotas")
    if not isinstance(quotas, list):
        return limits
    out = dict(limits)
    out["quotas"] = sorted_gemini_quotas([q for q in quotas if isinstance(q, dict)])
    return out


def gemini_quota_remaining_percent(quota: Dict[str, Any]) -> float:
    remaining = float_value(quota.get("remainingPercent"))
    if remaining is not None:
        return remaining
    used = float_value(quota.get("usedPercent"))
    if used is not None:
        return min(max(100.0 - used, 0.0), 100.0)
    return float("inf")


def gemini_quota_compact_sort_key(quota: Dict[str, Any]) -> Tuple[float, int, str]:
    return (
        gemini_quota_remaining_percent(quota),
        int_limit(quota.get("resetAt")) or 2**31 - 1,
        str(quota.get("label") or quota.get("id") or ""),
    )


def gemini_local_project_id(*extra_paths: Path) -> str:
    """Best-effort Code Assist project. Consumer Gemini no longer auto-provisions one."""
    for key in ("GOOGLE_CLOUD_PROJECT", "GOOGLE_CLOUD_PROJECT_ID"):
        value = os.environ.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    for path in extra_paths:
        try:
            text = path.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if text and 4 <= len(text) <= 64 and all(ch.isalnum() or ch in "-_" for ch in text):
            return text
    return ""


def antigravity_local_project_path() -> Path:
    return ANTIGRAVITY_CLI_DIR / "cache" / "default_project_id.txt"


def fetch_code_assist_quota(access_token: str, project_id: str = "") -> Tuple[Dict[str, Any], Dict[str, Any]]:
    """loadCodeAssist + retrieveUserQuota.

    After the 2026-06-18 consumer Code Assist cutover, loadCodeAssist often
    returns no `cloudaicompanionProject`. retrieveUserQuota still answers
    `{}` with remainingFraction + resetTime, so do not abort on a missing
    project — that was why Gemini/Antigravity tiles showed no 한도.
    """
    project_id = str(project_id or "")
    metadata = {
        "ideType": "IDE_UNSPECIFIED",
        "platform": "PLATFORM_UNSPECIFIED",
        "pluginType": "GEMINI",
    }
    load_payload: Dict[str, Any] = {"metadata": metadata}
    if project_id:
        metadata["duetProject"] = project_id
        load_payload["cloudaicompanionProject"] = project_id
    try:
        tier_payload = gemini_code_assist_post("loadCodeAssist", load_payload, access_token)
    except Exception:
        tier_payload = {}
    if not isinstance(tier_payload, dict):
        tier_payload = {}
    project_id = str(tier_payload.get("cloudaicompanionProject") or project_id or "")

    quota_payload: Dict[str, Any] = {}
    if project_id:
        try:
            quota_payload = gemini_code_assist_post(
                "retrieveUserQuota",
                {"project": project_id},
                access_token,
            )
        except Exception:
            quota_payload = {}
    # Empty project is common after the 2026-06-18 consumer cutover. Try
    # retrieveUserQuota({}) before failing — it still returns remainingFraction
    # + resetTime. A 403 here is project_required, not token_expired.
    if not (isinstance(quota_payload, dict) and quota_payload.get("buckets")):
        quota_payload = gemini_code_assist_post("retrieveUserQuota", {}, access_token)
    if not isinstance(quota_payload, dict):
        quota_payload = {}
    return tier_payload, quota_payload


def gemini_live_limits(force: bool = False) -> Dict[str, Any]:
    cached = None if force else cached_live_limits("gemini", LIVE_LIMITS_MAX_AGE_SECONDS)
    if cached:
        return normalize_gemini_limits(cached)
    auth_type = read_gemini_auth_type()
    if auth_type != "oauth-personal":
        return empty_limits()
    project_id = gemini_local_project_id()
    try:
        token = gemini_access_token()
        if not token:
            return empty_limits()
        tier_payload, quota_payload = fetch_code_assist_quota(token, project_id)
        limits = gemini_limits_from_quota_response(quota_payload, tier_payload, source=GEMINI_CODE_ASSIST_URL)
        write_live_limits_cache("gemini", limits)
        return limits
    except Exception as exc:
        stale = cached_live_limits("gemini", LIVE_LIMITS_MAX_AGE_SECONDS, allow_stale=True)
        if stale:
            return serve_stale_live_limits(
                "gemini",
                normalize_gemini_limits(stale),
                exc,
                project_id=project_id,
            )
        limits = live_limit_error(exc, GEMINI_CODE_ASSIST_URL, project_id=project_id)
        write_live_limits_cache("gemini", limits)
        return limits


def antigravity_live_limits(force: bool = False) -> Dict[str, Any]:
    # Antigravity quota rides the same Code Assist API as gemini, but on its own
    # OAuth token/client, so it must be refreshed and probed independently instead
    # of mirroring the gemini quota (which was wrong for Antigravity-only users and
    # for anyone whose gemini and antigravity plans differ).
    cached = None if force else cached_live_limits("antigravity", LIVE_LIMITS_MAX_AGE_SECONDS)
    if cached:
        return normalize_gemini_limits(cached)
    if read_antigravity_oauth_credentials() is None:
        return empty_limits()
    project_id = gemini_local_project_id(antigravity_local_project_path())
    try:
        token = antigravity_access_token()
        if not token:
            return empty_limits()
        tier_payload, quota_payload = fetch_code_assist_quota(token, project_id)
        limits = gemini_limits_from_quota_response(quota_payload, tier_payload, source=GEMINI_CODE_ASSIST_URL)
        if limits.get("status") == "not_configured" and not limits.get("quotas"):
            # An account with no Code Assist quota buckets — cache it as a definitive
            # "not applicable" (short TTL) so we don't re-probe + re-refresh the token
            # on every 60s tick. The refreshed access token is never persisted to
            # agy's file, so an uncached empty result means a refresh POST every tick.
            limits["reason"] = "not_applicable"
        write_live_limits_cache("antigravity", limits)
        return limits
    except Exception as exc:
        stale = cached_live_limits("antigravity", LIVE_LIMITS_MAX_AGE_SECONDS, allow_stale=True)
        if stale:
            return serve_stale_live_limits(
                "antigravity",
                normalize_gemini_limits(stale),
                exc,
                project_id=project_id,
            )
        limits = live_limit_error(exc, GEMINI_CODE_ASSIST_URL, project_id=project_id)
        if limits.get("reason") == "project_required":
            limits["error"] = "Antigravity Code Assist project ID unavailable"
        write_live_limits_cache("antigravity", limits)
        return limits


def grok_auth_path() -> Path:
    roots = grok_roots()
    for root in roots:
        path = root / "auth.json"
        if path.is_file():
            return path
    return (roots[0] if roots else HOME / ".grok") / "auth.json"


def grok_billing_val(raw: Any) -> Optional[float]:
    if isinstance(raw, dict) and "val" in raw:
        return float_value(raw.get("val"))
    return float_value(raw)


def read_grok_access_token() -> Dict[str, Any]:
    """Read the local Grok CLI session token. Never logs or returns PII fields."""
    raw = read_json(grok_auth_path())
    if not isinstance(raw, dict) or raw.get("_agentcat_error"):
        return {"token": None, "reason": "token_missing"}
    best_token: Optional[str] = None
    best_expiry = -1.0
    for entry in raw.values():
        if not isinstance(entry, dict):
            continue
        token = entry.get("key") or entry.get("access_token") or entry.get("accessToken")
        if not (isinstance(token, str) and token.strip()):
            continue
        expires = parse_timestamp(entry.get("expires_at") or entry.get("expiresAt"))
        score = expires.timestamp() if expires else 0.0
        if best_token is None or score >= best_expiry:
            best_token = token.strip()
            best_expiry = score
    if not best_token:
        return {"token": None, "reason": "token_missing"}
    return {"token": best_token, "reason": None}


def grok_period_window(period_type: Any) -> Tuple[str, str, str]:
    text = str(period_type or "").upper()
    if "HOUR" in text or "5H" in text or "SHORT" in text:
        return "grok:5h", "5시간", "5h"
    if "DAY" in text and "SEVEN" not in text and "WEEK" not in text:
        return "grok:1d", "1일", "1d"
    if "WEEK" in text or "7D" in text or "SEVEN" in text:
        return "grok:7d", "7일", "7d"
    return "grok:monthly", "월별 한도", "monthly"


def grok_limits_from_credits_response(payload: Dict[str, Any], source: str = GROK_BILLING_CREDITS_URL) -> Dict[str, Any]:
    """Map `/usage` credits billing — this is the weekly SuperGrok window."""
    config = payload.get("config") if isinstance(payload.get("config"), dict) else payload
    if not isinstance(config, dict):
        return empty_limits(reason="not_applicable")

    period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
    used_percent = grok_billing_val(config.get("creditUsagePercent"))
    reset_at = (
        (period or {}).get("end")
        or config.get("billingPeriodEnd")
        or config.get("billing_period_end")
    )
    if used_percent is None and reset_at is None and not isinstance(config.get("productUsage"), list):
        return empty_limits(reason="not_applicable")

    quota_id, label, window = grok_period_window((period or {}).get("type"))
    remaining_percent = remaining_percent_from_used(used_percent) if used_percent is not None else None
    limits = empty_limits(status="auto")
    limits["source"] = source
    limits["planType"] = "weekly" if window == "7d" else window
    reset_epoch_value = reset_epoch(reset_at)
    if window == "5h":
        limits["shortUsedPercent"] = used_percent
        limits["shortWindowMinutes"] = 300
        limits["shortResetAt"] = reset_epoch_value
    else:
        limits["weeklyUsedPercent"] = used_percent
        limits["weeklyResetAt"] = reset_epoch_value

    quotas: List[Dict[str, Any]] = [
        quota_entry(
            quota_id,
            label,
            used_percent=used_percent,
            remaining_percent=remaining_percent,
            reset_at=reset_at,
            unit="percent",
            window=window,
            source=source,
        )
    ]
    for row in config.get("productUsage") or []:
        if not isinstance(row, dict):
            continue
        product = str(row.get("product") or "").strip()
        product_used = grok_billing_val(row.get("usagePercent"))
        if not product or product_used is None:
            continue
        slug = product.lower().replace(" ", "")
        if slug.startswith("grok") and len(slug) > 4:
            slug = slug[4:]
        product_window = "media" if "imagine" in slug else window
        quotas.append(
            quota_entry(
                f"grok:{slug}",
                product.replace("Grok", "Grok ").strip(),
                used_percent=product_used,
                remaining_percent=remaining_percent_from_used(product_used),
                reset_at=reset_at,
                unit="percent",
                window=product_window,
                model=slug,
                source=source,
            )
        )
    limits["quotas"] = quotas
    return limits


def grok_limits_from_billing_response(payload: Dict[str, Any], source: str = GROK_BILLING_URL) -> Dict[str, Any]:
    """Map Grok billing. Prefer credits (`/usage`) weekly windows; fall back
    to the calendar-month payload when credits are absent."""
    config = payload.get("config") if isinstance(payload.get("config"), dict) else payload
    if not isinstance(config, dict):
        return empty_limits(reason="not_applicable")

    if (
        isinstance(config.get("currentPeriod"), dict)
        or config.get("creditUsagePercent") is not None
        or isinstance(config.get("productUsage"), list)
    ):
        credits = grok_limits_from_credits_response(payload, source=source)
        if credits.get("status") == "auto":
            return credits

    used = grok_billing_val(config.get("used"))
    limit = grok_billing_val(config.get("monthlyLimit") or config.get("monthly_limit"))
    reset_at = config.get("billingPeriodEnd") or config.get("billing_period_end")
    if used is None and limit is None and reset_at is None:
        return empty_limits(reason="not_applicable")

    limits = empty_limits(status="auto")
    limits["source"] = source
    limits["planType"] = "monthly"
    if limit and limit > 0:
        limits["monthlyTokens"] = int(limit)
        if used is not None:
            limits["weeklyUsedPercent"] = min(max((used / limit) * 100.0, 0.0), 100.0)
    reset_epoch_value = reset_epoch(reset_at)
    if reset_epoch_value:
        limits["weeklyResetAt"] = reset_epoch_value

    remaining = None
    used_percent = None
    remaining_percent = None
    if limit and limit > 0:
        remaining = max(limit - (used or 0.0), 0.0)
        used_percent = min(max(((used or 0.0) / limit) * 100.0, 0.0), 100.0)
        remaining_percent = remaining_percent_from_used(used_percent)

    has_cap = bool(limit and limit > 0)
    quotas = [
        quota_entry(
            "grok:monthly",
            "월별 한도" if has_cap else "월별 초기화",
            used_percent=used_percent,
            remaining_percent=remaining_percent,
            reset_at=reset_at,
            unit="credits",
            used=used,
            remaining=remaining,
            limit=limit if has_cap else None,
            window="monthly",
            source=source,
        )
    ]
    limits["quotas"] = quotas
    return limits


def grok_live_limits(force: bool = False) -> Dict[str, Any]:
    cached = None if force else cached_live_limits("grok", LIVE_LIMITS_MAX_AGE_SECONDS)
    if cached:
        return cached
    creds = read_grok_access_token()
    token = creds.get("token")
    if not (isinstance(token, str) and token):
        return empty_limits(reason=creds.get("reason") or "token_missing")
    last_error: Optional[Exception] = None
    for url in (GROK_BILLING_CREDITS_URL, GROK_BILLING_URL):
        req = urllib.request.Request(
            url,
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/json",
                "User-Agent": "grok-cli/1.0.4",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=12) as resp:
                payload = json.loads(resp.read().decode("utf-8"))
            limits = grok_limits_from_billing_response(
                payload if isinstance(payload, dict) else {},
                source=url,
            )
            if limits.get("status") == "auto":
                write_live_limits_cache("grok", limits)
                return limits
        except urllib.error.HTTPError as exc:
            last_error = exc
            if exc.code in {401, 403}:
                break
        except Exception as exc:
            last_error = exc
    stale = cached_live_limits("grok", LIVE_LIMITS_MAX_AGE_SECONDS, allow_stale=True)
    if stale and last_error is not None:
        return serve_stale_live_limits("grok", stale, last_error)
    if isinstance(last_error, urllib.error.HTTPError):
        limits = live_limit_error(last_error, GROK_BILLING_CREDITS_URL)
        if last_error.code in {401, 403}:
            limits["reason"] = "token_expired"
        write_live_limits_cache("grok", limits)
        return limits
    if last_error is not None:
        limits = live_limit_error(last_error, GROK_BILLING_CREDITS_URL)
        write_live_limits_cache("grok", limits)
        return limits
    return empty_limits(reason="not_applicable")


def kimi_credential_files() -> List[Path]:
    """Every `credentials/kimi-code*.json` under known Kimi roots.

    Kimi CLI 0.39.x keeps an empty stub at `kimi-code.json` and the live
    token in sibling env-scoped files (`kimi-code-env-<hash>.json`).
    """
    files: List[Path] = []
    seen: Set[str] = set()
    for root in kimi_roots():
        creds_dir = root / "credentials"
        try:
            candidates = sorted(creds_dir.glob("kimi-code*.json"))
        except OSError:
            continue
        for path in candidates:
            if not path.is_file():
                continue
            key = str(path)
            if key in seen:
                continue
            seen.add(key)
            files.append(path)
    return files


def kimi_expires_at_epoch_seconds(raw: Any) -> Optional[int]:
    """Normalize Kimi `expires_at` to epoch seconds.

    Values below 10^11 are treated as seconds; larger values as milliseconds.
    Zero is a known stub/expired sentinel and is preserved.
    """
    if isinstance(raw, bool) or raw is None:
        return None
    value: Optional[int] = None
    if isinstance(raw, (int, float)):
        value = int(raw)
    elif isinstance(raw, str):
        text = raw.strip().replace(",", "").replace("_", "")
        if not text:
            return None
        sign = -1 if text.startswith("-") else 1
        digits = text[1:] if text[0] in "+-" else text
        if not digits.isdigit():
            return None
        value = sign * int(digits)
    else:
        return None
    if value < 0:
        return None
    if value == 0 or value < KIMI_EXPIRES_AT_MS_THRESHOLD:
        return value
    return value // 1000


def _kimi_token_from_payload(raw: Dict[str, Any], *keys: str) -> Optional[str]:
    for key in keys:
        value = raw.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def _kimi_credentials_from_file(path: Path) -> Optional[Dict[str, Any]]:
    raw = read_json(path)
    if not isinstance(raw, dict) or raw.get("_agentcat_error"):
        return None
    access = _kimi_token_from_payload(raw, "access_token", "accessToken")
    refresh = _kimi_token_from_payload(raw, "refresh_token", "refreshToken")
    if not access and not refresh:
        return None
    return {
        "path": path,
        "access_token": access,
        "refresh_token": refresh,
        "expires_at": kimi_expires_at_epoch_seconds(raw.get("expires_at") or raw.get("expiresAt")),
        "reason": None,
    }


def kimi_credentials_path() -> Path:
    chosen: Optional[Path] = None
    chosen_expiry = -1
    stub: Optional[Path] = None
    for path in kimi_credential_files():
        creds = _kimi_credentials_from_file(path)
        if creds is None:
            if stub is None and path.name == "kimi-code.json":
                stub = path
            continue
        expiry = creds.get("expires_at")
        score = expiry if isinstance(expiry, int) else 0
        if chosen is None or score >= chosen_expiry:
            chosen = path
            chosen_expiry = score
    if chosen is not None:
        return chosen
    if stub is not None:
        return stub
    for root in kimi_roots():
        path = root / "credentials" / "kimi-code.json"
        if path.is_file():
            return path
    return HOME / ".kimi-code" / "credentials" / "kimi-code.json"


def read_kimi_oauth_credentials() -> Dict[str, Any]:
    best: Optional[Dict[str, Any]] = None
    best_expiry = -1
    for path in kimi_credential_files():
        creds = _kimi_credentials_from_file(path)
        if creds is None:
            continue
        expiry = creds.get("expires_at")
        score = expiry if isinstance(expiry, int) else 0
        if best is None or score >= best_expiry:
            best = creds
            best_expiry = score
    if best is None:
        return {"access_token": None, "refresh_token": None, "reason": "token_missing"}
    return {
        "access_token": best.get("access_token"),
        "refresh_token": best.get("refresh_token"),
        "expires_at": best.get("expires_at"),
        "reason": None,
    }


def refresh_kimi_access_token(refresh_token: str) -> Optional[str]:
    # In-memory only — never write Kimi's credentials file.
    body = urllib.parse.urlencode(
        {
            "client_id": KIMI_OAUTH_CLIENT_ID,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        }
    ).encode("utf-8")
    req = urllib.request.Request(
        KIMI_OAUTH_TOKEN_URL,
        data=body,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Accept": "application/json",
            "User-Agent": "kimi-code/1.0",
        },
    )
    with urllib.request.urlopen(req, timeout=12) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    token = payload.get("access_token") if isinstance(payload, dict) else None
    return token.strip() if isinstance(token, str) and token.strip() else None


def kimi_usage_number(raw: Any) -> Optional[float]:
    if isinstance(raw, dict):
        for key in ("used", "limit", "remaining", "val", "value"):
            if key in raw:
                return kimi_usage_number(raw.get(key))
        return None
    return float_value(raw)


def kimi_window_label(window: Any) -> Tuple[str, str, str]:
    if not isinstance(window, dict):
        return "kimi:usage", "Kimi 한도", "week"
    duration = int_limit(window.get("duration")) or 0
    unit = str(window.get("timeUnit") or window.get("unit") or "").lower()
    minutes = duration
    if "hour" in unit:
        minutes = duration * 60
    elif "day" in unit:
        minutes = duration * 24 * 60
    elif "week" in unit:
        minutes = duration * 7 * 24 * 60
    if 0 < minutes <= 12 * 60:
        return "kimi:5h", "5시간", "5h"
    if minutes <= 36 * 60:
        return "kimi:1d", "1일", "1d"
    return "kimi:7d", "7일", "7d"


def kimi_limits_from_usage_response(payload: Dict[str, Any], source: str = KIMI_USAGE_URL) -> Dict[str, Any]:
    if payload.get("kind") == "error":
        return empty_limits(status="error", error=str(payload.get("message") or "kimi usage error"))

    data = payload.get("data") if isinstance(payload.get("data"), dict) else payload
    if not isinstance(data, dict):
        return empty_limits(reason="not_applicable")

    limits = empty_limits(status="auto")
    limits["source"] = source
    quotas: List[Dict[str, Any]] = []

    rows = data.get("limits") if isinstance(data.get("limits"), list) else []
    for row in rows:
        if not isinstance(row, dict):
            continue
        detail = row.get("detail") if isinstance(row.get("detail"), dict) else row
        used = kimi_usage_number(detail.get("used"))
        limit = kimi_usage_number(detail.get("limit"))
        remaining = kimi_usage_number(detail.get("remaining"))
        reset_at = detail.get("resetTime") or detail.get("reset_at") or row.get("reset_at")
        if used is None and remaining is not None and limit is not None:
            used = max(limit - remaining, 0.0)
        if remaining is None and used is not None and limit is not None:
            remaining = max(limit - used, 0.0)
        if used is None and limit is None:
            continue
        quota_id, label, window = kimi_window_label(row.get("window"))
        used_percent = None
        remaining_percent = None
        if limit and limit > 0 and used is not None:
            used_percent = min(max((used / limit) * 100.0, 0.0), 100.0)
            remaining_percent = remaining_percent_from_used(used_percent)
            if window == "5h":
                limits["shortUsedPercent"] = used_percent
                limits["shortWindowMinutes"] = 300
                limits["shortResetAt"] = reset_epoch(reset_at)
            elif window == "7d":
                limits["weeklyUsedPercent"] = used_percent
                limits["weeklyResetAt"] = reset_epoch(reset_at)
                limits["weeklyTokens"] = int(limit)
        quotas.append(
            quota_entry(
                quota_id,
                label,
                used_percent=used_percent,
                remaining_percent=remaining_percent,
                reset_at=reset_at,
                unit="requests",
                used=used,
                remaining=remaining,
                limit=limit if limit and limit > 0 else None,
                window=window,
                source=source,
            )
        )

    summary = data.get("usage") if isinstance(data.get("usage"), dict) else data.get("summary")
    if isinstance(summary, dict):
        used = kimi_usage_number(summary.get("used"))
        limit = kimi_usage_number(summary.get("limit"))
        remaining = kimi_usage_number(summary.get("remaining"))
        reset_at = summary.get("resetTime") or summary.get("reset_at")
        if used is None and remaining is not None and limit is not None:
            used = max(limit - remaining, 0.0)
        if remaining is None and used is not None and limit is not None:
            remaining = max(limit - used, 0.0)
        if limit and limit > 0 and used is not None:
            used_percent = min(max((used / limit) * 100.0, 0.0), 100.0)
            if limits.get("weeklyUsedPercent") is None:
                limits["weeklyUsedPercent"] = used_percent
                limits["weeklyResetAt"] = reset_epoch(reset_at)
                limits["weeklyTokens"] = int(limit)
            if not any(item.get("id") == "kimi:7d" for item in quotas):
                quotas.append(
                    quota_entry(
                        "kimi:7d",
                        "7일",
                        used_percent=used_percent,
                        remaining_percent=remaining_percent_from_used(used_percent),
                        reset_at=reset_at,
                        unit="requests",
                        used=used,
                        remaining=remaining,
                        limit=limit,
                        window="7d",
                        source=source,
                    )
                )

    extra = data.get("extra_usage") if isinstance(data.get("extra_usage"), dict) else None
    if extra:
        used_cents = kimi_usage_number(extra.get("monthly_used_cents"))
        limit_cents = kimi_usage_number(extra.get("monthly_charge_limit_cents"))
        if extra.get("monthly_charge_limit_enabled") and limit_cents and limit_cents > 0:
            used = (used_cents or 0.0) / 100.0
            limit = limit_cents / 100.0
            used_percent = min(max((used / limit) * 100.0, 0.0), 100.0)
            quotas.append(
                quota_entry(
                    "kimi:booster",
                    "월별 크레딧",
                    used_percent=used_percent,
                    remaining_percent=remaining_percent_from_used(used_percent),
                    unit="usd",
                    used=used,
                    remaining=max(limit - used, 0.0),
                    limit=limit,
                    window="monthly",
                    source=source,
                )
            )

    if not quotas:
        return empty_limits(reason="not_applicable")
    limits["quotas"] = quotas
    return limits


def kimi_usage_request(access_token: str) -> Dict[str, Any]:
    req = urllib.request.Request(
        KIMI_USAGE_URL,
        headers={
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "User-Agent": "kimi-code/1.0",
        },
    )
    with urllib.request.urlopen(req, timeout=12) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    return payload if isinstance(payload, dict) else {}


def kimi_live_limits(force: bool = False) -> Dict[str, Any]:
    cached = None if force else cached_live_limits("kimi", LIVE_LIMITS_MAX_AGE_SECONDS)
    if cached:
        return cached
    creds = read_kimi_oauth_credentials()
    access = creds.get("access_token")
    refresh = creds.get("refresh_token")
    if not access and not refresh:
        return empty_limits(reason=creds.get("reason") or "token_missing")

    last_error: Optional[Exception] = None
    tokens: List[str] = []
    expires_at = creds.get("expires_at")
    now = int(time.time())
    expired = isinstance(expires_at, int) and expires_at <= now
    refresh_failed = False
    if isinstance(access, str) and access and not expired:
        tokens.append(access)
    if isinstance(refresh, str) and refresh:
        try:
            refreshed = refresh_kimi_access_token(refresh)
        except Exception as exc:
            last_error = exc
            refresh_failed = True
            refreshed = None
        if refreshed:
            tokens.append(refreshed)
            refresh_failed = False
    if isinstance(access, str) and access and access not in tokens:
        tokens.append(access)

    for token in tokens:
        try:
            payload = kimi_usage_request(token)
            limits = kimi_limits_from_usage_response(payload, source=KIMI_USAGE_URL)
            write_live_limits_cache("kimi", limits)
            return limits
        except urllib.error.HTTPError as exc:
            last_error = exc
            if exc.code in {401, 403}:
                continue
            break
        except Exception as exc:
            last_error = exc
            break

    stale = cached_live_limits("kimi", LIVE_LIMITS_MAX_AGE_SECONDS, allow_stale=True)
    if stale:
        return serve_stale_live_limits("kimi", stale, last_error or RuntimeError("Kimi usage API failed"))
    if last_error is None:
        return empty_limits(reason="token_expired" if expired else "token_missing")
    limits = live_limit_error(last_error, KIMI_USAGE_URL)
    if refresh_failed or (isinstance(last_error, urllib.error.HTTPError) and last_error.code in {401, 403}):
        limits["reason"] = "token_expired"
    write_live_limits_cache("kimi", limits)
    return limits


def prefer_live_limits(live: Dict[str, Any], fallback: Dict[str, Any]) -> Dict[str, Any]:
    if live.get("status") in {"auto", "ok"} and (
        live.get("quotas") or any(live.get(key) is not None for key in ("weeklyUsedPercent", "shortUsedPercent"))
    ):
        if fallback.get("sessionTokens") is not None and live.get("sessionTokens") is None:
            live = dict(live)
            live["sessionTokens"] = fallback.get("sessionTokens")
        return live
    if fallback.get("status") not in {None, "not_configured"}:
        if live.get("error"):
            fallback = dict(fallback)
            fallback["liveError"] = live.get("error")
        return fallback
    return live


def runtime_limits() -> Dict[str, Dict[str, Any]]:
    def _safe(fn: Any) -> Dict[str, Any]:
        # Per-provider isolation: one provider raising (e.g. a stat race on a deleted
        # session file, or a deleted cwd) must not freeze the whole snapshot — it
        # would be served with a fresh servedAt as if everything were current.
        try:
            return fn()
        except Exception as exc:
            return empty_limits(status="error", error=str(exc))

    codex_fallback = _safe(codex_runtime_limits)
    claude_fallback = _safe(claude_runtime_limits)
    gemini_limits = _safe(gemini_live_limits)
    return {
        "codex": prefer_live_limits(_safe(codex_live_limits), codex_fallback),
        "claude": prefer_live_limits(_safe(claude_live_limits), claude_fallback),
        "gemini": gemini_limits,
        # Antigravity probes its own Code Assist quota (26.28.0). Return it directly
        # like gemini — do NOT fall back to a copy of the gemini limits, which would
        # relabel Gemini's quota as Antigravity's (the exact #45 mirroring bug this
        # provider was split out to fix).
        "antigravity": _safe(antigravity_live_limits),
        "grok": _safe(grok_live_limits),
        "kimi": _safe(kimi_live_limits),
    }


def parse_timestamp(raw: Any) -> Optional[dt.datetime]:
    if raw is None:
        return None
    if isinstance(raw, (int, float)) and not isinstance(raw, bool):
        value = float(raw)
        if value > 10_000_000_000:
            value = value / 1000.0
        try:
            return dt.datetime.fromtimestamp(value, dt.timezone.utc)
        except Exception:
            return None
    if isinstance(raw, str):
        text = raw.strip()
        if text.isdigit():
            return parse_timestamp(int(text))
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        try:
            parsed = dt.datetime.fromisoformat(text)
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=dt.timezone.utc)
            return parsed.astimezone(dt.timezone.utc)
        except ValueError:
            return None
    return None


def empty_periods() -> Dict[str, int]:
    return {"today": 0, "week": 0, "month": 0, "all": 0}


def empty_provider_usage(status: str = "not_found", source: Optional[str] = None) -> Dict[str, Any]:
    return {
        "status": status,
        "source": source,
        "tokens": empty_periods(),
        "models": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        # Per-provider event-type breakdown (chat / tools / mcp / shell).
        # `status: not_available` means the provider's data source does
        # not expose the necessary information yet — the UI hides the
        # breakdown panel rather than rendering misleading zeros.
        "breakdown": empty_breakdown(),
        # Per-project rollup. Same status semantics as breakdown: when
        # `not_available`, the UI hides the per-project section.
        "projects": empty_projects(),
    }


def empty_projects() -> Dict[str, Any]:
    return {
        "status": "not_available",
        "items": [],
    }


def display_project_name(path: str) -> str:
    """Friendly leaf name for a project path.

    Strips trailing slashes and returns the last meaningful directory
    component. Falls back to the input when the path doesn't have a
    folder name (e.g. just `/`).
    """
    text = (path or "").rstrip("/\\")
    if not text:
        return ""
    leaf = Path(text).name
    return leaf or text


SHELL_TOOL_NAMES = {
    "bash",
    "shell",
    "exec",
    "execute_command",
    "run_terminal_cmd",
    "run_terminal_command",
    "shell_exec",
    "terminal",
    "run",
}


def classify_tool_name(name: str) -> str:
    """Classify a tool name as 'mcp', 'shell', or 'tool'.

    MCP tools use the `mcp__server__name` convention across Claude
    Code, Cursor, and most clients shipping the MCP spec. Shell tools
    are matched against a small known-name set rather than fuzzy
    substring so we don't accidentally bucket `bash_completion` or
    similar utility tool names.
    """
    if not name:
        return "tool"
    lower = name.lower()
    if lower.startswith("mcp__") or lower.startswith("mcp_") or lower.startswith("mcp:"):
        return "mcp"
    if lower in SHELL_TOOL_NAMES:
        return "shell"
    return "tool"


def empty_breakdown() -> Dict[str, Any]:
    return {
        "status": "not_available",
        "chat": 0,
        "tools": 0,
        "mcp": 0,
        "shell": 0,
    }


def update_breakdown(
    breakdown: Dict[str, Any],
    *,
    chat: int = 0,
    tools: Iterable[str] = (),
) -> None:
    """Bump per-category counts. Switching `status` to `ok` the moment
    any signal lands so the UI can render a real card."""
    if chat:
        breakdown["chat"] = int(breakdown.get("chat", 0)) + chat
        breakdown["status"] = "ok"
    for tool_name in tools:
        category = classify_tool_name(str(tool_name))
        breakdown["tools"] = int(breakdown.get("tools", 0)) + 1
        if category in ("mcp", "shell"):
            breakdown[category] = int(breakdown.get(category, 0)) + 1
        breakdown["status"] = "ok"


def add_to_periods(periods: Dict[str, int], amount: int, when: Optional[dt.datetime]) -> None:
    periods["all"] = periods.get("all", 0) + amount
    if when is None:
        return
    day = day_key_for_timestamp(when)
    if day is None:
        return
    dated = periods_from_daily_tokens({day: amount})
    for period in ("today", "week", "month"):
        periods[period] = periods.get(period, 0) + dated[period]


def day_key_for_timestamp(when: Optional[dt.datetime]) -> Optional[str]:
    if when is None:
        return None
    if when.tzinfo is None:
        when = when.replace(tzinfo=dt.timezone.utc)
    return when.astimezone().date().isoformat()


def hour_key_for_timestamp(when: Optional[dt.datetime]) -> Optional[str]:
    """Hour-resolution bucket key.

    Format ``YYYY-MM-DDTHH`` in the host's local timezone. Sortable as a
    string so the Mac app can render a heatmap straight from the map
    without re-parsing. Mirrors `day_key_for_timestamp` so the
    add-to-bucket plumbing is symmetric.
    """
    if when is None:
        return None
    if when.tzinfo is None:
        when = when.replace(tzinfo=dt.timezone.utc)
    local = when.astimezone()
    return f"{local.date().isoformat()}T{local.hour:02d}"


def add_to_daily(daily: Dict[str, int], amount: int, when: Optional[dt.datetime]) -> None:
    key = day_key_for_timestamp(when)
    if key is None:
        return
    daily[key] = daily.get(key, 0) + amount


def add_to_hourly(hourly: Dict[str, int], amount: int, when: Optional[dt.datetime]) -> None:
    key = hour_key_for_timestamp(when)
    if key is None:
        return
    hourly[key] = hourly.get(key, 0) + amount


def local_date_changed(start: Optional[dt.datetime], end: Optional[dt.datetime]) -> bool:
    if start is None or end is None:
        return False
    return start.astimezone().date() != end.astimezone().date()


def normalized_model_name(raw: Any) -> Optional[str]:
    if raw is None or isinstance(raw, bool):
        return None
    text = str(raw).strip()
    if not text or text.lower() in {"unknown", "null", "none"}:
        return None
    return text


TOKEN_TOTAL_PART_KEYS = {
    "inputTokens",
    "outputTokens",
    "cacheReadInputTokens",
    "cacheCreationInputTokens",
    "cachedInputTokens",
    "reasoningTokens",
    "thoughtTokens",
    "toolTokens",
}


def usage_token_total(metrics: Dict[str, int]) -> int:
    total = int(metrics.get("totalTokens") or 0)
    if total > 0:
        return total
    return sum(int(metrics.get(key) or 0) for key in TOKEN_TOTAL_PART_KEYS)


def add_usage_metrics(
    result: Dict[str, Any],
    model_raw: Any,
    metrics: Dict[str, int],
    when: Optional[dt.datetime],
) -> bool:
    total = usage_token_total(metrics)
    if total <= 0:
        return False

    tokens = result.setdefault("tokens", empty_periods())
    models = result.setdefault("models", {})
    daily = result.setdefault("dailyTokens", {})
    hourly = result.setdefault("hourlyTokens", {})
    model = normalized_model_name(model_raw) or "unknown"
    model_tokens = models.setdefault(model, {})

    for key, amount in metrics.items():
        if amount <= 0 or key == "totalTokens":
            continue
        tokens[key] = tokens.get(key, 0) + amount
        model_tokens[key] = model_tokens.get(key, 0) + amount

    tokens["totalTokens"] = tokens.get("totalTokens", 0) + total
    model_tokens["totalTokens"] = model_tokens.get("totalTokens", 0) + total
    add_to_periods(tokens, total, when)
    add_to_periods(model_tokens, total, when)
    add_to_daily(daily, total, when)
    add_to_hourly(hourly, total, when)
    return True


def nested_dict_value(value: Any, path: Iterable[str]) -> Optional[Any]:
    current = value
    for key in path:
        if not isinstance(current, dict):
            return None
        current = current.get(key)
    return current


def codex_model_from_rollout(raw_path: Any) -> Optional[str]:
    if not raw_path:
        return None
    path = Path(str(raw_path)).expanduser()
    if not path.is_absolute():
        path = HOME / path
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for index, line in enumerate(fh):
                if index >= 1000:
                    break
                try:
                    item = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(item, dict):
                    continue
                payload = item.get("payload")
                candidates = [
                    item.get("model"),
                    nested_dict_value(payload, ["model"]),
                    nested_dict_value(payload, ["collaboration_mode", "settings", "model"]),
                    nested_dict_value(payload, ["settings", "model"]),
                    nested_dict_value(payload, ["metadata", "model"]),
                    nested_dict_value(payload, ["session", "model"]),
                    nested_dict_value(payload, ["info", "model"]),
                ]
                for candidate in candidates:
                    model = normalized_model_name(candidate)
                    if model:
                        return model
    except OSError:
        return None
    return None


def read_text_limited(path: Path, max_bytes: int = LOCAL_PROVIDER_PARSE_BYTES) -> Optional[str]:
    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            if size > max_bytes:
                fh.seek(max(0, size - max_bytes))
                data = fh.read()
                newline = data.find(b"\n")
                if newline >= 0:
                    data = data[newline + 1 :]
            else:
                data = fh.read()
        return data.decode("utf-8", errors="replace")
    except OSError:
        return None


def iter_jsonl_file(path: Path) -> Iterable[Dict[str, Any]]:
    text = read_text_limited(path)
    if text is None:
        return
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(payload, dict):
            yield payload


def opencode_data_dir() -> Path:
    xdg = os.environ.get("XDG_DATA_HOME")
    base = Path(xdg).expanduser() if xdg else HOME / ".local" / "share"
    return base / "opencode"


def opencode_message_metrics(data: Dict[str, Any]) -> Dict[str, int]:
    tokens = data.get("tokens") if isinstance(data.get("tokens"), dict) else {}
    cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
    return {
        "inputTokens": nonnegative_int(tokens.get("input")) or 0,
        "outputTokens": nonnegative_int(tokens.get("output")) or 0,
        "reasoningTokens": nonnegative_int(tokens.get("reasoning")) or 0,
        "cacheReadInputTokens": nonnegative_int(cache.get("read")) or 0,
        "cacheCreationInputTokens": nonnegative_int(cache.get("write")) or 0,
    }


KIMI_LOG_RESPONSE_RE = re.compile(r"\bllm response\b.*\boutputTokens=(\d+)\b")
KIMI_LOG_MODEL_RE = re.compile(r"\bllm config\b.*\bmodel=([^\s]+)")
KIMI_LOG_MODEL_ALIAS_RE = re.compile(r"\bllm config\b.*\bmodelAlias=([^\s]+)")


def kimi_roots() -> List[Path]:
    roots: List[Path] = []
    for env_name in ("KIMI_CODE_DIR", "KIMI_DATA_DIR"):
        raw = os.environ.get(env_name)
        if not raw:
            continue
        for part in raw.split(","):
            text = part.strip()
            if text:
                roots.append(Path(text).expanduser())
    if not roots:
        roots = [HOME / ".kimi-code", HOME / ".kimi"]
    seen: Set[str] = set()
    unique: List[Path] = []
    for root in roots:
        key = str(root)
        if key not in seen:
            seen.add(key)
            unique.append(root)
    return unique


def kimi_code_log_files(root: Path) -> List[Path]:
    sessions = root / "sessions"
    try:
        return [
            path
            for path in sessions.glob("*/session_*/logs/kimi-code.log")
            if path.is_file()
        ]
    except OSError:
        return []


def kimi_wire_log_files(root: Path) -> List[Path]:
    sessions = root / "sessions"
    try:
        legacy = [path for path in sessions.glob("*/*/wire.jsonl") if path.is_file()]
        modern = [path for path in sessions.glob("*/*/agents/*/wire.jsonl") if path.is_file()]
    except OSError:
        return []
    modern_session_keys: Set[Tuple[str, str]] = set()
    out: List[Path] = []
    for path in modern:
        try:
            rel = path.relative_to(sessions)
        except ValueError:
            continue
        if len(rel.parts) == 5 and rel.parts[2] == "agents" and rel.name == "wire.jsonl":
            modern_session_keys.add((rel.parts[0], rel.parts[1]))
            out.append(path)
    for path in legacy:
        try:
            rel = path.relative_to(sessions)
        except ValueError:
            continue
        if (
            len(rel.parts) == 3
            and rel.name == "wire.jsonl"
            and (rel.parts[0], rel.parts[1]) not in modern_session_keys
        ):
            out.append(path)
    return sorted(out)


def kimi_wire_session_dir(path: Path) -> Path:
    try:
        sessions = next(parent for parent in path.parents if parent.name == "sessions")
        rel = path.relative_to(sessions)
    except (StopIteration, ValueError):
        return path.parent
    if len(rel.parts) == 5 and rel.parts[2] == "agents":
        return sessions / rel.parts[0] / rel.parts[1]
    return path.parent


def kimi_config_model(root: Path) -> str:
    try:
        payload = json.loads((root / "config.json").read_text(encoding="utf-8"))
    except Exception:
        return "kimi-for-coding"
    if isinstance(payload, dict):
        return normalized_model_name(payload.get("model")) or "kimi-for-coding"
    return "kimi-for-coding"


def parse_kimi_code_log(path: Path, result: Dict[str, Any]) -> int:
    text = read_text_limited(path)
    if text is None:
        return 0
    current_model = "kimi-code"
    events = 0
    for line in text.splitlines():
        model_match = KIMI_LOG_MODEL_ALIAS_RE.search(line) or KIMI_LOG_MODEL_RE.search(line)
        if model_match:
            current_model = normalized_model_name(model_match.group(1)) or current_model
            continue
        response_match = KIMI_LOG_RESPONSE_RE.search(line)
        if not response_match:
            continue
        output_tokens = nonnegative_int(response_match.group(1)) or 0
        if output_tokens <= 0:
            continue
        when = parse_timestamp(line.split(None, 1)[0] if line else None)
        if add_usage_metrics(result, current_model, {"outputTokens": output_tokens}, when):
            events += 1
            update_breakdown(result["breakdown"], chat=1)
    return events


def kimi_wire_metrics(event: Dict[str, Any]) -> Dict[str, int]:
    if event.get("type") == "usage.record" and event.get("usageScope") == "turn":
        usage = event.get("usage") if isinstance(event.get("usage"), dict) else {}
        return {
            "inputTokens": nonnegative_int(usage.get("inputOther")) or 0,
            "outputTokens": nonnegative_int(usage.get("output")) or 0,
            "cacheReadInputTokens": nonnegative_int(usage.get("inputCacheRead")) or 0,
            "cacheCreationInputTokens": nonnegative_int(usage.get("inputCacheCreation")) or 0,
        }
    message = event.get("message") if isinstance(event.get("message"), dict) else {}
    if message.get("type") == "metadata":
        return {}
    if message.get("type") != "StatusUpdate":
        return {}
    payload = message.get("payload") if isinstance(message.get("payload"), dict) else {}
    usage = payload.get("token_usage") if isinstance(payload.get("token_usage"), dict) else {}
    input_tokens = nonnegative_int(usage.get("input_other")) or 0
    output_tokens = nonnegative_int(usage.get("output")) or 0
    cache_read = nonnegative_int(usage.get("input_cache_read")) or 0
    cache_create = nonnegative_int(usage.get("input_cache_creation")) or 0
    total = nonnegative_int(usage.get("total")) or 0
    accounted = input_tokens + output_tokens + cache_read + cache_create
    metrics = {
        "inputTokens": input_tokens,
        "outputTokens": output_tokens,
        "cacheReadInputTokens": cache_read,
        "cacheCreationInputTokens": cache_create,
    }
    if total > accounted:
        metrics["reasoningTokens"] = total - accounted
    elif total > 0:
        metrics["totalTokens"] = total
    return metrics


def parse_kimi_wire_log(path: Path, result: Dict[str, Any], model: str) -> int:
    events = 0
    for event in iter_jsonl_file(path):
        metrics = kimi_wire_metrics(event)
        if not metrics:
            continue
        when = parse_timestamp(event.get("timestamp") if event.get("timestamp") is not None else event.get("time"))
        if add_usage_metrics(result, model, metrics, when):
            events += 1
            update_breakdown(result["breakdown"], chat=1)
    return events


def kimi_snapshot() -> Dict[str, Any]:
    roots = kimi_roots()
    result = empty_provider_usage(source=",".join(str(root) for root in roots))
    result["displayName"] = "Kimi Code"
    existing_roots = [root for root in roots if root.exists()]
    if not existing_roots:
        return result

    events = 0
    code_files: List[Path] = []
    wire_files: List[Path] = []
    for root in existing_roots:
        code_files.extend(kimi_code_log_files(root))
        wire_files.extend(kimi_wire_log_files(root))
    wire_session_dirs = {_resolved_path_key(kimi_wire_session_dir(path)) for path in wire_files}
    code_files = [
        path
        for path in code_files
        if _resolved_path_key(path.parent.parent) not in wire_session_dirs
    ]
    code_files = recent_files(code_files)
    wire_files = recent_files(wire_files)

    for path in code_files:
        events += parse_kimi_code_log(path, result)
    for path in wire_files:
        # The legacy Kimi wire format stores the configured model at the root.
        root = path
        for parent in path.parents:
            if parent.name == "sessions":
                root = parent.parent
                break
        events += parse_kimi_wire_log(path, result, kimi_config_model(root))

    result["status"] = "ok" if events > 0 else "no_token_events_yet"
    result["source"] = ",".join(str(path) for path in (code_files + wire_files)) or ",".join(str(root) for root in existing_roots)
    result["events"] = events
    result["sessions"] = len(
        {str(path.parent.parent) for path in code_files}
        | {str(kimi_wire_session_dir(path)) for path in wire_files}
    )
    result["sources"] = {
        "kimiCodeLogFiles": len(code_files),
        "wireLogFiles": len(wire_files),
        "parseMaxFiles": LOCAL_PROVIDER_MAX_FILES,
    }
    return result


def grok_roots() -> List[Path]:
    raw = os.environ.get("GROK_HOME") or os.environ.get("XAI_HOME")
    roots: List[Path] = []
    if raw:
        for part in raw.split(","):
            text = part.strip()
            if text:
                roots.append(Path(text).expanduser())
    return roots or [HOME / ".grok", HOME / ".xai"]


def grok_session_project_path(updates_path: Path) -> Optional[str]:
    """Project cwd is the URL-encoded session group folder, not file content."""
    try:
        group = updates_path.parent.parent.name
    except Exception:
        return None
    if not group or group.startswith("."):
        return None
    decoded = urllib.parse.unquote(group).strip()
    return decoded or None


def grok_usage_metrics(usage: Any) -> Dict[str, int]:
    if not isinstance(usage, dict):
        return {}
    metrics = {
        "inputTokens": nonnegative_int(usage.get("inputTokens") or usage.get("input_tokens")) or 0,
        "outputTokens": nonnegative_int(usage.get("outputTokens") or usage.get("output_tokens")) or 0,
        "cacheReadInputTokens": nonnegative_int(
            usage.get("cachedReadTokens") or usage.get("cacheReadInputTokens") or usage.get("cached_read_tokens")
        ) or 0,
        "cacheCreationInputTokens": nonnegative_int(
            usage.get("cacheCreationTokens") or usage.get("cacheCreationInputTokens") or usage.get("cache_creation_tokens")
        ) or 0,
        "reasoningTokens": nonnegative_int(usage.get("reasoningTokens") or usage.get("reasoning_tokens")) or 0,
    }
    raw_total = usage.get("totalTokens")
    if raw_total is None:
        raw_total = usage.get("total_tokens")
    total = nonnegative_int(raw_total)
    if total is None:
        # Grok reports cached-read and reasoning counters as informational
        # breakdowns. They are not additional billable/accounted tokens.
        total = metrics["inputTokens"] + metrics["outputTokens"]
    elif total == 0:
        # Preserve an explicit zero as authoritative too. Returning the
        # informational counters would let the generic fallback sum them.
        return {}
    metrics["totalTokens"] = total
    return {key: amount for key, amount in metrics.items() if amount > 0}


def grok_usage_model(usage: Dict[str, Any], fallback: Optional[str] = None) -> str:
    model_usage = usage.get("modelUsage") if isinstance(usage.get("modelUsage"), dict) else {}
    for name in model_usage.keys():
        model = normalized_model_name(name)
        if model:
            return model
    return normalized_model_name(fallback) or "grok"


def grok_update_payload(event: Dict[str, Any]) -> Dict[str, Any]:
    params = event.get("params") if isinstance(event.get("params"), dict) else {}
    update = params.get("update") if isinstance(params.get("update"), dict) else {}
    return update if isinstance(update, dict) else {}


def grok_event_timestamp(event: Dict[str, Any], update: Dict[str, Any]) -> Optional[dt.datetime]:
    params = event.get("params") if isinstance(event.get("params"), dict) else {}
    meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
    return parse_timestamp(
        meta.get("agentTimestampMs")
        or event.get("ts")
        or event.get("timestamp")
        or update.get("timestamp")
    )


def grok_prompt_id(event: Dict[str, Any], update: Dict[str, Any]) -> Optional[str]:
    params = event.get("params") if isinstance(event.get("params"), dict) else {}
    meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
    for candidate in (
        update.get("prompt_id"),
        update.get("promptId"),
        meta.get("promptId"),
        meta.get("prompt_id"),
        event.get("prompt_id"),
    ):
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip()
    return None


def grok_tool_name(update: Dict[str, Any]) -> Optional[str]:
    # Names only — titles/rawInput can carry prompt text and must not be read.
    meta = update.get("_meta") if isinstance(update.get("_meta"), dict) else {}
    namespaced = meta.get("x.ai/tool") if isinstance(meta.get("x.ai/tool"), dict) else {}
    for candidate in (
        namespaced.get("name"),
        meta.get("x.ai/tool.name"),
        update.get("name"),
        update.get("toolName"),
        update.get("tool_name"),
        nested_dict_value(update, ["toolCall", "name"]),
        nested_dict_value(update, ["tool_call", "name"]),
    ):
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip()
    return None


def grok_tool_call_id(update: Dict[str, Any]) -> Optional[str]:
    for candidate in (
        update.get("toolCallId"),
        update.get("tool_call_id"),
        nested_dict_value(update, ["toolCall", "toolCallId"]),
        nested_dict_value(update, ["tool_call", "id"]),
    ):
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip()
    return None


def parse_grok_updates(path: Path) -> Dict[str, Any]:
    """Read usage/tool metadata from one updates.jsonl. Ignores prompt text."""
    usage_by_prompt: Dict[str, Dict[str, Any]] = {}
    media_ids: Dict[str, Set[str]] = {"images": set(), "videos": set()}
    tool_names: List[str] = []
    fallback_index = 0
    for event in iter_jsonl_file(path):
        update = grok_update_payload(event)
        if not update:
            continue
        session_update = str(update.get("sessionUpdate") or update.get("session_update") or "")
        tool_name = grok_tool_name(update)
        if session_update == "tool_call" and tool_name:
            tool_names.append(tool_name)
            media_kind = GROK_MEDIA_TOOL_NAMES.get(tool_name)
            if media_kind:
                call_id = grok_tool_call_id(update) or f"{path}:{fallback_index}"
                media_ids[media_kind].add(call_id)
        usage = update.get("usage")
        metrics = grok_usage_metrics(usage)
        if metrics:
            prompt_id = grok_prompt_id(event, update) or f"{path}:{fallback_index}"
            fallback_index += 1
            previous = usage_by_prompt.get(prompt_id)
            if previous is None or usage_token_total(metrics) >= usage_token_total(previous["metrics"]):
                usage_by_prompt[prompt_id] = {
                    "metrics": metrics,
                    "when": grok_event_timestamp(event, update),
                    "model": grok_usage_model(usage if isinstance(usage, dict) else {}, None),
                }
    return {
        "usage": list(usage_by_prompt.values()),
        "images": len(media_ids["images"]),
        "videos": len(media_ids["videos"]),
        "tool_names": tool_names,
    }


def grok_snapshot() -> Dict[str, Any]:
    roots = grok_roots()
    result = empty_provider_usage(source=",".join(str(root) for root in roots))
    result["displayName"] = "Grok"
    existing_roots = [root for root in roots if root.exists()]
    if not existing_roots:
        return result

    hook_files: List[Path] = []
    update_files: List[Path] = []
    for root in existing_roots:
        hook = root / "hooks" / "orca-status.json"
        if hook.is_file():
            hook_files.append(hook)
        sessions_root = root / "sessions"
        if not sessions_root.is_dir():
            continue
        try:
            update_files.extend(path for path in sessions_root.glob("*/*/updates.jsonl") if path.is_file())
        except OSError:
            pass

    update_files = recent_files(update_files)
    events = 0
    images = 0
    videos = 0
    project_tokens: Dict[str, int] = {}
    project_last: Dict[str, dt.datetime] = {}
    for path in update_files:
        parsed = parse_grok_updates(path)
        images += int(parsed.get("images") or 0)
        videos += int(parsed.get("videos") or 0)
        project_path = grok_session_project_path(path)
        for item in parsed.get("usage") or []:
            metrics = item.get("metrics") if isinstance(item, dict) else None
            if not isinstance(metrics, dict):
                continue
            when = item.get("when") if isinstance(item.get("when"), dt.datetime) else None
            if add_usage_metrics(result, item.get("model"), metrics, when):
                events += 1
                update_breakdown(result["breakdown"], chat=1)
                total = usage_token_total(metrics)
                if project_path and total > 0:
                    project_tokens[project_path] = project_tokens.get(project_path, 0) + total
                    if when is not None:
                        current = project_last.get(project_path)
                        if current is None or when > current:
                            project_last[project_path] = when
        update_breakdown(result["breakdown"], tools=parsed.get("tool_names") or [])

    result["status"] = "ok" if events > 0 else "no_token_events_yet"
    result["source"] = ",".join(str(path) for path in (hook_files + update_files[:8])) or ",".join(
        str(root) for root in existing_roots
    )
    result["events"] = events
    result["sessions"] = len(update_files)
    result["media"] = {"status": "ok" if (images or videos) else "empty", "images": images, "videos": videos}
    result["sources"] = {
        "hookFiles": len(hook_files),
        "sessionUpdateFiles": len(update_files),
        "parseMaxFiles": LOCAL_PROVIDER_MAX_FILES,
    }
    if project_tokens:
        items = []
        for project_path, tokens in project_tokens.items():
            last_active = project_last.get(project_path)
            items.append({
                "id": project_path,
                "path": project_path,
                "name": display_project_name(project_path),
                "tokens": tokens,
                "lastActive": last_active.isoformat().replace("+00:00", "Z") if last_active else None,
            })
        items.sort(key=lambda entry: int(entry.get("tokens") or 0), reverse=True)
        result["projects"] = {"status": "ok", "items": items[:20]}
    if hook_files and events == 0:
        result["message"] = "Grok local hooks detected; no session token events yet"
    return result


def opencode_snapshot() -> Dict[str, Any]:
    data_dir = opencode_data_dir()
    result = empty_provider_usage(source=str(data_dir))
    if not data_dir.exists():
        return result

    db_paths = sorted(path for path in data_dir.glob("opencode*.db") if path.is_file())
    if not db_paths:
        return result

    result["status"] = "ok"
    result["source"] = ",".join(str(path) for path in db_paths)
    events = 0
    errors: List[str] = []
    project_tokens: Dict[str, int] = {}
    project_last: Dict[str, dt.datetime] = {}
    for db_path in db_paths:
        conn: Optional[sqlite3.Connection] = None
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            session_columns = {row[1] for row in conn.execute("pragma table_info(session)").fetchall()}
            # Session schemas across opencode releases have used `path`,
            # `cwd`, and `working_directory`. Try each — first hit wins.
            path_col: Optional[str] = None
            for candidate in ("path", "cwd", "working_directory"):
                if candidate in session_columns:
                    path_col = candidate
                    break
            select_path = f"session.{path_col}" if path_col else "''"
            rows = conn.execute(
                f"""
                select message.time_created, message.data, {select_path}
                from message
                left join session on session.id = message.session_id
                where (session.time_archived is null or session.id is null)
                  and (session.parent_id is null or session.id is null)
                order by message.time_created asc
                """
            ).fetchall()
        except Exception as exc:
            errors.append(f"{db_path.name}: {exc}")
            continue
        finally:
            if conn is not None:
                try:
                    conn.close()
                except Exception:
                    pass

        for created_raw, data_raw, project_raw in rows:
            try:
                data = json.loads(data_raw.decode("utf-8", errors="replace") if isinstance(data_raw, bytes) else str(data_raw))
            except Exception:
                continue
            if not isinstance(data, dict) or data.get("role") != "assistant":
                continue
            metrics = opencode_message_metrics(data)
            when = parse_timestamp(created_raw)
            if add_usage_metrics(result, data.get("modelID"), metrics, when):
                events += 1
            project_path = str(project_raw or "").strip()
            if project_path:
                total = usage_token_total(metrics)
                if total > 0:
                    project_tokens[project_path] = project_tokens.get(project_path, 0) + total
                if when is not None:
                    current = project_last.get(project_path)
                    if current is None or when > current:
                        project_last[project_path] = when
            # PR-C: feed event-type breakdown so the Tools/MCP/Shell
            # panels stop being placeholders for opencode users.
            tool_requests = data.get("toolRequests")
            tool_names: List[str] = []
            if isinstance(tool_requests, list):
                for tool in tool_requests:
                    if not isinstance(tool, dict):
                        continue
                    name = tool.get("toolName") or tool.get("name") or tool.get("tool")
                    if name:
                        tool_names.append(str(name))
            update_breakdown(result["breakdown"], chat=1, tools=tool_names)

    if events == 0 and errors:
        result["status"] = "error"
        result["error"] = "; ".join(errors[:3])
    elif errors:
        result["warnings"] = errors[:3]
    result["events"] = events
    if project_tokens:
        items = []
        for project_path, tokens in project_tokens.items():
            last_active = project_last.get(project_path)
            items.append({
                "id": project_path,
                "path": project_path,
                "name": display_project_name(project_path),
                "tokens": tokens,
                "lastActive": last_active.isoformat().replace("+00:00", "Z") if last_active else None,
            })
        items.sort(key=lambda entry: int(entry.get("tokens") or 0), reverse=True)
        result["projects"] = {"status": "ok", "items": items[:20]}
    return result


def copilot_workspace_storage_dirs() -> List[Path]:
    if IS_WINDOWS:
        return [
            HOME / "AppData" / "Roaming" / "Code" / "User" / "workspaceStorage",
            HOME / "AppData" / "Roaming" / "Code - Insiders" / "User" / "workspaceStorage",
        ]
    if sys.platform == "darwin":
        return [
            HOME / "Library" / "Application Support" / "Code" / "User" / "workspaceStorage",
            HOME / "Library" / "Application Support" / "Code - Insiders" / "User" / "workspaceStorage",
        ]
    return [
        HOME / ".config" / "Code" / "User" / "workspaceStorage",
        HOME / ".config" / "Code - Insiders" / "User" / "workspaceStorage",
        HOME / ".vscode-server" / "data" / "User" / "workspaceStorage",
    ]


def copilot_legacy_event_files() -> List[Path]:
    root = HOME / ".copilot" / "session-state"
    try:
        return [
            path / "events.jsonl"
            for path in root.iterdir()
            if path.is_dir() and (path / "events.jsonl").is_file()
        ]
    except OSError:
        return []


def copilot_vscode_transcript_files() -> List[Path]:
    out: List[Path] = []
    for workspace_root in copilot_workspace_storage_dirs():
        try:
            workspace_dirs = list(workspace_root.iterdir())
        except OSError:
            continue
        for workspace_dir in workspace_dirs:
            transcripts = workspace_dir / "GitHub.copilot-chat" / "transcripts"
            try:
                out.extend(path for path in transcripts.iterdir() if path.is_file() and path.suffix == ".jsonl")
            except OSError:
                continue
    return out


def recent_files(paths: List[Path], stat_cache: Optional[Dict[str, Any]] = None) -> List[Path]:
    def mtime(path: Path) -> float:
        stat_result = _stat_quiet(path, stat_cache)
        return stat_result.st_mtime if stat_result is not None else 0.0

    return sorted(paths, key=mtime, reverse=True)[: max(1, LOCAL_PROVIDER_MAX_FILES)]


def copilot_legacy_model(event: Dict[str, Any], current_model: Optional[str]) -> Optional[str]:
    data = event.get("data") if isinstance(event.get("data"), dict) else {}
    model = normalized_model_name(data.get("model"))
    if model:
        return model
    if event.get("type") == "session.model_change":
        return normalized_model_name(data.get("newModel")) or current_model
    return current_model


def parse_copilot_legacy_file(path: Path, result: Dict[str, Any]) -> int:
    current_model: Optional[str] = None
    events = 0
    try:
        file_when = dt.datetime.fromtimestamp(path.stat().st_mtime, dt.timezone.utc)
    except OSError:
        file_when = None
    for event in iter_jsonl_file(path):
        current_model = copilot_legacy_model(event, current_model)
        if event.get("type") != "assistant.message":
            continue
        data = event.get("data") if isinstance(event.get("data"), dict) else {}
        output_tokens = nonnegative_int(data.get("outputTokens")) or 0
        if output_tokens <= 0 or not current_model:
            continue
        metrics = {"outputTokens": output_tokens}
        if add_usage_metrics(result, current_model, metrics, parse_timestamp(event.get("timestamp")) or file_when):
            events += 1
    return events


def infer_copilot_transcript_model(events: List[Dict[str, Any]]) -> str:
    counts: Dict[str, int] = {}
    for event in events:
        data = event.get("data") if isinstance(event.get("data"), dict) else {}
        model = normalized_model_name(data.get("model"))
        if model:
            counts[model] = counts.get(model, 0) + 100
        if event.get("type") != "assistant.message":
            continue
        tool_requests = data.get("toolRequests")
        if not isinstance(tool_requests, list):
            continue
        for tool in tool_requests:
            if not isinstance(tool, dict):
                continue
            tool_call_id = str(tool.get("toolCallId") or "")
            if tool_call_id.startswith(("toolu_bdrk_", "toolu_vrtx_", "tooluse_", "toolu_")):
                counts["copilot-anthropic-auto"] = counts.get("copilot-anthropic-auto", 0) + 1
            elif tool_call_id.startswith("call_"):
                counts["copilot-openai-auto"] = counts.get("copilot-openai-auto", 0) + 1
    if counts:
        return sorted(counts.items(), key=lambda item: item[1], reverse=True)[0][0]
    return "copilot-auto"


def char_token_estimate(text: Any) -> int:
    if not isinstance(text, str) or not text:
        return 0
    # ASCII BPE tokenizes at ~4 chars/token; CJK and other multibyte scripts tokenize
    # far denser (~1.6 chars/token), so a flat len/4 undercounts CJK usage ~2-4x — a real
    # error for Copilot in CJK markets, where this estimator is the fallback (audit #12).
    ascii_count = sum(1 for ch in text if ord(ch) < 0x80)
    wide_count = len(text) - ascii_count
    return max(1, int(ascii_count / 4 + wide_count / 1.6))


def parse_copilot_transcript_file(path: Path, result: Dict[str, Any]) -> Tuple[int, int]:
    events = list(iter_jsonl_file(path))
    if not events:
        return 0, 0
    first = events[0]
    first_data = first.get("data") if isinstance(first.get("data"), dict) else {}
    if first.get("type") != "session.start" or first_data.get("producer") != "copilot-agent":
        return 0, 0

    model = infer_copilot_transcript_model(events)
    try:
        file_when = dt.datetime.fromtimestamp(path.stat().st_mtime, dt.timezone.utc)
    except OSError:
        file_when = None
    pending_input_tokens = 0
    parsed = 0
    estimated_tokens = 0
    for event in events:
        data = event.get("data") if isinstance(event.get("data"), dict) else {}
        if event.get("type") == "user.message":
            pending_input_tokens = char_token_estimate(data.get("content"))
            continue
        if event.get("type") != "assistant.message":
            continue
        explicit_output_tokens = nonnegative_int(data.get("outputTokens"))
        estimated_content_tokens = (
            char_token_estimate(data.get("content"))
            if explicit_output_tokens is None
            else 0
        )
        content_tokens = explicit_output_tokens if explicit_output_tokens is not None else estimated_content_tokens
        reasoning_tokens = char_token_estimate(data.get("reasoningText"))
        tool_requests = data.get("toolRequests")
        if (
            pending_input_tokens <= 0
            and content_tokens <= 0
            and reasoning_tokens <= 0
            and not isinstance(tool_requests, list)
        ):
            continue
        metrics = {
            "inputTokens": pending_input_tokens,
            "outputTokens": content_tokens,
            "reasoningTokens": reasoning_tokens,
        }
        if add_usage_metrics(result, model, metrics, parse_timestamp(event.get("timestamp")) or file_when):
            parsed += 1
            estimated_tokens += pending_input_tokens + estimated_content_tokens + reasoning_tokens
        # PR-C: copilot transcript carries the same toolRequests shape
        # opencode does — feed the breakdown counters.
        tool_names: List[str] = []
        if isinstance(tool_requests, list):
            for tool in tool_requests:
                if not isinstance(tool, dict):
                    continue
                name = tool.get("toolName") or tool.get("name") or tool.get("tool")
                if name:
                    tool_names.append(str(name))
        update_breakdown(result["breakdown"], chat=1, tools=tool_names)
        pending_input_tokens = 0
    return parsed, estimated_tokens


def copilot_workspace_folder(workspace_dir: Path) -> Optional[str]:
    """Resolve a VS Code workspaceStorage subdirectory to the on-disk
    folder it represents. Reads `workspace.json` which carries the
    `folder` URI; returns the local path or None if it can't decode."""
    try:
        payload = json.loads((workspace_dir / "workspace.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    folder = payload.get("folder") if isinstance(payload, dict) else None
    if not isinstance(folder, str):
        return None
    if folder.startswith("file://"):
        try:
            return urllib.parse.unquote(urllib.parse.urlparse(folder).path)
        except Exception:
            return None
    return folder


def copilot_workspace_folders() -> List[str]:
    folders: List[str] = []
    seen: set[str] = set()
    for workspace_root in copilot_workspace_storage_dirs():
        try:
            workspace_dirs = list(workspace_root.iterdir())
        except OSError:
            continue
        for workspace_dir in workspace_dirs:
            folder = copilot_workspace_folder(workspace_dir)
            if not folder or folder in seen:
                continue
            seen.add(folder)
            folders.append(folder)
    return folders


def copilot_project_for_path(path: Path) -> Optional[str]:
    """Map a copilot legacy events.jsonl or VS Code transcript file
    back to its project folder, or None if it can't be determined."""
    candidate = path
    for _ in range(6):
        parent = candidate.parent
        # `~/.copilot/session-state/<workspace_hash>/events.jsonl` — the
        # hash directory is the parent of events.jsonl.
        if candidate.name == "events.jsonl":
            return parent.name or None
        # VS Code transcripts live in workspaceStorage/<hash>/GitHub.copilot-chat/transcripts/<file>
        if parent.name == "transcripts" and parent.parent.name == "GitHub.copilot-chat":
            workspace_dir = parent.parent.parent
            folder = copilot_workspace_folder(workspace_dir)
            return folder or workspace_dir.name
        candidate = parent
        if candidate == candidate.parent:
            break
    return None


def copilot_snapshot() -> Dict[str, Any]:
    legacy_files = recent_files(copilot_legacy_event_files())
    transcript_files = recent_files(copilot_vscode_transcript_files())
    workspace_folders = copilot_workspace_folders()
    result = empty_provider_usage(source="~/.copilot/session-state, VS Code workspaceStorage")
    if not legacy_files and not transcript_files:
        if workspace_folders:
            result["status"] = "ok"
            result["events"] = 0
            result["projects"] = {
                "status": "ok",
                "items": [
                    {
                        "id": folder,
                        "path": folder,
                        "name": display_project_name(folder),
                        "tokens": 0,
                        "lastActive": None,
                    }
                    for folder in workspace_folders[:20]
                ],
            }
            result["sources"] = {
                "legacyFiles": 0,
                "transcriptFiles": 0,
                "workspaceFolders": len(workspace_folders),
                "parseMaxFiles": LOCAL_PROVIDER_MAX_FILES,
            }
        return result

    result["status"] = "ok"
    events = 0
    estimated_tokens = 0
    project_totals: Dict[str, int] = {}
    for path in legacy_files:
        before = int(result["tokens"].get("totalTokens") or 0)
        events += parse_copilot_legacy_file(path, result)
        after = int(result["tokens"].get("totalTokens") or 0)
        project = copilot_project_for_path(path)
        if project and after > before:
            project_totals[project] = project_totals.get(project, 0) + (after - before)
    for path in transcript_files:
        before = int(result["tokens"].get("totalTokens") or 0)
        parsed_events, parsed_estimated_tokens = parse_copilot_transcript_file(path, result)
        events += parsed_events
        estimated_tokens += parsed_estimated_tokens
        after = int(result["tokens"].get("totalTokens") or 0)
        project = copilot_project_for_path(path)
        if project and after > before:
            project_totals[project] = project_totals.get(project, 0) + (after - before)
    result["events"] = events
    total_tokens = int(result["tokens"].get("totalTokens") or 0)
    if estimated_tokens > 0 and total_tokens > 0:
        result["tokens"]["estimated"] = True
        result["tokens"]["estimatedShare"] = max(
            0.0, min(1.0, estimated_tokens / total_tokens)
        )
    if project_totals:
        items = [
            {
                "id": project,
                "path": project,
                "name": display_project_name(project),
                "tokens": tokens,
                "lastActive": None,
            }
            for project, tokens in project_totals.items()
        ]
        items.sort(key=lambda entry: int(entry.get("tokens") or 0), reverse=True)
        result["projects"] = {"status": "ok", "items": items[:20]}
    result["sources"] = {
        "legacyFiles": len(legacy_files),
        "transcriptFiles": len(transcript_files),
        "workspaceFolders": len(workspace_folders),
        "parseMaxFiles": LOCAL_PROVIDER_MAX_FILES,
    }
    if events == 0:
        result["status"] = "no_token_events_yet"
    return result


# ---------------------------------------------------------------------------
# Codex sessions-JSONL reader — per-class token accounting from rollout logs
#
# Competitors (ccusage / CodexBar / agentsview) read the Codex session logs
# under {CODEX_HOME or ~/.codex}/sessions/**/*.jsonl rather than the coarse
# single-total threads.tokens_used in state_*.sqlite. Each log is an append-only
# JSONL stream of typed entries; we care about:
#
#   - type == "turn_context"  -> payload.model  (the active model for the
#                                 following turn; we track the most recent one)
#   - type == "event_msg" with payload.type == "token_count"
#                             -> payload.info.last_token_usage carries the
#                                per-turn token breakdown:
#                                  input_tokens, cached_input_tokens,
#                                  output_tokens, reasoning_output_tokens
#
# Normalize like the competitors: cached_input_tokens is a subset of
# input_tokens, so uncached_input = input_tokens - cached_input_tokens (avoid
# double counting), and cached_input_tokens maps to cacheRead. reasoning tokens
# fold into output. Dedup is enforced by a per-file byte offset (we only ever
# parse lines past it), and a byte-offset + mtime cursor (mirroring the Claude
# jsonl-cursor pattern) skips unchanged files. The cursor also PERSISTS the
# accumulated rollups (per-class class totals, per-model class + daily totals,
# dailyTokens, hourlyTokens, projects) so each snapshot reflects the full
# running history while only parsing the newly-appended bytes — the period
# windows (today/week/month/all) are recomputed from the daily buckets at read
# time so they age correctly across calendar days.
# ---------------------------------------------------------------------------


# Raw per-class keys we persist for Codex turns. These map 1:1 to the
# connector token-class field names used everywhere else.
_CODEX_CLASS_KEYS = ("inputTokens", "outputTokens", "cacheReadInputTokens")


def codex_home() -> Path:
    """Resolve the Codex home dir, honoring $CODEX_HOME, else ~/.codex.

    Resolved dynamically (not a frozen module constant) so it tracks the
    module-level HOME the test harness swaps in, exactly like the other
    local-provider readers.
    """
    override = os.environ.get("CODEX_HOME")
    if override:
        return Path(override).expanduser()
    return HOME / ".codex"


def codex_session_roots() -> List[Path]:
    """CodexBar-compatible local session roots, across every tracked home.

    Codex keeps active logs under ``sessions`` and can move older logs to the
    sibling ``archived_sessions`` directory. Counting only ``sessions`` makes
    heavy users look like they used a tiny fraction of their real 30-day usage.

    With no adopted homes this is the same two directories under the same single
    home the connector has always read; adopted homes append their own pair.
    """
    roots: List[Path] = []
    for home in tracked_provider_homes("codex"):
        roots.append(home / "sessions")
        roots.append(home / "archived_sessions")
    return roots


def _codex_empty_raw_totals() -> Dict[str, int]:
    return {"input": 0, "cached": 0, "output": 0}


def _codex_usage_raw_totals(usage: Any) -> Optional[Dict[str, int]]:
    if not isinstance(usage, dict):
        return None
    input_tokens = nonnegative_int(usage.get("input_tokens")) or 0
    cached_raw = usage.get("cached_input_tokens")
    if cached_raw is None:
        cached_raw = usage.get("cache_read_input_tokens")
    cached_input = nonnegative_int(cached_raw) or 0
    # `reasoning_output_tokens` is a breakdown of `output_tokens`, not a
    # sibling of it: every token_count event Codex writes satisfies
    # total_tokens == input_tokens + output_tokens, with reasoning already
    # inside output. Adding it again inflated reported output by ~30%.
    output_tokens = nonnegative_int(usage.get("output_tokens")) or 0
    record = {
        "input": input_tokens,
        "cached": cached_input,
        "output": output_tokens,
    }
    if not any(record.values()):
        return None
    return record


def _codex_coerce_raw_totals(raw: Any) -> Optional[Dict[str, int]]:
    if not isinstance(raw, dict):
        return None
    record = {
        "input": nonnegative_int(raw.get("input")) or 0,
        "cached": nonnegative_int(raw.get("cached")) or 0,
        "output": nonnegative_int(raw.get("output")) or 0,
    }
    if not any(record.values()):
        return None
    return record


def _codex_add_raw_totals(lhs: Optional[Dict[str, int]], rhs: Dict[str, int]) -> Dict[str, int]:
    base = lhs or _codex_empty_raw_totals()
    return {
        "input": int(base.get("input") or 0) + int(rhs.get("input") or 0),
        "cached": int(base.get("cached") or 0) + int(rhs.get("cached") or 0),
        "output": int(base.get("output") or 0) + int(rhs.get("output") or 0),
    }


def _codex_total_delta(baseline: Optional[Dict[str, int]], current: Dict[str, int]) -> Dict[str, int]:
    base = baseline or _codex_empty_raw_totals()
    return {
        "input": max(0, int(current.get("input") or 0) - int(base.get("input") or 0)),
        "cached": max(0, int(current.get("cached") or 0) - int(base.get("cached") or 0)),
        "output": max(0, int(current.get("output") or 0) - int(base.get("output") or 0)),
    }


def _codex_divergent_total_delta(
    raw_baseline: Optional[Dict[str, int]],
    counted_baseline: Optional[Dict[str, int]],
    current: Dict[str, int],
) -> Dict[str, int]:
    raw = raw_baseline or _codex_empty_raw_totals()
    counted = counted_baseline or _codex_empty_raw_totals()

    def delta(raw_value: int, counted_value: int, current_value: int) -> int:
        if current_value >= raw_value:
            return max(0, current_value - raw_value)
        return max(0, current_value - counted_value)

    return {
        "input": delta(int(raw.get("input") or 0), int(counted.get("input") or 0), int(current.get("input") or 0)),
        "cached": delta(int(raw.get("cached") or 0), int(counted.get("cached") or 0), int(current.get("cached") or 0)),
        "output": delta(int(raw.get("output") or 0), int(counted.get("output") or 0), int(current.get("output") or 0)),
    }


def _codex_totals_equal(lhs: Optional[Dict[str, int]], rhs: Optional[Dict[str, int]]) -> bool:
    left = lhs or _codex_empty_raw_totals()
    right = rhs or _codex_empty_raw_totals()
    return (
        int(left.get("input") or 0) == int(right.get("input") or 0)
        and int(left.get("cached") or 0) == int(right.get("cached") or 0)
        and int(left.get("output") or 0) == int(right.get("output") or 0)
    )


def _codex_totals_at_least(lhs: Dict[str, int], rhs: Dict[str, int]) -> bool:
    return (
        int(lhs.get("input") or 0) >= int(rhs.get("input") or 0)
        and int(lhs.get("cached") or 0) >= int(rhs.get("cached") or 0)
        and int(lhs.get("output") or 0) >= int(rhs.get("output") or 0)
    )


def _codex_totals_at_most(lhs: Dict[str, int], rhs: Dict[str, int]) -> bool:
    return (
        int(lhs.get("input") or 0) <= int(rhs.get("input") or 0)
        and int(lhs.get("cached") or 0) <= int(rhs.get("cached") or 0)
        and int(lhs.get("output") or 0) <= int(rhs.get("output") or 0)
    )


def _codex_should_prefer_total_delta(
    raw_baseline: Optional[Dict[str, int]],
    current_total: Dict[str, int],
    total_delta: Dict[str, int],
    last_delta: Dict[str, int],
    saw_divergent_totals: bool,
) -> bool:
    if saw_divergent_totals or raw_baseline is None:
        return False
    return _codex_totals_at_least(current_total, raw_baseline) and _codex_totals_at_most(total_delta, last_delta)


def _codex_raw_delta_to_class_amounts(raw_delta: Optional[Dict[str, int]]) -> Optional[Dict[str, int]]:
    if not isinstance(raw_delta, dict):
        return None
    input_tokens = int(raw_delta.get("input") or 0)
    cached_input = int(raw_delta.get("cached") or 0)
    output_tokens = int(raw_delta.get("output") or 0)
    uncached_input = input_tokens - cached_input
    if uncached_input < 0:
        uncached_input = 0
    record = {
        "inputTokens": uncached_input,
        "outputTokens": output_tokens,
        "cacheReadInputTokens": cached_input,
    }
    if not any(record.values()):
        return None
    return record


def codex_session_token_class_amounts(info: Dict[str, Any]) -> Optional[Dict[str, int]]:
    """Extract a per-class token record from a token_count payload.info.

    Reads payload.info.last_token_usage (the per-turn delta competitors use)
    and normalizes to the connector's token-class keys. Returns None when no
    usable token fields are present so empty/heartbeat events are ignored.
    """
    return _codex_raw_delta_to_class_amounts(_codex_usage_raw_totals(info.get("last_token_usage")))


def codex_session_token_raw_delta(
    info: Dict[str, Any],
    counted_baseline: Optional[Dict[str, int]],
    raw_baseline: Optional[Dict[str, int]],
    saw_divergent_totals: bool,
) -> Tuple[Optional[Dict[str, int]], Optional[Dict[str, int]], Optional[Dict[str, int]], bool]:
    """Return the token delta for one Codex token_count event.

    Newer Codex builds can emit cumulative ``total_token_usage`` without a
    trustworthy per-turn ``last_token_usage``. This mirrors CodexBar's scanner:
    prefer last-delta when present, but use total-delta when the cumulative
    stream shows a smaller non-divergent increment; when only total exists,
    derive the delta from the previous raw total baseline.
    """
    last_delta = _codex_usage_raw_totals(info.get("last_token_usage"))
    current_total = _codex_usage_raw_totals(info.get("total_token_usage"))
    delta: Optional[Dict[str, int]] = None
    next_counted = counted_baseline
    next_raw = raw_baseline
    next_saw_divergent = bool(saw_divergent_totals)

    if last_delta is not None:
        delta = last_delta
        if current_total is not None:
            total_delta = _codex_total_delta(raw_baseline, current_total)
            if _codex_should_prefer_total_delta(
                raw_baseline,
                current_total,
                total_delta,
                last_delta,
                next_saw_divergent,
            ):
                delta = total_delta
            next_counted = _codex_add_raw_totals(counted_baseline, delta)
            next_raw = current_total
            if not _codex_totals_equal(next_raw, next_counted):
                next_saw_divergent = True
        else:
            next_counted = _codex_add_raw_totals(counted_baseline, delta)
            next_raw = next_counted
    elif current_total is not None:
        delta = (
            _codex_divergent_total_delta(raw_baseline, counted_baseline, current_total)
            if next_saw_divergent
            else _codex_total_delta(raw_baseline, current_total)
        )
        next_counted = _codex_add_raw_totals(counted_baseline, delta)
        next_raw = current_total
        if not _codex_totals_equal(next_raw, next_counted):
            next_saw_divergent = True

    if delta is not None and not any(delta.values()):
        delta = None
    return delta, next_counted, next_raw, next_saw_divergent


def codex_session_files() -> List[Path]:
    homes = tracked_provider_homes("codex")
    roots = [root for root in codex_session_roots() if root.is_dir()]
    if not roots:
        return []
    files: List[Path] = []
    seen: Set[str] = set()
    for root in roots:
        try:
            candidates = [p for p in root.glob("**/*.jsonl") if p.is_file()]
        except OSError:
            continue
        for path in candidates:
            key = str(path)
            if key in seen:
                continue
            seen.add(key)
            files.append(path)
    # Collapse files reachable through more than one root before anything counts
    # them. A mirrored home hardlinks its sessions, so the same inode arrives
    # under two paths and plain string keys would count both. Session-identity
    # matching only turns on with multiple homes — see dedupe_usage_paths.
    stat_cache: Dict[str, Any] = {}
    files = dedupe_usage_paths(files, stat_cache, match_session_identity=len(homes) > 1)
    # Heavy Codex users can exceed the scan cap. Prefer the newest rollouts so
    # today/week windows do not get stranded on old history, then parse the
    # selected files in path order for deterministic cursor updates.
    files = recent_files(files, stat_cache)
    files.sort(key=lambda p: str(p))
    return files


def _empty_codex_cursor() -> Dict[str, Any]:
    return {
        "version": CODEX_SESSIONS_CURSOR_VERSION,
        "files": {},
        # Accumulated rollups, persisted across snapshots.
        "daily": {},          # dateStr -> total tokens
        "hourly": {},         # hourStr -> total tokens
        "modelDaily": {},     # model -> {dateStr -> total tokens}
        "modelClasses": {},   # model -> {classKey -> tokens}
        "projects": {},       # cwd -> {tokens, last_active}
        "turns": 0,
    }


def _coerce_int_map(raw: Any) -> Dict[str, int]:
    if not isinstance(raw, dict):
        return {}
    out: Dict[str, int] = {}
    for k, v in raw.items():
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            out[str(k)] = int(v)
    return out


def load_codex_sessions_cursor() -> Dict[str, Any]:
    raw = read_json(CODEX_SESSIONS_CURSOR_FILE)
    if not isinstance(raw, dict) or raw.get("version") != CODEX_SESSIONS_CURSOR_VERSION:
        return _empty_codex_cursor()
    cursor = _empty_codex_cursor()
    files = raw.get("files")
    if isinstance(files, dict):
        for path_str, meta in files.items():
            if not isinstance(meta, dict):
                continue
            cursor["files"][str(path_str)] = {
                "offset": int(meta.get("offset") or 0),
                "mtime": float(meta.get("mtime") or 0.0),
                "size": int(meta.get("size") or 0),
                "turns": int(meta.get("turns") or 0),
                "lastModel": (str(meta["lastModel"]) if isinstance(meta.get("lastModel"), str) else None),
                "countedRawTotals": _codex_coerce_raw_totals(meta.get("countedRawTotals")),
                "rawTotalsBaseline": _codex_coerce_raw_totals(meta.get("rawTotalsBaseline")),
                "sawDivergentTotals": bool(meta.get("sawDivergentTotals")),
            }
    cursor["daily"] = _coerce_int_map(raw.get("daily"))
    cursor["hourly"] = _coerce_int_map(raw.get("hourly"))
    model_daily = raw.get("modelDaily")
    if isinstance(model_daily, dict):
        cursor["modelDaily"] = {
            str(model): _coerce_int_map(buckets) for model, buckets in model_daily.items()
        }
    model_classes = raw.get("modelClasses")
    if isinstance(model_classes, dict):
        cursor["modelClasses"] = {
            str(model): _coerce_int_map(classes) for model, classes in model_classes.items()
        }
    projects = raw.get("projects")
    if isinstance(projects, dict):
        clean_projects: Dict[str, Any] = {}
        for cwd, payload in projects.items():
            if not isinstance(payload, dict):
                continue
            clean_projects[str(cwd)] = {
                "tokens": int(payload.get("tokens") or 0),
                "last_active": payload.get("last_active"),
                "models": _coerce_int_map(payload.get("models")),
            }
        cursor["projects"] = clean_projects
    cursor["turns"] = int(raw.get("turns") or 0)
    return cursor


def save_codex_sessions_cursor(cursor: Dict[str, Any]) -> bool:
    tmp = unique_atomic_tmp_path(CODEX_SESSIONS_CURSOR_FILE)
    try:
        AGENTCAT_HOME.mkdir(parents=True, exist_ok=True)
        with tmp.open("w", encoding="utf-8") as fh:
            json.dump(cursor, fh, ensure_ascii=False, separators=(",", ":"))
            fh.write("\n")
        tmp.replace(CODEX_SESSIONS_CURSOR_FILE)
        return True
    except Exception as exc:
        logging.debug("save_codex_sessions_cursor failed: %s", exc)
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass
        return False


def codex_sessions_snapshot(force_rebuild: bool = False) -> Dict[str, Any]:
    """Per-class Codex token snapshot read from sessions/**/*.jsonl.

    Returns the SAME shape codex_snapshot produces (status/source/tokens/
    models/dailyTokens/hourlyTokens/breakdown/projects), or status ==
    'not_found' when no session files exist so the caller can fall back to
    the state.sqlite path.
    """
    result: Dict[str, Any] = {
        "status": "not_found",
        "source": None,
        "tokens": empty_periods(),
        "models": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        "breakdown": empty_breakdown(),
        "projects": empty_projects(),
    }
    files = codex_session_files()
    if not files:
        return result

    roots = [root for root in codex_session_roots() if root.is_dir()]
    result["source"] = " + ".join(f"{root}/**/*.jsonl" for root in roots)

    cursor = _empty_codex_cursor() if force_rebuild else load_codex_sessions_cursor()
    file_cursors: Dict[str, Any] = cursor["files"]
    daily: Dict[str, int] = cursor["daily"]
    hourly: Dict[str, int] = cursor["hourly"]
    model_daily: Dict[str, Dict[str, int]] = cursor["modelDaily"]
    model_classes: Dict[str, Dict[str, int]] = cursor["modelClasses"]
    projects: Dict[str, Any] = cursor["projects"]

    new_turns = 0
    # Persist the multi-MB cursor only when a file actually advanced; the
    # unconditional 60s re-serialization was a steady daemon CPU cost.
    changed = bool(force_rebuild)

    for path in files:
        path_str = str(path)
        try:
            stat = path.stat()
        except OSError:
            continue
        size = int(stat.st_size)
        mtime = float(stat.st_mtime)
        meta = file_cursors.get(path_str) or {}
        prev_offset = int(meta.get("offset") or 0)
        prev_mtime = float(meta.get("mtime") or 0.0)
        prev_size = int(meta.get("size") or 0)
        turn_index = int(meta.get("turns") or 0)
        # Unchanged file (same size + mtime): nothing new to parse. The byte
        # offset alone guarantees dedup; mtime+size is the cheap skip gate.
        if prev_offset >= size and prev_mtime == mtime and prev_size == size:
            continue
        # Truncated/rotated file: re-read from the start. The byte offset is
        # the dedup boundary, so resetting it re-counts the whole (new) file.
        if prev_offset > size:
            prev_offset = 0
            turn_index = 0

        new_offset = prev_offset
        # Carry the last model seen in this file across incremental reads — the
        # turn_context that set it may live before prev_offset. NOT gated on
        # turn_index: a fresh `codex exec` session is usually first scanned
        # after its turn_context but before its first token_count, so the
        # model must survive a zero-turn scan or every later turn lands in
        # "unknown" (2026-09-05: 58% of a day's Codex tokens).
        prev_model = meta.get("lastModel")
        current_model: Optional[str] = prev_model if isinstance(prev_model, str) else None
        counted_raw_totals = _codex_coerce_raw_totals(meta.get("countedRawTotals")) if turn_index else None
        raw_totals_baseline = _codex_coerce_raw_totals(meta.get("rawTotalsBaseline")) if turn_index else None
        saw_divergent_totals = bool(meta.get("sawDivergentTotals")) if turn_index else False
        try:
            with path.open("rb") as fh:
                fh.seek(prev_offset)
                for raw_line in fh:
                    if not raw_line.endswith(b"\n"):
                        # Incomplete trailing line: the writer is mid-append. Do NOT
                        # advance the cursor past it — committing this offset would
                        # permanently skip the turn once the writer finishes it (codex
                        # has no daily rebuild to recover, unlike claude — audit #8).
                        break
                    new_offset += len(raw_line)
                    line = raw_line.decode("utf-8", errors="replace").strip()
                    if not line:
                        continue
                    try:
                        obj = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if not isinstance(obj, dict):
                        continue
                    entry_type = obj.get("type")
                    payload = obj.get("payload")
                    if not isinstance(payload, dict):
                        continue
                    if entry_type == "turn_context":
                        model = normalized_model_name(payload.get("model"))
                        if model:
                            current_model = model
                        continue
                    if entry_type != "event_msg" or payload.get("type") != "token_count":
                        continue
                    info = payload.get("info")
                    if not isinstance(info, dict):
                        continue
                    raw_delta, counted_raw_totals, raw_totals_baseline, saw_divergent_totals = codex_session_token_raw_delta(
                        info,
                        counted_raw_totals,
                        raw_totals_baseline,
                        saw_divergent_totals,
                    )
                    amounts = _codex_raw_delta_to_class_amounts(raw_delta)
                    if amounts is None:
                        continue
                    # Dedup is enforced by the byte offset: we only ever read
                    # lines past prev_offset, so a token_count turn is counted
                    # exactly once across re-reads of a growing file. turn_index
                    # stays monotonic for diagnostics in the cursor.
                    turn_index += 1
                    new_turns += 1
                    when = parse_timestamp(obj.get("timestamp"))
                    model = current_model or normalized_model_name(info.get("model")) or "unknown"
                    total = sum(amounts.values())

                    # Accumulate the persistent rollups (cursor state). Period
                    # windows are recomputed from daily buckets after the scan.
                    model_cls = model_classes.setdefault(model, {})
                    for cls_key in _CODEX_CLASS_KEYS:
                        amt = int(amounts.get(cls_key) or 0)
                        if amt:
                            model_cls[cls_key] = model_cls.get(cls_key, 0) + amt
                    if total > 0:
                        day_key = day_key_for_timestamp(when)
                        hour_key = hour_key_for_timestamp(when)
                        if day_key is not None:
                            daily[day_key] = daily.get(day_key, 0) + total
                            md = model_daily.setdefault(model, {})
                            md[day_key] = md.get(day_key, 0) + total
                        if hour_key is not None:
                            hourly[hour_key] = hourly.get(hour_key, 0) + total
                        cwd = str(payload.get("cwd") or obj.get("cwd") or "").strip()
                        if cwd:
                            proj = projects.setdefault(cwd, {"tokens": 0, "last_active": None})
                            proj["tokens"] = int(proj.get("tokens") or 0) + total
                            project_models = proj.setdefault("models", {})
                            project_models[model] = int(project_models.get(model) or 0) + total
                            if when is not None:
                                last_dt = parse_timestamp(proj.get("last_active"))
                                if last_dt is None or when > last_dt:
                                    proj["last_active"] = when.isoformat().replace("+00:00", "Z")
        except OSError as exc:
            logging.warning("codex_sessions_snapshot: cannot read %s: %s", path_str, exc)
            continue

        changed = True
        file_cursors[path_str] = {
            "offset": new_offset,
            "mtime": mtime,
            "size": size,
            "turns": turn_index,
            "lastModel": current_model,
            "countedRawTotals": counted_raw_totals,
            "rawTotalsBaseline": raw_totals_baseline,
            "sawDivergentTotals": saw_divergent_totals,
        }

    cursor["turns"] = int(cursor.get("turns") or 0) + new_turns
    if changed and (force_rebuild or not cursor_recently_saved(CODEX_SESSIONS_CURSOR_FILE)):
        saved = save_codex_sessions_cursor(cursor)
        if not saved:
            logging.debug("codex_sessions_snapshot: cursor save failed")

    return _build_codex_sessions_snapshot(result, cursor)


def _build_codex_sessions_snapshot(result: Dict[str, Any], cursor: Dict[str, Any]) -> Dict[str, Any]:
    daily: Dict[str, int] = cursor.get("daily") or {}
    hourly: Dict[str, int] = cursor.get("hourly") or {}
    model_daily: Dict[str, Dict[str, int]] = cursor.get("modelDaily") or {}
    model_classes: Dict[str, Dict[str, int]] = cursor.get("modelClasses") or {}
    projects: Dict[str, Any] = cursor.get("projects") or {}
    total_turns = int(cursor.get("turns") or 0)

    periods = periods_from_daily_tokens(daily)
    if periods["all"] <= 0:
        # Session files exist but carried no usable token_count turns yet.
        result["status"] = "no_token_events_yet"
        return result

    tokens = dict(periods)
    tokens["totalTokens"] = periods["all"]
    # Sum per-class totals across models for the top-level token classes.
    class_totals: Dict[str, int] = {}
    for classes in model_classes.values():
        for cls_key, amt in classes.items():
            if amt:
                class_totals[cls_key] = class_totals.get(cls_key, 0) + int(amt)
    tokens.update(class_totals)
    result["tokens"] = tokens

    # Per-model rollup: class totals + period windows from per-model daily.
    models: Dict[str, Dict[str, int]] = {}
    for model, classes in model_classes.items():
        entry: Dict[str, int] = {k: int(v) for k, v in classes.items() if v}
        model_periods = periods_from_daily_tokens(model_daily.get(model) or {})
        entry.update(model_periods)
        entry["totalTokens"] = model_periods["all"]
        models[model] = entry
    result["models"] = models

    result["dailyTokens"] = {k: v for k, v in daily.items() if v > 0}
    result["hourlyTokens"] = {k: v for k, v in hourly.items() if v > 0}

    items = []
    for cwd, payload in projects.items():
        tok = int(payload.get("tokens") or 0)
        if tok <= 0:
            continue
        item = {
            "id": cwd,
            "path": cwd,
            "name": display_project_name(cwd),
            "tokens": tok,
            "lastActive": payload.get("last_active"),
        }
        project_models = _coerce_int_map(payload.get("models"))
        if project_models:
            item["models"] = project_models
        items.append(item)
    items.sort(key=lambda entry: int(entry.get("tokens") or 0), reverse=True)
    if items:
        result["projects"] = {"status": "ok", "items": items[:20]}

    if total_turns:
        result["breakdown"]["chat"] = total_turns
        result["breakdown"]["status"] = "ok"

    result["status"] = "ok"
    result["turns"] = total_turns
    return result


def codex_state_sqlite_paths() -> List[Path]:
    roots = [codex_home(), codex_home() / "sqlite"]
    paths: List[Path] = []
    seen: set = set()
    for root in roots:
        try:
            candidates = root.glob("state_*.sqlite")
            for path in candidates:
                if not path.is_file():
                    continue
                key = str(path)
                try:
                    key = str(path.resolve())
                except OSError:
                    pass
                if key in seen:
                    continue
                seen.add(key)
                paths.append(path)
        except OSError:
            continue

    def sort_key(path: Path) -> Tuple[float, str]:
        try:
            return (path.stat().st_mtime, str(path))
        except OSError:
            return (0.0, str(path))

    return sorted(paths, key=sort_key)


def codex_sqlite_snapshot() -> Dict[str, Any]:
    paths = codex_state_sqlite_paths()
    result: Dict[str, Any] = {
        "status": "not_found",
        "source": None,
        "tokens": empty_periods(),
        "models": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        "breakdown": empty_breakdown(),
        "projects": empty_projects(),
    }
    if not paths:
        return result

    db_path = paths[-1]
    result["source"] = str(db_path)
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        columns = [row[1] for row in conn.execute("pragma table_info(threads)").fetchall()]
        if "tokens_used" not in columns:
            result["status"] = "unsupported_schema"
            result["columns"] = columns
            return result
        model_col = "model" if "model" in columns else "null"
        updated_col = "updated_at" if "updated_at" in columns else ("created_at" if "created_at" in columns else "null")
        rollout_col = "rollout_path" if "rollout_path" in columns else "null"
        cwd_col = "cwd" if "cwd" in columns else "null"
        rows = conn.execute(
            f"select tokens_used, {model_col}, {updated_col}, {rollout_col}, {cwd_col} from threads where tokens_used is not null"
        ).fetchall()
        if cwd_col == "null":
            # Codex schemas without cwd cannot attribute thread token totals to projects.
            result["projects"] = {"status": "not_available", "items": []}
    except Exception as exc:
        result["status"] = "error"
        result["error"] = str(exc)
        return result
    finally:
        try:
            conn.close()
        except Exception:
            pass

    models: Dict[str, Dict[str, int]] = {}
    project_tokens: Dict[str, int] = {}
    project_models: Dict[str, Dict[str, int]] = {}
    project_last: Dict[str, dt.datetime] = {}
    rollout_model_cache: Dict[str, Optional[str]] = {}
    for tokens_raw, model_raw, updated_raw, rollout_raw, cwd_raw in rows:
        try:
            tokens = int(tokens_raw or 0)
        except (TypeError, ValueError):
            continue
        if tokens <= 0:
            continue
        when = parse_timestamp(updated_raw)
        add_to_periods(result["tokens"], tokens, when)
        add_to_daily(result["dailyTokens"], tokens, when)
        add_to_hourly(result["hourlyTokens"], tokens, when)
        model = normalized_model_name(model_raw)
        if model is None and rollout_raw:
            rollout_key = str(rollout_raw)
            if rollout_key not in rollout_model_cache:
                rollout_model_cache[rollout_key] = codex_model_from_rollout(rollout_raw)
            model = rollout_model_cache[rollout_key]
        if model is None:
            model = "unknown"
        model_periods = models.setdefault(model, empty_periods())
        add_to_periods(model_periods, tokens, when)
        project_path = str(cwd_raw or "").strip()
        if project_path:
            project_tokens[project_path] = project_tokens.get(project_path, 0) + tokens
            mix = project_models.setdefault(project_path, {})
            mix[model] = mix.get(model, 0) + tokens
            if when is not None:
                current = project_last.get(project_path)
                if current is None or when > current:
                    project_last[project_path] = when

    result["status"] = "ok"
    result["threads"] = len(rows)
    result["models"] = models
    if "cwd" in columns:
        items = []
        for project_path, tokens in project_tokens.items():
            last_active = project_last.get(project_path)
            item = {
                "id": project_path,
                "path": project_path,
                "name": display_project_name(project_path),
                "tokens": tokens,
                "lastActive": last_active.isoformat().replace("+00:00", "Z") if last_active else None,
            }
            if project_models.get(project_path):
                item["models"] = dict(project_models[project_path])
            items.append(item)
        items.sort(key=lambda entry: int(entry.get("tokens") or 0), reverse=True)
        result["projects"] = {"status": "ok", "items": items[:20]}
    # Codex SQLite gives us per-thread token totals but not per-tool
    # call records, so the breakdown only reports chat (= thread count).
    # Tools/MCP/Shell stay zero with status='ok' so the UI knows the
    # provider opted in to breakdown even though tool-level granularity
    # is unavailable.
    if rows:
        result["breakdown"]["chat"] = len(rows)
        result["breakdown"]["status"] = "ok"
    return attach_codex_usage_breakdown(result)


def _codex_tokens_all(snapshot: Dict[str, Any]) -> int:
    tokens = snapshot.get("tokens") if isinstance(snapshot, dict) else None
    if not isinstance(tokens, dict):
        return 0
    return int(tokens.get("all") or tokens.get("totalTokens") or 0)


CODEXBAR_COST_CACHE_VERSIONS = {
    "codex": 8,
    "claude": 2,
}


def codexbar_cost_cache_path(provider: str) -> Path:
    version = CODEXBAR_COST_CACHE_VERSIONS.get(provider, 1)
    return HOME / "Library" / "Caches" / "CodexBar" / "cost-usage" / f"{provider}-v{version}.json"


def _codexbar_cost_cache_updated_at(raw: Dict[str, Any]) -> Optional[str]:
    last_scan = raw.get("lastScanUnixMs")
    if not isinstance(last_scan, (int, float)) or isinstance(last_scan, bool) or last_scan <= 0:
        return None
    try:
        return dt.datetime.fromtimestamp(float(last_scan) / 1000.0, dt.timezone.utc).isoformat().replace("+00:00", "Z")
    except (OSError, OverflowError, ValueError):
        return None


def _codexbar_packed_usage(value: Any) -> Optional[Dict[str, int]]:
    """Decode CodexBar cost-cache day/model rows.

    CodexBar's MIT local cost scanner stores rows as [input, cacheRead,
    output]. The connector consumes only these aggregate token counts.
    """
    if not isinstance(value, list) or len(value) < 3:
        return None
    inp = nonnegative_int(value[0]) or 0
    cache_read = nonnegative_int(value[1]) or 0
    out = nonnegative_int(value[2]) or 0
    total = inp + cache_read + out
    if total <= 0:
        return None
    return {
        "inputTokens": inp,
        "cacheReadInputTokens": cache_read,
        "outputTokens": out,
        "totalTokens": total,
    }


def codexbar_cost_cache_snapshot(provider: str) -> Dict[str, Any]:
    """Optional aggregate floor from CodexBar's local cost scanner cache."""
    path = codexbar_cost_cache_path(provider)
    result = empty_provider_usage(source=str(path))
    result["sourceKind"] = "codexbar_cost_cache"
    raw = read_json(path)
    if not isinstance(raw, dict):
        return result
    if raw.get("version") != 1:
        result["status"] = "unsupported_schema"
        result["cacheVersion"] = raw.get("version")
        return result
    days = raw.get("days")
    if not isinstance(days, dict):
        return result

    daily: Dict[str, int] = {}
    model_daily: Dict[str, Dict[str, int]] = {}
    model_classes: Dict[str, Dict[str, int]] = {}
    for day_raw, models in days.items():
        day = str(day_raw)
        try:
            dt.date.fromisoformat(day)
        except ValueError:
            continue
        if not isinstance(models, dict):
            continue
        for model_raw, packed in models.items():
            usage = _codexbar_packed_usage(packed)
            if usage is None:
                continue
            model = normalized_model_name(model_raw) or "unknown"
            total = int(usage["totalTokens"])
            daily[day] = daily.get(day, 0) + total
            model_days = model_daily.setdefault(model, {})
            model_days[day] = model_days.get(day, 0) + total
            classes = model_classes.setdefault(model, {})
            for key in ("inputTokens", "cacheReadInputTokens", "outputTokens", "totalTokens"):
                amount = int(usage.get(key) or 0)
                if amount:
                    classes[key] = classes.get(key, 0) + amount

    periods = periods_from_daily_tokens(daily)
    if periods["all"] <= 0:
        result["status"] = "no_token_events_yet"
        return result

    tokens = dict(periods)
    tokens["totalTokens"] = periods["all"]
    for classes in model_classes.values():
        for key in ("inputTokens", "cacheReadInputTokens", "outputTokens"):
            amount = int(classes.get(key) or 0)
            if amount:
                tokens[key] = tokens.get(key, 0) + amount

    models_out: Dict[str, Dict[str, int]] = {}
    for model, classes in model_classes.items():
        entry = {key: int(value) for key, value in classes.items() if int(value) > 0}
        model_periods = periods_from_daily_tokens(model_daily.get(model) or {})
        entry.update(model_periods)
        entry["totalTokens"] = model_periods["all"]
        models_out[model] = entry

    result.update({
        "status": "ok",
        "tokens": tokens,
        "models": models_out,
        "dailyTokens": {k: v for k, v in daily.items() if v > 0},
        "updatedAt": _codexbar_cost_cache_updated_at(raw),
        "cacheProducerKey": raw.get("producerKey"),
        "cacheDays": len(days),
    })
    return result


def merge_provider_with_usage_floor(
    primary: Dict[str, Any],
    floor: Dict[str, Any],
    *,
    strategy: str,
) -> Dict[str, Any]:
    if floor.get("status") != "ok":
        return primary
    primary_total = _codex_tokens_all(primary)
    floor_total = _codex_tokens_all(floor)
    if floor_total <= 0:
        return primary
    if primary.get("status") != "ok" or primary_total <= 0:
        replacement = copy.deepcopy(floor)
        replacement["reconciled"] = {
            "status": "ok",
            "strategy": strategy,
            "primaryStatus": primary.get("status"),
            "floorTokens": floor_total,
        }
        return replacement
    if floor_total <= primary_total:
        return primary

    merged = copy.deepcopy(primary)
    tokens = merged.setdefault("tokens", {})
    floor_tokens = floor.get("tokens") if isinstance(floor.get("tokens"), dict) else {}
    for key in ("today", "week", "month", "all", "totalTokens", *TOKEN_TOTAL_PART_KEYS):
        floor_value = int(floor_tokens.get(key) or 0)
        if floor_value > int(tokens.get(key) or 0):
            tokens[key] = floor_value

    daily = merged.setdefault("dailyTokens", {})
    floor_daily = floor.get("dailyTokens") if isinstance(floor.get("dailyTokens"), dict) else {}
    if isinstance(daily, dict):
        for day, amount in floor_daily.items():
            value = int(amount or 0)
            if value > int(daily.get(day) or 0):
                daily[str(day)] = value
        # Each source's period totals are internally consistent, but taking a
        # per-period maximum can disagree with the final per-day merge when
        # the sources cover different days.  The lifetime fields remain
        # floors; dated windows always come from the final dated buckets.
        merged_periods = periods_from_daily_tokens(int_map(daily))
        for period in ("today", "week", "month"):
            tokens[period] = merged_periods[period]

    models = merged.setdefault("models", {})
    floor_models = floor.get("models") if isinstance(floor.get("models"), dict) else {}
    if isinstance(models, dict):
        for model, payload in floor_models.items():
            if not isinstance(payload, dict):
                continue
            target = models.setdefault(str(model), {})
            if not isinstance(target, dict):
                continue
            for key, amount in payload.items():
                if isinstance(amount, (int, float)) and not isinstance(amount, bool):
                    value = int(amount)
                    if value > int(target.get(key) or 0):
                        target[key] = value

    source = str(merged.get("source") or "")
    floor_source = str(floor.get("source") or "")
    if floor_source and floor_source not in source:
        merged["source"] = f"{source} + {floor_source}" if source else floor_source
    merged["externalReconciled"] = {
        "status": "ok",
        "strategy": strategy,
        "primaryTokens": primary_total,
        "floorTokens": floor_total,
        "source": floor.get("source"),
        "sourceKind": floor.get("sourceKind"),
    }
    return merged


def attach_local_usage_coverage(provider: str, snapshot: Dict[str, Any], **extra: Any) -> Dict[str, Any]:
    """Attach source coverage diagnostics for QA without changing totals."""
    if not isinstance(snapshot, dict) or snapshot.get("status") == "disabled":
        return snapshot
    descriptors: Dict[str, Dict[str, Any]] = {
        "claude": {
            "includedSources": ["claude_projects_jsonl", "stats_cache", "claude_desktop_allowlist"],
            "privacy": "usage_fields_only",
            "note": "Reads Claude Code/Claude Desktop JSONL usage fields only: message.usage, model, timestamp, cwd. Prompts and transcripts are ignored.",
        },
        "gemini": {
            "includedSources": ["agentcat_otel_telemetry", "gemini_code_assist_quota"],
            "privacy": "token_metrics_only",
            "note": "Gemini local token usage requires the Agent Cat telemetry outfile toggle; quota uses local Gemini OAuth when available.",
        },
        "antigravity": {
            "includedSources": ["agentcat_antigravity_telemetry", "local_antigravity_probe"],
            "privacy": "token_metrics_only",
            "note": "Antigravity does not borrow Gemini CLI tokens; it needs its own telemetry/probe signal.",
        },
        "opencode": {
            "includedSources": ["opencode_sqlite_messages"],
            "privacy": "assistant_token_metadata",
            "note": "Reads OpenCode local SQLite assistant message token metadata and session project path.",
        },
        "copilot": {
            "includedSources": ["copilot_legacy_events", "vscode_copilot_transcripts"],
            "privacy": "token_metadata_or_estimate",
            "note": "Uses explicit Copilot output tokens when present and local transcript estimates when the transcript lacks token fields.",
        },
        "kimi": {
            "includedSources": ["kimi_code_logs", "kimi_wire_logs", "kimi_billing_quota"],
            "privacy": "usage_fields_only",
            "note": "Reads Kimi Code token/model/timestamp log fields only. Prompt history, titles, and transcript content are ignored. Quota/reset uses the local Kimi login when available.",
        },
        "grok": {
            "includedSources": ["grok_session_updates", "grok_billing_reset"],
            "privacy": "usage_fields_only",
            "note": "Reads Grok session usage/tool-name fields only. Prompts, chat history, and terminal logs are ignored. Billing is used for the monthly reset timestamp, not a remaining-credit count.",
        },
    }
    descriptor = descriptors.get(provider)
    if descriptor is None:
        return snapshot
    tokens = snapshot.get("tokens") if isinstance(snapshot.get("tokens"), dict) else {}
    total = int(tokens.get("totalTokens") or tokens.get("all") or 0)
    snapshot_status = str(snapshot.get("status") or "not_found")
    coverage_status = "local_usage_available" if total > 0 else (
        "no_token_events_yet" if snapshot_status == "ok" else snapshot_status
    )
    coverage = {
        "status": coverage_status,
        "includedSources": descriptor["includedSources"],
        "periodWindow": {
            "today": "local_calendar_day",
            "week": "trailing_7_calendar_days_including_today",
            "month": "trailing_30_calendar_days_including_today",
        },
        "privacy": descriptor["privacy"],
        "note": descriptor["note"],
        "tokens": {
            "all": total,
            "today": int(tokens.get("today") or 0),
            "week": int(tokens.get("week") or 0),
            "month": int(tokens.get("month") or 0),
        },
    }
    coverage.update({k: v for k, v in extra.items() if v is not None})
    snapshot["usageCoverage"] = coverage
    return snapshot


def _codex_token_period_summary(snapshot: Dict[str, Any]) -> Dict[str, int]:
    tokens = snapshot.get("tokens") if isinstance(snapshot, dict) else None
    if not isinstance(tokens, dict):
        return empty_periods()
    summary = empty_periods()
    for key in ("today", "week", "month", "all"):
        summary[key] = int(tokens.get(key) or 0)
    summary["totalTokens"] = int(tokens.get("totalTokens") or summary["all"])
    return summary


def attach_codex_usage_coverage(
    snapshot: Dict[str, Any],
    sessions: Dict[str, Any],
    sqlite: Dict[str, Any],
    codexbar_cache: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    tokens = snapshot.setdefault("tokens", empty_periods())
    daily_tokens = snapshot.get("dailyTokens") if isinstance(snapshot.get("dailyTokens"), dict) else {}
    dated_total = 0
    for day, raw_amount in daily_tokens.items():
        try:
            dt.date.fromisoformat(str(day))
            amount = int(raw_amount)
        except (TypeError, ValueError):
            continue
        if not isinstance(raw_amount, bool) and amount > 0:
            dated_total += amount
    tokens["undatedFloor"] = max(0, int(tokens.get("all") or 0) - dated_total)

    session_ok = sessions.get("status") == "ok"
    sqlite_ok = sqlite.get("status") == "ok"
    if session_ok and sqlite_ok and snapshot.get("reconciled"):
        status = "local_reconciled"
    elif session_ok and sqlite_ok:
        status = "local_combined"
    elif session_ok:
        status = "sessions_jsonl"
    elif sqlite_ok:
        status = "state_sqlite"
    else:
        status = str(snapshot.get("status") or "not_found")

    included_sources: List[str] = []
    if session_ok:
        included_sources.append("sessions_jsonl")
    if sqlite_ok:
        included_sources.append("state_sqlite")
    codexbar_ok = isinstance(codexbar_cache, dict) and codexbar_cache.get("status") == "ok"
    if codexbar_ok:
        included_sources.append("codexbar_cost_cache")
        if snapshot.get("externalReconciled"):
            status = "local_reconciled_with_codexbar_cache"

    snapshot["usageCoverage"] = {
        "status": status,
        "includedSources": included_sources,
        "periodWindow": {
            "today": "local_calendar_day",
            "week": "trailing_7_calendar_days_including_today",
            "month": "trailing_30_calendar_days_including_today",
        },
        "sessions": {
            "status": sessions.get("status"),
            "source": sessions.get("source"),
            "tokens": _codex_token_period_summary(sessions),
            "turns": int(sessions.get("turns") or 0),
        },
        "stateSqlite": {
            "status": sqlite.get("status"),
            "source": sqlite.get("source"),
            "tokens": _codex_token_period_summary(sqlite),
            "threads": int(sqlite.get("threads") or 0),
        },
        "desktopApp": {
            "usageImport": "metadata_only",
            "tokensIncluded": False,
            "note": "ChatGPT/Codex app profile files are detected for setup diagnostics only; local token totals come from ~/.codex sessions JSONL and state_*.sqlite.",
        },
        "accountUsage": {
            "status": "on_demand",
            "includedInSnapshot": False,
            "httpPath": "/v1/usage",
            "cli": "agentcat usage --json",
            "note": "Use this path to compare local usage with CodexBar/OAuth account usage without slowing the 60s local snapshot poll.",
        },
    }
    if isinstance(codexbar_cache, dict):
        codexbar_included = bool(
            snapshot.get("externalReconciled")
            or (
                isinstance(snapshot.get("reconciled"), dict)
                and snapshot["reconciled"].get("strategy") == "codexbar_cost_cache_floor"
            )
        )
        snapshot["usageCoverage"]["codexbarCostCache"] = {
            "status": codexbar_cache.get("status"),
            "source": codexbar_cache.get("source"),
            "tokens": _codex_token_period_summary(codexbar_cache),
            "updatedAt": codexbar_cache.get("updatedAt"),
            "includedAsFloor": codexbar_included,
        }
    return snapshot


def _codex_rebuild_state_file() -> Path:
    return AGENTCAT_HOME / "codex-rebuild-state.json"


def _codex_rebuild_key(sessions: Dict[str, Any], sqlite: Dict[str, Any]) -> List[int]:
    return [_codex_tokens_all(sessions), _codex_tokens_all(sqlite)]


def mark_codex_rebuild_ineffective(sessions: Dict[str, Any], sqlite: Dict[str, Any]) -> None:
    """Record that a full rebuild did not close the sessions/sqlite gap.

    The trigger below compares two numbers a rebuild cannot always reconcile: a
    user who deleted old rollout JSONLs still has lifetime totals in
    ``state_*.sqlite``, so the gap is permanent. Without this marker the daemon
    re-parsed the entire sessions corpus (up to 10k files) every 60s forever.
    """
    try:
        write_json_atomic(
            _codex_rebuild_state_file(), {"ineffectiveKey": _codex_rebuild_key(sessions, sqlite)}
        )
    except Exception as exc:
        logging.debug("could not persist codex rebuild marker: %s", exc)


def _codex_rebuild_marked_ineffective(sessions: Dict[str, Any], sqlite: Dict[str, Any]) -> bool:
    raw = read_json(_codex_rebuild_state_file())
    if not isinstance(raw, dict):
        return False
    stored = raw.get("ineffectiveKey")
    if not isinstance(stored, list):
        return False
    # Keyed on both totals: when either moves, the corpus changed and a rebuild
    # is worth attempting again.
    return [int(x) for x in stored if isinstance(x, (int, float))] == _codex_rebuild_key(
        sessions, sqlite
    )


def _codex_sessions_need_rebuild(sessions: Dict[str, Any], sqlite: Dict[str, Any]) -> bool:
    if sessions.get("status") != "ok" or sqlite.get("status") != "ok":
        return False
    session_all = _codex_tokens_all(sessions)
    sqlite_all = _codex_tokens_all(sqlite)
    if session_all <= 0 or sqlite_all < 10_000_000:
        return False
    if sqlite_all <= session_all * 5:
        return False
    return not _codex_rebuild_marked_ineffective(sessions, sqlite)


def _merge_int_maps_by_max(primary: Dict[str, Any], fallback: Dict[str, Any]) -> bool:
    changed = False
    for key, raw in fallback.items():
        try:
            amount = int(raw)
        except (TypeError, ValueError):
            continue
        if amount <= 0:
            continue
        current = int(primary.get(key) or 0)
        if amount > current:
            primary[key] = amount
            changed = True
    return changed


def merge_codex_sessions_with_sqlite(sessions: Dict[str, Any], sqlite: Dict[str, Any]) -> Dict[str, Any]:
    merged = copy.deepcopy(sessions)
    changed = False

    session_tokens = merged.setdefault("tokens", empty_periods())
    sqlite_tokens = sqlite.get("tokens") if isinstance(sqlite.get("tokens"), dict) else {}
    # Codex state.sqlite only exposes each thread's LIFETIME cumulative `tokens_used`,
    # booked to the single day of its `updated_at`. That is a valid all-time FLOOR, but
    # feeding it into today/week/month/daily/hourly/per-model mis-dates an entire
    # thread's history into one day and inflates the headline by orders of magnitude
    # (audit #1). Use sqlite only to floor `all` (and totalTokens); trust the accurate
    # per-message sessions-JSONL for every dated bucket. This also keeps
    # sum(dailyTokens) <= all (audit #9), since dated buckets now come from one source.
    sqlite_all = int(sqlite_tokens.get("all") or 0)
    if sqlite_all > int(session_tokens.get("all") or 0):
        session_tokens["all"] = sqlite_all
        changed = True
    if int(session_tokens.get("all") or 0) > int(session_tokens.get("totalTokens") or 0):
        session_tokens["totalTokens"] = int(session_tokens.get("all") or 0)
        changed = True

    # Preserve per-model ALL-TIME attribution from sqlite (a model only ever seen in a
    # thread total should still show in the breakdown), but floor ONLY its `all` — never
    # its dated buckets, for the same mis-dating reason as the headline above.
    models = merged.setdefault("models", {})
    sqlite_models = sqlite.get("models") if isinstance(sqlite.get("models"), dict) else {}
    if isinstance(models, dict) and isinstance(sqlite_models, dict):
        for model, raw_periods in sqlite_models.items():
            if not isinstance(raw_periods, dict):
                continue
            model_all = int(raw_periods.get("all") or 0)
            if model_all <= 0:
                continue
            target = models.setdefault(str(model), empty_periods())
            if not isinstance(target, dict):
                continue
            if model_all > int(target.get("all") or 0):
                target["all"] = model_all
                if model_all > int(target.get("totalTokens") or 0):
                    target["totalTokens"] = model_all
                changed = True

    sqlite_projects = sqlite.get("projects") if isinstance(sqlite.get("projects"), dict) else {}
    merged_projects = merged.get("projects") if isinstance(merged.get("projects"), dict) else {}
    if (
        sqlite_projects.get("status") == "ok"
        and sqlite_projects.get("items")
        and (merged_projects.get("status") != "ok" or not merged_projects.get("items"))
    ):
        merged["projects"] = copy.deepcopy(sqlite_projects)
        changed = True

    sqlite_breakdown = sqlite.get("breakdown") if isinstance(sqlite.get("breakdown"), dict) else {}
    merged_breakdown = merged.setdefault("breakdown", empty_breakdown())
    if isinstance(merged_breakdown, dict) and sqlite_breakdown.get("status") == "ok":
        chat = int(sqlite_breakdown.get("chat") or 0)
        if chat > int(merged_breakdown.get("chat") or 0):
            merged_breakdown["chat"] = chat
            merged_breakdown["status"] = "ok"
            changed = True

    if "codexUsageBreakdown" in sqlite and "codexUsageBreakdown" not in merged:
        merged["codexUsageBreakdown"] = copy.deepcopy(sqlite.get("codexUsageBreakdown"))

    if changed:
        merged["source"] = f"{sessions.get('source')} + {sqlite.get('source')}"
        merged["sources"] = {
            "sessions": sessions.get("source"),
            "stateSqlite": sqlite.get("source"),
        }
        merged["reconciled"] = {
            "status": "ok",
            "strategy": "sqlite_period_floor",
            "sessionTokens": _codex_tokens_all(sessions),
            "sqliteTokens": _codex_tokens_all(sqlite),
        }
        if sqlite.get("threads") is not None:
            merged["sqliteThreads"] = int(sqlite.get("threads") or 0)
    return merged


def codex_snapshot() -> Dict[str, Any]:
    # Prefer the per-class sessions-JSONL reader (the technique ccusage /
    # CodexBar / agentsview use), but reconcile it with Codex's state.sqlite
    # thread totals. In the field, partial/corrupt JSONL cursors can otherwise
    # strand users at a tiny recent subtotal while Codex CLI's own usage screen
    # still has the full local thread total.
    try:
        sessions = codex_sessions_snapshot()
    except Exception as exc:  # defensive: never let JSONL parsing break codex
        logging.debug("codex_sessions_snapshot failed: %s", exc)
        sessions = {"status": "not_found"}

    sqlite = codex_sqlite_snapshot()

    if _codex_sessions_need_rebuild(sessions, sqlite):
        before = sessions
        try:
            rebuilt = codex_sessions_snapshot(force_rebuild=True)
            if rebuilt.get("status") == "ok":
                sessions = rebuilt
        except Exception as exc:
            logging.debug("codex_sessions_snapshot rebuild failed: %s", exc)
        # If the expensive rebuild left the gap exactly as wide, repeating it
        # every tick cannot help — the missing tokens are in deleted rollouts.
        if _codex_tokens_all(sessions) <= _codex_tokens_all(before):
            mark_codex_rebuild_ineffective(sessions, sqlite)

    codexbar_cache = codexbar_cost_cache_snapshot("codex")
    if sessions.get("status") == "ok":
        if "codexUsageBreakdown" in sqlite:
            sessions["codexUsageBreakdown"] = copy.deepcopy(sqlite["codexUsageBreakdown"])
        else:
            attach_codex_usage_breakdown(sessions)
        if sqlite.get("status") == "ok":
            local = merge_codex_sessions_with_sqlite(sessions, sqlite)
            merged = merge_provider_with_usage_floor(
                local,
                codexbar_cache,
                strategy="codexbar_cost_cache_floor",
            )
            return attach_codex_usage_breakdown(
                attach_codex_usage_coverage(merged, sessions, sqlite, codexbar_cache)
            )
        merged = merge_provider_with_usage_floor(
            sessions,
            codexbar_cache,
            strategy="codexbar_cost_cache_floor",
        )
        return attach_codex_usage_breakdown(
            attach_codex_usage_coverage(merged, sessions, sqlite, codexbar_cache)
        )

    merged = merge_provider_with_usage_floor(
        sqlite,
        codexbar_cache,
        strategy="codexbar_cost_cache_floor",
    )
    return attach_codex_usage_breakdown(
        attach_codex_usage_coverage(merged, sessions, sqlite, codexbar_cache)
    )


# ---------------------------------------------------------------------------
# llm-usage-cli bridge — on-demand accurate per-class usage from OAuth APIs
# ---------------------------------------------------------------------------

def live_usage_provider_from_limits(limits: Dict[str, Any]) -> Dict[str, Any]:
    """Map a live-limits result to the app's on-demand LiveUsageProvider shape.

    OAuth/subscription providers expose quota (used/remaining/reset), not billing tokens
    or dollar cost — so tokens are zero and cost_usd is null (the app UI hides both and
    shows the quota). A failure carries its machine-readable reason (token_expired / …).
    """
    status = limits.get("status")
    provider: Dict[str, Any] = {
        "status": "ok" if status in ("ok", "auto") else (status or "error"),
        "source": "oauth-live",
        "model": None,
        "tokens": {"total": 0, "input": 0, "output": 0, "cache_read": 0, "cache_write": 0},
        "cost_usd": None,
        "updated_at": now_iso(),
    }
    if limits.get("reason"):
        provider["reason"] = limits["reason"]

    # Headline quota = the tightest window (highest used%), else the weekly/short summary.
    tightest: Optional[Dict[str, Any]] = None
    for quota in limits.get("quotas") or []:
        if not isinstance(quota, dict):
            continue
        used = quota.get("usedPercent")
        if isinstance(used, (int, float)) and (tightest is None or used > tightest.get("usedPercent", -1.0)):
            tightest = quota
    if tightest is not None:
        provider["quota"] = {
            "used_percent": tightest.get("usedPercent"),
            "remaining_percent": tightest.get("remainingPercent"),
            "reset_at": tightest.get("resetAt"),
            "reset_description": tightest.get("label"),
        }
    else:
        used = limits.get("weeklyUsedPercent")
        reset = limits.get("weeklyResetAt")
        if used is None:
            used = limits.get("shortUsedPercent")
            reset = limits.get("shortResetAt")
        if isinstance(used, (int, float)):
            provider["quota"] = {
                "used_percent": used,
                "remaining_percent": max(0.0, 100.0 - used),
                "reset_at": reset,
                "reset_description": None,
            }
    return provider


def fetch_llm_usage_fresh() -> Dict[str, Any]:
    """On-demand authoritative usage/quota for the OAuth providers.

    User-triggered via `agentcat usage` / GET /v1/usage — not continuous polling. Forces a
    fresh live-limits fetch (bypassing the cache) so a just-fixed login shows immediately
    instead of waiting out the error backoff. Never refreshes or writes a provider's token,
    so an expired token yields a reason (token_expired / …), not a silent blank.
    """
    providers = {
            "claude": live_usage_provider_from_limits(claude_live_limits(force=True)),
            "codex": live_usage_provider_from_limits(codex_live_limits(force=True)),
            "gemini": live_usage_provider_from_limits(gemini_live_limits(force=True)),
            "antigravity": live_usage_provider_from_limits(antigravity_live_limits(force=True)),
            "grok": live_usage_provider_from_limits(grok_live_limits(force=True)),
            "kimi": live_usage_provider_from_limits(kimi_live_limits(force=True)),
    }
    if read_provider_key("openai"):
        providers["openai"] = openai_usage_live()
    return {"generatedAt": now_iso(), "source": "on-demand-oauth", "providers": providers}


# ---------------------------------------------------------------------------
# JournalScanner — incremental per-class token reader for Claude JSONL logs
# ---------------------------------------------------------------------------

_JOURNAL_ALL_KEYS = (
    "all_input", "all_output", "all_cacheRead", "all_cacheWrite_1h", "all_cacheWrite_5m",
)


def _empty_journal_totals() -> Dict[str, int]:
    return {k: 0 for k in _JOURNAL_ALL_KEYS}


def _empty_journal_projects() -> Dict[str, Dict[str, Any]]:
    return {}


def _empty_journal_daily_tokens() -> Dict[str, int]:
    return {}


def _empty_journal_hourly_tokens() -> Dict[str, int]:
    return {}


def _empty_journal_models() -> Dict[str, Dict[str, Any]]:
    return {}


def load_journal_cursor() -> Dict[str, Any]:
    raw = read_json(JOURNAL_CURSOR_FILE)
    if not isinstance(raw, dict) or raw.get("version") != CLAUDE_JOURNAL_CURSOR_VERSION:
        needs_rebuild = isinstance(raw, dict)
        return {
            "version": CLAUDE_JOURNAL_CURSOR_VERSION,
            "offsets": {},
            "totals": _empty_journal_totals(),
            "projects": _empty_journal_projects(),
            "dailyTokens": _empty_journal_daily_tokens(),
            "hourlyTokens": _empty_journal_hourly_tokens(),
            "models": _empty_journal_models(),
            "usageRecords": {},
            "projects_needs_rebuild": False,
            "usage_needs_rebuild": needs_rebuild,
        }
    has_projects = isinstance(raw.get("projects"), dict)
    has_daily = isinstance(raw.get("dailyTokens"), dict)
    has_hourly = isinstance(raw.get("hourlyTokens"), dict)
    has_models = isinstance(raw.get("models"), dict)
    has_usage_records = isinstance(raw.get("usageRecords"), dict)
    offsets = raw.get("offsets") or {}
    raw_totals = raw.get("totals") or {}
    totals = {
        key: int(raw_totals.get(key) or 0)
        for key in _JOURNAL_ALL_KEYS
    }
    projects = raw.get("projects") if has_projects else _empty_journal_projects()
    daily_tokens = raw.get("dailyTokens") if has_daily else _empty_journal_daily_tokens()
    hourly_tokens = raw.get("hourlyTokens") if has_hourly else _empty_journal_hourly_tokens()
    models = raw.get("models") if has_models else _empty_journal_models()
    usage_records = raw.get("usageRecords") if has_usage_records else {}
    return {
        "version": CLAUDE_JOURNAL_CURSOR_VERSION,
        "offsets": {str(p): int(v) for p, v in offsets.items() if isinstance(v, (int, float))},
        "totals": totals,
        "projects": projects,
        "dailyTokens": {str(k): int(v) for k, v in daily_tokens.items() if isinstance(v, (int, float))},
        "hourlyTokens": {str(k): int(v) for k, v in hourly_tokens.items() if isinstance(v, (int, float))},
        "models": {
            str(model): {
                **{
                    str(k): int(v)
                    for k, v in values.items()
                    if k not in {"today", "week", "month", "dailyTokens"}
                    and isinstance(v, (int, float))
                },
                "dailyTokens": {
                    str(day): int(amount)
                    for day, amount in (
                        values.get("dailyTokens", {}).items()
                        if isinstance(values.get("dailyTokens"), dict)
                        else []
                    )
                    if isinstance(amount, (int, float))
                },
            }
            for model, values in models.items()
            if isinstance(values, dict)
        },
        "usageRecords": {
            str(key): value
            for key, value in usage_records.items()
            if isinstance(value, dict)
        },
        "projects_needs_rebuild": not has_projects,
        "usage_needs_rebuild": not (has_daily and has_hourly and has_models and has_usage_records),
    }


CURSOR_SAVE_MIN_INTERVAL_SECONDS = float(
    os.environ.get("AGENTCAT_CURSOR_SAVE_INTERVAL_SECONDS", "300")
)


def cursor_recently_saved(path: Path) -> bool:
    """Debounce gate for multi-MB cursor writes on busy machines.

    Serializing a large cursor costs seconds of CPU; while agents are
    actively appending, every 60s cycle is dirty, so without this gate the
    daemon pays that cost every cycle. Skipping a save only means the next
    process re-parses the small unsaved journal tail — the cursor is a
    resume cache, so nothing is lost. Keyed on the cursor file's mtime so
    one-shot CLI runs and tests (fresh temp paths) are unaffected.
    """
    try:
        return (time.time() - path.stat().st_mtime) < CURSOR_SAVE_MIN_INTERVAL_SECONDS
    except OSError:
        return False


def save_journal_cursor(cursor: Dict[str, Any]) -> bool:
    tmp = unique_atomic_tmp_path(JOURNAL_CURSOR_FILE)
    try:
        AGENTCAT_HOME.mkdir(parents=True, exist_ok=True)
        with tmp.open("w", encoding="utf-8") as fh:
            # No sort_keys: key order is irrelevant to a resume cursor and
            # sorting a multi-MB dict measurably adds to each save.
            json.dump(cursor, fh, ensure_ascii=False, separators=(",", ":"))
            fh.write("\n")
        tmp.replace(JOURNAL_CURSOR_FILE)
        return True
    except Exception as exc:
        logging.debug("save_journal_cursor failed: %s", exc)
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass
        return False


def parse_claude_usage_line(obj: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    msg = obj.get("message")
    if not isinstance(msg, dict):
        return None
    usage = msg.get("usage")
    if not isinstance(usage, dict):
        return None
    inp = nonnegative_int(usage.get("input_tokens")) or 0
    out = nonnegative_int(usage.get("output_tokens")) or 0
    cache_read = nonnegative_int(usage.get("cache_read_input_tokens")) or 0
    cache_creation = usage.get("cache_creation") or {}
    if isinstance(cache_creation, dict):
        cache_write_1h = nonnegative_int(cache_creation.get("ephemeral_1h_input_tokens")) or 0
        cache_write_5m = nonnegative_int(cache_creation.get("ephemeral_5m_input_tokens")) or 0
        if cache_write_1h == 0 and cache_write_5m == 0:
            cache_write_1h = nonnegative_int(usage.get("cache_creation_input_tokens")) or 0
    else:
        total_write = nonnegative_int(usage.get("cache_creation_input_tokens")) or 0
        cache_write_1h, cache_write_5m = total_write, 0
    if inp == 0 and out == 0 and cache_read == 0 and cache_write_1h == 0 and cache_write_5m == 0:
        return None
    ts = parse_timestamp(obj.get("timestamp"))
    return {
        "dedupeKey": claude_usage_dedupe_key(obj, msg),
        "timestamp": ts,
        "model": str(msg.get("model") or "unknown"),
        "cwd": str(obj.get("cwd") or ""),
        "input": inp, "output": out, "cache_read": cache_read,
        "cache_write_1h": cache_write_1h, "cache_write_5m": cache_write_5m,
    }


def claude_usage_dedupe_key(obj: Dict[str, Any], msg: Dict[str, Any]) -> Optional[str]:
    request_id = obj.get("requestId") or obj.get("request_id")
    if isinstance(request_id, str) and request_id:
        return f"request:{request_id}"
    message_id = msg.get("id")
    if isinstance(message_id, str) and message_id:
        return f"message:{message_id}"
    return None


def claude_record_total(rec: Dict[str, Any]) -> int:
    return sum(
        int(rec.get(key) or 0)
        for key in ("input", "output", "cache_read", "cache_write_1h", "cache_write_5m")
    )


def claude_record_for_cursor(rec: Dict[str, Any]) -> Dict[str, Any]:
    timestamp = rec.get("timestamp")
    return {
        "timestamp": timestamp.isoformat() if isinstance(timestamp, dt.datetime) else None,
        "model": rec.get("model"),
        "cwd": rec.get("cwd"),
        "input": int(rec.get("input") or 0),
        "output": int(rec.get("output") or 0),
        "cache_read": int(rec.get("cache_read") or 0),
        "cache_write_1h": int(rec.get("cache_write_1h") or 0),
        "cache_write_5m": int(rec.get("cache_write_5m") or 0),
    }


def claude_record_from_cursor(raw: Any) -> Optional[Dict[str, Any]]:
    if not isinstance(raw, dict):
        return None
    timestamp = parse_timestamp(raw.get("timestamp"))
    return {
        "timestamp": timestamp,
        "model": str(raw.get("model") or "unknown"),
        "cwd": str(raw.get("cwd") or ""),
        "input": int_limit(raw.get("input")) or 0,
        "output": int_limit(raw.get("output")) or 0,
        "cache_read": int_limit(raw.get("cache_read")) or 0,
        "cache_write_1h": int_limit(raw.get("cache_write_1h")) or 0,
        "cache_write_5m": int_limit(raw.get("cache_write_5m")) or 0,
    }


def claude_journal_project_dirs() -> List[Path]:
    """Return Claude usage journal roots without reading transcript content.

    The canonical CLI root is ~/.claude/projects. Claude Desktop's local
    agent mode keeps the same JSONL shape under its Application Support
    directory. We only add the nested `.claude/projects` roots; parsing remains
    field allowlisted in parse_claude_usage_line().

    CLI roots come from tracked_provider_homes("claude") and are resolved at
    call time, so this never audits a different directory than
    claude_config_dir() reports for credentials under $CLAUDE_CONFIG_DIR. With
    no adopted homes that is exactly the one root this returned before.
    """
    roots: List[Path] = []
    seen: Set[str] = set()

    def add(root: Path) -> None:
        try:
            resolved = str(root.resolve())
        except OSError:
            resolved = str(root)
        if resolved in seen:
            return
        if not root.is_dir():
            return
        seen.add(resolved)
        roots.append(root)

    for home in tracked_provider_homes("claude"):
        add(home / "projects")
    added_desktop = 0
    for data_root in desktop_app_data_roots("claude"):
        if added_desktop >= CLAUDE_DESKTOP_PROJECT_DIR_MAX:
            break
        if not data_root.is_dir():
            continue
        for pattern in CLAUDE_DESKTOP_PROJECT_GLOBS:
            for candidate in sorted(data_root.glob(pattern)):
                add(candidate)
                added_desktop += 1
                if added_desktop >= CLAUDE_DESKTOP_PROJECT_DIR_MAX:
                    break
            if added_desktop >= CLAUDE_DESKTOP_PROJECT_DIR_MAX:
                break
    return roots


def claude_journal_files_by_root() -> List[Tuple[Path, List[Path]]]:
    """Journal files grouped by root, deduped across all roots.

    Every Claude scan walks the same roots, so the dedup has to happen once,
    globally, and then be handed back per-root — each caller still needs to know
    which root a file came from to classify it as CLI or desktop usage.

    Session-identity matching (the layer that can drop a file the connector used
    to count) turns on only when the user has adopted a second Claude home.
    Desktop roots alone never enable it, so a stock install scans exactly what it
    scanned before.
    """
    roots = claude_journal_project_dirs()
    if not roots:
        return []

    ordered: List[Tuple[Path, Path]] = []
    for root in roots:
        try:
            paths = sorted(root.rglob("*.jsonl"))
        except OSError:
            continue
        for path in paths:
            ordered.append((root, path))

    if len(roots) > 1:
        multi_home = len(tracked_provider_homes("claude")) > 1
        survivors = {
            str(path)
            for path in dedupe_usage_paths(
                [path for _root, path in ordered], {}, match_session_identity=multi_home
            )
        }
        ordered = [(root, path) for root, path in ordered if str(path) in survivors]

    grouped: Dict[str, Tuple[Path, List[Path]]] = {}
    for root, path in ordered:
        entry = grouped.get(str(root))
        if entry is None:
            grouped[str(root)] = (root, [path])
        else:
            entry[1].append(path)
    return list(grouped.values())


def _apply_record_to_totals(
    totals: Dict[str, int],
    rec: Dict[str, Any],
    _now: "dt.datetime",
    projects: Optional[Dict[str, Dict[str, Any]]] = None,
    daily_tokens: Optional[Dict[str, int]] = None,
    hourly_tokens: Optional[Dict[str, int]] = None,
    models: Optional[Dict[str, Dict[str, int]]] = None,
    sign: int = 1,
) -> None:
    ts: Optional["dt.datetime"] = rec.get("timestamp")
    if ts is not None and ts.tzinfo is None:
        ts = ts.replace(tzinfo=dt.timezone.utc)
    fields = (
        ("input", "input", "inputTokens"),
        ("output", "output", "outputTokens"),
        ("cache_read", "cacheRead", "cacheReadInputTokens"),
        ("cache_write_1h", "cacheWrite_1h", "cacheCreationInputTokens"),
        ("cache_write_5m", "cacheWrite_5m", "cacheCreationInputTokens"),
    )
    project_total = 0
    model = normalized_model_name(rec.get("model")) or "unknown"
    model_tokens = models.setdefault(model, {}) if models is not None else None
    project_class_keys = {
        "input": "input", "output": "output", "cache_read": "cacheRead",
        "cache_write_1h": "cacheWrite", "cache_write_5m": "cacheWrite",
    }
    project_classes = {cls: 0 for cls in PROJECT_COST_CLASS_KEYS}
    for rec_key, tok_key, model_key in fields:
        raw_amount = rec.get(rec_key) or 0
        if raw_amount <= 0:
            continue
        amount = int(raw_amount) * sign
        project_total += amount
        project_classes[project_class_keys[rec_key]] += amount
        totals[f"all_{tok_key}"] = totals.get(f"all_{tok_key}", 0) + amount
        if model_tokens is not None:
            model_tokens[model_key] = model_tokens.get(model_key, 0) + amount
    if project_total == 0:
        return
    if daily_tokens is not None:
        add_to_daily(daily_tokens, project_total, ts)
    if hourly_tokens is not None:
        add_to_hourly(hourly_tokens, project_total, ts)
    if model_tokens is not None:
        model_tokens["totalTokens"] = model_tokens.get("totalTokens", 0) + project_total
        model_daily = model_tokens.setdefault("dailyTokens", {})
        if isinstance(model_daily, dict):
            add_to_daily(model_daily, project_total, ts)
    cwd = str(rec.get("cwd") or "").strip()
    if projects is not None and cwd:
        project = projects.setdefault(cwd, {"tokens": 0, "last_active": None})
        project["tokens"] = int(project.get("tokens") or 0) + project_total
        project_models = project.setdefault("models", {})
        model_classes = project_models.setdefault(model, {cls: 0 for cls in PROJECT_COST_CLASS_KEYS})
        for cls, amount in project_classes.items():
            if amount:
                model_classes[cls] = int(model_classes.get(cls) or 0) + amount
        if ts is not None:
            last_active = project.get("last_active")
            last_dt = parse_timestamp(last_active)
            if last_dt is None or ts > last_dt:
                project["last_active"] = ts.isoformat().replace("+00:00", "Z")


def rebuild_claude_journal_projects(now: "dt.datetime") -> Dict[str, Dict[str, Any]]:
    projects: Dict[str, Dict[str, Any]] = {}
    scratch_totals = _empty_journal_totals()
    for _root, paths in claude_journal_files_by_root():
        for path in paths:
            try:
                with path.open("rb") as fh:
                    for raw_line in fh:
                        line = raw_line.decode("utf-8", errors="replace").strip()
                        if not line:
                            continue
                        try:
                            obj = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        rec = parse_claude_usage_line(obj)
                        if rec:
                            _apply_record_to_totals(scratch_totals, rec, now, projects)
            except OSError as exc:
                logging.warning("rebuild_claude_journal_projects: cannot read %s: %s", str(path), exc)
                continue
    return projects


def scan_claude_journal(cursor: Dict[str, Any]) -> Dict[str, Any]:
    project_roots = claude_journal_project_dirs()
    if not project_roots:
        cursor["_dirty"] = False
        return cursor
    # The cursor holds the full usage-record history (multi-MB); serializing
    # it every 60s cycle was the daemon's main steady-state CPU cost, so the
    # caller only persists it when this scan actually changed something.
    changed = False
    rebuilt = False
    now_utc = dt.datetime.now(dt.timezone.utc)
    offsets: Dict[str, int] = cursor.setdefault("offsets", {})
    totals: Dict[str, int] = cursor.setdefault("totals", _empty_journal_totals())
    projects: Dict[str, Dict[str, Any]] = cursor.setdefault("projects", _empty_journal_projects())
    daily_tokens: Dict[str, int] = cursor.setdefault("dailyTokens", _empty_journal_daily_tokens())
    hourly_tokens: Dict[str, int] = cursor.setdefault("hourlyTokens", _empty_journal_hourly_tokens())
    models: Dict[str, Dict[str, int]] = cursor.setdefault("models", _empty_journal_models())
    usage_records: Dict[str, Dict[str, Any]] = cursor.setdefault("usageRecords", {})
    if cursor.pop("usage_needs_rebuild", False):
        changed = True
        rebuilt = True
        offsets.clear()
        totals.clear()
        totals.update(_empty_journal_totals())
        projects.clear()
        daily_tokens.clear()
        hourly_tokens.clear()
        models.clear()
        usage_records.clear()
        cursor["projects_needs_rebuild"] = False
    if cursor.pop("projects_needs_rebuild", False):
        # Existing cursors predate per-project attribution. Rebuild only
        # project totals from JSONL so historical project usage appears
        # without disturbing global totals or byte offsets.
        changed = True
        rebuilt = True
        projects.clear()
        projects.update(rebuild_claude_journal_projects(now_utc))
    for _root, paths in claude_journal_files_by_root():
        for path in paths:
            path_str = str(path)
            try:
                file_size = path.stat().st_size
            except OSError:
                continue
            stored_offset = offsets.get(path_str, 0)
            if stored_offset > file_size:
                stored_offset = 0
            if stored_offset >= file_size:
                continue
            lines_parsed = lines_skipped = 0
            new_offset = stored_offset
            try:
                with path.open("rb") as fh:
                    fh.seek(stored_offset)
                    for raw_line in fh:
                        if not raw_line.endswith(b"\n"):
                            # Incomplete trailing line (writer mid-append): stop before
                            # advancing the cursor past it (audit #8). The next scan resumes
                            # at this byte once the writer completes the record.
                            break
                        new_offset += len(raw_line)
                        line = raw_line.decode("utf-8", errors="replace").strip()
                        if not line:
                            continue
                        try:
                            obj = json.loads(line)
                        except json.JSONDecodeError:
                            lines_skipped += 1
                            continue
                        rec = parse_claude_usage_line(obj)
                        if rec:
                            dedupe_key = rec.get("dedupeKey")
                            if isinstance(dedupe_key, str) and dedupe_key:
                                previous = claude_record_from_cursor(usage_records.get(dedupe_key))
                                if previous is not None:
                                    if claude_record_total(rec) <= claude_record_total(previous):
                                        continue
                                    _apply_record_to_totals(
                                        totals,
                                        previous,
                                        now_utc,
                                        projects,
                                        daily_tokens,
                                        hourly_tokens,
                                        models,
                                        sign=-1,
                                    )
                                usage_records[dedupe_key] = claude_record_for_cursor(rec)
                            _apply_record_to_totals(
                                totals,
                                rec,
                                now_utc,
                                projects,
                                daily_tokens,
                                hourly_tokens,
                                models,
                            )
                            lines_parsed += 1
            except OSError as exc:
                logging.warning("scan_claude_journal: cannot read %s: %s", path_str, exc)
                continue
            if offsets.get(path_str) != new_offset:
                changed = True
            offsets[path_str] = new_offset
            logging.debug("journal scan: %s bytes_read=%d parsed=%d skipped=%d",
                          path.name, new_offset - stored_offset, lines_parsed, lines_skipped)
    if changed:
        cursor["version"] = CLAUDE_JOURNAL_CURSOR_VERSION
    cursor["_dirty"] = changed
    cursor["_rebuilt"] = rebuilt
    return cursor


def _merge_journal_totals(tokens: Dict[str, int], cursor_totals: Dict[str, int]) -> None:
    for k, v in cursor_totals.items():
        if v > 0:
            tokens[k] = tokens.get(k, 0) + v
    all_input = cursor_totals.get("all_input", 0)
    all_output = cursor_totals.get("all_output", 0)
    all_cache_read = cursor_totals.get("all_cacheRead", 0)
    all_cache_write = cursor_totals.get("all_cacheWrite_1h", 0) + cursor_totals.get("all_cacheWrite_5m", 0)
    if all_input > 0:
        tokens["inputTokens"] = tokens.get("inputTokens", 0) + all_input
    if all_output > 0:
        tokens["outputTokens"] = tokens.get("outputTokens", 0) + all_output
    if all_cache_read > 0:
        tokens["cacheReadInputTokens"] = tokens.get("cacheReadInputTokens", 0) + all_cache_read
    if all_cache_write > 0:
        tokens["cacheCreationInputTokens"] = tokens.get("cacheCreationInputTokens", 0) + all_cache_write
    lifetime = sum(
        cursor_totals.get(f"all_{cls}", 0)
        for cls in ("input", "output", "cacheRead", "cacheWrite_1h", "cacheWrite_5m")
    )
    if lifetime > 0:
        tokens["all"] = lifetime
    if tokens.get("all", 0) > 0:
        tokens["totalTokens"] = tokens["all"]


def _merge_journal_buckets(target: Dict[str, int], source: Dict[str, int]) -> None:
    for key, amount in source.items():
        if amount > 0:
            target[key] = max(target.get(key, 0), amount)


def _merge_journal_models(target: Dict[str, Dict[str, int]], source: Dict[str, Dict[str, int]]) -> None:
    for model, values in source.items():
        if not isinstance(values, dict):
            continue
        model_tokens = target.setdefault(model, {})
        for key, amount in values.items():
            if key == "dailyTokens" or not isinstance(amount, (int, float)):
                continue
            if amount > 0:
                model_tokens[key] = max(model_tokens.get(key, 0), amount)
        daily = values.get("dailyTokens") if isinstance(values.get("dailyTokens"), dict) else {}
        periods = periods_from_daily_tokens(int_map(daily))
        lifetime = int(model_tokens.get("totalTokens") or periods["all"])
        periods["all"] = lifetime
        for key, amount in periods.items():
            if amount > 0:
                model_tokens[key] = max(model_tokens.get(key, 0), amount)


def _journal_project_item_models(raw: Any) -> Dict[str, Dict[str, int]]:
    out: Dict[str, Dict[str, int]] = {}
    if not isinstance(raw, dict):
        return out
    for model, classes in raw.items():
        if not isinstance(classes, dict):
            continue
        inp = int(classes.get("input") or 0)
        outp = int(classes.get("output") or 0)
        cache_read = int(classes.get("cacheRead") or 0)
        cache_write = int(classes.get("cacheWrite") or 0)
        total = inp + outp + cache_read + cache_write
        if total > 0:
            out[str(model)] = {
                "inputTokens": inp, "outputTokens": outp,
                "cacheReadInputTokens": cache_read,
                "cacheCreationInputTokens": cache_write, "totalTokens": total,
            }
    return out


def _journal_projects_snapshot(projects: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
    items = []
    for path, payload in projects.items():
        if not isinstance(payload, dict):
            continue
        tokens = int(payload.get("tokens") or 0)
        if tokens <= 0:
            continue
        item = {
            "id": path,
            "path": path,
            "name": display_project_name(path),
            "tokens": tokens,
            "lastActive": payload.get("last_active"),
        }
        models = _journal_project_item_models(payload.get("models"))
        if models:
            item["models"] = models
        items.append(item)
    items.sort(key=lambda entry: int(entry.get("tokens") or 0), reverse=True)
    return {"status": "ok", "items": items[:20]}


def _claude_snapshot_with_current_windows(result: Dict[str, Any]) -> Dict[str, Any]:
    """Refresh Claude's rolling labels from its dated buckets at read time."""
    periods = periods_from_daily_tokens(int_map(result.get("dailyTokens")))
    tokens = result.setdefault("tokens", {})
    for key in ("today", "week", "month"):
        tokens[key] = periods[key]
    tokens["all"] = max(_insight_int(tokens.get("all")), periods["all"])
    tokens["totalTokens"] = tokens["all"]
    return result


def _path_is_within(child: Path, parent: Path) -> bool:
    """True when ``child`` resolves to ``parent`` or a path nested under it.

    Defensive: resolution failures fall back to string comparison so a
    non-existent or permission-denied path never raises.
    """
    try:
        child_resolved = child.resolve()
    except OSError:
        child_resolved = child
    try:
        parent_resolved = parent.resolve()
    except OSError:
        parent_resolved = parent
    try:
        child_resolved.relative_to(parent_resolved)
        return True
    except ValueError:
        return False


def _classify_claude_journal_root(root: Path) -> str:
    """Tag a Claude journal root as ``cli`` or ``app``.

    The CLI root is ``CLAUDE_PROJECTS_DIR``; everything reachable under a
    ``desktop_app_data_roots("claude")`` path is the desktop app. CLI takes
    precedence when a path somehow matches both.
    """
    for home in tracked_provider_homes("claude"):
        if _path_is_within(root, home / "projects"):
            return "cli"
    for data_root in desktop_app_data_roots("claude"):
        if _path_is_within(root, data_root):
            return "app"
    # Unknown provenance: attribute to CLI so the total stays consistent with
    # claude_journal_project_dirs() enumeration (CLI root added first).
    return "cli"


def _desktop_originated_claude_session_ids() -> Set[str]:
    """Session ids of Claude Code runs launched from the Claude desktop app.

    The desktop app now runs embedded Claude Code, whose journals land in the
    SHARED CLI dir (``~/.claude/projects``) — so by root they'd count as "cli".
    The desktop app records each such run in
    ``<app-support>/claude-code-sessions/**/*.json`` with a ``cliSessionId`` that
    equals the journal filename stem, letting us reattribute those journals to
    the desktop ("app") surface. Defensive against unreadable/partial indexes.
    """
    ids: Set[str] = set()
    for data_root in desktop_app_data_roots("claude"):
        sessions_dir = data_root / "claude-code-sessions"
        try:
            paths = sessions_dir.rglob("*.json")
        except OSError:
            continue
        for path in paths:
            try:
                obj = json.loads(path.read_text(encoding="utf-8", errors="replace"))
            except (OSError, json.JSONDecodeError, ValueError):
                continue
            if isinstance(obj, dict):
                sid = obj.get("cliSessionId")
                if isinstance(sid, str) and sid:
                    ids.add(sid)
    return ids


_CLAUDE_USAGE_BY_SOURCE_LOCK = threading.Lock()
_CLAUDE_USAGE_BY_SOURCE_KEY: Optional[Tuple] = None
_CLAUDE_USAGE_BY_SOURCE_VALUE: Optional[Dict[str, Any]] = None


def _claude_journal_signature() -> Tuple:
    """Cheap fingerprint of every Claude journal file: (path, mtime_ns, size).

    Walking + stat'ing is orders of magnitude cheaper than reading and
    JSON-parsing the whole corpus, so it lets ``claude_usage_by_source`` skip
    the full re-scan on the 60s snapshot tick unless a file actually changed.
    """
    entries = []
    for root, paths in claude_journal_files_by_root():
        surface = _classify_claude_journal_root(root)
        for path in paths:
            try:
                stat = path.stat()
                entries.append((str(path), surface, stat.st_mtime_ns, stat.st_size))
            except OSError:
                continue
    return tuple(entries)


def claude_usage_by_source() -> Dict[str, Any]:
    """Sum Claude journal tokens split by surface (CLI vs Desktop app).

    Standalone scan over the same journal roots used by the merged totals;
    deliberately independent of the incremental cursor so this stays purely
    additive and cannot perturb existing offsets/totals. Defensive against
    unreadable files and malformed lines.

    Memoized on the journal file signature so the daemon's 60s snapshot tick
    only re-reads the (potentially hundreds of MB) corpus when a file changed,
    instead of every cycle.
    """
    global _CLAUDE_USAGE_BY_SOURCE_KEY, _CLAUDE_USAGE_BY_SOURCE_VALUE
    # Desktop-launched Claude Code journals live in the shared CLI dir; reattribute
    # them to "app" by session id. Fold the id set into the cache key so the split
    # recomputes when the desktop session index changes.
    desktop_ids = _desktop_originated_claude_session_ids()
    signature = (_claude_journal_signature(), tuple(sorted(desktop_ids)))
    with _CLAUDE_USAGE_BY_SOURCE_LOCK:
        if _CLAUDE_USAGE_BY_SOURCE_VALUE is not None and _CLAUDE_USAGE_BY_SOURCE_KEY == signature:
            return dict(_CLAUDE_USAGE_BY_SOURCE_VALUE)

    per_source: Dict[str, int] = {"cli": 0, "app": 0}
    for root, paths in claude_journal_files_by_root():
        surface = _classify_claude_journal_root(root)
        for path in paths:
            # A CLI-root journal whose session id was launched from the desktop
            # app is really desktop usage.
            file_surface = "app" if (surface == "cli" and path.stem in desktop_ids) else surface
            try:
                with path.open("rb") as fh:
                    for raw_line in fh:
                        line = raw_line.decode("utf-8", errors="replace").strip()
                        if not line:
                            continue
                        try:
                            obj = json.loads(line)
                        except (json.JSONDecodeError, ValueError):
                            continue
                        if not isinstance(obj, dict):
                            continue
                        rec = parse_claude_usage_line(obj)
                        if rec:
                            per_source[file_surface] += claude_record_total(rec)
            except OSError as exc:
                logging.warning("claude_usage_by_source: cannot read %s: %s", str(path), exc)
                continue
    cli_tokens = per_source["cli"]
    app_tokens = per_source["app"]
    by_surface = {k: v for k, v in {"cli": cli_tokens, "app": app_tokens}.items() if v > 0}
    value = {
        "status": "ok" if (cli_tokens > 0 or app_tokens > 0) else "not_available",
        "units": "tokens",
        "bySurface": by_surface,
        "source": "claude-journal-split",
    }
    with _CLAUDE_USAGE_BY_SOURCE_LOCK:
        _CLAUDE_USAGE_BY_SOURCE_KEY = signature
        _CLAUDE_USAGE_BY_SOURCE_VALUE = value
    return dict(value)


def claude_snapshot() -> Dict[str, Any]:
    path = HOME / ".claude" / "stats-cache.json"
    raw = read_json(path)
    result: Dict[str, Any] = {
        "status": "not_found",
        "source": f"{path}+jsonl",
        "tokens": {},
        "models": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        "breakdown": empty_breakdown(),
        "projects": empty_projects(),
    }
    if isinstance(raw, dict) and raw.get("_agentcat_error"):
        result["status"] = "error"
        result["error"] = raw["_agentcat_error"]

    # Per-class token data from JSONL journal (incremental scan)
    cursor = load_journal_cursor()
    cursor = scan_claude_journal(cursor)
    rebuilt = bool(cursor.pop("_rebuilt", False))
    # Rebuilds must persist immediately — a stale cursor on disk would
    # trigger the full rebuild again next cycle. Ordinary appends are
    # debounced: the unsaved tail just gets re-parsed by the next process.
    if cursor.pop("_dirty", True) and (rebuilt or not cursor_recently_saved(JOURNAL_CURSOR_FILE)):
        saved = save_journal_cursor(cursor)
        if not saved:
            logging.debug("claude_snapshot: cursor save failed")
    if cursor["totals"]:
        _merge_journal_totals(result["tokens"], cursor["totals"])
        if result["status"] == "not_found" and any(cursor["totals"].values()):
            result["status"] = "ok"
    _merge_journal_buckets(result["dailyTokens"], cursor.get("dailyTokens") or {})
    _merge_journal_buckets(result["hourlyTokens"], cursor.get("hourlyTokens") or {})
    _merge_journal_models(result["models"], cursor.get("models") or {})
    if cursor.get("projects"):
        result["projects"] = _journal_projects_snapshot(cursor["projects"])

    # Additive per-source split (Claude Code CLI vs Claude Desktop app).
    # Independent full scan; does not touch any existing field above.
    result["usageBySource"] = claude_usage_by_source()
    claude_cost_cache = codexbar_cost_cache_snapshot("claude")

    if raw is None:
        merged = merge_provider_with_usage_floor(
            result,
            claude_cost_cache,
            strategy="codexbar_claude_cost_cache_floor",
        )
        return attach_local_usage_coverage(
            "claude",
            _claude_snapshot_with_current_windows(merged),
            codexbarCostCache={
                "status": claude_cost_cache.get("status"),
                "source": claude_cost_cache.get("source"),
                "tokens": _codex_token_period_summary(claude_cost_cache),
                "includedAsFloor": bool(
                    merged.get("externalReconciled")
                    or (
                        isinstance(merged.get("reconciled"), dict)
                        and merged["reconciled"].get("strategy") == "codexbar_claude_cost_cache_floor"
                    )
                ),
            },
        )

    if result["status"] not in ("error",):
        result["status"] = "ok"

    # stats-cache: model names, dailyTokens structure, activity counts (fallback)
    model_usage = raw.get("modelUsage") if isinstance(raw, dict) else None
    if isinstance(model_usage, dict):
        for model, payload in model_usage.items():
            model_tokens = result["models"].setdefault(str(model), {})
            for key, amount in extract_tokens(payload).items():
                if amount > 0:
                    model_tokens.setdefault(key, amount)

    daily_model_tokens = raw.get("dailyModelTokens") if isinstance(raw, dict) else None
    if isinstance(daily_model_tokens, dict):
        result["dailyModelTokensDays"] = len(daily_model_tokens)
    elif isinstance(daily_model_tokens, list):
        stats_daily: Dict[str, int] = {}
        model_daily_from_stats: Dict[str, Dict[str, int]] = {}
        for item in daily_model_tokens:
            if not isinstance(item, dict):
                continue
            tokens_by_model = item.get("tokensByModel")
            if not isinstance(tokens_by_model, dict):
                continue
            day_key = str(item.get("date") or "").strip()
            try:
                dt.date.fromisoformat(day_key)
            except ValueError:
                when = parse_timestamp(item.get("date"))
                day_key = day_key_for_timestamp(when) or ""
            if not day_key:
                continue
            total = 0
            for model_raw, value in tokens_by_model.items():
                amount = int_limit(value) or 0
                if amount <= 0:
                    continue
                total += amount
                model = normalized_model_name(model_raw) or "unknown"
                model_daily = model_daily_from_stats.setdefault(model, {})
                model_daily[day_key] = max(model_daily.get(day_key, 0), amount)
            if total > 0:
                stats_daily[day_key] = max(stats_daily.get(day_key, 0), total)
                result["dailyTokens"][day_key] = max(result["dailyTokens"].get(day_key, 0), total)
        result["dailyModelTokensDays"] = len(daily_model_tokens)
        for model, model_daily in model_daily_from_stats.items():
            stats_periods = periods_from_daily_tokens(model_daily)
            model_periods = result["models"].setdefault(model, {})
            for key, amount in stats_periods.items():
                if amount > 0:
                    model_periods.setdefault(key, amount)
        periods = periods_from_daily_tokens(stats_daily)
        for key in ("today", "week", "month", "all"):
            if periods[key] > 0 and result["tokens"].get(key, 0) <= 0:
                result["tokens"][key] = periods[key]
    daily_activity = raw.get("dailyActivity") if isinstance(raw, dict) else None
    if isinstance(daily_activity, dict):
        result["dailyActivityDays"] = len(daily_activity)
    elif isinstance(daily_activity, list):
        result["dailyActivityDays"] = len(daily_activity)
    merged = merge_provider_with_usage_floor(
        result,
        claude_cost_cache,
        strategy="codexbar_claude_cost_cache_floor",
    )
    return attach_local_usage_coverage(
        "claude",
        _claude_snapshot_with_current_windows(merged),
        codexbarCostCache={
            "status": claude_cost_cache.get("status"),
            "source": claude_cost_cache.get("source"),
            "tokens": _codex_token_period_summary(claude_cost_cache),
            "includedAsFloor": bool(
                merged.get("externalReconciled")
                or (
                    isinstance(merged.get("reconciled"), dict)
                    and merged["reconciled"].get("strategy") == "codexbar_claude_cost_cache_floor"
                )
            ),
        },
    )


def gemini_source_descriptors() -> List[Dict[str, Any]]:
    return [
        {
            "id": "geminiCli",
            "displayName": "Gemini CLI",
            "telemetry": GEMINI_TELEMETRY,
            "cache": GEMINI_USAGE_CACHE,
            "settings": HOME / ".gemini" / "settings.json",
            "installed": bool(shutil.which("gemini") or (HOME / ".gemini").exists() or GEMINI_TELEMETRY.exists()),
        },
        {
            "id": "antigravityCli",
            "displayName": "Antigravity CLI",
            "telemetry": ANTIGRAVITY_TELEMETRY,
            "cache": ANTIGRAVITY_USAGE_CACHE,
            "settings": ANTIGRAVITY_CLI_DIR / "settings.json",
            "installed": bool(shutil.which("agy") or shutil.which("antigravity") or ANTIGRAVITY_CLI_DIR.exists() or ANTIGRAVITY_TELEMETRY.exists()),
        },
    ]


def gemini_source_status(source: Dict[str, Any], usage: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    telemetry_path = Path(source["telemetry"])
    settings_path = Path(source["settings"])
    tokens = int((usage or {}).get("tokens", {}).get("totalTokens") or 0) if usage else 0
    telemetry_configured = False
    if settings_path.exists():
        try:
            settings = json.loads(settings_path.read_text(encoding="utf-8"))
            telemetry = settings.get("telemetry") if isinstance(settings, dict) else None
            telemetry_configured = isinstance(telemetry, dict) and str(telemetry.get("outfile") or "") == str(telemetry_path)
        except Exception:
            telemetry_configured = False
    return {
        "displayName": source["displayName"],
        "installed": bool(source.get("installed")),
        "status": "ok" if tokens > 0 else "no_token_events_yet" if telemetry_path.exists() else "no_telemetry_yet",
        "telemetryConfigured": telemetry_configured,
        "source": str(telemetry_path),
        "settings": str(settings_path),
        "cache": str(source["cache"]),
        "tokens": tokens,
        "events": int((usage or {}).get("events") or 0) if usage else 0,
    }


def merge_token_maps(target: Dict[str, int], source: Any) -> None:
    if not isinstance(source, dict):
        return
    for key, value in int_map(source).items():
        target[key] = int(target.get(key) or 0) + value


def gemini_period_map(raw: Any) -> Dict[str, int]:
    values = int_map(raw)
    periods = {**empty_periods(), **values}
    lifetime = int(values.get("all") or values.get("totalTokens") or 0)
    if lifetime <= 0:
        lifetime = sum(int(values.get(key) or 0) for key in TOKEN_CLASS_KEYS)
    if lifetime <= 0:
        lifetime = max((int(values.get(key) or 0) for key in ("today", "week", "month")), default=0)
    periods["all"] = lifetime
    return periods


def merge_gemini_usage(usages: List[Dict[str, Any]]) -> Dict[str, Any]:
    if len(usages) == 1:
        merged = copy.deepcopy(usages[0])
        merged["tokens"] = gemini_period_map(merged.get("tokens"))
        for model, raw_tokens in list((merged.get("models") or {}).items()):
            model_tokens = gemini_period_map(raw_tokens)
            if model_tokens["all"] > 0:
                merged["models"][model] = model_tokens
        return merged
    merged = {
        "tokens": empty_periods(),
        "models": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        "events": 0,
        "cache": {"source": "multi-source-full-log-index", "sources": []},
    }
    for usage in usages:
        merge_token_maps(merged["tokens"], gemini_period_map(usage.get("tokens")))
        merge_token_maps(merged["dailyTokens"], usage.get("dailyTokens", {}))
        merge_token_maps(merged["hourlyTokens"], usage.get("hourlyTokens", {}))
        merged["events"] += int(usage.get("events") or 0)
        for model, raw_tokens in (usage.get("models") or {}).items():
            model_tokens = merged["models"].setdefault(str(model), empty_periods())
            merge_token_maps(model_tokens, gemini_period_map(raw_tokens))
        merged["cache"]["sources"].append(usage.get("cache", {"source": "unknown"}))
    return merged


def gemini_snapshot() -> Dict[str, Any]:
    global _GEMINI_CACHE_KEY, _GEMINI_CACHE_VALUE, _GEMINI_CACHE_LOADED_AT

    sources = gemini_source_descriptors()
    result: Dict[str, Any] = {
        "status": "no_telemetry_yet",
        "source": ", ".join(str(source["telemetry"]) for source in sources),
        "canonicalProvider": "google",
        "providerLabel": "Gemini",
        "displayName": "Gemini",
        "sources": {str(source["id"]): gemini_source_status(source) for source in sources},
        "tokens": empty_periods(),
        "models": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        "events": 0,
        "cache": {"source": "none"},
        # Gemini telemetry carries tool/MCP call records under
        # `gemini_cli.tool.call`; parse_gemini_telemetry could grow a
        # second pass for those. For now mark not_available so the
        # client doesn't render zeros that imply zero tools were used.
        "breakdown": empty_breakdown(),
    }
    existing_sources = [source for source in sources if Path(source["telemetry"]).exists()]
    if not existing_sources:
        return result

    stats = [(source["id"], Path(source["telemetry"]).stat()) for source in existing_sources]
    cache_key = tuple((str(source_id), int(stat.st_size), int(stat.st_mtime_ns)) for source_id, stat in stats)
    with _GEMINI_CACHE_LOCK:
        cache_age = time.monotonic() - _GEMINI_CACHE_LOADED_AT
        if _GEMINI_CACHE_VALUE is not None and (
            _GEMINI_CACHE_KEY == cache_key or cache_age < GEMINI_CACHE_MIN_SECONDS
        ):
            return copy.deepcopy(_GEMINI_CACHE_VALUE)

        try:
            usages = []
            source_statuses = {}
            source_usages = {}
            for source in existing_sources:
                telemetry_path = Path(source["telemetry"])
                cache_path = Path(source["cache"])
                stat = telemetry_path.stat()
                state = load_gemini_usage_state(stat, telemetry_path=telemetry_path, cache_path=cache_path)
                state = scan_gemini_telemetry_state(state, stat, telemetry_path=telemetry_path)
                state = rotate_telemetry_log_if_oversized(state, telemetry_path)
                save_gemini_usage_state(state, cache_path=cache_path)
                usage = gemini_usage_result_from_state(state)
                usages.append(usage)
                source_usages[str(source["id"])] = usage
                source_statuses[str(source["id"])] = gemini_source_status(source, usage)
            usage = merge_gemini_usage(usages)
        except Exception as exc:
            result["status"] = "error"
            result["error"] = str(exc)
            return result

        result["status"] = "ok" if usage["events"] else "no_token_events_yet"
        for source_id, source_status in source_statuses.items():
            result["sources"][source_id] = source_status
        result["tokens"] = usage["tokens"]
        result["models"] = usage["models"]
        result["dailyTokens"] = usage["dailyTokens"]
        result["hourlyTokens"] = usage["hourlyTokens"]
        result["events"] = usage["events"]
        result["cache"] = usage["cache"]
        result["_sourceUsages"] = source_usages
        _GEMINI_CACHE_KEY = cache_key
        _GEMINI_CACHE_VALUE = copy.deepcopy(result)
        _GEMINI_CACHE_LOADED_AT = time.monotonic()
        return result


def read_recent_gemini_telemetry(file_size: int, telemetry_path: Optional[Path] = None) -> str:
    telemetry_path = telemetry_path or GEMINI_TELEMETRY
    start = max(0, file_size - max(GEMINI_TELEMETRY_PARSE_BYTES, 1024 * 1024))
    with telemetry_path.open("rb") as fh:
        fh.seek(start)
        text = fh.read().decode("utf-8", errors="replace")
    if start > 0:
        first_object = text.find("{")
        if first_object >= 0:
            text = text[first_object:]
    return text


def iter_json_objects(text: str) -> Iterable[Any]:
    decoder = json.JSONDecoder()
    index = 0
    length = len(text)
    while index < length:
        while index < length and text[index].isspace():
            index += 1
        if index >= length:
            break
        if text[index] != "{":
            next_object = text.find("{", index + 1)
            if next_object < 0:
                break
            index = next_object
        try:
            payload, end = decoder.raw_decode(text, index)
        except json.JSONDecodeError:
            next_object = text.find("{", index + 1)
            if next_object < 0:
                break
            index = next_object
            continue
        yield payload
        index = end


def metric_name(metric: Any) -> Optional[str]:
    if not isinstance(metric, dict):
        return None
    descriptor = metric.get("descriptor")
    if not isinstance(descriptor, dict):
        return None
    name = descriptor.get("name")
    return str(name) if name is not None else None


def metric_value(raw: Any) -> Optional[int]:
    if isinstance(raw, bool):
        return None
    if isinstance(raw, (int, float)):
        return max(0, int(raw))
    if isinstance(raw, dict):
        for key in ("sum", "value", "count"):
            value = metric_value(raw.get(key))
            if value is not None:
                return value
    return None


def timestamp_from_otel(raw: Any) -> Optional[dt.datetime]:
    if isinstance(raw, list) and raw and isinstance(raw[0], (int, float)):
        seconds = float(raw[0])
        nanos = float(raw[1]) if len(raw) > 1 and isinstance(raw[1], (int, float)) else 0.0
        try:
            return dt.datetime.fromtimestamp(seconds + nanos / 1_000_000_000, dt.timezone.utc)
        except Exception:
            return None
    if isinstance(raw, (int, float)) and not isinstance(raw, bool):
        value = float(raw)
        if value > 10_000_000_000_000:
            value = value / 1_000_000_000.0
        return parse_timestamp(value)
    if isinstance(raw, str) and raw.strip().isdigit():
        try:
            value = float(raw.strip())
        except ValueError:
            return None
        if value > 10_000_000_000_000:
            value = value / 1_000_000_000.0
        return parse_timestamp(value)
    if isinstance(raw, dict):
        seconds = raw.get("seconds") or raw.get("secondsSinceEpoch")
        nanos = raw.get("nanos") or raw.get("nanoseconds") or 0
        if seconds is not None:
            try:
                return dt.datetime.fromtimestamp(
                    float(seconds) + float(nanos or 0) / 1_000_000_000,
                    dt.timezone.utc,
                )
            except Exception:
                return None
    return parse_timestamp(raw)


def gemini_token_key(raw: Any) -> Optional[str]:
    token_type = normalized_key(raw)
    if token_type in {"input", "input_token", "input_tokens"}:
        return "inputTokens"
    if token_type in {"output", "output_token", "output_tokens"}:
        return "outputTokens"
    if token_type in {"cache", "cached", "cached_content", "cache_read"}:
        return "cacheReadInputTokens"
    if token_type in {"thought", "thoughts", "reasoning"}:
        return "thoughtTokens"
    if token_type in {"tool", "tools"}:
        return "toolTokens"
    return None


def freeze_identity_value(raw: Any) -> Any:
    if isinstance(raw, list):
        return tuple(freeze_identity_value(item) for item in raw)
    if isinstance(raw, dict):
        return tuple(sorted((str(key), freeze_identity_value(value)) for key, value in raw.items()))
    return raw


def gemini_metric_records(payload: Any, preferred_metric: str) -> List[Tuple[Tuple[Any, ...], str, str, int, Optional[dt.datetime], Optional[dt.datetime]]]:
    records: List[Tuple[Tuple[Any, ...], str, str, int, Optional[dt.datetime], Optional[dt.datetime]]] = []
    if not isinstance(payload, dict):
        return records

    for scope in payload.get("scopeMetrics") or []:
        if not isinstance(scope, dict):
            continue
        for metric in scope.get("metrics") or []:
            if metric_name(metric) != preferred_metric:
                continue
            for point in metric.get("dataPoints") or []:
                if not isinstance(point, dict):
                    continue
                attributes = point.get("attributes") if isinstance(point.get("attributes"), dict) else {}
                if preferred_metric == "gemini_cli.token.usage":
                    token_key = gemini_token_key(attributes.get("type"))
                    model = str(attributes.get("model") or "unknown")
                else:
                    token_key = gemini_token_key(attributes.get("gen_ai.token.type"))
                    model = str(attributes.get("gen_ai.response.model") or attributes.get("gen_ai.request.model") or "unknown")
                amount = metric_value(point.get("value"))
                if token_key is None or amount is None:
                    continue
                start_raw = point.get("startTime") if point.get("startTime") is not None else point.get("startTimeUnixNano")
                end_raw = (
                    point.get("endTime")
                    if point.get("endTime") is not None
                    else point.get("endTimeUnixNano")
                    if point.get("endTimeUnixNano") is not None
                    else point.get("timeUnixNano")
                )
                start_when = timestamp_from_otel(start_raw)
                when = timestamp_from_otel(end_raw) or start_when
                identity = (
                    preferred_metric,
                    attributes.get("session.id"),
                    model,
                    token_key,
                    freeze_identity_value(start_raw),
                )
                records.append((identity, token_key, model, amount, when, start_when))
    return records


def parse_gemini_telemetry(text: str) -> Tuple[Dict[str, int], Dict[str, Dict[str, int]], Dict[str, int], Dict[str, int], int]:
    records: List[Tuple[Tuple[Any, ...], str, str, int, Optional[dt.datetime], Optional[dt.datetime]]] = []
    for payload in iter_json_objects(text):
        records.extend(gemini_metric_records(payload, "gemini_cli.token.usage"))

    if not records:
        for payload in iter_json_objects(text):
            records.extend(gemini_metric_records(payload, "gen_ai.client.token.usage"))

    by_identity: Dict[Tuple[Any, ...], List[Tuple[str, str, int, Optional[dt.datetime], Optional[dt.datetime]]]] = {}
    for identity, token_key, model, amount, when, start_when in records:
        by_identity.setdefault(identity, []).append((token_key, model, amount, when, start_when))

    tokens: Dict[str, int] = empty_periods()
    models: Dict[str, Dict[str, int]] = {}
    daily_tokens: Dict[str, int] = {}
    hourly_tokens: Dict[str, int] = {}
    periods = empty_periods()
    events = 0
    for group in by_identity.values():
        group.sort(
            key=lambda item: (
                (item[3] or item[4] or dt.datetime.fromtimestamp(0, dt.timezone.utc)).timestamp(),
                item[2],
            )
        )
        previous_amount: Optional[int] = None
        for token_key, model, amount, when, start_when in group:
            if previous_amount is None:
                delta = amount
                bucket_when = start_when if local_date_changed(start_when, when) else (when or start_when)
            elif amount >= previous_amount:
                delta = amount - previous_amount
                bucket_when = when or start_when
            else:
                # Counter reset within the same session identity.
                delta = amount
                bucket_when = when or start_when
            previous_amount = amount
            if delta <= 0:
                continue

            events += 1
            tokens[token_key] = tokens.get(token_key, 0) + delta
            model_tokens = models.setdefault(model, empty_periods())
            model_tokens[token_key] = model_tokens.get(token_key, 0) + delta
            add_to_periods(model_tokens, delta, bucket_when)
            add_to_periods(periods, delta, bucket_when)
            add_to_daily(daily_tokens, delta, bucket_when)
            add_to_hourly(hourly_tokens, delta, bucket_when)

    total = sum(tokens.values())
    if total > 0:
        tokens["totalTokens"] = total
        for key, amount in periods.items():
            tokens[key] = amount
    return tokens, models, daily_tokens, hourly_tokens, events


def empty_gemini_usage_state(telemetry_path: Optional[Path] = None) -> Dict[str, Any]:
    telemetry_path = telemetry_path or GEMINI_TELEMETRY
    return {
        "version": GEMINI_USAGE_CACHE_VERSION,
        "source": str(telemetry_path),
        "offset": 0,
        "size": 0,
        "mtimeNs": 0,
        "tokenClasses": {},
        "models": {},
        "modelDailyTokens": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        "events": 0,
        "identities": {},
    }


def load_gemini_usage_state(
    stat: os.stat_result,
    *,
    telemetry_path: Optional[Path] = None,
    cache_path: Optional[Path] = None,
) -> Dict[str, Any]:
    telemetry_path = telemetry_path or GEMINI_TELEMETRY
    cache_path = cache_path or GEMINI_USAGE_CACHE
    try:
        raw = json.loads(cache_path.read_text(encoding="utf-8"))
    except Exception:
        return empty_gemini_usage_state(telemetry_path)
    if not isinstance(raw, dict):
        return empty_gemini_usage_state(telemetry_path)
    if raw.get("version") != GEMINI_USAGE_CACHE_VERSION:
        return empty_gemini_usage_state(telemetry_path)
    if raw.get("source") != str(telemetry_path):
        return empty_gemini_usage_state(telemetry_path)
    offset = int_limit(raw.get("offset")) or 0
    if offset < 0:
        return empty_gemini_usage_state(telemetry_path)
    if offset > stat.st_size:
        cached_size = int_limit(raw.get("size")) or 0
        if cached_size == stat.st_size:
            raw["offset"] = int(stat.st_size)
        else:
            # The telemetry log was truncated/rotated (e.g. the user reclaimed disk from
            # a multi-GB file, or our own cleaner ran). Do NOT discard the accumulated
            # history (audit #2 — this was a full wipe of week/month/all). Keep the
            # totals + the `identities` dedup map and re-scan from offset 0: dedup makes
            # re-counting any records that survived truncation a no-op, so at worst we
            # miss brand-new records in the truncated span, never lose confirmed history.
            raw["offset"] = 0
            raw["size"] = 0
            raw["mtimeNs"] = 0
    return raw


def save_gemini_usage_state(state: Dict[str, Any], cache_path: Optional[Path] = None) -> None:
    cache_path = cache_path or GEMINI_USAGE_CACHE
    ensure_dirs()
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = unique_atomic_tmp_path(cache_path)
    tmp.write_text(json.dumps(state, sort_keys=True, separators=(",", ":")), encoding="utf-8")
    tmp.replace(cache_path)


def gemini_identity_key(identity: Tuple[Any, ...]) -> str:
    return json.dumps(identity, sort_keys=True, separators=(",", ":"), default=str)


def add_gemini_delta_to_state(
    state: Dict[str, Any],
    *,
    token_key: str,
    model: str,
    amount: int,
    when: Optional[dt.datetime],
) -> None:
    token_classes = state.setdefault("tokenClasses", {})
    token_classes[token_key] = int(token_classes.get(token_key) or 0) + amount

    models = state.setdefault("models", {})
    model_tokens = models.setdefault(model, {})
    model_tokens[token_key] = int(model_tokens.get(token_key) or 0) + amount

    day_key = day_key_for_timestamp(when)
    if day_key:
        daily_tokens = state.setdefault("dailyTokens", {})
        daily_tokens[day_key] = int(daily_tokens.get(day_key) or 0) + amount
        model_daily = state.setdefault("modelDailyTokens", {}).setdefault(model, {})
        model_daily[day_key] = int(model_daily.get(day_key) or 0) + amount

    hour_key = hour_key_for_timestamp(when)
    if hour_key:
        hourly_tokens = state.setdefault("hourlyTokens", {})
        hourly_tokens[hour_key] = int(hourly_tokens.get(hour_key) or 0) + amount

    state["events"] = int(state.get("events") or 0) + 1


def apply_gemini_records_to_state(
    state: Dict[str, Any],
    records: List[Tuple[Tuple[Any, ...], str, str, int, Optional[dt.datetime], Optional[dt.datetime]]],
) -> None:
    by_identity: Dict[Tuple[Any, ...], List[Tuple[str, str, int, Optional[dt.datetime], Optional[dt.datetime]]]] = {}
    for identity, token_key, model, amount, when, start_when in records:
        by_identity.setdefault(identity, []).append((token_key, model, amount, when, start_when))

    identities = state.setdefault("identities", {})
    for identity, group in by_identity.items():
        identity_key = gemini_identity_key(identity)
        last = identities.get(identity_key) if isinstance(identities.get(identity_key), dict) else {}
        previous_amount = int_limit(last.get("amount")) if isinstance(last, dict) else None
        group.sort(
            key=lambda item: (
                (item[3] or item[4] or dt.datetime.fromtimestamp(0, dt.timezone.utc)).timestamp(),
                item[2],
            )
        )
        for token_key, model, amount, when, start_when in group:
            if previous_amount is None:
                delta = amount
                bucket_when = start_when if local_date_changed(start_when, when) else (when or start_when)
            elif amount >= previous_amount:
                delta = amount - previous_amount
                bucket_when = when or start_when
            else:
                delta = amount
                bucket_when = when or start_when
            previous_amount = amount
            if delta <= 0:
                continue
            add_gemini_delta_to_state(
                state,
                token_key=token_key,
                model=model,
                amount=delta,
                when=bucket_when,
            )
        if previous_amount is not None:
            identities[identity_key] = {"amount": previous_amount}


def iter_gemini_telemetry_payloads(offset: int = 0, telemetry_path: Optional[Path] = None) -> Iterable[Tuple[Any, int]]:
    telemetry_path = telemetry_path or GEMINI_TELEMETRY
    decoder = json.JSONDecoder()
    buffer = ""
    buffer_start = offset
    chunk_size = max(GEMINI_TELEMETRY_STREAM_CHUNK_BYTES, 1024 * 1024)
    with telemetry_path.open("rb") as fh:
        fh.seek(offset)
        while True:
            chunk = fh.read(chunk_size)
            eof = not chunk
            if chunk:
                buffer += chunk.decode("utf-8", errors="replace")

            index = 0
            while True:
                while index < len(buffer) and buffer[index].isspace():
                    index += 1
                if index >= len(buffer):
                    buffer_start += len(buffer.encode("utf-8"))
                    buffer = ""
                    break
                if buffer[index] != "{":
                    next_object = buffer.find("{", index + 1)
                    if next_object < 0:
                        if eof:
                            buffer_start += len(buffer.encode("utf-8"))
                            buffer = ""
                        elif index > 0:
                            buffer_start += len(buffer[:index].encode("utf-8"))
                            buffer = buffer[index:]
                        break
                    index = next_object
                try:
                    payload, end = decoder.raw_decode(buffer, index)
                except json.JSONDecodeError:
                    if index > 0:
                        buffer_start += len(buffer[:index].encode("utf-8"))
                        buffer = buffer[index:]
                    break
                end_offset = buffer_start + len(buffer[:end].encode("utf-8"))
                yield payload, end_offset
                index = end
                if index >= 1024 * 1024:
                    buffer_start += len(buffer[:index].encode("utf-8"))
                    buffer = buffer[index:]
                    index = 0

            if eof:
                break


def gemini_remaining_bytes_are_whitespace(offset: int, file_size: int, telemetry_path: Optional[Path] = None) -> bool:
    telemetry_path = telemetry_path or GEMINI_TELEMETRY
    if offset >= file_size:
        return True
    remaining = file_size - offset
    if remaining > max(GEMINI_TELEMETRY_STREAM_CHUNK_BYTES, 1024 * 1024):
        return False
    with telemetry_path.open("rb") as fh:
        fh.seek(offset)
        return not fh.read(remaining).strip()


def scan_gemini_telemetry_state(
    state: Dict[str, Any],
    stat: os.stat_result,
    *,
    telemetry_path: Optional[Path] = None,
) -> Dict[str, Any]:
    telemetry_path = telemetry_path or GEMINI_TELEMETRY
    offset = int_limit(state.get("offset")) or 0
    if offset < 0 or offset > stat.st_size:
        state = empty_gemini_usage_state(telemetry_path)
        offset = 0

    last_offset = offset
    for payload, end_offset in iter_gemini_telemetry_payloads(offset, telemetry_path=telemetry_path):
        records = gemini_metric_records(payload, "gemini_cli.token.usage")
        if not records:
            records = gemini_metric_records(payload, "gen_ai.client.token.usage")
        if records:
            apply_gemini_records_to_state(state, records)
        last_offset = max(last_offset, end_offset)

    if gemini_remaining_bytes_are_whitespace(last_offset, int(stat.st_size), telemetry_path=telemetry_path):
        last_offset = int(stat.st_size)

    state["source"] = str(telemetry_path)
    state["offset"] = min(last_offset, int(stat.st_size))
    state["size"] = int(stat.st_size)
    state["mtimeNs"] = int(stat.st_mtime_ns)
    return state


def rotate_telemetry_log_if_oversized(
    state: Dict[str, Any], telemetry_path: Path
) -> Dict[str, Any]:
    """Reclaim the OTEL log once every byte of it has been read.

    Agent Cat configures the CLI to append here, so it owns the file's
    lifecycle — but nothing ever trimmed it (8.9 GB measured on a dev machine).

    Truncating only when ``offset == size`` guarantees no unread record is
    destroyed; an unread tail simply defers rotation to a later tick. The
    accumulated totals are safe because they live in the cache state, not in the
    log, and ``load_gemini_usage_state`` already treats "offset > size" as a
    rotation — it rescans from zero, where the ``identities`` dedup map makes
    recounting a no-op. So this reclaims disk without losing history or
    double-counting it.
    """
    if TELEMETRY_LOG_MAX_BYTES <= 0:
        return state
    size = int(state.get("size") or 0)
    if size < TELEMETRY_LOG_MAX_BYTES:
        return state
    if int(state.get("offset") or 0) < size:
        return state
    try:
        with telemetry_path.open("r+b") as fh:
            fh.truncate(0)
        stat = telemetry_path.stat()
    except OSError as exc:
        # Losing a rotation is survivable; failing the usage scan is not.
        logging.warning(
            "agentcat: could not rotate %s: %s", _tilde(telemetry_path), type(exc).__name__
        )
        return state
    logging.info(
        "agentcat: rotated %s at %d MB (fully read)", _tilde(telemetry_path), size // (1024 * 1024)
    )
    state["offset"] = 0
    state["size"] = int(stat.st_size)
    state["mtimeNs"] = int(stat.st_mtime_ns)
    return state


def int_map(raw: Any) -> Dict[str, int]:
    out: Dict[str, int] = {}
    if not isinstance(raw, dict):
        return out
    for key, value in raw.items():
        amount = int_limit(value)
        if amount is not None:
            out[str(key)] = amount
    return out


def periods_from_daily_tokens(daily_tokens: Dict[str, int]) -> Dict[str, int]:
    """Return exact local-calendar 1-, 7-, 30-day and all-time totals."""
    periods = empty_periods()
    today_local = dt.datetime.now(dt.timezone.utc).astimezone().date()
    week_start = today_local - dt.timedelta(days=6)
    month_start = today_local - dt.timedelta(days=29)
    for day, amount in daily_tokens.items():
        if amount <= 0:
            continue
        periods["all"] = periods.get("all", 0) + amount
        try:
            day_date = dt.date.fromisoformat(str(day)[:10])
        except ValueError:
            continue
        if day_date == today_local:
            periods["today"] = periods.get("today", 0) + amount
        if week_start <= day_date <= today_local:
            periods["week"] = periods.get("week", 0) + amount
        if month_start <= day_date <= today_local:
            periods["month"] = periods.get("month", 0) + amount
    return periods


def gemini_usage_result_from_state(state: Dict[str, Any]) -> Dict[str, Any]:
    token_classes = int_map(state.get("tokenClasses"))
    daily_tokens = int_map(state.get("dailyTokens"))
    hourly_tokens = int_map(state.get("hourlyTokens"))

    tokens = {**empty_periods(), **token_classes}
    total = sum(token_classes.values())
    if total > 0:
        tokens["totalTokens"] = total
        periods = periods_from_daily_tokens(daily_tokens)
        periods["all"] = total
        for key, amount in periods.items():
            tokens[key] = amount

    models: Dict[str, Dict[str, int]] = {}
    raw_models = state.get("models") if isinstance(state.get("models"), dict) else {}
    raw_model_daily = state.get("modelDailyTokens") if isinstance(state.get("modelDailyTokens"), dict) else {}
    for model, raw_model_tokens in raw_models.items():
        raw_token_classes = int_map(raw_model_tokens)
        model_total = sum(raw_token_classes.values())
        if model_total <= 0:
            continue
        model_tokens = {**empty_periods(), **raw_token_classes}
        model_daily = int_map(raw_model_daily.get(model)) if isinstance(raw_model_daily, dict) else {}
        periods = periods_from_daily_tokens(model_daily)
        periods["all"] = model_total
        for key, amount in periods.items():
            model_tokens[key] = amount
        models[str(model)] = model_tokens

    return {
        "tokens": tokens,
        "models": models,
        "dailyTokens": daily_tokens,
        "hourlyTokens": hourly_tokens,
        "modelDailyTokens": {
            str(model): int_map(days)
            for model, days in (raw_model_daily.items() if isinstance(raw_model_daily, dict) else [])
        },
        "events": int(state.get("events") or 0),
        "cache": {
            "source": "full-log-index",
            "offset": int(state.get("offset") or 0),
            "size": int(state.get("size") or 0),
        },
    }


def antigravity_history_days() -> set:
    days = set()
    path = ANTIGRAVITY_CLI_DIR / "history.jsonl"
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except Exception:
        return days
    for line in lines[-2000:]:
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(payload, dict):
            continue
        when = parse_timestamp(payload.get("timestamp"))
        day = day_key_for_timestamp(when)
        if day:
            days.add(day)
    return days


def antigravity_inference_days(activity: Optional[Dict[str, Any]]) -> set:
    days = antigravity_history_days()
    counts = activity.get("countsByProvider") if isinstance(activity, dict) else {}
    if isinstance(counts, dict) and int(counts.get("antigravity") or 0) > 0 and int(counts.get("gemini") or 0) <= 0:
        now_utc = dt.datetime.now(dt.timezone.utc)
        today_utc = day_key_for_timestamp(now_utc)
        today_local = day_key_for_timestamp(now_utc.astimezone())
        if today_utc:
            days.add(today_utc)
        if today_local:
            days.add(today_local)
    return days


def _hour_day_key(raw: str) -> str:
    return str(raw or "")[:10]


def filter_google_usage_days(usage: Dict[str, Any], days: set, *, include: bool) -> Dict[str, Any]:
    daily_tokens = {
        day: amount
        for day, amount in int_map(usage.get("dailyTokens")).items()
        if (day in days) == include
    }
    hourly_tokens = {
        hour: amount
        for hour, amount in int_map(usage.get("hourlyTokens")).items()
        if (_hour_day_key(hour) in days) == include
    }
    model_daily_raw = usage.get("modelDailyTokens") if isinstance(usage.get("modelDailyTokens"), dict) else {}
    source_models = usage.get("models") if isinstance(usage.get("models"), dict) else {}
    models: Dict[str, Dict[str, int]] = {}
    model_daily_tokens: Dict[str, Dict[str, int]] = {}
    for model, raw_days in model_daily_raw.items():
        model_days = {
            day: amount
            for day, amount in int_map(raw_days).items()
            if (day in days) == include
        }
        model_total = sum(model_days.values())
        if model_total <= 0:
            continue
        source_model_tokens = int_map(source_models.get(model))
        original_model_total = (
            source_model_tokens.get("totalTokens")
            or source_model_tokens.get("all")
            or sum(source_model_tokens.get(key, 0) for key in TOKEN_CLASS_KEYS)
        )
        periods = periods_from_daily_tokens(model_days)
        periods["all"] = model_total
        model_tokens = empty_periods()
        model_tokens.update({
            key: _scaled_token_class(source_model_tokens.get(key, 0), model_total, original_model_total)
            for key in TOKEN_CLASS_KEYS
        })
        for key, amount in periods.items():
            model_tokens[key] = amount
        models[str(model)] = model_tokens
        model_daily_tokens[str(model)] = model_days

    total = sum(daily_tokens.values())
    tokens: Dict[str, int] = empty_periods()
    source_tokens = usage.get("tokens") if isinstance(usage.get("tokens"), dict) else {}
    original_total = int(source_tokens.get("totalTokens") or source_tokens.get("all") or 0)
    if total > 0:
        for key in TOKEN_CLASS_KEYS:
            amount = _scaled_token_class(int(source_tokens.get(key) or 0), total, original_total)
            if amount > 0:
                tokens[key] = amount
        tokens["totalTokens"] = total
        periods = periods_from_daily_tokens(daily_tokens)
        periods["all"] = total
        for key, amount in periods.items():
            tokens[key] = amount

    filtered = {
        "tokens": tokens,
        "models": models,
        "dailyTokens": daily_tokens,
        "hourlyTokens": hourly_tokens,
        "modelDailyTokens": model_daily_tokens,
        "events": int(usage.get("events") or 0) if total > 0 and total == original_total else 0,
        "cache": copy.deepcopy(usage.get("cache") or {"source": "filtered"}),
    }
    if total > 0 and total != original_total:
        filtered["cache"]["source"] = "filtered-by-antigravity-history"
    return filtered


def google_usage_total(usage: Optional[Dict[str, Any]]) -> int:
    if not isinstance(usage, dict):
        return 0
    tokens = usage.get("tokens") if isinstance(usage.get("tokens"), dict) else {}
    return int(tokens.get("totalTokens") or tokens.get("all") or sum(v for v in tokens.values() if isinstance(v, int)) or 0)


def apply_google_usage(snapshot: Dict[str, Any], usage: Optional[Dict[str, Any]], *, status_if_empty: Optional[str] = None) -> Dict[str, Any]:
    out = copy.deepcopy(snapshot)
    usage = usage if isinstance(usage, dict) else {}
    if out.get("providerLabel") == "Antigravity" and google_usage_total(usage) <= 0:
        out["tokens"] = {}
    else:
        out["tokens"] = gemini_period_map(usage.get("tokens"))
    out["models"] = {}
    for model, raw_tokens in (usage.get("models") or {}).items():
        model_tokens = gemini_period_map(raw_tokens)
        if model_tokens["all"] > 0:
            out["models"][str(model)] = model_tokens
    out["dailyTokens"] = copy.deepcopy(usage.get("dailyTokens") or {})
    out["hourlyTokens"] = copy.deepcopy(usage.get("hourlyTokens") or {})
    out["events"] = int(usage.get("events") or 0)
    out["cache"] = copy.deepcopy(usage.get("cache") or {"source": "none"})
    out["status"] = "ok" if google_usage_total(usage) > 0 else (status_if_empty or out.get("status") or "no_token_events_yet")
    return out


# --- Antigravity local usage via its conversation SQLite store ------------------
# agy does not emit an OTEL token stream on Windows, but it persists each
# generation in ~/.gemini/antigravity-cli/conversations/*.db. gen_metadata is an
# unversioned protobuf blob, so this reader deliberately parses only known fields,
# rejects implausible values, and fails soft if the upstream schema changes.

def _pb_varint(blob: bytes, index: int) -> Tuple[Optional[int], int]:
    shift = 0
    value = 0
    while index < len(blob):
        byte = blob[index]
        index += 1
        value |= (byte & 0x7F) << shift
        if not (byte & 0x80):
            return value, index
        shift += 7
        if shift > 63:
            return None, index
    return None, index


def _pb_parse(blob: bytes) -> Dict[int, List[Tuple[int, Any]]]:
    """Parse one protobuf message level, stopping safely on malformed input."""
    fields: Dict[int, List[Tuple[int, Any]]] = {}
    index = 0
    while index < len(blob):
        key, index = _pb_varint(blob, index)
        if key is None:
            break
        field_number, wire_type = key >> 3, key & 7
        if field_number <= 0:
            break
        if wire_type == 0:
            value, index = _pb_varint(blob, index)
            if value is None:
                break
        elif wire_type == 1:
            if index + 8 > len(blob):
                break
            value = int.from_bytes(blob[index:index + 8], "little")
            index += 8
        elif wire_type == 2:
            length, index = _pb_varint(blob, index)
            if length is None or index + length > len(blob):
                break
            value = blob[index:index + length]
            index += length
        elif wire_type == 5:
            if index + 4 > len(blob):
                break
            value = int.from_bytes(blob[index:index + 4], "little")
            index += 4
        else:
            break
        fields.setdefault(field_number, []).append((wire_type, value))
    return fields


def _pb_submsg(fields: Dict[int, List[Tuple[int, Any]]], number: int) -> Optional[Dict[int, List[Tuple[int, Any]]]]:
    for wire_type, value in fields.get(number, []):
        if wire_type == 2 and isinstance(value, (bytes, bytearray)):
            return _pb_parse(bytes(value))
    return None


def _pb_uint(fields: Dict[int, List[Tuple[int, Any]]], number: int) -> Optional[int]:
    for wire_type, value in fields.get(number, []):
        if wire_type == 0 and isinstance(value, int):
            return value
    return None


def _pb_str(fields: Dict[int, List[Tuple[int, Any]]], number: int) -> Optional[str]:
    for wire_type, value in fields.get(number, []):
        if wire_type == 2 and isinstance(value, (bytes, bytearray)):
            try:
                return bytes(value).decode("utf-8")
            except UnicodeDecodeError:
                return None
    return None


# Reverse-engineered agy 1.0.x gen_metadata fields:
#   .1.4.(1,2,3,9) cache/input/output/thought tokens
#   .1.9.4.1 timestamp, .1.(21|19) model label/id
_ANTIGRAVITY_TOKEN_SANITY_MAX = 5_000_000


def _antigravity_gen_metrics(blob: bytes) -> Optional[Tuple[str, Optional[dt.datetime], Dict[str, int]]]:
    message = _pb_submsg(_pb_parse(blob), 1) if blob else None
    usage = _pb_submsg(message, 4) if message else None
    if not usage:
        return None
    cache = _pb_uint(usage, 1) or 0
    input_tokens = _pb_uint(usage, 2) or 0
    output_tokens = _pb_uint(usage, 3) or 0
    thought_tokens = _pb_uint(usage, 9) or 0
    values = (cache, input_tokens, output_tokens, thought_tokens)
    if any(value < 0 or value >= _ANTIGRAVITY_TOKEN_SANITY_MAX for value in values):
        return None
    if input_tokens == 0 and output_tokens == 0:
        return None

    model = _pb_str(message, 21) or _pb_str(message, 19) or "Antigravity"
    when: Optional[dt.datetime] = None
    generation = _pb_submsg(message, 9)
    timestamp_message = _pb_submsg(generation, 4) if generation else None
    timestamp_value = _pb_uint(timestamp_message, 1) if timestamp_message else None
    if isinstance(timestamp_value, int) and 1_600_000_000 < timestamp_value < 4_000_000_000:
        when = dt.datetime.fromtimestamp(timestamp_value, dt.timezone.utc)
    return model, when, {
        "inputTokens": input_tokens,
        "outputTokens": output_tokens,
        "cacheReadInputTokens": cache,
        "thoughtTokens": thought_tokens,
    }


def antigravity_conversations_dir() -> Path:
    return ANTIGRAVITY_CLI_DIR / "conversations"


def antigravity_sqlite_usage() -> Optional[Dict[str, Any]]:
    """Return real Antigravity usage from local read-only trajectory databases."""
    conversations = antigravity_conversations_dir()
    if not conversations.exists():
        return None
    try:
        # Do not preflight candidates with Path.is_file(): on older pathlib
        # versions it uses Path.stat(), which can hide an otherwise readable DB.
        databases = sorted(conversations.glob("*.db"))
    except OSError:
        return None
    result = empty_provider_usage(source=str(conversations))
    events = 0
    for database in databases:
        connection: Optional[sqlite3.Connection] = None
        try:
            database_when = dt.datetime.fromtimestamp(database.stat().st_mtime, dt.timezone.utc)
        except (OSError, OverflowError, ValueError):
            database_when = None
        try:
            connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
            rows = connection.execute(
                "select data from gen_metadata where length(data) < 100000 order by rowid"
            ).fetchall()
        except (OSError, sqlite3.Error):
            continue
        finally:
            if connection is not None:
                connection.close()
        for (blob,) in rows:
            if not isinstance(blob, (bytes, bytearray)):
                continue
            parsed = _antigravity_gen_metrics(bytes(blob))
            if parsed is None:
                continue
            model, when, metrics = parsed
            if add_usage_metrics(result, model, metrics, when or database_when):
                events += 1
    if events == 0:
        return None
    result["status"] = "ok"
    result["events"] = events
    result["source"] = str(conversations)
    return result


def antigravity_provider_snapshot(
    gemini_snapshot_data: Dict[str, Any],
    usage: Optional[Dict[str, Any]],
    *,
    status_if_empty: str,
    source_note: str,
    source_status_override: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    source_status = copy.deepcopy(
        source_status_override
        if isinstance(source_status_override, dict)
        else (gemini_snapshot_data.get("sources") or {}).get("antigravityCli") or {}
    )
    has_usage = google_usage_total(usage) > 0
    if usage and has_usage:
        source_status["status"] = (
            "inferred_from_history"
            if source_note == "history-day-inference"
            else "ok"
        )
        source_status["tokens"] = google_usage_total(usage)
        source_status["events"] = int(usage.get("events") or source_status.get("events") or 0)
    source_status.setdefault(
        "collectionMethod",
        "history_day_inference"
        if source_note == "history-day-inference"
        else "dedicated_otel_token_metrics"
        if has_usage
        else "server_side_only_no_local_token_stream",
    )
    out = {
        "status": "ok" if google_usage_total(usage) > 0 else status_if_empty,
        "source": source_status.get("source") or str(ANTIGRAVITY_TELEMETRY),
        "canonicalProvider": "google",
        "providerLabel": "Antigravity",
        "displayName": "Antigravity",
        "sourceAttribution": source_note,
        "sources": {"antigravityCli": source_status},
        "tokens": {},
        "models": {},
        "dailyTokens": {},
        "hourlyTokens": {},
        "events": 0,
        "cache": {"source": "none"},
        "breakdown": empty_breakdown(),
    }
    return apply_google_usage(out, usage, status_if_empty=status_if_empty)


def split_google_cli_snapshots(
    gemini_snapshot_data: Dict[str, Any],
    activity: Optional[Dict[str, Any]],
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    source_usages = gemini_snapshot_data.pop("_sourceUsages", {})
    common_usage = source_usages.get("geminiCli") if isinstance(source_usages, dict) else None
    antigravity_usage = source_usages.get("antigravityCli") if isinstance(source_usages, dict) else None
    source_statuses = gemini_snapshot_data.get("sources") if isinstance(gemini_snapshot_data.get("sources"), dict) else {}
    gemini_source_status = copy.deepcopy(source_statuses.get("geminiCli") or {})
    antigravity_source_status = copy.deepcopy(source_statuses.get("antigravityCli") or {})
    gemini_snapshot_data["sources"] = {"geminiCli": gemini_source_status} if gemini_source_status else {}
    gemini_source_path = gemini_source_status.get("source")
    if gemini_source_path:
        gemini_snapshot_data["source"] = gemini_source_path

    # Tier 1: Antigravity has its own dedicated local telemetry outfile. This is
    # the only honest source of Antigravity tokens, so the gemini provider keeps
    # the gemini-cli usage and antigravity gets its own.
    if google_usage_total(antigravity_usage) > 0:
        gemini_provider = apply_google_usage(gemini_snapshot_data, common_usage, status_if_empty="no_token_events_yet")
        antigravity_provider = antigravity_provider_snapshot(
            gemini_snapshot_data,
            antigravity_usage,
            status_if_empty="no_token_events_yet",
            source_note="dedicated-telemetry",
            source_status_override=antigravity_source_status,
        )
        return gemini_provider, antigravity_provider

    # Tier 1.5: the local trajectory DB is the honest Antigravity token source on
    # Windows. Schema drift or an unreadable DB fails soft to the empty fallback.
    sqlite_usage = antigravity_sqlite_usage()
    if google_usage_total(sqlite_usage) > 0:
        gemini_provider = apply_google_usage(gemini_snapshot_data, common_usage, status_if_empty="no_token_events_yet")
        sqlite_source_status = dict(antigravity_source_status)
        sqlite_source_status["collectionMethod"] = "local_sqlite_trajectory"
        sqlite_source_status["source"] = str(antigravity_conversations_dir())
        antigravity_provider = antigravity_provider_snapshot(
            gemini_snapshot_data,
            sqlite_usage,
            status_if_empty="no_token_events_yet",
            source_note="local-sqlite-trajectory",
            source_status_override=sqlite_source_status,
        )
        return gemini_provider, antigravity_provider

    # Tier 2: older Antigravity installs could share Google's common telemetry
    # stream. Only an explicitly unconfigured Gemini telemetry source is
    # eligible; a missing flag is unknown and stays Gemini-owned. Within that
    # legacy stream, attribute complete days corroborated by Antigravity's own
    # history (or an unambiguous currently-active process), remove those days
    # from Gemini, and label the result as inference. Dedicated OTEL and local
    # trajectory SQLite above always win and are never filtered.
    counts = activity.get("countsByProvider") if isinstance(activity, dict) else {}
    inference_days = antigravity_inference_days(activity)
    if inference_days:
        antigravity_source_status["historyDays"] = len(inference_days)
    antigravity_installed = bool(antigravity_source_status.get("installed"))
    antigravity_active = isinstance(counts, dict) and int(counts.get("antigravity") or 0) > 0
    if (
        inference_days
        and google_usage_total(common_usage) > 0
        and (antigravity_installed or antigravity_active)
        and gemini_source_status.get("telemetryConfigured") is False
    ):
        inferred_usage = filter_google_usage_days(common_usage, inference_days, include=True)
        if google_usage_total(inferred_usage) > 0:
            gemini_usage = filter_google_usage_days(common_usage, inference_days, include=False)
            gemini_provider = apply_google_usage(
                gemini_snapshot_data,
                gemini_usage,
                status_if_empty="no_token_events_yet",
            )
            inferred_source_status = dict(antigravity_source_status)
            inferred_source_status["source"] = gemini_source_path or str(GEMINI_TELEMETRY)
            inferred_source_status["collectionMethod"] = "history_day_inference"
            antigravity_provider = antigravity_provider_snapshot(
                gemini_snapshot_data,
                inferred_usage,
                status_if_empty="no_token_events_yet",
                source_note="history-day-inference",
                source_status_override=inferred_source_status,
            )
            return gemini_provider, antigravity_provider

    # Without corroborated days there is no honest fallback attribution.
    status_if_empty = "no_telemetry_yet" if (antigravity_installed or antigravity_active) else "not_found"
    antigravity_provider = antigravity_provider_snapshot(
        gemini_snapshot_data,
        None,
        status_if_empty=status_if_empty,
        source_note="no-antigravity-telemetry",
        source_status_override=antigravity_source_status,
    )
    return gemini_snapshot_data, antigravity_provider


def command_parts(command: str) -> List[str]:
    text = command.strip()
    if not text:
        return []
    try:
        parts = shlex.split(text, posix=not IS_WINDOWS)
    except ValueError:
        parts = text.split()
    return [part.strip("\"'") for part in parts if part.strip("\"'")]


def executable_name(command: str) -> Optional[str]:
    parts = command_parts(command)
    if not parts:
        return None
    first = parts[0]

    def basename(value: str) -> str:
        return Path(value.replace("\\", "/")).name.lower()

    executable = basename(first)
    if executable in {"node", "node.exe"} and len(parts) > 1:
        for part in parts[1:]:
            if part.startswith("-"):
                continue
            first = part
            break
    return basename(first)


def classify_process(command: str) -> Optional[str]:
    lower = command.lower()
    normalized = lower.replace("\\", "/")
    if (
        "/agent cat.app/" in normalized
        or "/agentcatmac/" in normalized
        or "agentcat-connectors/bin/agentcat" in normalized
        or "agent-cat-windows.exe" in normalized
    ):
        return None
    if "/applications/claude.app/contents/" in normalized:
        return None
    # ChatGPT now hosts the Codex surface. Its bundled helpers are not a
    # second CLI session and must not create a duplicate Codex process row.
    if "/applications/chatgpt.app/contents/" in normalized:
        return None
    if "/applications/antigravity.app/contents/" in normalized:
        return None
    if (
        "/windowsapps/openai.codex_" in normalized
        and "/app/codex.exe" in normalized
        and "/app/resources/codex.exe" not in normalized
    ):
        return None
    if (
        "/appdata/local/openai/codex/bin/" in normalized
        and "codex.exe" in normalized
        and "app-server --listen stdio://" in normalized
    ):
        return None
    if "/.vscode/extensions/openai.chatgpt-" in normalized:
        return None

    executable = executable_name(command)
    if not executable or executable in IGNORED_EXECUTABLES:
        return None

    if executable in {"codex", "codex.exe", "codex.cmd"} or "@openai/codex" in normalized:
        return "codex"
    if executable in {"claude", "claude.exe", "claude.cmd"} or "@anthropic-ai/claude" in normalized or "claude-code" in normalized:
        return "claude"
    if (
        executable in {"agy", "agy.exe", "antigravity", "antigravity.exe", "antigravity-cli"}
        or "/.gemini/antigravity-cli/" in normalized
        or "com.google.antigravity" in normalized
    ):
        return "antigravity"
    if (
        executable in {"gemini", "gemini.exe", "gemini.cmd", "gemini-cli"}
        or "@google/gemini" in normalized
    ):
        return "gemini"
    if executable in {"kimi", "kimi.exe", "kimi.cmd", "kimi-code", "kimi-code.exe", "kimi-code.cmd"}:
        return "kimi"
    if executable in {"grok", "grok.exe", "grok.cmd", "grok-code", "grok-code.exe", "grok-code.cmd", "grock"}:
        return "grok"
    return None


def safe_activity_command(provider: str, pid: int) -> str:
    return f"{provider} pid {pid}"


def motion_stage(process_count: int, total_cpu: float, runnable_process_count: int) -> str:
    if process_count <= 0:
        return "sleeping"

    activity_score = total_cpu + float(runnable_process_count) * 4.0
    if activity_score >= 22:
        return "sprinting"
    if activity_score >= 7:
        return "running"
    return "walking"


def empty_windows_activity_result() -> Dict[str, Any]:
    return {
        "status": "unknown",
        "updatedAt": now_iso(),
        "processCount": 0,
        "totalCPUPercent": 0,
        "totalMemoryBytes": 0,
        "motionStage": "sleeping",
        "runtimeModes": safe_runtime_modes_snapshot(),
        "countsByProvider": {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0},
        "memoryBytesByProvider": {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0},
        "processes": [],
    }


def windows_powershell_command() -> List[str]:
    for executable in ("pwsh.exe", "pwsh", "powershell.exe", "powershell"):
        found = shutil.which(executable)
        if found:
            return [found, "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command"]
    return ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]


def windows_activity_from_rows(
    rows: List[Dict[str, Any]],
    *,
    scan_source: str,
    scan_warning: Optional[str] = None,
) -> Dict[str, Any]:
    rows.sort(key=lambda row: (-float(row["cpuPercent"]), str(row["kind"])))
    counts = {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0}
    memory_by_provider = {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0}
    for row in rows:
        provider = str(row["kind"])
        counts[provider] = counts.get(provider, 0) + 1
        memory_by_provider[provider] = memory_by_provider.get(provider, 0) + int(row.get("memoryBytes") or 0)
    total_cpu = sum(float(row["cpuPercent"]) for row in rows)
    total_memory = sum(int(row.get("memoryBytes") or 0) for row in rows)
    runnable_process_count = sum(1 for row in rows if float(row.get("cpuPercent", 0)) > 0.1)
    activity_score = total_cpu + float(runnable_process_count) * 3.0

    result = empty_windows_activity_result()
    result.update(
        {
            "status": "ok",
            "processCount": len(rows),
            "totalCPUPercent": total_cpu,
            "totalMemoryBytes": total_memory,
            "runnableProcessCount": runnable_process_count,
            "activityScore": activity_score,
            "motionStage": motion_stage(len(rows), total_cpu, runnable_process_count),
            "runtimeModes": safe_runtime_modes_snapshot(
                active_providers=[provider for provider, count in counts.items() if count > 0]
            ),
            "countsByProvider": counts,
            "memoryBytesByProvider": memory_by_provider,
            "processes": rows,
            "scanSource": scan_source,
        }
    )
    if scan_warning:
        result["scanWarning"] = scan_warning[:240]
    return result


def terminal_activity_snapshot_windows_tasklist(scan_warning: Optional[str] = None) -> Dict[str, Any]:
    result = empty_windows_activity_result()
    try:
        completed = subprocess.run(
            ["tasklist.exe", "/FO", "CSV", "/NH"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=min(windows_process_scan_timeout_seconds(), 10.0),
            creationflags=CREATE_NO_WINDOW,
        )
    except Exception as exc:
        result["status"] = "error"
        result["error"] = str(exc)
        return result

    if completed.returncode != 0:
        result["status"] = "error"
        result["error"] = completed.stderr.strip() or "tasklist process scan failed"
        return result

    rows: List[Dict[str, Any]] = []
    for item in csv.reader(completed.stdout.splitlines()):
        if len(item) < 2:
            continue
        image_name = item[0]
        provider = classify_process(image_name)
        if provider is None:
            continue
        try:
            pid = int(item[1])
        except (TypeError, ValueError):
            continue
        memory_kb = 0
        if len(item) >= 5:
            digits = re.sub(r"[^0-9]", "", item[4])
            memory_kb = int(digits or 0)
        rows.append(
            {
                "pid": pid,
                "parentID": 0,
                "kind": provider,
                "cpuPercent": 0,
                "rssKilobytes": memory_kb,
                "memoryBytes": memory_kb * 1024,
                "state": "unknown",
                "command": safe_activity_command(provider, pid),
            }
        )
    return windows_activity_from_rows(rows, scan_source="tasklist", scan_warning=scan_warning)


def terminal_activity_snapshot_windows() -> Dict[str, Any]:
    result = empty_windows_activity_result()
    script = r"""
$ErrorActionPreference = 'SilentlyContinue'
# Win32_PerfFormattedData exposes the cooked per-process CPU % (sum across
# cores, like the app's own scan); a single query is a valid instantaneous
# sample, so no second-sample delta is needed. Without this, CPU was always 0.
$perf = Get-CimInstance Win32_PerfFormattedData_PerfProc_Process | Group-Object IDProcess -AsHashTable -AsString
$rows = @(
Get-Process |
  Where-Object {
    $text = (($_.ProcessName + ' ' + $_.Path).ToLower())
    $text -match '(^|[^a-z])(codex|claude|gemini|agy|antigravity)([^a-z]|$)'
  } |
  ForEach-Object {
    $cpu = 0
    $key = [string]$_.Id
    if ($perf -and $perf.ContainsKey($key)) { $v = $perf[$key].PercentProcessorTime; if ($v -is [array]) { $v = $v[0] }; $cpu = [double]$v }
    [pscustomobject]@{
      ProcessId = [uint32]$_.Id
      ParentProcessId = 0
      Name = $_.ProcessName
      Path = $_.Path
      CommandLine = $_.Path
      CpuPercent = $cpu
      WorkingSetSize = [int64]$_.WorkingSet64
    }
  }
)
if (-not $rows) {
  $rows = @(
  Get-CimInstance Win32_Process -Property ProcessId,ParentProcessId,Name,CommandLine,WorkingSetSize |
    Where-Object {
      $text = (($_.Name + ' ' + $_.CommandLine).ToLower())
      $text -match '(^|[^a-z])(codex|claude|gemini|agy|antigravity)([^a-z]|$)'
    } |
    ForEach-Object {
      $cpu = 0
      $key = [string]$_.ProcessId
      if ($perf -and $perf.ContainsKey($key)) { $v = $perf[$key].PercentProcessorTime; if ($v -is [array]) { $v = $v[0] }; $cpu = [double]$v }
      [pscustomobject]@{
        ProcessId = [uint32]$_.ProcessId
        ParentProcessId = [uint32]$_.ParentProcessId
        Name = $_.Name
        CommandLine = $_.CommandLine
        CpuPercent = $cpu
        WorkingSetSize = [int64]$_.WorkingSetSize
      }
    }
  )
}
$rows | ConvertTo-Json -Compress
"""
    try:
        completed = subprocess.run(
            windows_powershell_command() + [script],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=windows_process_scan_timeout_seconds(),
            creationflags=CREATE_NO_WINDOW,
        )
    except Exception as exc:
        fallback = terminal_activity_snapshot_windows_tasklist(scan_warning=f"PowerShell scan failed: {exc}")
        if fallback.get("status") == "ok":
            return fallback
        result["status"] = "error"
        result["error"] = str(exc)
        return result

    if completed.returncode != 0:
        fallback = terminal_activity_snapshot_windows_tasklist(
            scan_warning=completed.stderr.strip() or "PowerShell process scan failed"
        )
        if fallback.get("status") == "ok":
            return fallback
        result["status"] = "error"
        result["error"] = completed.stderr.strip() or "PowerShell process scan failed"
        return result

    text = completed.stdout.strip()
    if not text:
        return windows_activity_from_rows([], scan_source="powershell-get-process")

    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as exc:
        result["status"] = "error"
        result["error"] = str(exc)
        return result

    items = parsed if isinstance(parsed, list) else [parsed] if isinstance(parsed, dict) else []
    rows: List[Dict[str, Any]] = []
    for item in items:
        if not isinstance(item, dict):
            continue
        if item.get("CommandLine"):
            command = str(item.get("CommandLine"))
        elif item.get("Path"):
            command = json.dumps(str(item.get("Path")))
        else:
            command = str(item.get("Name") or "")
        provider = classify_process(command)
        if provider is None:
            continue
        try:
            pid = int(item.get("ProcessId") or 0)
            parent_id = int(item.get("ParentProcessId") or 0)
            cpu = float(item.get("CpuPercent") or 0)
            memory_bytes = int(item.get("WorkingSetSize") or 0)
        except (TypeError, ValueError):
            continue
        rows.append(
            {
                "pid": pid,
                "parentID": parent_id,
                "kind": provider,
                "cpuPercent": cpu,
                "rssKilobytes": max(memory_bytes, 0) // 1024,
                "memoryBytes": max(memory_bytes, 0),
                "state": "running" if cpu > 0.1 else "sleeping",
                "command": safe_activity_command(provider, pid),
            }
        )

    return windows_activity_from_rows(rows, scan_source="powershell-get-process")


def terminal_activity_snapshot() -> Dict[str, Any]:
    if IS_WINDOWS:
        return terminal_activity_snapshot_windows()

    result: Dict[str, Any] = {
        "status": "unknown",
        "updatedAt": now_iso(),
        "processCount": 0,
        "totalCPUPercent": 0,
        "totalMemoryBytes": 0,
        "motionStage": "sleeping",
        # Computed once below (or in the ps-error path) — NOT here, where it was a wasted
        # events-DB query on every snapshot since the success path overwrites it (audit #6).
        "runtimeModes": [],
        "countsByProvider": {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0},
        "memoryBytesByProvider": {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0},
        "processes": [],
    }
    try:
        completed = subprocess.run(
            ["/bin/ps", "-axo", "pid=,ppid=,pcpu=,rss=,stat=,command="],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=2.0,
        )
    except Exception as exc:
        result["status"] = "error"
        result["error"] = str(exc)
        result["runtimeModes"] = safe_runtime_modes_snapshot()
        return result

    rows: List[Dict[str, Any]] = []
    for raw_line in completed.stdout.splitlines():
        parts = raw_line.split(None, 5)
        if len(parts) != 6:
            continue
        try:
            pid = int(parts[0])
            parent_id = int(parts[1])
            cpu = float(parts[2])
            rss_kilobytes = int(parts[3])
        except ValueError:
            continue
        state = parts[4]
        command = parts[5]
        provider = classify_process(command)
        if provider is None:
            continue
        memory_bytes = max(rss_kilobytes, 0) * 1024
        rows.append(
            {
                "pid": pid,
                "parentID": parent_id,
                "kind": provider,
                "cpuPercent": cpu,
                "rssKilobytes": rss_kilobytes,
                "memoryBytes": memory_bytes,
                "state": state,
                "command": safe_activity_command(provider, pid),
            }
        )

    rows.sort(key=lambda row: (-float(row["cpuPercent"]), str(row["kind"])))
    counts = {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0}
    memory_by_provider = {"codex": 0, "claude": 0, "gemini": 0, "antigravity": 0}
    for row in rows:
        counts[str(row["kind"])] = counts.get(str(row["kind"]), 0) + 1
        memory_by_provider[str(row["kind"])] = memory_by_provider.get(str(row["kind"]), 0) + int(row.get("memoryBytes") or 0)
    total_cpu = sum(float(row["cpuPercent"]) for row in rows)
    total_memory = sum(int(row.get("memoryBytes") or 0) for row in rows)
    runnable_process_count = sum(1 for row in rows if str(row.get("state", "")).upper().startswith("R"))
    activity_score = total_cpu + float(runnable_process_count) * 4.0

    result.update(
        {
            "status": "ok",
            "processCount": len(rows),
            "totalCPUPercent": total_cpu,
            "totalMemoryBytes": total_memory,
            "runnableProcessCount": runnable_process_count,
            "activityScore": activity_score,
            "motionStage": motion_stage(len(rows), total_cpu, runnable_process_count),
            "runtimeModes": safe_runtime_modes_snapshot(
                active_providers=[provider for provider, count in counts.items() if count > 0]
            ),
            "countsByProvider": counts,
            "memoryBytesByProvider": memory_by_provider,
            "processes": rows,
        }
    )
    return result


CONNECTOR_VERSION_RE = re.compile(
    r"CONNECTOR_VERSION\s*=\s*os\.environ\.get\(\s*['\"]AGENTCAT_CONNECTOR_VERSION['\"]\s*,\s*['\"]([^'\"]+)['\"]"
)
CONNECTOR_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
VALID_UPDATE_CHANNELS = {"public"}


def agentcat_connectors_dir() -> Path:
    raw = os.environ.get("AGENTCAT_CONNECTORS_DIR")
    return Path(raw or str(AGENTCAT_HOME / "connectors")).expanduser().resolve()


def auto_update_state_file() -> Path:
    return AGENTCAT_HOME / "auto-update.json"


def update_channel_state_file() -> Path:
    return AGENTCAT_HOME / "update-channel.json"


def current_connector_repo_dir() -> Optional[Path]:
    try:
        script_path = Path(__file__).resolve()
    except Exception:
        return None
    if script_path.name != "agentcat" or script_path.parent.name != "bin":
        return None
    return script_path.parent.parent.resolve()


def parse_connector_version_from_text(text: str) -> Optional[str]:
    match = CONNECTOR_VERSION_RE.search(text)
    if not match:
        return None
    return match.group(1).strip() or None


def connector_version_key(version: str) -> Tuple[int, ...]:
    parts = [int(part) for part in re.findall(r"\d+", str(version))]
    return tuple(parts or [0])


def is_newer_connector_version(remote_version: str, current_version: str = CONNECTOR_VERSION) -> bool:
    return connector_version_key(remote_version) > connector_version_key(current_version)


def auto_update_enabled_status() -> Tuple[bool, str]:
    # Public auto-update remains opt-in. When enabled it executes the trusted
    # installer already present in the managed checkout; that installer accepts
    # only a release manifest whose archive matches a mandatory SHA-256.
    explicit_env = os.environ.get("AGENTCAT_AUTO_UPDATE")
    if explicit_env is not None and not env_flag("AGENTCAT_AUTO_UPDATE", True):
        return False, "disabled by AGENTCAT_AUTO_UPDATE"
    if os.environ.get("AGENTCAT_CONNECTOR_VERSION"):
        return False, "disabled while AGENTCAT_CONNECTOR_VERSION overrides the runtime version"
    settings = agentcat_settings()
    configured = settings_value(settings, ("autoUpdate", "enabled"), ("autoUpdateEnabled",))
    if isinstance(configured, bool) and not configured:
        return False, "disabled by settings"
    opted_in = (explicit_env is not None and env_flag("AGENTCAT_AUTO_UPDATE", True)) or (
        isinstance(configured, bool) and configured
    )
    if not opted_in:
        return False, "free-channel auto-update is off by default; opt in via AGENTCAT_AUTO_UPDATE or settings.autoUpdate.enabled"
    repo_dir = current_connector_repo_dir()
    install_dir = agentcat_connectors_dir()
    if repo_dir is None:
        return False, "current connector path is not a managed install"
    if repo_dir != install_dir and not env_flag("AGENTCAT_AUTO_UPDATE_ALLOW_DEV", False):
        return False, f"current connector path is outside managed install: {repo_dir}"
    installer = repo_dir / ("install.ps1" if IS_WINDOWS else "install.sh")
    if not installer.is_file():
        return False, "managed install is missing its trusted public-channel installer"
    return True, "enabled"


def read_auto_update_state() -> Dict[str, Any]:
    raw = read_json(auto_update_state_file())
    return raw if isinstance(raw, dict) else {}


def write_auto_update_state(state: Dict[str, Any]) -> None:
    write_json_atomic(auto_update_state_file(), state)


def read_update_channel_state() -> Dict[str, Any]:
    raw = read_json(update_channel_state_file())
    return raw if isinstance(raw, dict) else {}


def write_update_channel_state(channel: str, manifest: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    if channel not in VALID_UPDATE_CHANNELS:
        raise ValueError("channel must be public")
    state: Dict[str, Any] = {
        "channel": "public",
        "updatedAt": now_iso(),
        "currentVersion": CONNECTOR_VERSION,
        "status": "public",
        "installStatus": "current",
    }
    write_json_atomic(update_channel_state_file(), state)
    return state


def update_channel_status_snapshot() -> Dict[str, Any]:
    raw = read_update_channel_state()
    return {
        "channel": "public",
        "status": (raw.get("status") or "public") if raw.get("channel") == "public" else "public",
        "installStatus": (raw.get("installStatus") or "current") if raw.get("channel") == "public" else "current",
        "currentVersion": CONNECTOR_VERSION,
        "updatedAt": raw.get("updatedAt"),
    }


def auto_update_status_snapshot() -> Dict[str, Any]:
    enabled, reason = auto_update_enabled_status()
    state = read_auto_update_state()
    if not state:
        return {
            "status": "idle" if enabled else "disabled",
            "enabled": enabled,
            "reason": reason,
            "currentVersion": CONNECTOR_VERSION,
            "channel": update_channel_status_snapshot(),
        }
    status = dict(state)
    status.setdefault("enabled", enabled)
    status.setdefault("reason", reason)
    status.setdefault("currentVersion", CONNECTOR_VERSION)
    status["channel"] = update_channel_status_snapshot()
    return status


def validate_public_connector_manifest(manifest: Any) -> Dict[str, Any]:
    if not isinstance(manifest, dict):
        raise ValueError("public connector manifest must be an object")
    version = str(manifest.get("version") or "").strip()
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        raise ValueError("public connector manifest version is invalid")
    contract_version = int(manifest.get("contractVersion") or 0)
    if contract_version < 1:
        raise ValueError("public connector manifest contractVersion is invalid")
    archive_url = str(manifest.get("archiveUrl") or "").strip()
    if not archive_url.startswith("https://github.com/yong076/agentcat-connectors/"):
        raise ValueError("public connector manifest archive URL is not approved")
    digest = str(manifest.get("sha256") or "").strip()
    if not CONNECTOR_SHA256_RE.fullmatch(digest):
        raise ValueError("public connector manifest SHA-256 is invalid")
    return dict(manifest)


def fetch_public_connector_manifest() -> Dict[str, Any]:
    request = urllib.request.Request(
        AUTO_UPDATE_MANIFEST_URL,
        headers={"User-Agent": f"AgentCat/{CONNECTOR_VERSION}"},
    )
    with urllib.request.urlopen(request, timeout=AUTO_UPDATE_HTTP_TIMEOUT_SECONDS) as response:
        body = response.read(512 * 1024)
    return validate_public_connector_manifest(json.loads(body.decode("utf-8")))


def fetch_remote_connector_version() -> str:
    return str(fetch_public_connector_manifest()["version"])


def start_auto_update_install(remote_version: str) -> subprocess.Popen:
    ensure_dirs()
    env = os.environ.copy()
    env["AGENTCAT_CONNECTORS_DIR"] = str(agentcat_connectors_dir())
    env["AGENTCAT_CONNECTORS_MANIFEST_URL"] = AUTO_UPDATE_MANIFEST_URL
    stdout_path = AGENTCAT_HOME / "auto-update.out.log"
    stderr_path = AGENTCAT_HOME / "auto-update.err.log"
    stdout = stdout_path.open("ab")
    stderr = stderr_path.open("ab")
    try:
        repo_dir = current_connector_repo_dir()
        if repo_dir is None or repo_dir != agentcat_connectors_dir():
            raise ValueError("refusing to update outside the managed connector install")
        if IS_WINDOWS:
            script_path = repo_dir / "install.ps1"
            if not script_path.is_file():
                raise ValueError("trusted Windows installer is missing")
            return subprocess.Popen(
                ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(script_path)],
                cwd=str(HOME),
                env=env,
                stdout=stdout,
                stderr=stderr,
                creationflags=CREATE_NO_WINDOW,
            )
        bash = shutil.which("bash") or "/bin/bash"
        script_path = repo_dir / "install.sh"
        if not script_path.is_file():
            raise ValueError("trusted POSIX installer is missing")
        return subprocess.Popen(
            [bash, str(script_path)],
            cwd=str(HOME),
            env=env,
            stdout=stdout,
            stderr=stderr,
        )
    finally:
        stdout.close()
        stderr.close()


def check_auto_update_once(apply_update: bool = True) -> Dict[str, Any]:
    checked_at = now_iso()
    enabled, reason = auto_update_enabled_status()
    repo_dir = current_connector_repo_dir()
    state: Dict[str, Any] = {
        "checkedAt": checked_at,
        "currentVersion": CONNECTOR_VERSION,
        "enabled": enabled,
        "installDir": str(agentcat_connectors_dir()),
        "repoDir": str(repo_dir) if repo_dir else None,
        "reason": reason,
    }
    if not enabled:
        state["status"] = "disabled"
        write_auto_update_state(state)
        return state
    try:
        remote_version = fetch_remote_connector_version()
        state["remoteVersion"] = remote_version
        if not is_newer_connector_version(remote_version, CONNECTOR_VERSION):
            state["status"] = "current"
            write_auto_update_state(state)
            return state
        if not apply_update:
            state["status"] = "update_available"
            write_auto_update_state(state)
            return state
        proc = start_auto_update_install(remote_version)
        state.update(
            {
                "status": "update_started",
                "installPid": proc.pid,
                "message": f"updating Agent Cat connector {CONNECTOR_VERSION} -> {remote_version}",
            }
        )
        write_auto_update_state(state)
        return state
    except Exception as exc:
        state.update({"status": "error", "error": str(exc)})
        write_auto_update_state(state)
        return state


def auto_update_loop(interval_seconds: float, initial_delay_seconds: float) -> None:
    time.sleep(max(0.0, initial_delay_seconds))
    while True:
        try:
            state = check_auto_update_once(apply_update=True)
            if state.get("status") == "update_started":
                print(state.get("message", "agentcatd update started"), file=sys.stderr, flush=True)
            elif state.get("status") == "error":
                print(f"agentcatd update check failed: {state.get('error')}", file=sys.stderr, flush=True)
        except Exception as exc:
            print(f"agentcatd update loop failed: {exc}", file=sys.stderr, flush=True)
        time.sleep(max(60.0, interval_seconds))


def project_daily_file() -> Path:
    """Per-day per-project token delta ledger: {"YYYY-MM-DD": {label: tokens}}."""
    return AGENTCAT_HOME / "project-daily.json"


def project_daily_state_file() -> Path:
    """Delta-accounting baselines: last observed cumulative tokens per project."""
    return AGENTCAT_HOME / "project-daily-state.json"


def project_daily_cost_file() -> Path:
    """Versioned rich ledger kept beside the legacy public flat ledger."""
    return AGENTCAT_HOME / "project-daily-cost.json"


def _project_daily_label_entry(raw: Any) -> Optional[Dict[str, Any]]:
    flat = nonnegative_int(raw)
    if flat:
        return {"total": flat, "providers": {}}
    if not isinstance(raw, dict):
        return None
    total = nonnegative_int(raw.get("total"))
    if not total:
        return None
    providers: Dict[str, Dict[str, Any]] = {}
    raw_providers = raw.get("providers")
    if isinstance(raw_providers, dict):
        for provider, entry in raw_providers.items():
            normalized = _project_daily_provider_entry(entry)
            if str(provider) and normalized:
                providers[str(provider)] = normalized
    return {"total": total, "providers": providers}


def _project_daily_provider_entry(raw: Any) -> Optional[Dict[str, Any]]:
    if not isinstance(raw, dict):
        return None
    tokens = nonnegative_int(raw.get("tokens"))
    if not tokens:
        return None
    cost_raw = raw.get("estCostUSD")
    est_cost = float(cost_raw) if isinstance(cost_raw, (int, float)) and not isinstance(cost_raw, bool) and cost_raw >= 0 else None
    top_model_raw = raw.get("topModel")
    top_model = top_model_raw if isinstance(top_model_raw, str) and top_model_raw else None
    models: Dict[str, int] = {}
    raw_models = raw.get("models")
    if isinstance(raw_models, dict):
        for model, amount in raw_models.items():
            value = nonnegative_int(amount)
            if str(model) and value:
                models[str(model)] = value
    return {"tokens": tokens, "estCostUSD": est_cost, "topModel": top_model, "models": models}


def _project_item_models(raw: Any) -> Dict[str, Dict[str, Any]]:
    out: Dict[str, Dict[str, Any]] = {}
    if not isinstance(raw, dict):
        return out
    class_aliases = (
        ("input", "inputTokens"), ("output", "outputTokens"),
        ("cacheRead", "cacheReadInputTokens"), ("cacheWrite", "cacheCreationInputTokens"),
    )
    for model, value in raw.items():
        name = normalized_model_name(model) or "unknown"
        flat = nonnegative_int(value)
        if flat is not None:
            if flat:
                out[name] = {"tokens": flat, "classes": None}
            continue
        if not isinstance(value, dict):
            continue
        has_classes = any(alias in value for _cls, alias in class_aliases)
        classes = {cls: nonnegative_int(value.get(alias)) or 0 for cls, alias in class_aliases}
        tokens = nonnegative_int(value.get("totalTokens"))
        if tokens is None:
            tokens = sum(classes.values()) if has_classes else 0
        if tokens > 0:
            out[name] = {"tokens": tokens, "classes": classes if has_classes else None}
    return out


def load_project_daily() -> Dict[str, Dict[str, Dict[str, Any]]]:
    raw = read_json(project_daily_cost_file())
    if not (isinstance(raw, dict) and isinstance(raw.get("days"), dict)):
        raw = read_json(project_daily_file())
    if isinstance(raw, dict) and isinstance(raw.get("days"), dict):
        raw_days: Dict[str, Any] = raw["days"]
    elif isinstance(raw, dict):
        raw_days = raw  # v1 flat file: day keys at the top level
    else:
        raw_days = {}
    out: Dict[str, Dict[str, Dict[str, Any]]] = {}
    for day, labels in raw_days.items():
        if not PROJECT_DAILY_DAY_RE.match(str(day)) or not isinstance(labels, dict):
            continue
        bucket: Dict[str, Dict[str, Any]] = {}
        for label, entry in labels.items():
            normalized = _project_daily_label_entry(entry)
            if str(label) and normalized:
                bucket[str(label)] = normalized
        if bucket:
            out[str(day)] = bucket
    return out


def load_project_daily_state() -> Dict[str, Any]:
    """Baselines for delta accounting.

    {"baselines": {"provider|projectId": cumulativeTokens},
     "modelBaselines": {"provider|projectId": {model: {"tokens": int,
     "classes": {input, output, cacheRead, cacheWrite} | None}}}}.
    Legacy state files (baselines only) load with empty model baselines, so the
    first rich-ledger pass seeds models without booking history onto today.
    """
    raw = read_json(project_daily_state_file())
    baselines: Dict[str, int] = {}
    model_baselines: Dict[str, Dict[str, Dict[str, Any]]] = {}
    if not isinstance(raw, dict):
        return {"baselines": baselines, "modelBaselines": model_baselines}
    raw_baselines = raw.get("baselines")
    if isinstance(raw_baselines, dict):
        for key, value in raw_baselines.items():
            amount = nonnegative_int(value)
            if str(key) and amount is not None:
                baselines[str(key)] = amount
    raw_models = raw.get("modelBaselines")
    if isinstance(raw_models, dict):
        for key, models in raw_models.items():
            if not str(key) or not isinstance(models, dict):
                continue
            normalized: Dict[str, Dict[str, Any]] = {}
            for model, entry in models.items():
                if not str(model) or not isinstance(entry, dict):
                    continue
                tokens = nonnegative_int(entry.get("tokens"))
                if tokens is None:
                    continue
                raw_classes = entry.get("classes")
                classes: Optional[Dict[str, int]] = None
                if isinstance(raw_classes, dict):
                    classes = {
                        cls: nonnegative_int(raw_classes.get(cls)) or 0
                        for cls in PROJECT_COST_CLASS_KEYS
                    }
                normalized[str(model)] = {"tokens": tokens, "classes": classes}
            if normalized:
                model_baselines[str(key)] = normalized
    grok_revision_changed = raw.get("grokAccountingVersion") != GROK_ACCOUNTING_STATE_VERSION
    if grok_revision_changed:
        baselines = {key: value for key, value in baselines.items() if not key.startswith("grok|")}
        model_baselines = {
            key: value for key, value in model_baselines.items() if not key.startswith("grok|")
        }
    return {
        "baselines": baselines,
        "modelBaselines": model_baselines,
        "_grokRevisionChanged": grok_revision_changed,
    }


def prune_project_daily(days: Dict[str, Dict[str, Any]], today: "dt.date") -> bool:
    """Drop day buckets older than PROJECT_DAILY_RETENTION_DAYS (and malformed keys)."""
    cutoff = today - dt.timedelta(days=PROJECT_DAILY_RETENTION_DAYS)
    changed = False
    for day in list(days.keys()):
        try:
            parsed = dt.date.fromisoformat(day)
        except ValueError:
            days.pop(day, None)
            changed = True
            continue
        if parsed < cutoff:
            days.pop(day, None)
            changed = True
    return changed


def snapshot_project_cumulative(providers: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
    """'provider|project-id' -> cumulative observation from provider rollups.

    Keyed per provider+project so one provider's counter reset (or a project
    dropping out of another provider's top-20 list) never bleeds into the
    others' delta accounting. Labels are basenames only — never paths.
    Each observation: {"provider", "label", "tokens", "models"} where models
    carries per-model cumulative usage when the provider attributes it.
    """
    out: Dict[str, Dict[str, Any]] = {}
    for provider, usage in (providers or {}).items():
        if not isinstance(usage, dict):
            continue
        projects = usage.get("projects")
        if not isinstance(projects, dict) or projects.get("status") != "ok":
            continue
        items = projects.get("items")
        if not isinstance(items, list):
            continue
        for item in items:
            if not isinstance(item, dict):
                continue
            project_id = str(item.get("id") or item.get("path") or "").strip()
            tokens = nonnegative_int(item.get("tokens"))
            if not project_id or tokens is None:
                continue
            label = display_project_name(project_id)
            if not label:
                continue
            out[f"{provider}|{project_id}"] = {
                "provider": str(provider),
                "label": label,
                "tokens": tokens,
                "models": _project_item_models(item.get("models")),
            }
    return out


def project_daily_snapshot_slice(
    days: Dict[str, Dict[str, Any]], today: "dt.date"
) -> Dict[str, Dict[str, int]]:
    """Trailing PROJECT_DAILY_SNAPSHOT_DAYS v1 flat view ({day: {label:
    tokens}}) embedded in the snapshot for pre-dailyCost clients."""
    cutoff = today - dt.timedelta(days=PROJECT_DAILY_SNAPSHOT_DAYS - 1)
    out: Dict[str, Dict[str, int]] = {}
    for day, labels in days.items():
        try:
            parsed = dt.date.fromisoformat(day)
        except ValueError:
            continue
        if parsed >= cutoff and labels:
            out[day] = {label: int(entry["total"]) for label, entry in labels.items()}
    return out


def project_daily_cost_snapshot_slice(
    days: Dict[str, Dict[str, Any]], today: "dt.date"
) -> Dict[str, Dict[str, Any]]:
    """Trailing PROJECT_DAILY_COST_SNAPSHOT_DAYS rich view (capability
    "projects.dailyCost"). Per-day model mixes stay in the ledger file; the
    snapshot exposes tokens/estCostUSD/topModel per provider."""
    cutoff = today - dt.timedelta(days=PROJECT_DAILY_COST_SNAPSHOT_DAYS - 1)
    out: Dict[str, Dict[str, Any]] = {}
    for day, labels in days.items():
        try:
            parsed = dt.date.fromisoformat(day)
        except ValueError:
            continue
        if parsed < cutoff or not labels:
            continue
        day_out: Dict[str, Any] = {}
        for label, entry in labels.items():
            day_out[label] = {
                "total": int(entry["total"]),
                "providers": {
                    provider: {
                        "tokens": int(pentry["tokens"]),
                        "estCostUSD": pentry["estCostUSD"],
                        "topModel": pentry["topModel"],
                    }
                    for provider, pentry in entry["providers"].items()
                },
            }
        out[day] = day_out
    return out


def _project_daily_top_model(models: Dict[str, int]) -> Optional[str]:
    """Deterministic top model for a day's mix: most tokens, ties broken by
    lexicographically smallest name; 'unknown' never wins."""
    best: Optional[Tuple[str, int]] = None
    for model, tokens in models.items():
        if model == "unknown" or tokens <= 0:
            continue
        if best is None or tokens > best[1] or (tokens == best[1] and model < best[0]):
            best = (model, tokens)
    return best[0] if best else None


def _model_baseline_value(current: Dict[str, Any]) -> Dict[str, Any]:
    classes = current.get("classes")
    return {
        "tokens": int(current["tokens"]),
        "classes": dict(classes) if isinstance(classes, dict) else None,
    }


def _reseed_model_baselines(
    baseline_models: Dict[str, Dict[str, Any]],
    observed_models: Dict[str, Dict[str, Any]],
) -> None:
    """Replace all model baselines after a project counter reset/first sight."""
    baseline_models.clear()
    for model, current in observed_models.items():
        baseline_models[model] = _model_baseline_value(current)


def _project_model_deltas(
    baseline_models: Dict[str, Dict[str, Any]],
    observed_models: Dict[str, Dict[str, Any]],
) -> Tuple[Dict[str, int], Optional[float], bool]:
    """Per-model delta accounting mirroring the per-project total rules.

    First sighting seeds the baseline; a shrinking model counter (or any
    shrinking class) rebases without booking. Cost accrues only for models
    with a known name, a full class split on both sides of the delta, and a
    price in the merged table — everything else contributes tokens to the
    mix but no cost. Returns (deltas, costUSD or None, baselines changed).
    """
    deltas: Dict[str, int] = {}
    cost_total: Optional[float] = None
    changed = False
    for model, current in observed_models.items():
        prev = baseline_models.get(model)
        if prev is None or current["tokens"] < prev["tokens"]:
            baseline_models[model] = _model_baseline_value(current)
            changed = True
            continue
        token_delta = current["tokens"] - prev["tokens"]
        class_deltas: Optional[Dict[str, int]] = None
        cur_classes = current.get("classes")
        prev_classes = prev.get("classes")
        if isinstance(cur_classes, dict) and isinstance(prev_classes, dict):
            candidate = {
                cls: int(cur_classes.get(cls) or 0) - int(prev_classes.get(cls) or 0)
                for cls in PROJECT_COST_CLASS_KEYS
            }
            if any(value < 0 for value in candidate.values()):
                # A class counter reset makes the aggregate model delta
                # unattributable. Rebase the whole model and resume booking
                # only from this coherent baseline on the next snapshot.
                baseline_models[model] = _model_baseline_value(current)
                changed = True
                continue
            class_deltas = candidate
        new_baseline = _model_baseline_value(current)
        if new_baseline != prev:
            baseline_models[model] = new_baseline
            changed = True
        if token_delta <= 0:
            continue
        deltas[model] = deltas.get(model, 0) + token_delta
        if model != "unknown" and class_deltas and any(class_deltas.values()):
            cost = estimate_cost(
                model,
                class_deltas["input"],
                class_deltas["output"],
                class_deltas["cacheRead"],
                class_deltas["cacheWrite"],
            )
            if cost is not None:
                cost_total = (cost_total or 0.0) + cost["total"]
    return deltas, cost_total, changed


def update_project_daily(
    providers: Dict[str, Any], now: Optional["dt.datetime"] = None
) -> Dict[str, Dict[str, Any]]:
    """Book per-project cumulative growth into LOCAL-day delta buckets.

    Delta accounting against the previous cumulative value: only growth since
    the last snapshot is booked (to today's local day), so restarts never
    double-count. First sighting only seeds the baseline (months of history
    must not land on today), and a shrinking counter rebases the baseline
    without ever booking a negative delta.

    The rich ledger adds per-provider splits per day/label plus estimated cost: the same
    delta rules run per model where the provider rollup attributes models
    (Claude journal carries the full class split, Codex sessions model totals
    only), class deltas are priced through estimate_cost (LiteLLM feed over
    the bundled table), and estCostUSD stays null when nothing is
    attributable — a partial value covers only the priced share, never a
    blended guess. The return value deliberately remains the public 14-day
    flat slice; the 30-day rich slice is loaded separately for the snapshot.
    """
    if now is None:
        now = dt.datetime.now(dt.timezone.utc)
    today_key = day_key_for_timestamp(now) or now.astimezone().date().isoformat()
    today = dt.date.fromisoformat(today_key)
    days = load_project_daily()
    state = load_project_daily_state()
    baselines: Dict[str, int] = state["baselines"]
    model_baselines: Dict[str, Dict[str, Dict[str, Any]]] = state["modelBaselines"]
    days_changed = prune_project_daily(days, today)
    state_changed = bool(state.get("_grokRevisionChanged"))
    for key, observed in snapshot_project_cumulative(providers).items():
        tokens = observed["tokens"]
        key_models = model_baselines.setdefault(key, {})
        previous = baselines.get(key)
        if previous is None or tokens < previous:
            baselines[key] = tokens
            _reseed_model_baselines(key_models, observed["models"])
            state_changed = True
            continue
        delta = tokens - previous
        model_deltas, cost_total, models_changed = _project_model_deltas(
            key_models, observed["models"]
        )
        if models_changed:
            state_changed = True
        if delta == 0:
            continue
        baselines[key] = tokens
        state_changed = True
        bucket = days.setdefault(today_key, {})
        label_entry = bucket.setdefault(
            observed["label"], {"total": 0, "providers": {}}
        )
        label_entry["total"] = int(label_entry["total"]) + delta
        pentry = label_entry["providers"].setdefault(
            observed["provider"],
            {"tokens": 0, "estCostUSD": None, "topModel": None, "models": {}},
        )
        pentry["tokens"] = int(pentry["tokens"]) + delta
        for model, model_delta in model_deltas.items():
            pentry["models"][model] = int(pentry["models"].get(model) or 0) + model_delta
        if cost_total is not None:
            pentry["estCostUSD"] = round((pentry["estCostUSD"] or 0.0) + cost_total, 6)
        pentry["topModel"] = _project_daily_top_model(pentry["models"])
        days_changed = True
    if days_changed:
        write_json_atomic(
            project_daily_cost_file(),
            {"version": PROJECT_DAILY_FILE_VERSION, "days": days},
        )
        write_json_atomic(
            project_daily_file(),
            {
                day: {label: int(entry["total"]) for label, entry in labels.items()}
                for day, labels in days.items()
            },
        )
    if state_changed:
        write_json_atomic(
            project_daily_state_file(),
            {
                "version": PROJECT_DAILY_STATE_VERSION,
                "grokAccountingVersion": GROK_ACCOUNTING_STATE_VERSION,
                "baselines": baselines,
                "modelBaselines": {k: v for k, v in model_baselines.items() if v},
            },
        )
    return project_daily_snapshot_slice(days, today)


_BUILD_SNAPSHOT_LOCK = threading.RLock()


def build_snapshot() -> Dict[str, Any]:
    # Serialize snapshot builds. build_snapshot() is invoked from the 60s refresh loop,
    # the POST /v1/config handler, the `agentcat event` path, and the cold-start thread;
    # update_project_daily books per-project *deltas* against a persisted baseline, so two
    # interleaved builds re-book the same growth into today's projectsDaily (audit #4).
    # An RLock keeps it safe even if a future caller nests a build.
    with _BUILD_SNAPSHOT_LOCK:
        return _build_snapshot_impl()


def _build_snapshot_impl() -> Dict[str, Any]:
    ensure_dirs()
    settings = agentcat_settings()
    provider_config = configured_provider_entries(settings)
    try:
        latest_by_provider: Dict[str, Any] = latest_events_by_provider()
    except Exception as exc:
        latest_by_provider = {"_agentcat_error": str(exc), "path": str(EVENTS_DB)}
    limits_by_provider = configured_limits()
    runtime_limits_by_provider = runtime_limits()
    def _safe_provider(provider_id: str, fn: Any) -> Dict[str, Any]:
        # Per-provider isolation: one provider's reader raising must NOT fail the whole
        # build_snapshot. The refresh loop swallows the exception and then serves the
        # previous snapshot with a fresh servedAt — so a single bad provider silently
        # freezes ALL numbers as if current (audit #14). Degrade to an error entry.
        try:
            return fn()
        except Exception as exc:
            logging.debug("provider %s snapshot failed: %s", provider_id, exc)
            snap = empty_provider_usage(status="error")
            snap["error"] = str(exc)
            return snap

    try:
        activity = terminal_activity_snapshot()
    except Exception as exc:
        logging.debug("terminal_activity_snapshot failed: %s", exc)
        activity = {"status": "error", "error": str(exc)}
    if (provider_config.get("gemini") or {}).get("enabled") is False and (provider_config.get("antigravity") or {}).get("enabled") is False:
        gemini_provider = disabled_provider_snapshot("gemini")
        antigravity_provider = disabled_provider_snapshot("antigravity")
    else:
        try:
            gemini_provider, antigravity_provider = split_google_cli_snapshots(gemini_snapshot(), activity)
        except Exception as exc:
            logging.debug("gemini/antigravity snapshot failed: %s", exc)
            gemini_provider = empty_provider_usage(status="error")
            gemini_provider["error"] = str(exc)
            antigravity_provider = empty_provider_usage(status="error")
            antigravity_provider["error"] = str(exc)
    providers = {
        "codex": disabled_provider_snapshot("codex") if (provider_config.get("codex") or {}).get("enabled") is False else _safe_provider("codex", codex_snapshot),
        "claude": disabled_provider_snapshot("claude") if (provider_config.get("claude") or {}).get("enabled") is False else _safe_provider("claude", claude_snapshot),
        "gemini": gemini_provider,
        "antigravity": antigravity_provider,
        "opencode": disabled_provider_snapshot("opencode") if (provider_config.get("opencode") or {}).get("enabled") is False else _safe_provider("opencode", opencode_snapshot),
        "copilot": disabled_provider_snapshot("copilot") if (provider_config.get("copilot") or {}).get("enabled") is False else _safe_provider("copilot", copilot_snapshot),
        "kimi": disabled_provider_snapshot("kimi") if (provider_config.get("kimi") or {}).get("enabled") is False else _safe_provider("kimi", kimi_snapshot),
        "grok": disabled_provider_snapshot("grok") if (provider_config.get("grok") or {}).get("enabled") is False else _safe_provider("grok", grok_snapshot),
    }
    if (provider_config.get("gemini") or {}).get("enabled") is False:
        providers["gemini"] = disabled_provider_snapshot("gemini")
    if (provider_config.get("antigravity") or {}).get("enabled") is False:
        providers["antigravity"] = disabled_provider_snapshot("antigravity")
    for provider in ("gemini", "antigravity", "opencode", "copilot", "kimi", "grok"):
        attach_local_usage_coverage(provider, providers.get(provider, {}))
    for provider, data in providers.items():
        if data.get("status") == "disabled":
            data["limits"] = empty_limits("disabled")
            continue
        data["limits"] = merge_limits(
            limits_by_provider.get(provider, empty_limits()),
            runtime_limits_by_provider.get(provider, empty_limits()),
        )
    desktop_apps = desktop_app_sources_snapshot(settings)
    attach_desktop_app_sources(providers, desktop_apps)
    snapshot = {
        "schemaVersion": SCHEMA_VERSION,
        "contractVersion": CONTRACT_VERSION,
        "connectorVersion": CONNECTOR_VERSION,
        "capabilities": list(CONNECTOR_CAPABILITIES),
        "generatedAt": now_iso(),
        "update": auto_update_status_snapshot(),
        "daemon": daemon_status_snapshot(),
        "activity": activity,
        "providers": providers,
        "desktopApps": desktop_apps,
        "events": {
            "latestByProvider": latest_by_provider,
        },
    }
    for data in providers.values():
        try:
            burn_rate = provider_burn_rate(data)
            if burn_rate:
                data["burnRate"] = burn_rate
        except Exception as exc:
            logging.debug("provider_burn_rate failed: %s", exc)
        try:
            auto_quota = provider_auto_quota(data)
            if auto_quota:
                data["autoQuota"] = auto_quota
        except Exception as exc:
            logging.debug("provider_auto_quota failed: %s", exc)
    try:
        recommendation = snapshot_recommendation(providers)
        if recommendation:
            snapshot["recommendation"] = recommendation
    except Exception as exc:
        logging.debug("snapshot_recommendation failed: %s", exc)
    # Independent login/quota pools (capability "providerInstances.v1").
    # Additive and local-only: legacy clients keep reading providers.<id>, while
    # newer clients can render N peer connections without summing percentages.
    try:
        snapshot["providerInstances"] = provider_instances_snapshot(runtime_limits_by_provider)
    except Exception as exc:
        logging.debug("provider_instances_snapshot failed: %s", exc)
    # Where each provider's usage lives, and which of those homes we read
    # (capability "homes.discovery"). Diagnostic only — it never changes what
    # gets counted — and additive, so older app builds simply ignore it.
    try:
        snapshot["homes"] = home_discovery_snapshot()
    except Exception as exc:
        logging.debug("home_discovery_snapshot failed: %s", exc)
    # Per-day per-project token deltas (capability "projects.daily").
    # Additive/optional: failure degrades to an absent field and must NOT
    # block the snapshot write.
    try:
        snapshot["projectsDaily"] = update_project_daily(providers)
        today_key = day_key_for_timestamp(dt.datetime.now(dt.timezone.utc))
        today = dt.date.fromisoformat(today_key) if today_key else dt.datetime.now().astimezone().date()
        snapshot["projectsDailyCost"] = project_daily_cost_snapshot_slice(load_project_daily(), today)
    except Exception as exc:
        logging.debug("update_project_daily failed: %s", exc)
    # LiteLLM pricing feed metadata (capability "pricing.feed"). Additive and
    # optional: any failure degrades to the bundled table without blocking.
    try:
        snapshot["pricing"] = pricing_status_snapshot()
    except Exception as exc:
        logging.debug("pricing_status_snapshot failed: %s", exc)
    insights_by_period: Dict[str, Any] = {}
    for period in ("today", "week", "month", "all"):
        try:
            derived = derive_insights(snapshot, period=period)
            insights_by_period[period] = {"status": "ok", **derived}
        except Exception as exc:
            insights_by_period[period] = {"status": "error", "error": str(exc)}
    snapshot["insightsByPeriod"] = insights_by_period
    snapshot["insights"] = insights_by_period["week"]
    write_json_atomic(LATEST_SNAPSHOT, snapshot)
    return snapshot


_HTTP_LIVE_CACHE_LOCK = threading.Lock()
_HTTP_LIVE_CACHE: Optional[Tuple[float, Dict[str, Any], Dict[str, Any]]] = None
HTTP_LIVE_CACHE_TTL = float(os.environ.get("AGENTCAT_HTTP_LIVE_CACHE_SECONDS", "2.0"))


def _live_activity_and_desktop() -> Tuple[Dict[str, Any], Dict[str, Any]]:
    """The per-request live overlay (process scan + desktop-app walk), cached for a
    couple of seconds. The app polls /v1/snapshot every ~2-5s, and each call otherwise
    spawned `/bin/ps` (or WMI) and walked the desktop tree — 10-13% of a core steady
    state (audit #6). The 60s background loop keeps the snapshot body fresh; this only
    throttles the live overlay."""
    global _HTTP_LIVE_CACHE
    now = time.monotonic()
    with _HTTP_LIVE_CACHE_LOCK:
        if _HTTP_LIVE_CACHE is not None and (now - _HTTP_LIVE_CACHE[0]) < HTTP_LIVE_CACHE_TTL:
            return _HTTP_LIVE_CACHE[1], _HTTP_LIVE_CACHE[2]
    activity = terminal_activity_snapshot()
    desktop_apps = desktop_app_sources_snapshot(agentcat_settings())
    with _HTTP_LIVE_CACHE_LOCK:
        _HTTP_LIVE_CACHE = (time.monotonic(), activity, desktop_apps)
    return activity, desktop_apps


# Cheap envelope keys that always ride along: a caller filtering for one
# section still needs to know which schema and connector produced it.
_SNAPSHOT_ENVELOPE_KEYS = (
    "schemaVersion",
    "contractVersion",
    "connectorVersion",
    "generatedAt",
    "servedAt",
)


def filter_snapshot_sections(payload: Dict[str, Any], requested: str) -> Dict[str, Any]:
    """Narrow /v1/snapshot to the sections a caller actually reads.

    The full snapshot is ~180KB on a machine with real history, and `providers`
    alone is ~65% of it. The menu bar app polls every couple of seconds but only
    consumes `activity` (~5%), so it was paying a full decode of the other 95%
    on every tick — the app's largest sustained CPU cost.

    Unknown or empty input returns the payload untouched, which keeps this
    backwards compatible in both directions: an old app gets everything, and a
    new app asking an old connector simply receives the full payload and
    ignores the extra.
    """
    if not requested:
        return payload
    keep = {name.strip() for name in requested.split(",") if name.strip()}
    if not keep:
        return payload
    filtered = {
        key: value
        for key, value in payload.items()
        if key in keep or key in _SNAPSHOT_ENVELOPE_KEYS
    }
    # Never answer with only envelope keys — that would look like a healthy
    # response carrying no data at all.
    if not any(key in keep for key in filtered):
        return payload
    return filtered


def snapshot_for_http() -> Dict[str, Any]:
    cached = read_json(LATEST_SNAPSHOT)
    if isinstance(cached, dict) and isinstance(cached.get("providers"), dict):
        snapshot = copy.deepcopy(cached)
        snapshot["servedAt"] = now_iso()
        snapshot["update"] = auto_update_status_snapshot()
        activity, desktop_apps = _live_activity_and_desktop()
        snapshot["activity"] = activity
        snapshot["desktopApps"] = desktop_apps
        providers = snapshot.get("providers")
        if isinstance(providers, dict):
            attach_desktop_app_sources(providers, desktop_apps)
        return snapshot
    return build_snapshot()


def snapshot_refresh_loop(interval_seconds: float) -> None:
    while True:
        time.sleep(interval_seconds)
        try:
            build_snapshot()
        except Exception as exc:
            print(f"agentcatd snapshot refresh failed: {exc}", file=sys.stderr, flush=True)


def concise_snapshot_text(snapshot: Dict[str, Any]) -> str:
    lines = ["Agent Cat snapshot"]
    for provider, data in snapshot.get("providers", {}).items():
        status = data.get("status", "unknown")
        tokens = data.get("tokens") or {}
        if provider == "codex":
            total = tokens.get("all", 0)
            week = tokens.get("week", 0)
            lines.append(f"- codex: {status}, {total:,} tokens all-time, {week:,} last 7d")
        else:
            total = tokens.get("totalTokens") or sum(v for v in tokens.values() if isinstance(v, int))
            lines.append(f"- {provider}: {status}, {int(total):,} tokens captured")
    return "\n".join(lines)


def statusline_text(payload: Any) -> str:
    model = display_model(find_first_key(payload, ["model", "modelName", "model_name"]))
    tokens = extract_tokens(payload)
    chunks = ["Agent Cat"]
    if model:
        chunks.append(str(model))
    if isinstance(payload, dict):
        context = payload.get("context_window")
        if isinstance(context, dict) and context.get("used_percentage") is not None:
            chunks.append(f"ctx {context.get('used_percentage')}%")
        limits = payload.get("rate_limits")
        if isinstance(limits, dict):
            five_hour = limits.get("five_hour")
            seven_day = limits.get("seven_day")
            if isinstance(five_hour, dict) and five_hour.get("used_percentage") is not None:
                chunks.append(f"5h {five_hour.get('used_percentage')}%")
            if isinstance(seven_day, dict) and seven_day.get("used_percentage") is not None:
                chunks.append(f"7d {seven_day.get('used_percentage')}%")
    if tokens.get("totalTokens"):
        chunks.append(f"{tokens['totalTokens']:,} tok")
    elif len(chunks) == 1:
        chunks.append("collecting")
    return " · ".join(chunks)


def setup_prompt_text() -> str:
    install_command = "curl -fsSL https://raw.githubusercontent.com/yong076/agentcat-connectors/main/install.sh | bash"
    return f"""Set up Agent Cat on this Mac for Codex, Claude Code, and Gemini CLI.

First run this local connector install command if `agentcat` is missing:

{install_command}

Then verify the local snapshot:

agentcat snapshot --json

If this runtime supports skills or MCP tools, install or use the Agent Cat Usage skill from:
https://github.com/yong076/agentcat-connectors/tree/main/skills/agentcat-usage

Expected behavior:
- Use `agentcat snapshot --json` as the source of truth for Codex, Claude Code, and Gemini CLI usage.
- Codex should use local state plus the Agent Cat notify hook when configured.
- Claude Code should use local stats plus Agent Cat hooks when configured.
- Gemini CLI should use local telemetry configured by Agent Cat.
- Report exact provider quotas only when the snapshot exposes them. Otherwise say unavailable.
- Never store or report prompt text, message content, transcripts, or conversation bodies.
"""


# ---------------------------------------------------------------------------
# Reflect (돌아보기) — a second reader of the session files the connector
# already indexes for tokens.
#
# Reflect answers "what slowed me down, what worked, how should I ask next
# time" from the user's own Claude Code / Codex transcripts. Everything runs on
# this machine: the indexer walks the same session paths the token readers walk
# (claude_journal_files_by_root / codex_session_files), the digest is scrubbed
# and sampled before it reaches an analyzer, the analyzer is the user's own CLI
# (`claude -p`), and results live in ~/.agentcat/reflect.db. The only outbound
# shape is the analyzer subprocess; the telemetry-shaped summary is a fixed
# five-field struct with no free text (reflect_telemetry_summary).
#
# Layout: config → indexer → scrub/sampling → analyzer → store → synthesis →
# HTTP/CLI → scheduler. Each layer is a plain function so tests can drive it
# with synthetic transcripts and a stubbed runner.
# ---------------------------------------------------------------------------

REFLECT_DB = AGENTCAT_HOME / "reflect.db"
REFLECT_CONFIG_FILE = AGENTCAT_HOME / "reflect.json"
REFLECT_OPENCODE_STORAGE = HOME / ".local" / "share" / "opencode" / "storage"
REFLECT_COPILOT_SESSION_STATE = HOME / ".copilot" / "session-state"
REFLECT_GROK_HOME = HOME / ".grok"
REFLECT_GEMINI_TMP = HOME / ".gemini" / "tmp"
REFLECT_CURSOR_CHATS = HOME / ".cursor" / "chats"
REFLECT_CURSOR_WORKSPACE_STORAGE = HOME / "Library" / "Application Support" / "Cursor" / "User" / "workspaceStorage"
REFLECT_KIMI_HOME = HOME / ".kimi-code"
# cwd for the analyzer subprocess. Claude Code journals every `-p` run under
# ~/.claude/projects/<cwd>; keeping the analyzer in its own directory lets the
# indexer recognise and skip its own sessions (no feedback loop).
REFLECT_SCRATCH_DIR = AGENTCAT_HOME / "reflect-scratch"
REFLECT_MARKER = "AGENTCAT_REFLECT_ANALYSIS_REQUEST"
REFLECT_DAILY_CAP = 20
