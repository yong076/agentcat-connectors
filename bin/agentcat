    "enabled": False,
    "runner": "claude-native",
    "dailyCap": REFLECT_DAILY_CAP,
    "nightlyHour": 3,
    "weeklyWeekday": 6,  # Monday=0 … Sunday=6
    "weeklyHour": 18,
    "lookbackDays": 14,
    # Files older than this (mtime) are never indexed: Reflect is a weekly
    # mirror, not an archive, and a first sync over years of rollouts would
    # otherwise parse gigabytes for sessions no view ever shows.
    "indexDays": 30,
}
