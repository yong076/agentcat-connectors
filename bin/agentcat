def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def _chmod_quiet(path: Path, mode: int) -> None:
    # Best-effort: chmod is unsupported / a no-op on Windows, and we never want a
    # permission tweak to crash the daemon.
    if IS_WINDOWS:
        return
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def ensure_dirs() -> None:
    AGENTCAT_HOME.mkdir(parents=True, exist_ok=True)
    _chmod_quiet(AGENTCAT_HOME, 0o700)
    GEMINI_TELEMETRY.parent.mkdir(parents=True, exist_ok=True)
    # Lock down the private files/dirs directly under ~/.agentcat (events DB,
    # snapshots, caches, update state) to owner-only access. This is a shallow
    # pass so the frequently-called ensure_dirs stays cheap; nested telemetry
    # dirs are normalized when their parent is created.
    if not IS_WINDOWS:
        try:
            children = list(AGENTCAT_HOME.iterdir())
        except OSError:
            children = []
        for child in children:
            _chmod_quiet(child, 0o700 if child.is_dir() else 0o600)


def agentcat_settings() -> Dict[str, Any]:
    path = AGENTCAT_HOME / "settings.json"
    try:
        with path.open("r", encoding="utf-8") as fh:
            raw = json.load(fh)
    except Exception:
        return {}
    return raw if isinstance(raw, dict) else {}


def write_agentcat_settings(settings: Dict[str, Any]) -> None:
    write_json_atomic(AGENTCAT_HOME / "settings.json", settings)


def settings_value(settings: Dict[str, Any], *paths: Tuple[str, ...]) -> Any:
    for path in paths:
        current: Any = settings
        for key in path:
            if not isinstance(current, dict):
                current = None
                break
            current = current.get(key)
        if current is not None:
            return current
    return None


# ---------------------------------------------------------------------------
# Multi-home discovery
#
# A provider's usage can live under more than one home on the same machine: a
# second profile ($CODEX_HOME / $CLAUDE_CONFIG_DIR pointed elsewhere), an
# app-managed runtime home, or a mirror another tool created. The daemon reads
# whichever home its environment named when launchd froze that environment at
# install time, so every other home is invisible — and a mirror that silently
# stops receiving new sessions looks fine, because the lifetime total it already
# holds stays plausible.
#
# Discovery is automatic; adoption is not. A discovered home is reported by
# `agentcat doctor` and only counted once the user adopts it. Auto-absorbing
# would eventually swallow a backup dir or a test fixture and inflate every
# number the product shows, which costs more trust than the gap it closes.
# ---------------------------------------------------------------------------

PROVIDER_HOME_SPECS: Dict[str, Dict[str, Any]] = {
    "codex": {
        "envVar": "CODEX_HOME",
        "defaultName": ".codex",
        "siblingGlob": ".codex*",
        "usageGlobs": ("sessions/**/*.jsonl", "archived_sessions/**/*.jsonl"),
        # Markers prove a directory really is a provider home, so a stray
        # ~/.codex-notes folder never gets offered as a usage source.
        "markers": ("sessions", "archived_sessions", "auth.json"),
        # Homes other local tools create by mirroring ~/.codex.
        "knownRuntimeHomes": ("Library/Application Support/orca/codex-runtime-home/home",),
    },
    "claude": {
        "envVar": "CLAUDE_CONFIG_DIR",
        "defaultName": ".claude",
        "siblingGlob": ".claude*",
        "usageGlobs": ("projects/**/*.jsonl",),
        "markers": ("projects", "settings.json"),
        "knownRuntimeHomes": (),
    },
}

HOME_DISCOVERY_PROVIDER_IDS = tuple(PROVIDER_HOME_SPECS)

# Discovery is advisory, so it is bounded rather than exhaustive: a home buried
# under a 13th backup copy is not worth turning `doctor` into a directory walk.
HOME_DISCOVERY_MAX_CANDIDATES = 12
# Counting files in a candidate home stops here. Set high because the cap costs
# accuracy, not just detail: stopping early also stops the newest-file search,
# and "how recently was this home written to" is the signal that separates a
# stalled mirror from a second profile. Measured ~100ms for 8.5k files, and the
# snapshot path is memoized below rather than paying it every tick.
HOME_DISCOVERY_FILE_CAP = 50000
# Homes appear and disappear on the order of days, so the 60s snapshot tick must
# not re-walk them. doctor and the CLI bypass this and always read fresh.
HOME_DISCOVERY_CACHE_TTL_SECONDS = 600


def _stat_quiet(path: Path, cache: Optional[Dict[str, Any]] = None) -> Optional[os.stat_result]:
    """stat() a path, returning None instead of raising, memoized per scan."""
    key = str(path)
    if cache is not None and key in cache:
        return cache[key]
    try:
        result: Optional[os.stat_result] = path.stat()
    except OSError:
        result = None
    if cache is not None:
        cache[key] = result
    return result


_SESSION_UUID_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.IGNORECASE
)


def _session_identity(path: Path) -> Optional[str]:
    """Identify the session a usage file holds, from its filename alone.

    Codex names rollouts ``rollout-<timestamp>-<uuid>.jsonl`` and Claude names
    journals ``<sessionId>.jsonl``; both carry a UUID that is stable across
    copies of the same session. Returns None when no UUID is present, which
    means "cannot claim two files are the same session" — never a false match.
    """
    match = _SESSION_UUID_RE.search(path.name)
    return match.group(0).lower() if match else None


def dedupe_usage_paths(
    paths: List[Path],
    stat_cache: Optional[Dict[str, Any]] = None,
    match_session_identity: bool = False,
) -> List[Path]:
    """Collapse usage files reachable through more than one home.

    Layers, cheapest first:

    1. ``realpath`` — catches symlinked homes.
    2. ``(st_dev, st_ino)`` — catches hardlinked mirrors, which layer 1 cannot
       see because both paths are equally real. This is the shape a local mirror
       of ``~/.codex`` actually takes.
    3. session identity from the filename — catches true copies (independent
       inodes holding the same session). The longer file wins, because a stale
       copy is a truncated snapshot of the live one.

    Layers 1–2 always run: two paths to one inode are the same bytes, so
    counting both is unambiguously wrong. Layer 3 is a judgement call about two
    genuinely different files, so it only runs when more than one home is in
    play (``match_session_identity``) — inside a single home, ``sessions/`` and
    ``archived_sessions/`` holding the same UUID is a move in progress, not a
    duplicate to resolve.

    Input order is preserved for the survivors, so callers keep deterministic
    cursor keys.
    """
    seen_identity: Set[Any] = set()
    by_session: Dict[str, int] = {}
    kept: List[Optional[Path]] = []

    for path in paths:
        try:
            identity: Any = str(path.resolve())
        except OSError:
            identity = str(path)
        stat_result = _stat_quiet(path, stat_cache)
        if stat_result is not None:
            identity = (stat_result.st_dev, stat_result.st_ino)
        if identity in seen_identity:
            continue
        seen_identity.add(identity)

        if match_session_identity:
            session = _session_identity(path)
            if session is not None:
                previous_index = by_session.get(session)
                if previous_index is not None:
                    previous = kept[previous_index]
                    previous_stat = _stat_quiet(previous, stat_cache) if previous else None
                    previous_size = previous_stat.st_size if previous_stat else -1
                    current_size = stat_result.st_size if stat_result else -1
                    if current_size > previous_size:
                        # The live file is longer than the stale copy: swap, keeping
                        # the discarded one out of the result entirely.
                        kept[previous_index] = None
                        by_session[session] = len(kept)
                        kept.append(path)
                    continue
                by_session[session] = len(kept)
        kept.append(path)

    return [path for path in kept if path is not None]


def _home_has_marker(home: Path, spec: Dict[str, Any]) -> bool:
    for marker in spec.get("markers") or ():
        if (home / str(marker)).exists():
            return True
    return False


def home_usage_stats(home: Path, spec: Dict[str, Any]) -> Dict[str, Any]:
    """Count usage files under a home and date the newest one.

    Bounded by HOME_DISCOVERY_FILE_CAP: this answers "is this home in use, and
    how recently" for diagnostics, not "how many tokens".
    """
    files = 0
    newest: Optional[float] = None
    capped = False
    for pattern in spec.get("usageGlobs") or ():
        try:
            for path in home.glob(str(pattern)):
                if not path.is_file():
                    continue
                files += 1
                stat_result = _stat_quiet(path)
                if stat_result is not None:
                    if newest is None or stat_result.st_mtime > newest:
                        newest = stat_result.st_mtime
                if files >= HOME_DISCOVERY_FILE_CAP:
                    capped = True
                    break
        except OSError:
            continue
        if capped:
            break
    return {"files": files, "newestMtime": newest, "capped": capped}


def _home_settings(provider: str, settings: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    resolved = agentcat_settings() if settings is None else settings
    homes = resolved.get("homes")
    if not isinstance(homes, dict):
        return {}
    entry = homes.get(provider)
    return entry if isinstance(entry, dict) else {}


def _home_path_list(entry: Dict[str, Any], key: str) -> List[Path]:
    raw = entry.get(key)
    if not isinstance(raw, list):
        return []
    paths: List[Path] = []
    for item in raw:
        if isinstance(item, str) and item.strip():
            paths.append(Path(item).expanduser())
    return paths


def default_provider_home(provider: str) -> Path:
    """The home the connector reads today, before any adoption.

    Resolved at call time so it tracks both a swapped module HOME (tests) and an
    env var injected into the daemon's launch environment.
    """
    spec = PROVIDER_HOME_SPECS.get(provider) or {}
    env_var = spec.get("envVar")
    override = os.environ.get(str(env_var)) if env_var else None
    if override:
        return Path(override).expanduser()
    return HOME / str(spec.get("defaultName") or f".{provider}")


def provider_home_candidates(provider: str) -> List[Dict[str, Any]]:
    """Every home this provider might be storing usage in, with why we looked.

    Sources, in precedence order: the default/env home the connector already
    reads, known app-managed runtime homes, then a bounded sibling glob. Each
    entry is ``{path, source, exists, tracked, excluded, stats}``; discovery
    never changes what gets counted.
    """
    spec = PROVIDER_HOME_SPECS.get(provider)
    if not spec:
        return []

    settings_entry = _home_settings(provider)
    adopted = {str(p.resolve() if p.exists() else p) for p in _home_path_list(settings_entry, "adopted")}
    excluded = {str(p.resolve() if p.exists() else p) for p in _home_path_list(settings_entry, "excluded")}

    candidates: List[Dict[str, Any]] = []
    seen: Set[str] = set()

    def add(home: Path, source: str) -> None:
        if len(candidates) >= HOME_DISCOVERY_MAX_CANDIDATES:
            return
        try:
            key = str(home.resolve())
        except OSError:
            key = str(home)
        if key in seen:
            return
        exists = home.is_dir()
        # A non-default candidate has to look like a real provider home; the
        # default one is always listed so its absence is itself diagnosable.
        if source != "default" and (not exists or not _home_has_marker(home, spec)):
            return
        seen.add(key)
        candidates.append({
            "path": home,
            "source": source,
            "exists": exists,
            "tracked": source == "default" or key in adopted,
            "excluded": key in excluded,
            "stats": home_usage_stats(home, spec) if exists else {"files": 0, "newestMtime": None, "capped": False},
        })

    default_home = default_provider_home(provider)
    add(default_home, "default")

    for relative in spec.get("knownRuntimeHomes") or ():
        add(HOME / str(relative), "known_runtime")

    for home in _home_path_list(settings_entry, "adopted"):
        add(home, "adopted")

    sibling_glob = spec.get("siblingGlob")
    if sibling_glob:
        try:
            siblings = sorted(HOME.glob(str(sibling_glob)))
        except OSError:
            siblings = []
        for home in siblings:
            if home.is_dir():
                add(home, "sibling")

    return candidates


def tracked_provider_homes(provider: str) -> List[Path]:
    """Homes the connector actually reads: the default one plus adopted ones.

    Excluded homes are dropped even if adopted, so an exclusion is always the
    stronger signal. With nothing adopted this returns exactly the single home
    the connector read before multi-home support existed.
    """
    default_home = default_provider_home(provider)
    settings_entry = _home_settings(provider)
    excluded: Set[str] = set()
    for home in _home_path_list(settings_entry, "excluded"):
        try:
            excluded.add(str(home.resolve()))
        except OSError:
            excluded.add(str(home))

    homes: List[Path] = [default_home]
    seen: Set[str] = set()
    try:
        seen.add(str(default_home.resolve()))
    except OSError:
        seen.add(str(default_home))

    for home in _home_path_list(settings_entry, "adopted"):
        try:
            key = str(home.resolve())
        except OSError:
            key = str(home)
        if key in seen or key in excluded or not home.is_dir():
            continue
        seen.add(key)
        homes.append(home)
    return homes


CONFIG_PROVIDER_IDS = ("codex", "claude", "gemini", "antigravity", "opencode", "copilot", "kimi", "grok")
DESKTOP_APP_PROVIDER_IDS = ("claude", "codex")

DESKTOP_APP_SPECS: Dict[str, Dict[str, Any]] = {
