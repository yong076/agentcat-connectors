def resolve_user_home_env() -> str:
    """The user's real home directory, as a string.

    On Windows, Git Bash/MSYS set ``HOME`` to a POSIX-style shell home
    (``/c/msys/home/alice``) that has none of the provider directories under it.
    Trusting it there made every provider read as `not_found`, and disagreed
    with the PowerShell verifier, which uses ``UserProfile``. So Windows prefers
    ``USERPROFILE`` and only falls back to ``HOME``; POSIX is unchanged.
    """
    if os.name == "nt":
        return os.environ.get("USERPROFILE") or os.environ.get("HOME") or str(Path.home())
    return os.environ.get("HOME") or str(Path.home())


